/* 刷牙详情弹窗组件样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.detail-modal {
  width: 85%;
  max-height: 80vh;
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  position: relative;
  overflow-y: auto;
}

.detail-close {
  position: absolute;
  top: 20rpx;
  right: 24rpx;
  font-size: 36rpx;
  color: #999;
  z-index: 10;
}

.detail-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.detail-emoji {
  font-size: 48rpx;
  display: block;
  margin-bottom: 8rpx;
}

.detail-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.detail-rows {
  margin-bottom: 20rpx;
}

.detail-row {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-label {
  font-size: 26rpx;
  color: #666;
  width: 160rpx;
  flex-shrink: 0;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 4rpx;
}

.detail-star {
  font-size: 28rpx;
  opacity: 0.3;
}

.detail-star.active {
  opacity: 1;
}

.detail-score-text {
  font-size: 24rpx;
  color: #FF6B8A;
  margin-left: 8rpx;
}

.detail-stickers {
  display: flex;
  gap: 8rpx;
  flex-wrap: wrap;
}

.detail-sticker-emoji {
  font-size: 32rpx;
}

/* 照片展示 */
.detail-images {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.detail-image-item {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 2rpx solid #FFB6C1;
}

.detail-image-thumb {
  width: 100%;
  height: 100%;
}

.detail-image-edit {
  position: absolute;
  bottom: 4rpx;
  left: 4rpx;
  width: 32rpx;
  height: 32rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
}

.detail-image-delete {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 28rpx;
  height: 28rpx;
  background: #FF4444;
  color: white;
  font-size: 16rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 编辑模式 */
.edit-section {
  margin-top: 16rpx;
}

.edit-group {
  margin-bottom: 24rpx;
}

.edit-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.score-selector {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.select-star {
  font-size: 40rpx;
  opacity: 0.3;
  transition: all 0.2s;
}

.select-star.active {
  opacity: 1;
  transform: scale(1.1);
}

.note-textarea {
  width: 100%;
  min-height: 100rpx;
  padding: 16rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}

/* 编辑图片 */
.edit-images {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.edit-image-item {
  position: relative;
  width: 130rpx;
  height: 130rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 2rpx solid #FFB6C1;
}

.edit-image-thumb {
  width: 100%;
  height: 100%;
}

.edit-image-delete {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 32rpx;
  height: 32rpx;
  background: #FF4444;
  color: white;
  font-size: 18rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-image-add {
  width: 130rpx;
  height: 130rpx;
  border: 3rpx dashed #FFB6C1;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 182, 193, 0.1);
}

.edit-image-add .add-icon {
  font-size: 48rpx;
  color: #FF6B8A;
}

/* 按钮 */
.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.modal-btn {
  flex: 1;
  padding: 18rpx;
  border-radius: 40rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
}

.modal-btn.cancel {
  background: #f0f0f0;
  color: #666;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: white;
}

.detail-edit-btn {
  text-align: center;
  margin-top: 20rpx;
  padding: 16rpx;
  background: linear-gradient(135deg, #FFF0F5, #FFE4EC);
  border-radius: 30rpx;
  border: 2rpx solid #FFB6C1;
}

.detail-edit-btn text {
  font-size: 28rpx;
  color: #FF6B8A;
  font-weight: bold;
}
