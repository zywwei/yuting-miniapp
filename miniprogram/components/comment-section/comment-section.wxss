.comment-section {
  margin-top: 16rpx;
}

.section-header {
  padding: 16rpx 0;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.comment-list {
  padding: 0;
}

.comment-item {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  font-size: 40rpx;
  flex-shrink: 0;
}

.comment-body {
  flex: 1;
  overflow: hidden;
}

.comment-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.comment-author {
  font-size: 24rpx;
  color: #666;
  font-weight: bold;
}

.comment-delete {
  font-size: 22rpx;
  color: #ff4444;
  padding: 4rpx 12rpx;
}

.comment-text {
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
}

.comment-emoji {
  font-size: 48rpx;
}

.comment-image {
  width: 300rpx;
  border-radius: 12rpx;
  margin-top: 8rpx;
}

.comment-input-area {
  margin-top: 16rpx;
  background: #f8f8f8;
  border-radius: 24rpx;
  padding: 16rpx;
}

.input-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.comment-input {
  flex: 1;
  background: #fff;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  font-size: 28rpx;
}

.input-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.action-btn {
  font-size: 36rpx;
  padding: 4rpx;
}

.send-btn {
  font-size: 26rpx;
  color: #ccc;
  padding: 8rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
}

.send-btn.active {
  color: #FF6B8A;
}

.emoji-panel {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 16rpx 0 0;
}

.emoji-item {
  font-size: 40rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
