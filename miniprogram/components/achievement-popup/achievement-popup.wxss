/* 成就解锁弹窗样式 */
.popup-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s ease;
}

.popup-mask.show {
  opacity: 1;
  pointer-events: auto;
}

.popup-container {
  position: relative;
  width: 560rpx;
  background: white;
  border-radius: 32rpx;
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
  transform: scale(0.8) translateY(40rpx);
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  overflow: hidden;
}

.popup-container.show {
  transform: scale(1) translateY(0);
}

/* 光晕背景 */
.glow {
  position: absolute;
  top: -60rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  opacity: 0.3;
  pointer-events: none;
}

.rarity-common .glow {
  background: radial-gradient(circle, #4CAF50 0%, transparent 70%);
}

.rarity-rare .glow {
  background: radial-gradient(circle, #2196F3 0%, transparent 70%);
}

.rarity-legendary .glow {
  background: radial-gradient(circle, #FF9800 0%, transparent 70%);
  animation: legendary-glow 1.5s ease-in-out infinite;
}

@keyframes legendary-glow {
  0%, 100% { opacity: 0.3; transform: translateX(-50%) scale(1); }
  50% { opacity: 0.5; transform: translateX(-50%) scale(1.1); }
}

/* 成就图标 */
.achievement-icon-wrap {
  position: relative;
  z-index: 1;
  margin-bottom: 24rpx;
}

.achievement-icon {
  font-size: 100rpx;
  line-height: 1.2;
  animation: icon-bounce 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes icon-bounce {
  0% { transform: scale(0) rotate(-15deg); }
  60% { transform: scale(1.2) rotate(5deg); }
  100% { transform: scale(1) rotate(0); }
}

/* 解锁提示 */
.unlock-label {
  font-size: 28rpx;
  color: #FF9800;
  font-weight: bold;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
}

/* 成就信息 */
.achievement-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.achievement-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
}

/* 稀有度标签 */
.rarity-tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 24rpx;
  border-radius: 20rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.rarity-tag.rarity-common {
  background: #E8F5E9;
  color: #4CAF50;
}

.rarity-tag.rarity-rare {
  background: #E3F2FD;
  color: #2196F3;
}

.rarity-tag.rarity-legendary {
  background: #FFF3E0;
  color: #FF9800;
}

/* 关闭提示 */
.tap-hint {
  font-size: 22rpx;
  color: #CCC;
}
