/* 通用图片管理组件样式 */
.photo-section {
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  margin-top: 16rpx;
}

.photo-section-title {
  font-size: 26rpx;
  color: #E91E63;
  font-weight: bold;
  margin-bottom: 16rpx;
  text-align: center;
}

.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.photo-item {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid #FFB6C1;
}

.photo-thumb {
  width: 100%;
  height: 100%;
}

.photo-edit {
  position: absolute;
  bottom: 4rpx;
  left: 4rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.photo-delete {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 32rpx;
  height: 32rpx;
  background: #FF4444;
  color: white;
  font-size: 18rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-add {
  width: 140rpx;
  height: 140rpx;
  border: 3rpx dashed #FFB6C1;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: rgba(255, 182, 193, 0.1);
}

.photo-add .add-icon {
  font-size: 36rpx;
}

.photo-add .add-text {
  font-size: 22rpx;
  color: #FF6B8A;
}

.photo-add:active {
  background: rgba(255, 182, 193, 0.3);
}
