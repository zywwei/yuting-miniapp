/* 家长中心样式 */
.container {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 40rpx;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #7E57C2, #5E35B1);
  padding: 40rpx;
  color: white;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
}

.header-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* 区块 */
.section {
  background: white;
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 28rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 数据概览 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stat-item {
  text-align: center;
  padding: 20rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #5E35B1;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 学习进度 */
.progress-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.progress-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-label {
  font-size: 24rpx;
  color: #666;
  min-width: 120rpx;
}

.progress-bar {
  flex: 1;
  height: 16rpx;
  background: #F0F0F0;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #7E57C2, #5E35B1);
  border-radius: 8rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 22rpx;
  color: #999;
  min-width: 80rpx;
  text-align: right;
}

/* 成就系统 */
.achievement-summary {
  text-align: center;
}

.achievement-progress {
  display: flex;
  justify-content: center;
  align-items: baseline;
}

.achievement-number {
  font-size: 56rpx;
  font-weight: bold;
  color: #5E35B1;
}

.achievement-total {
  font-size: 28rpx;
  color: #999;
}

.achievement-bar {
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  overflow: hidden;
  margin: 16rpx 0;
}

.achievement-fill {
  height: 100%;
  background: linear-gradient(90deg, #FFD700, #FFA000);
  border-radius: 6rpx;
}

.achievement-text {
  font-size: 24rpx;
  color: #999;
}

/* 最近笔记 */
.note-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.note-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
}

.note-icon {
  font-size: 32rpx;
}

.note-info {
  flex: 1;
}

.note-title {
  font-size: 26rpx;
  color: #333;
}

.note-date {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.note-arrow {
  font-size: 28rpx;
  color: #CCC;
}

.empty-text {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 20rpx;
}

/* 数据备份与恢复 */
.backup-desc {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.backup-btn {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #F8F9FA;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  transition: background 0.2s;
}

.backup-btn:active {
  background: #E8E9EA;
}

.backup-btn-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.backup-btn-info {
  flex: 1;
}

.backup-btn-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.backup-btn-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.backup-btn-arrow {
  font-size: 32rpx;
  color: #CCC;
}

.backup-status {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  text-align: center;
}

.backup-status.loading {
  background: #E3F2FD;
  color: #1976D2;
}

.backup-status.success {
  background: #E8F5E9;
  color: #388E3C;
}

.backup-status.warning {
  background: #FFF3E0;
  color: #F57C00;
}

.backup-status.error {
  background: #FFEBEE;
  color: #D32F2F;
}

/* 角色卡片 */
.role-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.role-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.role-icon {
  font-size: 48rpx;
}

.role-info {
  display: flex;
  flex-direction: column;
}

.role-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.role-nickname {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.role-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.admin-badge {
  font-size: 22rpx;
  color: #FF6B8A;
  background: #FFF0F5;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

.card-arrow {
  font-size: 36rpx;
  color: #ccc;
}
