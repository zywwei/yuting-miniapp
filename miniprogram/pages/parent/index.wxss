/* 家长中心样式 */
.container {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 40rpx;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #7E57C2, #5E35B1);
  padding: 40rpx;
  color: white;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
}

.header-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* 区块 */
.section {
  background: white;
  margin: 24rpx 24rpx 0;
  border-radius: 20rpx;
  padding: 28rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 数据概览 */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.stat-item {
  text-align: center;
  padding: 20rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
}

.stat-number {
  font-size: 48rpx;
  font-weight: bold;
  color: #5E35B1;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 学习进度 */
.progress-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.progress-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-label {
  font-size: 24rpx;
  color: #666;
  min-width: 120rpx;
}

.progress-bar {
  flex: 1;
  height: 16rpx;
  background: #F0F0F0;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #7E57C2, #5E35B1);
  border-radius: 8rpx;
  transition: width 0.3s;
}

.progress-text {
  font-size: 22rpx;
  color: #999;
  min-width: 80rpx;
  text-align: right;
}

/* 成就系统 */
.achievement-summary {
  text-align: center;
}

.achievement-progress {
  display: flex;
  justify-content: center;
  align-items: baseline;
}

.achievement-number {
  font-size: 56rpx;
  font-weight: bold;
  color: #5E35B1;
}

.achievement-total {
  font-size: 28rpx;
  color: #999;
}

.achievement-bar {
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  overflow: hidden;
  margin: 16rpx 0;
}

.achievement-fill {
  height: 100%;
  background: linear-gradient(90deg, #FFD700, #FFA000);
  border-radius: 6rpx;
}

.achievement-text {
  font-size: 24rpx;
  color: #999;
}

/* 最近笔记 */
.note-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.note-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
}

.note-icon {
  font-size: 32rpx;
}

.note-info {
  flex: 1;
}

.note-title {
  font-size: 26rpx;
  color: #333;
}

.note-date {
  font-size: 20rpx;
  color: #999;
  margin-top: 4rpx;
}

.note-arrow {
  font-size: 28rpx;
  color: #CCC;
}

.empty-text {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 20rpx;
}
