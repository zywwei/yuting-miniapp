<!-- 家长中心 -->
<view class="container">
  <!-- 头部 -->
  <view class="header">
    <view class="header-title">👨‍👩‍👧 家庭中心</view>
    <view class="header-desc">{{childName}}已成长 {{stats.growthDays}} 天</view>
  </view>

  <!-- 我的角色 -->
  <view class="section" wx:if="{{member}}" bindtap="goFamilySettings">
    <view class="section-title">👤 我的角色</view>
    <view class="role-card">
      <view class="role-left">
        <text class="role-icon">{{member.role === 'father' ? '👨' : member.role === 'mother' ? '👩' : member.role === 'child' ? '🧒' : member.role === 'grandpa' ? '👴' : member.role === 'grandma' ? '👵' : '👤'}}</text>
        <view class="role-info">
          <text class="role-name">{{member.roleName}}</text>
          <text class="role-nickname">{{member.nickname || '未设置昵称'}}</text>
        </view>
      </view>
      <view class="role-right">
        <text class="admin-badge" wx:if="{{isAdmin}}">管理员</text>
        <text class="card-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 数据概览 -->
  <view class="section">
    <view class="section-title">📊 数据概览</view>
    <view class="stats-grid">
      <view class="stat-item">
        <view class="stat-number">{{stats.brushingStreak}}</view>
        <view class="stat-label">连续刷牙</view>
      </view>
      <view class="stat-item">
        <view class="stat-number">{{stats.cardsLearned}}</view>
        <view class="stat-label">已识字</view>
      </view>
      <view class="stat-item">
        <view class="stat-number">{{stats.poemsMemorized}}</view>
        <view class="stat-label">已背诗</view>
      </view>
      <view class="stat-item">
        <view class="stat-number">{{stats.drawingsCount}}</view>
        <view class="stat-label">画画作品</view>
      </view>
    </view>
  </view>

  <!-- 学习进度 -->
  <view class="section">
    <view class="section-title">📚 学习进度</view>
    <view class="progress-list">
      <view class="progress-item">
        <view class="progress-label">识字卡片</view>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{stats.cardsLearned / 120 * 100}}%;"></view>
        </view>
        <view class="progress-text">{{stats.cardsLearned}}/120</view>
      </view>
      <view class="progress-item">
        <view class="progress-label">古诗背诵</view>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{stats.poemsMemorized / 25 * 100}}%;"></view>
        </view>
        <view class="progress-text">{{stats.poemsMemorized}}/25</view>
      </view>
      <view class="progress-item">
        <view class="progress-label">数字启蒙</view>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{stats.numbersLearned / 100 * 100}}%;"></view>
        </view>
        <view class="progress-text">{{stats.numbersLearned}}/100</view>
      </view>
      <view class="progress-item">
        <view class="progress-label">英语学习</view>
        <view class="progress-bar">
          <view class="progress-fill" style="width: {{stats.englishLearned / 56 * 100}}%;"></view>
        </view>
        <view class="progress-text">{{stats.englishLearned}}/56</view>
      </view>
    </view>
  </view>

  <!-- 成就系统 -->
  <view class="section" bindtap="viewAchievements">
    <view class="section-title">🏆 成就系统</view>
    <view class="achievement-summary">
      <view class="achievement-progress">
        <view class="achievement-number">{{achievementStats.unlocked}}</view>
        <view class="achievement-total">/{{achievementStats.total}}</view>
      </view>
      <view class="achievement-bar">
        <view class="achievement-fill" style="width: {{achievementStats.percentage}}%;"></view>
      </view>
      <view class="achievement-text">已解锁 {{achievementStats.percentage}}%</view>
    </view>
  </view>

  <!-- 最近笔记 -->
  <view class="section">
    <view class="section-title">📝 最近笔记</view>
    <view class="note-list" wx:if="{{recentNotes.length > 0}}">
      <view
        wx:for="{{recentNotes}}"
        wx:key="id"
        class="note-item"
        bindtap="viewNote"
        data-id="{{item.id}}"
      >
        <view class="note-icon">{{item.type === 'diary' ? '📖' : item.type === 'funny' ? '😄' : '📚'}}</view>
        <view class="note-info">
          <view class="note-title">{{item.title}}</view>
          <view class="note-date">{{item.createTime}}</view>
        </view>
        <view class="note-arrow">›</view>
      </view>
    </view>
    <view wx:else class="empty-text">暂无笔记</view>
  </view>

  <!-- 数据备份与恢复 -->
  <view class="section">
    <view class="section-title">💾 数据备份与恢复</view>
    <view class="backup-desc">备份所有数据（包括图片、记录、画作等），可随时恢复</view>

    <!-- 导出备份 -->
    <view class="backup-btn" bindtap="exportData">
      <view class="backup-btn-icon">📤</view>
      <view class="backup-btn-info">
        <view class="backup-btn-title">导出备份</view>
        <view class="backup-btn-desc">将所有数据导出为备份文件</view>
      </view>
      <view class="backup-btn-arrow">›</view>
    </view>

    <!-- 导入恢复 -->
    <view class="backup-btn" bindtap="importData">
      <view class="backup-btn-icon">📥</view>
      <view class="backup-btn-info">
        <view class="backup-btn-title">导入恢复</view>
        <view class="backup-btn-desc">从备份文件恢复数据</view>
      </view>
      <view class="backup-btn-arrow">›</view>
    </view>

    <!-- 备份状态 -->
    <view wx:if="{{backupStatus}}" class="backup-status {{backupStatusType}}">
      <text>{{backupStatus}}</text>
    </view>
  </view>
</view>
