<!-- 刷牙计时页 - 战斗场景 -->
<view class="timer-container" style="background: {{themeBg}};">
  <!-- 背景装饰 - 闪烁星星 -->
  <view class="bg-stars">
    <view class="star star-1">⭐</view>
    <view class="star star-2">✨</view>
    <view class="star star-3">💫</view>
    <view class="star star-4">⭐</view>
    <view class="star star-5">✨</view>
    <view class="star star-6">💫</view>
    <view class="star star-7">⭐</view>
    <view class="star star-8">✨</view>
  </view>
  <!-- 背景装饰 - 飘动云朵 -->
  <view class="bg-clouds">
    <view class="cloud cloud-1">☁️</view>
    <view class="cloud cloud-2">☁️</view>
    <view class="cloud cloud-3">☁️</view>
  </view>

  <!-- ===== 主线故事组件 ===== -->
  <story-dialog
    show="{{showStoryDialog}}"
    dialogues="{{storyDialogues}}"
    chapter="{{currentChapter}}"
    type="start"
    bind:complete="onStoryDialogComplete"
  />

  <story-dialog
    show="{{showVictoryDialog}}"
    dialogues="{{victoryDialogues}}"
    chapter="{{currentChapter}}"
    type="victory"
    bind:complete="onVictoryDialogComplete"
  />

  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 顶部极简工具栏（融入场景） -->
  <view class="top-bar" style="padding-right: {{capsuleRight}}px;">
    <view class="back-btn" bindtap="goBack">
      <text>←</text>
    </view>
    <view class="top-right">
      <view class="points-badge" wx:if="{{brushPoints > 0 || lastBrushPoints > 0}}">
        <text>⭐ {{brushPoints > 0 ? brushPoints : lastBrushPoints}}</text>
      </view>
      <view class="sound-btn" bindtap="toggleSound">
        <text>{{soundEnabled ? '🔊' : '🔇'}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 战斗场景（一体化布局） ===== -->
  <view class="battle-scene">
    <!-- 顶部信息栏 -->
    <view class="battle-top-bar">
      <view class="chapter-tag" wx:if="{{currentChapter}}">
        <text>{{currentChapter.emoji}} 第{{round}}轮 · {{currentChapter.name}}</text>
      </view>
      <view class="timer-bar {{isRunning ? 'timer-active' : ''}}">
        <text class="timer-num">{{minutes}}:{{seconds}}</text>
        <view class="timer-progress">
          <view class="timer-fill" style="width: {{overallProgress}}%;"></view>
        </view>
      </view>
    </view>

    <!-- 战斗主区域 -->
    <view class="battle-arena">
      <!-- 战斗中 -->
      <view wx:if="{{currentEnemy && !isCompleted}}" class="battle-fight">
        <!-- 地面/背景 -->
        <view class="battle-ground"></view>

        <!-- 小怪物 -->
        <view wx:if="{{showMinions}}" class="minions-area">
          <view wx:for="{{minions}}" wx:key="id"
                class="minion {{item.defeating ? 'minion-defeating' : ''}} {{item.defeated ? 'minion-defeated' : ''}}"
                style="left: {{item.x}}%; top: {{item.y}}%;">
            <text class="minion-emoji">{{item.emoji}}</text>
            <view wx:if="{{item.defeating}}" class="minion-hit">💥</view>
          </view>
          <!-- 小怪物进度 -->
          <view class="minions-progress">
            <text class="minions-count">小怪物：{{defeatedMinions}}/{{totalMinions}}</text>
          </view>
        </view>

        <!-- 敌人（中央） -->
        <view class="enemy-hero {{enemyShaking && !isCriticalHit ? 'shake' : ''}} {{isEnemyDefeated ? 'defeated' : ''}} {{enemyAngry ? 'angry' : ''}}">
          <text class="enemy-emoji {{!isCriticalHit ? 'enemy-idle' : ''}} {{enemyShaking && !isCriticalHit ? 'shake' : ''}} {{enemyHitReact && !isCriticalHit ? 'hit-react' : ''}} {{isEnemyDefeated ? 'defeated' : ''}} {{isCriticalHit ? critEnemyAnim : ''}}"
                style="--enemy-scale: {{enemyScale}};">{{currentEnemy.emoji}}</text>
          <!-- 击败烟花粒子 -->
          <view wx:if="{{fireworkParticles.length > 0}}" class="firework-container">
            <view wx:for="{{fireworkParticles}}" wx:key="id"
                  class="firework-particle"
                  style="--fw-angle: {{item.angle}}deg; --fw-distance: {{item.distance}}rpx; --fw-delay: {{item.delay}}s; --fw-size: {{item.size}}rpx; color: {{item.color}};">
              {{item.emoji}}
            </view>
          </view>
          <!-- 暴击名字 -->
          <text wx:if="{{isCriticalHit && critName}}" class="crit-name-text">{{critName}}</text>
          <!-- HP条 -->
          <view class="enemy-hp">
            <view class="hp-bar">
              <view class="hp-fill" style="width: {{(enemyCurrentHp / currentEnemy.hp) * 100}}%;"></view>
            </view>
            <text class="hp-num">HP {{enemyCurrentHp > 0 ? enemyCurrentHp : 0}}/{{currentEnemy.hp}}</text>
          </view>
          <!-- 敌人名称 -->
          <text class="enemy-name">{{currentEnemy.name}}</text>
          <!-- 愤怒标记 -->
          <view wx:if="{{enemyAngry}}" class="angry-mark">😤</view>
          <!-- 小怪物消灭提示 -->
          <view wx:if="{{minionDefeatEffect && minionDefeatEffect.show}}" class="minion-defeat-text">
            <text>{{minionDefeatEffect.text}}</text>
          </view>

          <!-- 敌人被击败视觉冲击特效 -->
          <!-- 全屏闪光 -->
          <view wx:if="{{showDefeatFlash}}" class="defeat-flash-overlay"></view>
          <!-- 冲击波 -->
          <view wx:if="{{showShockwave}}" class="defeat-shockwave"></view>
          <!-- 碎片飞溅 -->
          <view wx:if="{{enemyDebris.length > 0}}" class="enemy-debris-container">
            <view wx:for="{{enemyDebris}}" wx:key="id"
                  class="enemy-debris"
                  style="--deb-x: {{item.x}}rpx; --deb-y: {{item.y}}rpx; --deb-delay: {{item.delay}}s; --deb-size: {{item.size}}rpx; color: {{item.color}};">
              {{item.emoji}}
            </view>
          </view>
        </view>

        <!-- KO大字（独立于enemy-hero，确保居中且不被隐藏） -->
        <view wx:if="{{showKoText}}" class="ko-text-container">
          <text class="ko-text">KO！</text>
          <text class="ko-sub">{{currentEnemy.name}} 被击败</text>
        </view>

        <!-- 牙刷（根据区域动态变化位置和方向） -->
        <view class="toothbrush-hero {{isRunning ? 'attacking' : ''}} {{isDashing ? 'dashing' : ''}}"
              style="left: {{toothbrushX}}%; top: {{toothbrushY}}%; --rotation: {{toothbrushRotation}}deg;">
          <view class="toothbrush-wrapper" style="transform: translate(-50%, -50%) rotate({{toothbrushRotation}}deg);">
            <text class="toothbrush-emoji {{isCriticalHit ? 'critical-flash' : ''}}">🪥</text>
            <!-- 牙刷残影（暴击时显示） -->
            <view wx:if="{{isCriticalHit}}" class="toothbrush-afterimage"></view>
          </view>
          <view class="attack-lines" wx:if="{{isRunning}}">
            <view class="line line-1"></view>
            <view class="line line-2"></view>
            <view class="line line-3"></view>
          </view>
          <!-- 攻击轨迹 -->
          <view wx:if="{{showTrail}}" class="attack-trail" style="--trail-angle: {{trailAngle}}deg;">
            <view class="trail-line trail-1"></view>
            <view class="trail-line trail-2"></view>
            <view class="trail-line trail-3"></view>
          </view>
        </view>

        <!-- 攻击特效 -->
        <view wx:if="{{showAttackEffect}}" class="hit-effect {{isCritical ? 'critical' : ''}}" style="left: {{attackEffectX}}%; top: {{attackEffectY}}%;">
          <text class="hit-text">-{{attackDamage}}</text>
          <text wx:if="{{isCritical}}" class="crit-text">暴击！</text>
          <text class="hit-icon">{{isCritical ? '⚡' : '💥'}}</text>
          <!-- 命中爆炸粒子 -->
          <view class="explosion-particles">
            <view wx:for="{{explosionParticles}}" wx:key="id" class="particle {{item.type}}" style="--angle: {{item.angle}}deg; --delay: {{item.delay}}s;">{{item.emoji}}</view>
          </view>
        </view>

        <!-- 暴击专属特效（20种随机模式） -->
        <view wx:if="{{showCriticalEffect && critAnim}}" class="critical-effect">
          <text class="critical-emoji" style="color: {{critAnim.color}};">{{critAnim.emoji}}</text>
          <text class="critical-text" style="color: {{critAnim.color}};">{{critAnim.name}}！</text>
          <view class="critical-flash-overlay" style="background: {{critAnim.color}};"></view>
        </view>

        <!-- 连击计数器 -->
        <view wx:if="{{showCombo}}" class="combo-counter">
          <text class="combo-text">{{comboText}}</text>
        </view>

        <!-- 战斗提示 -->
        <view class="fight-hint" wx:if="{{!isRunning && !isPaused}}">
          <text>⚔️ 点击下方开始战斗</text>
        </view>
        <view class="fight-hint" wx:if="{{isRunning && showMinions && defeatedMinions < totalMinions}}">
          <text>🎯 先消灭{{totalMinions - defeatedMinions}}个小怪物！</text>
        </view>
        <view class="fight-hint" wx:if="{{isRunning && (!showMinions || defeatedMinions >= totalMinions)}}">
          <text>🪥 攻击{{currentEnemy.name}}！</text>
        </view>
        <view class="fight-hint" wx:if="{{isPaused}}">
          <text>⏸ 战斗暂停</text>
        </view>

        <!-- 积分飘字 -->
        <view wx:if="{{showPoints}}" class="points-float">
          <text>{{pointsText}}</text>
        </view>
      </view>

      <!-- 胜利状态 -->
      <view wx:if="{{isCompleted}}" class="battle-victory">
        <!-- 撒花 -->
        <view class="confetti-layer">
          <view wx:for="{{confetti}}" wx:key="id" wx:if="{{item.type === 'paper'}}"
                class="confetti-paper"
                style="left:{{item.x}}%;animation-delay:{{item.delay}}s;background:{{item.color}};width:{{item.w}}rpx;height:{{item.h}}rpx;">
          </view>
          <view wx:for="{{confetti}}" wx:key="id" wx:if="{{item.type === 'emoji'}}"
                class="confetti-emoji"
                style="left:{{item.x}}%;animation-delay:{{item.delay}}s;font-size:{{item.size}}rpx;">
            {{item.emoji}}
          </view>
        </view>

        <!-- 胜利主体 -->
        <view class="victory-main">
          <!-- 被击败的敌人 -->
          <view class="defeated-enemy">
            <text class="defeated-emoji">{{currentEnemy.emoji}}</text>
            <view class="defeated-mark">已击败</view>
          </view>

          <!-- 胜利信息 -->
          <view class="victory-info">
            <text class="victory-title">🎉 战斗胜利！</text>
            <text class="victory-desc">{{completedText}}</text>
            <view class="victory-stars">
              <text wx:for="{{completedStarsArr}}" wx:key="index" class="star"
                    style="animation-delay:{{index * 0.15}}s">⭐</text>
            </view>
            <view class="victory-points" wx:if="{{brushPoints > 0}}">
              <text>🏆 +{{brushPoints}} 积分</text>
            </view>
          </view>
        </view>

        <!-- 贴纸选择（胜利后显示） -->
        <view wx:if="{{showStickerPicker}}" class="sticker-picker-inline">
          <text class="sticker-hint">给牙齿贴个贴纸吧~</text>
          <view class="sticker-list">
            <view wx:for="{{stickers}}" wx:key="id" class="sticker-item" bindtap="onTapSticker" data-id="{{item.id}}">
              <text>{{item.emoji}}</text>
            </view>
          </view>
        </view>

        <!-- 6区牙齿（胜利后显示，用于贴贴纸） -->
        <view wx:if="{{toothZones.length > 0}}" class="tooth-strip-inline">
          <view wx:for="{{toothZones}}" wx:key="index"
                class="tooth-zone zone-{{item.state}} {{item.state === 'current' ? 'zone-pulse' : ''}}"
                style="border-color: {{item.color}};">
            <view class="zone-tooth-body">
              <text class="zone-tooth-emoji">{{item.state === 'clean' ? '✨' : '🦷'}}</text>
            </view>
            <view class="zone-stickers" wx:if="{{placedStickers.length > 0 && item.state === 'clean'}}">
              <view wx:for="{{placedStickers}}" wx:key="id" wx:for-item="sticker"
                    wx:if="{{sticker.zoneIndex === index}}"
                    class="zone-sticker-wrap"
                    style="left: {{sticker.x}}%; top: {{sticker.y}}%;">
                <text class="zone-sticker">{{sticker.emoji}}</text>
                <view class="sticker-delete-btn" catchtap="onDeleteSticker" data-id="{{sticker.id}}">✕</view>
              </view>
            </view>
            <view class="zone-shine" wx:if="{{item.state === 'clean'}}">✨</view>
            <view class="zone-crown" wx:if="{{item.state === 'clean'}}">👑</view>
            <view class="zone-label">{{item.name}}</view>
            <view class="zone-check" wx:if="{{item.state === 'clean'}}">✓</view>
          </view>
        </view>

        <!-- 完成按钮 -->
        <view class="done-btn" bindtap="onDoneBrushing">
          <text>✓ 完成</text>
        </view>
      </view>
    </view>

    <!-- ===== 6区牙齿（刷牙时显示） ===== -->
    <view wx:if="{{toothZones.length > 0 && !isCompleted}}" class="tooth-strip">
      <view wx:for="{{toothZones}}" wx:key="index"
            class="tooth-zone zone-{{item.state}} {{item.state === 'current' ? 'zone-pulse' : ''}}"
            style="border-color: {{item.color}};">
        <view class="zone-tooth-body">
          <text class="zone-tooth-emoji">{{item.state === 'clean' ? '✨' : '🦷'}}</text>
        </view>
        <view class="zone-germs" wx:if="{{item.germs.length > 0 && item.state !== 'clean'}}">
          <text wx:for="{{item.germs}}" wx:key="id"
                class="zone-germ {{item.fleeing ? 'germ-flee' : 'germ-wiggle'}}"
                style="left: {{item.x}}%; top: {{item.y}}%;">{{item.emoji}}</text>
        </view>
        <view class="zone-shine" wx:if="{{item.state === 'clean'}}">✨</view>
        <view class="zone-crown" wx:if="{{item.state === 'clean'}}">👑</view>
        <view class="zone-label">{{item.name}}</view>
        <view class="zone-timer" wx:if="{{currentAreaIndex === index && isRunning}}">
          <text class="zone-timer-num">{{areaRemaining}}</text>
        </view>
        <view class="zone-check" wx:if="{{item.state === 'clean'}}">✓</view>
      </view>
    </view>

    <!-- ===== 奖励星星 ===== -->
    <view class="reward-section" wx:if="{{isRunning || isPaused || isCompleted}}">
      <view class="star-row">
        <view wx:for="{{rewardStars}}" wx:key="index" class="star-item {{item ? 'earned' : ''}}">
          <text class="star-emoji">{{item ? '⭐' : '☆'}}</text>
        </view>
      </view>
      <text class="reward-text">{{currentRewardText}}</text>
    </view>

  </view>

  <!-- ===== 时长选择 ===== -->
  <view wx:if="{{!isRunning && !isPaused && !isCompleted}}" class="duration-picker">
    <text class="duration-title">⏱ 刷牙时长</text>
    <view class="duration-options">
      <view class="duration-opt {{selectedDuration === 60 ? 'active' : ''}}" bindtap="selectDuration" data-sec="60">
        <text class="duration-num">1</text><text class="duration-unit">分钟</text>
      </view>
      <view class="duration-opt {{selectedDuration === 120 ? 'active' : ''}}" bindtap="selectDuration" data-sec="120">
        <text class="duration-num">2</text><text class="duration-unit">分钟</text>
      </view>
      <view class="duration-opt {{selectedDuration === 180 ? 'active' : ''}}" bindtap="selectDuration" data-sec="180">
        <text class="duration-num">3</text><text class="duration-unit">分钟</text>
      </view>
    </view>
  </view>

  <!-- ===== 按钮 ===== -->
  <view class="btn-area">
    <!-- 开始前 -->
    <view wx:if="{{!isRunning && !isPaused && !isCompleted}}" class="btn-start" bindtap="startTimer">
      <view class="btn-sparkle"></view>
      <text class="btn-icon">⚔️</text>
      <text class="btn-label">开始战斗！</text>
    </view>
    <!-- 战斗中 -->
    <view wx:if="{{isRunning}}" class="btn-pause" bindtap="pauseTimer">
      <text class="btn-icon">⏸</text>
      <text class="btn-label">暂停战斗</text>
    </view>
    <view wx:if="{{isRunning}}" class="btn-finish-early" bindtap="finishEarly">
      <text>✅ 提前结束战斗</text>
    </view>
    <!-- 暂停中 -->
    <view wx:if="{{isPaused && !isCompleted}}" class="btn-start" bindtap="resumeTimer">
      <view class="btn-sparkle"></view>
      <text class="btn-icon">▶</text>
      <text class="btn-label">继续战斗！</text>
    </view>
    <view wx:if="{{!isRunning && !isCompleted}}" class="btn-retry" bindtap="resetTimer">
      <text>↻ 重新开始</text>
    </view>
    <!-- 胜利后 -->
    <view wx:if="{{isCompleted}}" class="victory-actions">
      <view class="victory-btn primary" bindtap="goCheckIn">
        <text class="victory-btn-icon">📷</text>
        <text class="victory-btn-text">拍照打卡</text>
      </view>
      <view class="victory-btn outline" bindtap="goBrushingPage">
        <text class="victory-btn-text">查看统计 →</text>
      </view>
    </view>
  </view>

  <view class="safe-bottom"></view>

  <!-- 成就解锁弹窗 -->
  <achievement-popup id="achievementPopup" />
</view>
