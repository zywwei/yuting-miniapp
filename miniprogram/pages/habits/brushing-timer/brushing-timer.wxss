/* 刷牙计时页 - 战斗场景（一体化布局） */
.timer-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFE4EC 0%, #FFF0F5 30%, #FFF5F8 60%, #FFEEF2 100%);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* ===== 背景装饰 ===== */
.bg-stars {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
}

.star {
  position: absolute;
  animation: twinkle 2s ease-in-out infinite;
  opacity: 0.5;
  color: #FFB6C1;
}

.star-1 { top: 10%; left: 5%; font-size: 24rpx; animation-delay: 0s; }
.star-2 { top: 15%; right: 10%; font-size: 20rpx; animation-delay: 0.5s; }
.star-3 { top: 25%; left: 15%; font-size: 16rpx; animation-delay: 1s; }
.star-4 { top: 35%; right: 20%; font-size: 28rpx; animation-delay: 1.5s; }
.star-5 { top: 50%; left: 8%; font-size: 18rpx; animation-delay: 0.3s; }
.star-6 { top: 60%; right: 5%; font-size: 22rpx; animation-delay: 0.8s; }
.star-7 { top: 75%; left: 20%; font-size: 14rpx; animation-delay: 1.2s; }
.star-8 { top: 85%; right: 15%; font-size: 26rpx; animation-delay: 0.6s; }

@keyframes twinkle {
  0%, 100% { opacity: 0.2; transform: scale(0.8); }
  50% { opacity: 0.8; transform: scale(1.2); }
}

.bg-clouds {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
}

.cloud {
  position: absolute;
  font-size: 80rpx;
  opacity: 0.15;
  animation: float 25s linear infinite;
  filter: blur(2px);
}

.cloud-1 { top: 8%; left: -15%; animation-duration: 30s; }
.cloud-2 { top: 22%; left: -20%; animation-duration: 35s; animation-delay: 8s; }
.cloud-3 { top: 38%; left: -15%; animation-duration: 28s; animation-delay: 15s; }

@keyframes float {
  0% { transform: translateX(0); }
  100% { transform: translateX(130vw); }
}

/* ===== 顶部极简工具栏 ===== */
.status-bar { width: 100%; background: transparent; }
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 20rpx;
  position: relative;
  z-index: 10;
}
.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.6);
  border-radius: 50%;
  font-size: 28rpx;
  color: #E91E63;
}
.back-btn:active { background: rgba(255,255,255,0.8); }
.top-right { display: flex; align-items: center; gap: 15rpx; }
.sound-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.6);
  border-radius: 50%;
  font-size: 24rpx;
}
.points-badge {
  background: linear-gradient(135deg, #FFD700, #FFA000);
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(255, 160, 0, 0.4);
  animation: badgePulse 2s ease-in-out infinite;
}

@keyframes badgePulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

/* ===== 战斗场景 ===== */
.battle-scene {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
  height: calc(100vh - 200rpx); /* 减去按钮区域高度 */
}

/* 顶部信息栏 */
.battle-top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15rpx 25rpx;
  background: rgba(255,255,255,0.6);
  backdrop-filter: blur(10px);
  flex-shrink: 0;
}

.chapter-tag {
  font-size: 24rpx;
  color: #E91E63;
  font-weight: bold;
}

.timer-bar {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.timer-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #E91E63;
  font-family: 'Courier New', monospace;
  min-width: 100rpx;
  text-align: center;
}

.timer-active .timer-num {
  animation: timerPulse 1s ease-in-out infinite;
}

@keyframes timerPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.timer-progress {
  width: 150rpx;
  height: 12rpx;
  background: #FFD6E0;
  border-radius: 6rpx;
  overflow: hidden;
}

.timer-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF9AAB, #FF6B8A);
  border-radius: 6rpx;
  transition: width 0.5s;
}

/* 战斗竞技场 */
.battle-arena {
  flex: 1;
  position: relative;
  overflow: hidden;
}

/* 战斗中 */
.battle-fight {
  width: 100%;
  height: 100%;
  position: relative;
  padding: 20rpx;
}

/* 地面 */
.battle-ground {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 25%;
  background: linear-gradient(180deg, transparent, rgba(255,182,193,0.15));
}

/* 牙刷英雄 */
.toothbrush-hero {
  position: absolute;
  z-index: 10;
  transition: left 0.5s ease, top 0.5s ease, transform 0.5s ease;
}

.toothbrush-emoji {
  font-size: 120rpx;
  display: block;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.2));
}

.attacking .toothbrush-emoji {
  animation: brushAttack 0.4s ease-in-out infinite;
}

@keyframes brushAttack {
  0% { transform: scale(1); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

/* 攻击线条 */
.attack-lines {
  position: absolute;
  top: 50%;
  right: -80rpx;
  transform: translateY(-50%);
}

.line {
  width: 80rpx;
  height: 5rpx;
  background: linear-gradient(90deg, #FF6B8A, transparent);
  margin: 12rpx 0;
  animation: lineDash 0.5s ease-out infinite;
}

.line-1 { animation-delay: 0s; }
.line-2 { animation-delay: 0.1s; width: 55rpx; }
.line-3 { animation-delay: 0.2s; width: 30rpx; }

@keyframes lineDash {
  0% { opacity: 0; transform: translateX(-30rpx); }
  50% { opacity: 1; }
  100% { opacity: 0; transform: translateX(30rpx); }
}

/* 敌人英雄 */
.enemy-hero {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 5;
  text-align: center;
  filter: drop-shadow(0 10rpx 20rpx rgba(0,0,0,0.15));
}

.enemy-emoji {
  font-size: 240rpx;
  display: block;
  animation: enemyIdle 2s ease-in-out infinite;
}

@keyframes enemyIdle {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-20rpx) scale(1.1); }
}

.shake {
  animation: shake 0.3s ease-in-out !important;
}

@keyframes shake {
  0%, 100% { transform: translate(-50%, -50%); }
  25% { transform: translate(calc(-50% - 30rpx), -50%); }
  75% { transform: translate(calc(-50% + 30rpx), -50%); }
}

.defeated {
  animation: defeated 0.5s ease-out forwards !important;
}

@keyframes defeated {
  0% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.3); }
  100% { transform: scale(0.8) rotate(20deg); opacity: 0.5; }
}

/* 敌人HP */
.enemy-hp {
  margin-top: 24rpx;
  padding: 0 24rpx;
}

.hp-bar {
  width: 100%;
  max-width: 280rpx;
  height: 28rpx;
  background: #FFD6E0;
  border-radius: 14rpx;
  overflow: hidden;
  margin: 0 auto;
  border: none;
}

.hp-fill {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50, #8BC34A);
  border-radius: 14rpx;
  transition: width 0.5s, background 0.3s;
  border: none;
}

.hp-num {
  font-size: 28rpx;
  color: #E91E63;
  margin-top: 12rpx;
  display: block;
  font-weight: bold;
}

.enemy-name {
  font-size: 32rpx;
  color: #666;
  margin-top: 16rpx;
  display: block;
  font-weight: bold;
}

/* 敌人愤怒状态 */
.enemy-hero.angry .enemy-emoji {
  animation: enemyAngry 0.5s ease-in-out infinite;
  filter: hue-rotate(30deg) brightness(1.1);
}

@keyframes enemyAngry {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.angry-mark {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  font-size: 28rpx;
  animation: angryBounce 0.5s ease-in-out infinite;
}

@keyframes angryBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

/* 命中效果 */
.hit-effect {
  position: absolute;
  transform: translate(-50%, -50%);
  z-index: 10;
  text-align: center;
  animation: hitBurst 0.6s ease-out forwards;
}

@keyframes hitBurst {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(0.5); }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.5); }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(1.8) translateY(-50rpx); }
}

.hit-text {
  font-size: 60rpx;
  font-weight: bold;
  color: #F44336;
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.3);
  display: block;
}

.hit-icon {
  font-size: 50rpx;
  display: block;
}

/* 暴击特效 */
.hit-effect.critical {
  animation: critBurst 0.8s ease-out forwards;
}

@keyframes critBurst {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(0.3); }
  30% { opacity: 1; transform: translate(-50%, -50%) scale(1.8); }
  60% { opacity: 1; transform: translate(-50%, -50%) scale(1.2); }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(1.5) translateY(-60rpx); }
}

.crit-text {
  font-size: 32rpx;
  color: #FFD700;
  font-weight: bold;
  display: block;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
  animation: critFlash 0.3s ease-out;
}

@keyframes critFlash {
  0% { opacity: 0; transform: scale(0.5); }
  50% { opacity: 1; transform: scale(1.3); }
  100% { opacity: 1; transform: scale(1); }
}

/* 连击计数器 */
.combo-counter {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
  animation: comboAppear 0.3s ease-out;
}

@keyframes comboAppear {
  0% { opacity: 0; transform: translateX(-50%) scale(0.5); }
  100% { opacity: 1; transform: translateX(-50%) scale(1); }
}

.combo-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF4081;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
  background: rgba(255,255,255,0.9);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  border: 3rpx solid #FF4081;
}

/* ===== 小怪物系统 ===== */
.minions-area {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 8;
}

.minion {
  position: absolute;
  font-size: 50rpx;
  animation: minionFloat 2s ease-in-out infinite;
  transition: all 0.3s;
}

@keyframes minionFloat {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-10rpx) scale(1.1); }
}

.minion-defeating {
  animation: minionDefeat 0.5s ease-out forwards !important;
}

@keyframes minionDefeat {
  0% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.5); opacity: 0.8; }
  100% { transform: scale(0) rotate(360deg); opacity: 0; }
}

.minion-defeated {
  opacity: 0;
  transform: scale(0);
  pointer-events: none;
}

.minion-hit {
  position: absolute;
  top: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 30rpx;
  animation: minionHitBurst 0.5s ease-out forwards;
}

@keyframes minionHitBurst {
  0% { opacity: 1; transform: translateX(-50%) scale(0.5); }
  50% { opacity: 1; transform: translateX(-50%) scale(1.5); }
  100% { opacity: 0; transform: translateX(-50%) scale(2) translateY(-30rpx); }
}

.minions-progress {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  background: rgba(0,0,0,0.6);
  color: white;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
}

.minions-count {
  font-weight: bold;
}

/* 小怪物消灭提示 */
.minion-defeat-text {
  position: absolute;
  bottom: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(76, 175, 80, 0.9);
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: bold;
  white-space: nowrap;
  animation: minionDefeatTextAppear 0.3s ease-out;
}

@keyframes minionDefeatTextAppear {
  from { opacity: 0; transform: translateX(-50%) translateY(10rpx); }
  to { opacity: 1; transform: translateX(-50%) translateY(0); }
}

/* 战斗提示 */
.fight-hint {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 26rpx;
  color: #E91E63;
  background: rgba(255,255,255,0.8);
  padding: 10rpx 25rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  z-index: 15;
}

/* 积分飘字 */
.points-float {
  position: absolute;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 15;
  animation: floatUp 1.5s ease-out forwards;
}

@keyframes floatUp {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(0.8); }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.2); }
  100% { opacity: 0; transform: translate(-50%, -150%) scale(1); }
}

.points-float text {
  font-size: 48rpx;
  font-weight: bold;
  color: #FFD700;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
  background: rgba(255,255,255,0.9);
  padding: 15rpx 25rpx;
  border-radius: 20rpx;
}

/* ===== 胜利状态 ===== */
.battle-victory {
  width: 100%;
  height: 100%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 撒花 */
.confetti-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
}

.confetti-paper {
  position: absolute;
  top: -20rpx;
  animation: confettiFall 3s ease-out forwards;
}

@keyframes confettiFall {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  100% { transform: translateY(600rpx) rotate(720deg); opacity: 0; }
}

.confetti-emoji {
  position: absolute;
  top: -40rpx;
  animation: emojiFall 3s ease-out forwards;
}

@keyframes emojiFall {
  0% { transform: translateY(0) scale(1); opacity: 1; }
  100% { transform: translateY(600rpx) scale(0.5); opacity: 0; }
}

/* 胜利主体 */
.victory-main {
  text-align: center;
  z-index: 10;
  animation: victoryPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes victoryPop {
  0% { transform: scale(0); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

/* 被击败的敌人 */
.defeated-enemy {
  position: relative;
  display: inline-block;
  margin-bottom: 20rpx;
}

.defeated-emoji {
  font-size: 140rpx;
  display: block;
  filter: grayscale(0.5);
  opacity: 0.7;
}

.defeated-mark {
  position: absolute;
  top: -10rpx;
  right: -20rpx;
  background: #4CAF50;
  color: white;
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  font-weight: bold;
}

/* 胜利信息 */
.victory-info {
  margin-bottom: 20rpx;
}

.victory-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #E91E63;
  display: block;
  margin-bottom: 10rpx;
}

.victory-desc {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 15rpx;
}

.victory-stars {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 15rpx;
}

.victory-stars .star {
  font-size: 36rpx;
  animation: starPop 0.3s ease-out both;
}

@keyframes starPop {
  from { transform: scale(0); }
  to { transform: scale(1); }
}

.victory-points {
  background: linear-gradient(135deg, #FFD700, #FFA000);
  color: white;
  padding: 10rpx 20rpx;
  border-radius: 15rpx;
  font-size: 26rpx;
  font-weight: bold;
  display: inline-block;
}

/* 贴纸选择 */
.sticker-picker {
  margin-top: 20rpx;
}

.sticker-hint {
  font-size: 24rpx;
  color: #E91E63;
  display: block;
  margin-bottom: 12rpx;
}

.sticker-list {
  display: flex;
  justify-content: center;
  gap: 15rpx;
}

.sticker-item {
  width: 55rpx;
  height: 55rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.9);
  border-radius: 12rpx;
  border: 2rpx solid #FFB6C1;
  font-size: 28rpx;
  transition: transform 0.2s;
}

.sticker-item:active {
  transform: scale(0.9);
}

/* ===== 刷牙前小游戏 ===== */
.pre-game {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10;
}

.pre-germ {
  position: absolute;
  animation: germWiggle 0.5s ease-in-out infinite;
  cursor: pointer;
}

@keyframes germWiggle {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-10deg); }
  75% { transform: rotate(10deg); }
}

.pre-germ-flee {
  animation: germFlee 0.5s ease-out forwards !important;
}

@keyframes germFlee {
  0% { opacity: 1; transform: scale(1); }
  100% { opacity: 0; transform: scale(0) translateY(-50rpx); }
}

.pre-germ-emoji {
  font-size: 40rpx;
}

.pre-hint {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 28rpx;
  color: #4CAF50;
  background: rgba(255,255,255,0.9);
  padding: 15rpx 25rpx;
  border-radius: 20rpx;
  font-weight: bold;
}

/* 6区牙齿（2行3列，占满宽度） */
.tooth-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(2, 1fr);
  gap: 10rpx;
  padding: 16rpx;
  margin: 0 24rpx 16rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 32rpx;
  backdrop-filter: blur(12px);
  box-shadow: 0 4rpx 16rpx rgba(255, 154, 171, 0.2);
  flex-shrink: 0;
}

.tooth-zone {
  position: relative;
  height: 120rpx;
  background: linear-gradient(180deg, #FFFDE7 0%, #FFF9C4 100%);
  border: 3rpx solid;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 当前正在刷的区域：脉冲发光 */
.tooth-zone.zone-current {
  background: linear-gradient(180deg, #FFF0F5 0%, #FFE4EC 100%);
  transform: scale(1.08);
  z-index: 2;
}

.zone-pulse {
  animation: zonePulse 1s ease-in-out infinite;
}

@keyframes zonePulse {
  0%, 100% { box-shadow: 0 0 16rpx rgba(255, 154, 171, 0.45); }
  50% { box-shadow: 0 0 36rpx rgba(255, 154, 171, 0.75); }
}

/* 已刷干净的区域：雪白闪亮 */
.tooth-zone.zone-clean {
  background: linear-gradient(180deg, #FFFFFF 0%, #E8F5E9 100%);
  border-color: #81C784 !important;
  transform: scale(1);
}

.zone-tooth-body {
  position: relative;
  z-index: 1;
}

.zone-tooth-emoji {
  font-size: 40rpx;
  display: block;
  transition: transform 0.4s;
}

.tooth-zone.zone-clean .zone-tooth-emoji {
  animation: cleanToothPop 0.6s ease-out;
}

@keyframes cleanToothPop {
  0% { transform: scale(0.5) rotate(-10deg); }
  60% { transform: scale(1.3) rotate(5deg); }
  100% { transform: scale(1) rotate(0deg); }
}

/* 细菌层 */
.zone-germs {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 2;
  pointer-events: none;
}

.zone-germ {
  position: absolute;
  font-size: 22rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0,0,0,0.15));
}

.germ-wiggle {
  animation: germWiggle 1.2s ease-in-out infinite;
}

@keyframes germWiggle {
  0%, 100% { transform: rotate(-12deg) scale(1); }
  50% { transform: rotate(12deg) scale(1.15); }
}

.germ-flee {
  animation: germFlee 0.7s ease-out forwards;
}

@keyframes germFlee {
  0% { transform: translate(0, 0) scale(1); opacity: 1; }
  40% { transform: translate(0, -30rpx) scale(1.1); opacity: 1; }
  100% { transform: translate(0, -120rpx) scale(0.3); opacity: 0; }
}

/* 闪亮特效 */
.zone-shine {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 40rpx;
  z-index: 3;
  animation: shinePop 0.8s ease-out forwards;
  pointer-events: none;
}

@keyframes shinePop {
  0% { transform: translate(-50%, -50%) scale(0) rotate(-45deg); opacity: 0; }
  50% { transform: translate(-50%, -50%) scale(1.6) rotate(0deg); opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(1) rotate(0deg); opacity: 0.85; }
}

/* 小皇冠 */
.zone-crown {
  position: absolute;
  top: -4rpx;
  right: -2rpx;
  font-size: 20rpx;
  z-index: 4;
  animation: miniCrownBounce 1s ease-in-out infinite;
}

@keyframes miniCrownBounce {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-4rpx) rotate(12deg); }
}

/* 区域名称标签 */
.zone-label {
  position: absolute;
  bottom: 4rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 18rpx;
  color: #999;
  font-weight: 500;
  z-index: 3;
  pointer-events: none;
}

.tooth-zone.zone-current .zone-label {
  color: #FF6B8A;
  font-weight: bold;
}

.tooth-zone.zone-clean .zone-label {
  color: #81C784;
  font-weight: bold;
}

/* 当前区域倒计时 */
.zone-timer {
  position: absolute;
  top: 2rpx;
  right: 4rpx;
  z-index: 5;
  pointer-events: none;
}

.zone-timer-num {
  font-size: 22rpx;
  font-weight: bold;
  color: #FF6B8A;
  background: rgba(255, 255, 255, 0.85);
  padding: 2rpx 8rpx;
  border-radius: 12rpx;
  line-height: 1;
  box-shadow: 0 2rpx 6rpx rgba(255, 154, 171, 0.2);
}

/* 已完成勾号 */
.zone-check {
  position: absolute;
  top: 2rpx;
  left: 4rpx;
  font-size: 20rpx;
  color: #81C784;
  font-weight: bold;
  z-index: 5;
  pointer-events: none;
  animation: checkPop 0.3s ease-out;
}

@keyframes checkPop {
  0% { transform: scale(0); }
  60% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

/* 泡泡 */
.bubble-area {
  position: absolute;
  top: -40rpx;
  left: -60rpx;
  width: 300rpx;
  height: 300rpx;
  pointer-events: none;
  z-index: 0;
}

.bubble-item {
  position: absolute;
  animation: bubbleRise 3s ease-out infinite;
  opacity: 0;
}

@keyframes bubbleRise {
  0% { opacity: 0; transform: translateY(40rpx) scale(0.5); }
  20% { opacity: 0.9; }
  100% { opacity: 0; transform: translateY(-80rpx) scale(1.3); }
}

/* 刷牙前小游戏：瞌睡细菌 */
.pre-game-area {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 8;
  pointer-events: none;
}

.pre-germ {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: auto;
}

.pre-germ-wiggle {
  animation: preGermWiggle 2s ease-in-out infinite;
}

@keyframes preGermWiggle {
  0%, 100% { transform: translate(-50%, -50%) rotate(-8deg) scale(1); }
  50% { transform: translate(-50%, -50%) rotate(8deg) scale(1.1); }
}

.pre-germ-flee {
  animation: preGermFlee 0.7s ease-out forwards;
}

@keyframes preGermFlee {
  0% { transform: translate(-50%, -50%) scale(1) rotate(0deg); opacity: 1; }
  100% { transform: translate(-50%, -150%) scale(0.3) rotate(360deg); opacity: 0; }
}

.pre-germ-emoji {
  font-size: 64rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.2));
}

.pre-hint {
  position: absolute;
  bottom: 200rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.95);
  color: #FF6B8A;
  font-size: 28rpx;
  font-weight: bold;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 154, 171, 0.3);
  animation: preHintPop 0.5s ease-out;
  pointer-events: none;
}

@keyframes preHintPop {
  0% { transform: translateX(-50%) scale(0); }
  60% { transform: translateX(-50%) scale(1.1); }
  100% { transform: translateX(-50%) scale(1); }
}

/* 刷牙后贴纸 */
.zone-stickers {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 4;
  pointer-events: none;
}

.zone-sticker {
  position: absolute;
  font-size: 24rpx;
  animation: stickerPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  filter: drop-shadow(0 2rpx 4rpx rgba(0,0,0,0.15));
}

@keyframes stickerPop {
  0% { transform: scale(0) rotate(-45deg); }
  70% { transform: scale(1.4) rotate(10deg); }
  100% { transform: scale(1) rotate(0deg); }
}

.sticker-section {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed rgba(255, 154, 171, 0.3);
}

.sticker-title {
  display: block;
  font-size: 26rpx;
  color: #FF6B8A;
  margin-bottom: 16rpx;
  font-weight: bold;
}

.sticker-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.sticker-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(255, 154, 171, 0.25);
  transition: transform 0.15s;
}

.sticker-btn:active { transform: scale(0.9); }

.sticker-emoji { font-size: 40rpx; }

.sticker-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.btn-save-decoration {
  display: inline-block;
  background: linear-gradient(135deg, #81C784, #66BB6A);
  color: white;
  padding: 22rpx 56rpx;
  border-radius: 60rpx;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 10rpx 30rpx rgba(129, 199, 132, 0.4);
  transition: transform 0.2s;
}

.btn-save-decoration:active { transform: scale(0.95); }

/* 脏东西 */
.dirty-spot {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 8;
  animation: dirtyAppear 0.4s ease-out;
  cursor: pointer;
}

.dirty-spot:active {
  transform: translate(-50%, -50%) scale(0.8);
}

@keyframes dirtyAppear {
  0% { transform: translate(-50%, -50%) scale(0) rotate(-180deg); opacity: 0; }
  60% { transform: translate(-50%, -50%) scale(1.2) rotate(10deg); }
  100% { transform: translate(-50%, -50%) scale(1) rotate(0deg); opacity: 1; }
}

.dirty-emoji {
  font-size: 60rpx;
  animation: dirtyWobble 1.5s ease-in-out infinite;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.2));
}

@keyframes dirtyWobble {
  0%, 100% { transform: rotate(-8deg); }
  50% { transform: rotate(8deg); }
}

.dirty-points {
  font-size: 20rpx;
  color: #FFD700;
  font-weight: bold;
  background: rgba(0, 0, 0, 0.7);
  padding: 4rpx 10rpx;
  border-radius: 12rpx;
  margin-top: -6rpx;
}

/* 刷掉特效 */
.clean-effect {
  position: absolute;
  transform: translate(-50%, -50%);
  z-index: 15;
  animation: cleanPop 1.5s ease-out forwards;
  pointer-events: none;
}

.clean-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #4CAF50;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
  white-space: nowrap;
}

@keyframes cleanPop {
  0% { transform: translate(-50%, -50%) scale(0); opacity: 0; }
  30% { transform: translate(-50%, -50%) scale(1.3); opacity: 1; }
  50% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  100% { transform: translate(-50%, -150%) scale(1); opacity: 0; }
}

/* 积分弹出动画 */
.points-popup {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 20;
  animation: pointsPop 2.5s ease-out forwards;
  pointer-events: none;
}

.points-text {
  font-size: 52rpx;
  font-weight: bold;
  color: #FFD700;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

@keyframes pointsPop {
  0% { transform: translate(-50%, -50%) scale(0); opacity: 0; }
  20% { transform: translate(-50%, -50%) scale(1.3); opacity: 1; }
  40% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  100% { transform: translate(-50%, -150%) scale(1); opacity: 0; }
}

/* 刷牙小知识 */
.tip-popup {
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
  animation: tipSlide 2.5s ease-out forwards;
  pointer-events: none;
}

.tip-text {
  background: rgba(0, 0, 0, 0.75);
  color: white;
  padding: 14rpx 28rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  white-space: nowrap;
  backdrop-filter: blur(10px);
}

@keyframes tipSlide {
  0% { transform: translateX(-50%) translateY(20rpx); opacity: 0; }
  20% { transform: translateX(-50%) translateY(0); opacity: 1; }
  80% { transform: translateX(-50%) translateY(0); opacity: 1; }
  100% { transform: translateX(-50%) translateY(-20rpx); opacity: 0; }
}

/* ===== 奖励 ===== */
.reward-section { padding: 8rpx 40rpx; text-align: center; flex-shrink: 0; }
.star-row { display: flex; justify-content: center; gap: 20rpx; margin-bottom: 6rpx; }
.star-item { transition: transform 0.3s; }
.star-emoji { font-size: 40rpx; opacity: 0.25; transition: opacity 0.3s; }
.star-item.earned .star-emoji { opacity: 1; animation: starPop 0.5s ease-out; }

@keyframes starPop {
  0% { transform: scale(0.3); }
  50% { transform: scale(1.5); }
  100% { transform: scale(1); }
}

.reward-text { font-size: 28rpx; color: #FF6B8A; font-weight: bold; }

/* ===== 时长选择 ===== */
.duration-picker {
  padding: 16rpx 50rpx 0;
  text-align: center;
}

.duration-title {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 16rpx;
}

.duration-options {
  display: flex;
  justify-content: center;
  gap: 24rpx;
}

.duration-opt {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  background: white;
  box-shadow: 0 4rpx 16rpx rgba(255, 154, 171, 0.15);
  transition: all 0.2s;
}

.duration-opt.active {
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: white;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 138, 0.35);
}

.duration-num {
  font-size: 36rpx;
  font-weight: bold;
}

.duration-unit {
  font-size: 22rpx;
}

.duration-opt.active .duration-num,
.duration-opt.active .duration-unit {
  color: white;
}

/* ===== 按钮 ===== */
.btn-area {
  padding: 24rpx 50rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.btn-start {
  width: 100%;
  padding: 32rpx 0;
  text-align: center;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: white;
  border-radius: 64rpx;
  font-size: 36rpx;
  font-weight: bold;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(255, 107, 138, 0.4);
  transition: transform 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-start:active { transform: scale(0.96); }

.btn-icon { font-size: 40rpx; }
.btn-label { font-size: 36rpx; }

.btn-sparkle {
  position: absolute;
  top: -50%; left: -50%;
  width: 200%; height: 200%;
  background: linear-gradient(45deg, transparent 40%, rgba(255,255,255,0.2) 50%, transparent 60%);
  animation: sparkleMove 3s linear infinite;
}

@keyframes sparkleMove {
  0% { transform: translateX(-100%) rotate(25deg); }
  100% { transform: translateX(100%) rotate(25deg); }
}

.btn-pause {
  width: 100%;
  padding: 32rpx 0;
  text-align: center;
  background: linear-gradient(135deg, #FFB74D, #FF9800);
  color: white;
  border-radius: 64rpx;
  font-size: 36rpx;
  font-weight: bold;
  box-shadow: 0 12rpx 36rpx rgba(255, 152, 0, 0.35);
  transition: transform 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-pause:active { transform: scale(0.96); }

.btn-retry {
  padding: 12rpx 40rpx;
  color: #bbb;
  font-size: 26rpx;
}

.btn-finish-early {
  padding: 16rpx 40rpx;
  color: #81C784;
  font-size: 28rpx;
  font-weight: bold;
  background: rgba(129, 199, 132, 0.1);
  border-radius: 40rpx;
  transition: transform 0.2s;
}

.btn-finish-early:active {
  transform: scale(0.96);
}

/* ===== 胜利后按钮 ===== */
.victory-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.victory-btn {
  width: 100%;
  padding: 24rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: bold;
  transition: transform 0.2s;
}

.victory-btn:active {
  transform: scale(0.96);
}

/* 主要按钮 - 拍照打卡 */
.victory-btn.primary {
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 138, 0.4);
}

/* 次要按钮 - 保存纪念 */
.victory-btn.secondary {
  background: linear-gradient(135deg, #81C784, #66BB6A);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(129, 199, 132, 0.4);
}

/* 轮廓按钮 - 查看统计 */
.victory-btn.outline {
  background: transparent;
  color: #E91E63;
  border: 3rpx solid #FFB6C1;
}

.victory-btn-icon {
  font-size: 32rpx;
}

.victory-btn-text {
  font-size: 30rpx;
}

.safe-bottom { height: 40rpx; }

/* ===== 主线故事 - 敌人卡片区域 ===== */
.story-enemy-area {
  position: relative;
  z-index: 5;
  padding: 10rpx 20rpx;
  animation: slideDown 0.5s ease-out;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-50rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

