<!-- 刷牙统计页 -->
<view class="stats-container">
  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 顶部工具栏 -->
  <view class="toolbar" style="padding-right: {{capsuleRight}}px;">
    <view class="tool-left">
      <view class="tool-btn" bindtap="goBack">
        <text>← 返回</text>
      </view>
    </view>
    <view class="tool-center">
      <text class="tool-title">📊 刷牙统计</text>
    </view>
  </view>

  <!-- 汇总卡片 -->
  <view class="summary-cards">
    <view class="summary-card">
      <text class="summary-number">{{stats.streak}}</text>
      <text class="summary-label">🔥 连续天数</text>
    </view>

    <view class="summary-card">
      <text class="summary-number">{{stats.todayCount}}</text>
      <text class="summary-label">✅ 今日完成</text>
    </view>

    <view class="summary-card">
      <text class="summary-number">{{stats.weekRate}}%</text>
      <text class="summary-label">📅 本周完成率</text>
    </view>

    <view class="summary-card">
      <text class="summary-number">{{stats.avgScore}}</text>
      <text class="summary-label">⭐ 平均评分</text>
    </view>
  </view>

  <!-- 日历 -->
  <view class="calendar-card">
    <view class="calendar-header">
      <view class="calendar-nav">
        <view class="calendar-arrow" bindtap="prevMonth">◀</view>
        <view class="calendar-title">{{currentYear}}年{{currentMonth}}月</view>
        <view class="calendar-arrow" bindtap="nextMonth">▶</view>
      </view>
      <view class="calendar-legend">
        <view class="legend-item">
          <view class="legend-dot morning-dot"></view>
          <text>早上</text>
        </view>
        <view class="legend-item">
          <view class="legend-dot evening-dot"></view>
          <text>晚上</text>
        </view>
      </view>
    </view>

    <view class="weekdays">
      <view wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this" class="weekday">
        {{item}}
      </view>
    </view>

    <view class="days-grid">
      <view
        wx:for="{{calendarDays}}"
        wx:key="date"
        class="day-cell {{item.isCurrentMonth ? '' : 'other-month'}} {{item.isToday ? 'today' : ''}} {{item.date && item.date === selectedDate ? 'selected' : ''}}"
        bindtap="selectDate"
        data-date="{{item.date}}"
      >
        <text class="day-number">{{item.day}}</text>
        <view wx:if="{{item.morning}}" class="day-mark morning-mark">☀️</view>
        <view wx:if="{{item.evening}}" class="day-mark evening-mark">🌙</view>
      </view>
    </view>
  </view>

  <!-- 本周趋势 -->
  <view class="trend-card">
    <view class="trend-title">📊 本周趋势</view>
    <view class="trend-chart">
      <view wx:for="{{weekTrend}}" wx:key="date" class="trend-bar-wrap">
        <view class="trend-bar-bg">
          <view class="trend-bar" style="height: {{item.percent}}%;"></view>
        </view>
        <text class="trend-label">{{item.weekday}}</text>
        <view class="trend-dots">
          <view wx:if="{{item.morning}}" class="trend-dot morning-dot"></view>
          <view wx:if="{{item.evening}}" class="trend-dot evening-dot"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 当日摘要卡片 -->
  <view wx:if="{{daySummary}}" class="day-summary-card">
    <view class="day-summary-header">
      <text class="day-summary-date">{{daySummary.date}} {{daySummary.weekday}}</text>
      <text class="day-summary-badge {{daySummary.isComplete ? 'complete' : ''}}">{{daySummary.isComplete ? '✅ 早晚完成' : '⏳ 进行中'}}</text>
    </view>
    <view class="day-summary-row">
      <view class="day-summary-item">
        <text class="day-summary-icon">{{daySummary.morning ? '☀️' : '⬜'}}</text>
        <text class="day-summary-label">早上</text>
        <text class="day-summary-value">{{daySummary.morning ? '已刷 ' + daySummary.morning.score + '分' : '未刷'}}</text>
      </view>
      <view class="day-summary-divider"></view>
      <view class="day-summary-item">
        <text class="day-summary-icon">{{daySummary.evening ? '🌙' : '⬜'}}</text>
        <text class="day-summary-label">晚上</text>
        <text class="day-summary-value">{{daySummary.evening ? '已刷 ' + daySummary.evening.score + '分' : '未刷'}}</text>
      </view>
      <view class="day-summary-divider"></view>
      <view class="day-summary-item">
        <text class="day-summary-icon">⭐</text>
        <text class="day-summary-label">积分</text>
        <text class="day-summary-value">{{daySummary.totalPoints}}</text>
      </view>
    </view>
    <!-- 补刷按钮：非今天、且有未刷时段 -->
    <view wx:if="{{daySummary.canCatchUp}}" class="catch-up-row">
      <view wx:if="{{!daySummary.morning}}" class="catch-up-btn" bindtap="catchUpBrush" data-time="morning">
        <text>☀️ 补刷早上</text>
      </view>
      <view wx:if="{{!daySummary.evening}}" class="catch-up-btn" bindtap="catchUpBrush" data-time="evening">
        <text>🌙 补刷晚上</text>
      </view>
    </view>
  </view>

  <!-- 积分与贴纸 -->
  <view class="extras-row">
    <view class="extra-card" bindtap="togglePointsPanel">
      <text class="extra-icon">🏆</text>
      <text class="extra-label">总积分</text>
      <text class="extra-value">{{totalPoints}}</text>
    </view>
    <view class="extra-card" bindtap="toggleStickerAlbum">
      <text class="extra-icon">🎨</text>
      <text class="extra-label">贴纸册</text>
      <text class="extra-value">{{decorations.length}}张</text>
    </view>
  </view>

  <!-- 贴纸纪念册弹窗 -->
  <view wx:if="{{showStickerAlbum}}" class="modal-mask" bindtap="toggleStickerAlbum">
    <view class="sticker-album-modal" catchtap="noop">
      <view class="detail-close" bindtap="toggleStickerAlbum">✕</view>
      <view class="detail-header">
        <text class="detail-emoji">🎨</text>
        <text class="detail-title">贴纸纪念册</text>
      </view>
      <view wx:if="{{decorations.length > 0}}" class="sticker-album-list">
        <view wx:for="{{decorations}}" wx:key="id" class="sticker-album-item">
          <view class="sticker-album-date">{{item.date}} {{item.timeOfDay === 'morning' ? '☀️' : '🌙'}}</view>
          <view class="sticker-album-emojis">
            <text wx:for="{{item.stickers}}" wx:key="id" wx:for-item="s" class="sticker-album-emoji">{{s.emoji}}</text>
          </view>
          <view class="sticker-album-points">⭐ {{item.points}}分</view>
        </view>
      </view>
      <view wx:else class="empty-history">
        <text class="empty-icon">🎨</text>
        <text class="empty-text">还没有贴纸哦~</text>
        <text class="empty-tip">刷牙完成后给牙齿贴吧贴吧！</text>
      </view>
    </view>
  </view>

  <!-- 历史记录 -->
  <view class="history-card">
    <view class="history-title">
      <text>📝 {{selectedDate ? selectedDate + ' 记录' : '最近记录'}}</text>
      <text wx:if="{{selectedDate}}" class="history-show-all" bindtap="selectDate" data-date="{{selectedDate}}">查看全部</text>
    </view>

    <view wx:if="{{records.length > 0}}" class="history-list">
      <view
        wx:for="{{records}}"
        wx:key="id"
        class="history-item"
        bindtap="viewDetail"
        data-id="{{item.id}}"
      >
        <image
          wx:if="{{item.imagePath}}"
          class="history-image"
          src="{{item.imagePath}}"
          mode="aspectFill"
          bindtap="previewImage"
          data-path="{{item.imagePath}}"
        />
        <view wx:else class="history-image history-image-placeholder">✅</view>
        <view class="history-info">
          <view class="history-date">{{item.date}} {{item.timeOfDay === 'morning' ? '早上' : '晚上'}}</view>
          <view class="history-time">{{item.createTimeFormatted}}</view>
          <view wx:if="{{item.note}}" class="history-note">{{item.note}}</view>
        </view>
        <view class="history-score">
          <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" wx:for-item="star"
                class="history-star {{star <= item.score ? 'active' : ''}}">⭐</text>
        </view>
        <view class="delete-btn" catchtap="deleteRecord" data-id="{{item.id}}">
          <text>🗑️</text>
        </view>
      </view>
    </view>

    <view wx:else class="empty-history">
      <text class="empty-icon">🦷</text>
      <text class="empty-text">还没有刷牙记录哦~</text>
      <text class="empty-tip">从今天开始，帮{{childName}}养成刷牙好习惯！</text>
    </view>
  </view>

  <!-- 详情弹窗（组件化） -->
  <brushing-detail
    show="{{showDetail}}"
    record="{{detailRecord}}"
    bind:close="closeDetail"
    bind:updated="onDetailUpdated"
  />

  <!-- 补刷评分弹窗 -->
  <view wx:if="{{showScoreModal}}" class="modal-mask">
    <view class="detail-modal">
      <view class="detail-header">
        <text class="detail-emoji">🦷</text>
        <text class="detail-title">补刷{{modalTime === 'morning' ? '早上' : '晚上'}}刷牙</text>
      </view>

      <view class="score-selector">
        <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this"
              class="select-star {{score >= item ? 'active' : ''}}"
              bindtap="selectScore" data-score="{{item}}">⭐</view>
      </view>
      <view class="score-label-text">{{scoreLabel}}</view>

      <input class="note-input" placeholder="写点鼓励的话吧~（可选）" value="{{note}}" bindinput="onNoteInput" />

      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="cancelScore">取消</view>
        <view class="modal-btn confirm" bindtap="confirmScore">确认补刷</view>
      </view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
