<!-- 刷牙打卡页 -->
<view class="brushing-container">
  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 顶部工具栏 -->
  <view class="toolbar" style="padding-right: {{capsuleRight}}px;">
    <view class="tool-left">
      <view class="tool-btn" bindtap="goBack">
        <text>← 返回</text>
      </view>
    </view>
    <view class="tool-center">
      <text class="tool-title">🦷 钰婷刷牙打卡</text>
    </view>
    <view class="tool-right">
      <view class="tool-btn" bindtap="goStats">
        <text>📊 统计</text>
      </view>
    </view>
  </view>

  <!-- 顶部信息区 -->
  <view class="header-info">
    <view class="date-display">
      <view class="date-main">
        <text class="date-icon">📅</text>
        <text class="date-day">{{todayInfo.day}}</text>
      </view>
      <view class="date-sub">
        <text class="date-week-icon">{{todayInfo.weekdayIcon}}</text>
        <text class="date-week">{{todayInfo.weekday}}</text>
      </view>
    </view>
    <view class="streak-badge">
      <text class="streak-icon">🔥</text>
      <text class="streak-text">已连续 {{streakDays}} 天</text>
    </view>
  </view>

  <!-- ===== 主线故事区域 ===== -->
  <view wx:if="{{showStorySection && currentChapter}}" class="story-section">
    <!-- 标题行：探险 + 今日任务 -->
    <view class="story-header">
      <text class="story-chapter-emoji">{{currentChapter.emoji}}</text>
      <text class="story-chapter-name">第{{round}}轮·{{currentChapter.name}}</text>
      <text class="story-mission-text" wx:if="{{isEnemyDefeated}}">✅ 今日任务：已打败{{currentEnemy.name}}</text>
      <text class="story-mission-text" wx:else>⚔️ 今日任务：打败{{currentEnemy.name}}</text>
    </view>

    <!-- 进度条区域 -->
    <view class="progress-area">
      <text class="enemy-emoji">{{currentEnemy.emoji}}</text>
      <view class="hp-bar-wrap">
        <view class="hp-bg">
          <view
            class="hp-fill"
            style="width: {{(enemyCurrentHp / currentEnemy.hp) * 100}}%; background: {{enemyCurrentHp > 3 ? '#4CAF50' : (enemyCurrentHp > 1 ? '#FF9800' : '#F44336')}};"
          />
        </view>
        <text class="hp-text">HP {{enemyCurrentHp}}/{{currentEnemy.hp}}</text>
      </view>
    </view>
  </view>

  <!-- 打卡卡片区 -->
  <view class="cards-area">
    <!-- 早上刷牙卡片 -->
    <view class="brushing-card {{morningRecord ? 'done' : ''}}">
      <view class="card-content">
        <!-- 左侧：基础信息 -->
        <view class="card-left">
          <view class="card-header">
            <text class="card-icon">☀️</text>
            <text class="card-title">早上刷牙</text>
          </view>
          <view class="card-desc">{{morningRecord ? '已完成，牙齿亮晶晶~' : '早上刷一刷，口气清新'}}</view>

          <view wx:if="{{!morningRecord}}" class="card-action">
            <view class="check-btn timer-btn" bindtap="goTimer" data-time="morning">
              <text>⏱ 计时刷牙</text>
            </view>
            <view class="check-btn" bindtap="checkIn" data-time="morning">
              <text>📷 拍照打卡</text>
            </view>
            <view class="check-btn direct-btn" bindtap="directCheckIn" data-time="morning">
              <text>✅ 直接打卡</text>
            </view>
          </view>

          <view wx:if="{{morningRecord}}" class="record-info">
            <view class="record-score-row">
              <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" wx:for-item="star"
                    class="star {{star <= morningRecord.score ? 'active' : ''}}">⭐</text>
              <text wx:if="{{morningRecord.note}}" class="record-note-inline">{{morningRecord.note}}</text>
            </view>
            <view class="record-detail">
              <view class="detail-tag" wx:if="{{morningRecord.createTimeFormatted}}">🕐 {{morningRecord.createTimeFormatted}}</view>
              <view class="detail-tag" wx:if="{{morningRecord.durationText}}">⏱ {{morningRecord.durationText}}</view>
            </view>
            <view class="record-actions">
              <view class="action-btn" bindtap="viewDetail" data-time="morning">
                <text>📋 查看详情</text>
              </view>
              <view class="action-btn" bindtap="goTimer" data-time="morning">
                <text>🔄 重新刷牙</text>
              </view>
              <view class="action-btn" bindtap="addPhoto" data-time="morning">
                <text>📷 补拍照片</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 右侧：图片区域 -->
        <view wx:if="{{morningRecord}}" class="card-right">
          <view wx:if="{{morningRecord.images.length > 0}}" class="photo-area">
            <swiper class="photo-swiper" indicator-dots="{{morningRecord.images.length > 1}}" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#FF6B8A" autoplay="false" circular="false">
              <swiper-item wx:for="{{morningRecord.images}}" wx:key="*this">
                <image class="photo-thumb" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-path="{{item}}" data-images="{{morningRecord.images}}" />
              </swiper-item>
            </swiper>
            <view wx:if="{{morningRecord.images.length > 1}}" class="photo-count">
              <text>{{morningRecord.images.length}}张</text>
            </view>
            <view class="photo-edit" catchtap="editPhotoInDraw" data-path="{{morningRecord.images[0]}}" data-time-of-day="morning">✏️</view>
          </view>
          <view wx:elif="{{morningRecord.imagePath}}" class="photo-area">
            <image class="photo-thumb" src="{{morningRecord.imagePath}}" mode="aspectFill" bindtap="previewImage" data-path="{{morningRecord.imagePath}}" />
            <view class="photo-edit" catchtap="editPhotoInDraw" data-path="{{morningRecord.imagePath}}" data-time-of-day="morning">✏️</view>
          </view>
          <view wx:else class="photo-area photo-placeholder">
            <text>✅</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 晚上刷牙卡片 -->
    <view class="brushing-card {{eveningRecord ? 'done' : ''}}">
      <view class="card-content">
        <!-- 左侧：基础信息 -->
        <view class="card-left">
          <view class="card-header">
            <text class="card-icon">🌙</text>
            <text class="card-title">晚上刷牙</text>
          </view>
          <view class="card-desc">{{eveningRecord ? '已完成，可以安心睡觉啦~' : '睡前刷一刷，保护小牙齿'}}</view>

          <view wx:if="{{!eveningRecord}}" class="card-action">
            <view class="check-btn timer-btn" bindtap="goTimer" data-time="evening">
              <text>⏱ 计时刷牙</text>
            </view>
            <view class="check-btn" bindtap="checkIn" data-time="evening">
              <text>📷 拍照打卡</text>
            </view>
            <view class="check-btn direct-btn" bindtap="directCheckIn" data-time="evening">
              <text>✅ 直接打卡</text>
            </view>
          </view>

          <view wx:if="{{eveningRecord}}" class="record-info">
            <view class="record-score-row">
              <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" wx:for-item="star"
                    class="star {{star <= eveningRecord.score ? 'active' : ''}}">⭐</text>
              <text wx:if="{{eveningRecord.note}}" class="record-note-inline">{{eveningRecord.note}}</text>
            </view>
            <view class="record-detail">
              <view class="detail-tag" wx:if="{{eveningRecord.createTimeFormatted}}">🕐 {{eveningRecord.createTimeFormatted}}</view>
              <view class="detail-tag" wx:if="{{eveningRecord.durationText}}">⏱ {{eveningRecord.durationText}}</view>
            </view>
            <view class="record-actions">
              <view class="action-btn" bindtap="viewDetail" data-time="evening">
                <text>📋 查看详情</text>
              </view>
              <view class="action-btn" bindtap="goTimer" data-time="evening">
                <text>🔄 重新刷牙</text>
              </view>
              <view class="action-btn" bindtap="addPhoto" data-time="evening">
                <text>📷 补拍照片</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 右侧：图片区域 -->
        <view wx:if="{{eveningRecord}}" class="card-right">
          <view wx:if="{{eveningRecord.images.length > 0}}" class="photo-area">
            <swiper class="photo-swiper" indicator-dots="{{eveningRecord.images.length > 1}}" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#FF6B8A" autoplay="false" circular="false">
              <swiper-item wx:for="{{eveningRecord.images}}" wx:key="*this">
                <image class="photo-thumb" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-path="{{item}}" data-images="{{eveningRecord.images}}" />
              </swiper-item>
            </swiper>
            <view wx:if="{{eveningRecord.images.length > 1}}" class="photo-count">
              <text>{{eveningRecord.images.length}}张</text>
            </view>
            <view class="photo-edit" catchtap="editPhotoInDraw" data-path="{{eveningRecord.images[0]}}" data-time-of-day="evening">✏️</view>
          </view>
          <view wx:elif="{{eveningRecord.imagePath}}" class="photo-area">
            <image class="photo-thumb" src="{{eveningRecord.imagePath}}" mode="aspectFill" bindtap="previewImage" data-path="{{eveningRecord.imagePath}}" />
            <view class="photo-edit" catchtap="editPhotoInDraw" data-path="{{eveningRecord.imagePath}}" data-time-of-day="evening">✏️</view>
          </view>
          <view wx:else class="photo-area photo-placeholder">
            <text>✅</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 昨日回顾 -->
  <view class="yesterday-section">
    <view class="yesterday-title">
      <text>📋 昨日回顾</text>
      <text class="yesterday-date" wx:if="{{yesterdayDate}}">{{yesterdayDate}}</text>
    </view>
    <view class="yesterday-cards">
      <!-- 早上 -->
      <view class="yesterday-card {{yesterdayMorning ? 'done' : 'missed'}}" bindtap="previewYesterdayImage" data-time="morning">
        <view class="yesterday-header">
          <text class="yesterday-icon">☀️</text>
          <text class="yesterday-label">早上</text>
        </view>
        <view wx:if="{{yesterdayMorning}}" class="yesterday-detail">
          <view class="yesterday-stars">
            <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" wx:for-item="star"
                  class="star {{star <= yesterdayMorning.score ? 'active' : ''}}">⭐</text>
          </view>
          <text class="yesterday-time" wx:if="{{yesterdayMorning.createTimeFormatted}}">🕐 {{yesterdayMorning.createTimeFormatted}}</text>
          <text class="yesterday-duration" wx:if="{{yesterdayMorning.durationText}}">⏱ {{yesterdayMorning.durationText}}</text>
          <view wx:if="{{yesterdayMorning.images && yesterdayMorning.images.length > 0}}" class="yesterday-photo-count">
            <text>📷 {{yesterdayMorning.images.length}}张照片</text>
          </view>
        </view>
        <view wx:else class="yesterday-missed-text">
          <text>✗ 未刷</text>
        </view>
      </view>
      <!-- 晚上 -->
      <view class="yesterday-card {{yesterdayEvening ? 'done' : 'missed'}}" bindtap="previewYesterdayImage" data-time="evening">
        <view class="yesterday-header">
          <text class="yesterday-icon">🌙</text>
          <text class="yesterday-label">晚上</text>
        </view>
        <view wx:if="{{yesterdayEvening}}" class="yesterday-detail">
          <view class="yesterday-stars">
            <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" wx:for-item="star"
                  class="star {{star <= yesterdayEvening.score ? 'active' : ''}}">⭐</text>
          </view>
          <text class="yesterday-time" wx:if="{{yesterdayEvening.createTimeFormatted}}">🕐 {{yesterdayEvening.createTimeFormatted}}</text>
          <text class="yesterday-duration" wx:if="{{yesterdayEvening.durationText}}">⏱ {{yesterdayEvening.durationText}}</text>
          <view wx:if="{{yesterdayEvening.images && yesterdayEvening.images.length > 0}}" class="yesterday-photo-count">
            <text>📷 {{yesterdayEvening.images.length}}张照片</text>
          </view>
        </view>
        <view wx:else class="yesterday-missed-text">
          <text>✗ 未刷</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 评分弹窗 -->
  <view wx:if="{{showScoreModal}}" class="modal-mask">
    <view class="modal-content">
      <view class="modal-title">🦷 给钰婷打分</view>
      <view class="modal-desc">{{modalTime === 'morning' ? '早上' : '晚上'}}刷牙完成啦~</view>

      <view class="score-selector">
        <view
          wx:for="{{[1,2,3,4,5]}}"
          wx:key="*this"
          class="select-star {{score >= item ? 'active' : ''}}"
          bindtap="selectScore"
          data-score="{{item}}"
        >
          ⭐
        </view>
      </view>

      <view class="score-label">{{scoreLabel}}</view>

      <input
        class="note-input"
        placeholder="写点鼓励的话吧~（可选）"
        value="{{note}}"
        bindinput="onNoteInput"
      />

      <view class="modal-actions">
        <view class="modal-btn cancel" bindtap="cancelScore">取消</view>
        <view class="modal-btn confirm" bindtap="confirmScore">确认打卡</view>
      </view>
    </view>
  </view>

  <!-- 详情弹窗 -->
  <view wx:if="{{showDetail && detailRecord}}" class="modal-mask" bindtap="closeDetail">
    <view class="detail-modal" catchtap="noop">
      <view class="detail-close" bindtap="closeDetail">✕</view>
      <view class="detail-header">
        <text class="detail-emoji">{{detailRecord.timeOfDay === 'morning' ? '☀️' : '🌙'}}</text>
        <text class="detail-title">{{detailRecord.timeOfDay === 'morning' ? '早上' : '晚上'}}刷牙详情</text>
      </view>

      <view class="detail-rows">
        <view class="detail-row">
          <text class="detail-label">📅 日期</text>
          <text class="detail-value">{{detailRecord.date}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">🕐 时间</text>
          <text class="detail-value">{{detailRecord.timeStr}}</text>
        </view>
        <view class="detail-row" wx:if="{{detailRecord.durationText}}">
          <text class="detail-label">⏱ 方式</text>
          <text class="detail-value">{{detailRecord.durationText}}</text>
        </view>
        <view class="detail-row">
          <text class="detail-label">⭐ 评分</text>
          <view class="detail-value">
            <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" wx:for-item="star"
                  class="detail-star {{star <= detailRecord.score ? 'active' : ''}}">⭐</text>
            <text class="detail-score-text">{{detailRecord.score}}分</text>
          </view>
        </view>
        <view class="detail-row" wx:if="{{detailRecord.points > 0}}">
          <text class="detail-label">🏆 积分</text>
          <text class="detail-value">+{{detailRecord.points}}</text>
        </view>
        <view class="detail-row" wx:if="{{detailRecord.completedAreas && detailRecord.completedAreas.length > 0}}">
          <text class="detail-label">🦷 刷牙区域</text>
          <text class="detail-value">{{detailRecord.completedAreas.join('、')}}</text>
        </view>
        <view class="detail-row" wx:if="{{detailRecord.stickers && detailRecord.stickers.length > 0}}">
          <text class="detail-label">🎨 贴纸</text>
          <view class="detail-stickers">
            <text wx:for="{{detailRecord.stickers}}" wx:key="id" class="detail-sticker-emoji">{{item.emoji}}</text>
          </view>
        </view>
        <view class="detail-row" wx:if="{{detailRecord.note}}">
          <text class="detail-label">💬 备注</text>
          <text class="detail-value">{{detailRecord.note}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 成功提示 -->
  <view wx:if="{{showSuccess}}" class="success-toast">
    <view class="success-icon">✨</view>
    <view class="success-text">{{successText}}</view>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-bottom"></view>
</view>
