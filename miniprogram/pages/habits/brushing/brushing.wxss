/* 刷牙打卡页样式 */
.brushing-container {
  height: 100vh;
  background: linear-gradient(180deg, #FFF0F6 0%, #FFF5F8 50%, #FFF8F5 100%);
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 状态栏占位 */
.status-bar {
  width: 100%;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
}

/* 顶部工具栏 */
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
}

.tool-left, .tool-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tool-btn {
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  color: white;
  font-size: 24rpx;
}

.tool-btn:active {
  background: rgba(255, 255, 255, 0.4);
}

.tool-center {
  flex: 1;
  text-align: center;
}

.tool-title {
  color: white;
  font-size: 30rpx;
  font-weight: bold;
}

/* 顶部信息区 */
.header-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 20rpx;
}

.date-display {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.date-main {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.date-icon {
  font-size: 28rpx;
}

.date-day {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.date-sub {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.date-week-icon {
  font-size: 20rpx;
}

.date-week {
  font-size: 24rpx;
  color: #666;
}

.streak-badge {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  padding: 10rpx 16rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 138, 0.3);
}

.streak-icon {
  font-size: 24rpx;
}

.streak-text {
  font-size: 22rpx;
  color: white;
  font-weight: bold;
}

/* 打卡卡片 */
.cards-area {
  padding: 0 20rpx;
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 12rpx;
}

.brushing-card {
  background: white;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(255, 154, 171, 0.15);
  position: relative;
  overflow: hidden;
}

.brushing-card.done {
  background: linear-gradient(135deg, #FFF8F0, #FFF0F3);
  border: 2rpx solid #FFD6DE;
}

.brushing-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 100%;
  background: linear-gradient(180deg, #FF9AAB, #FF6B8A);
}

.brushing-card.done::before {
  background: linear-gradient(180deg, #90EE90, #4CAF50);
}

/* 卡片内容布局 */
.card-content {
  display: flex;
  gap: 16rpx;
}

.card-left {
  flex: 1;
  min-width: 0;
}

.card-right {
  flex-shrink: 0;
  width: 160rpx;
}

/* 图片区域 */
.photo-area {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo-thumb {
  width: 100%;
  height: 100%;
}

.photo-count {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  background: rgba(0,0,0,0.6);
  color: white;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
}

.photo-edit {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0,0,0,0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
}

.photo-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(129, 199, 132, 0.2);
  font-size: 48rpx;
}

/* 记录信息 */
.record-info {
  margin-top: 12rpx;
}

.record-score {
  display: flex;
  gap: 4rpx;
  margin-bottom: 8rpx;
}

.record-score .star {
  font-size: 20rpx;
  opacity: 0.3;
}

.record-score .star.active {
  opacity: 1;
}

.record-note {
  font-size: 22rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.record-detail {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.detail-tag {
  font-size: 20rpx;
  color: #999;
  background: rgba(0,0,0,0.05);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

/* 操作按钮 */
.record-actions {
  display: flex;
  gap: 10rpx;
  margin-top: 12rpx;
}

.action-btn {
  padding: 8rpx 16rpx;
  background: rgba(255, 107, 138, 0.1);
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 107, 138, 0.3);
}

.action-btn text {
  font-size: 20rpx;
  color: #FF6B8A;
}

.action-btn:active {
  background: rgba(255, 107, 138, 0.2);
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.card-icon {
  font-size: 52rpx;
}

.card-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.card-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.card-action {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
  justify-content: center;
}

.check-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: white;
  padding: 18rpx 30rpx;
  border-radius: 26rpx;
  font-size: 26rpx;
  font-weight: bold;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 138, 0.25);
  transition: all 0.2s;
}

.check-btn:active {
  transform: scale(0.96);
}

.check-btn.timer-btn {
  background: linear-gradient(135deg, #81C784, #4CAF50);
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.25);
}

.check-btn.direct-btn {
  background: linear-gradient(135deg, #4FC3F7, #0288D1);
  box-shadow: 0 4rpx 12rpx rgba(2, 136, 209, 0.25);
}

/* 已完成记录展示 */
.record-display {
  margin-top: 10rpx;
}

/* 多图横向滚动 */
.photo-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.photo-list {
  display: inline-flex;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  flex-shrink: 0;
}

.record-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  background: #F8F8F8;
}

.photo-single {
  position: relative;
  display: inline-block;
}

.photo-delete {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: #FF4444;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  z-index: 10;
}

.photo-edit {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  z-index: 10;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  background: #F5F5F5;
  border: 3rpx dashed #DDD;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-add-icon {
  font-size: 60rpx;
  color: #CCC;
}

/* 刷牙详情标签 */
.record-detail {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.detail-tag {
  font-size: 22rpx;
  color: #666;
  background: #F5F5F5;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.record-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  background: linear-gradient(135deg, #E8F5E9, #F1F8E9);
}

.record-score {
  display: flex;
  gap: 8rpx;
  margin-top: 16rpx;
}

.score-star {
  font-size: 28rpx;
  opacity: 0.3;
}

.score-star.active {
  opacity: 1;
}

.record-note {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  background: rgba(255, 154, 171, 0.1);
  padding: 10rpx 20rpx;
  border-radius: 12rpx;
  display: inline-block;
}

.add-photo-btn {
  display: inline-block;
  background: linear-gradient(135deg, #4FC3F7, #0288D1);
  color: white;
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(2, 136, 209, 0.25);
}

.add-photo-btn:active {
  transform: scale(0.96);
}

.record-extra-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.retry-btn {
  display: inline-block;
  background: linear-gradient(135deg, #81C784, #4CAF50);
  color: white;
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.25);
}

.retry-btn:active {
  transform: scale(0.96);
}

/* 昨日回顾 */
.yesterday-section {
  margin: 0 20rpx 12rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 16rpx;
  padding: 12rpx 16rpx;
}

.yesterday-title {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 10rpx;
}

.yesterday-cards {
  display: flex;
  gap: 12rpx;
}

.yesterday-card {
  flex: 1;
  padding: 12rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 12rpx;
  border: 2rpx solid #EEE;
  text-align: center;
}

.yesterday-card.done {
  background: rgba(129, 199, 132, 0.15);
  border-color: #81C784;
}

.yesterday-card.missed {
  background: rgba(255, 182, 193, 0.15);
  border-color: #FFB6C1;
}

.yesterday-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  margin-bottom: 8rpx;
}

.yesterday-icon {
  font-size: 24rpx;
}

.yesterday-label {
  font-size: 22rpx;
  color: #666;
  font-weight: bold;
}

.yesterday-detail {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.yesterday-stars {
  display: flex;
  gap: 2rpx;
}

.yesterday-stars .star {
  font-size: 16rpx;
  opacity: 0.3;
}

.yesterday-stars .star.active {
  opacity: 1;
}

.yesterday-time {
  font-size: 18rpx;
  color: #999;
}

.yesterday-duration {
  font-size: 18rpx;
  color: #666;
}

.yesterday-missed-text {
  color: #FF6B8A;
  font-size: 22rpx;
  font-weight: bold;
}

/* 底部区域 */
.bottom-area {
  padding: 12rpx 20rpx 20rpx;
  text-align: center;
  flex-shrink: 0;
}

.encourage-text {
  font-size: 24rpx;
  color: #FF6B8A;
  background: rgba(255, 255, 255, 0.7);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  display: inline-block;
  margin-bottom: 12rpx;
}

/* 牙齿装饰 */
.tooth-decoration {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  opacity: 0.6;
}

.tooth-emoji {
  font-size: 24rpx;
  animation: toothBounce 2s ease-in-out infinite;
}

@keyframes toothBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-5rpx); }
}

.tooth-text {
  font-size: 20rpx;
  color: #FFB6C1;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal-content {
  width: 80%;
  background: white;
  border-radius: 32rpx;
  padding: 50rpx 40rpx;
  text-align: center;
}

.modal-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.modal-desc {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.score-selector {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin: 30rpx 0;
}

.select-star {
  font-size: 56rpx;
  opacity: 0.25;
  transition: all 0.2s;
}

.select-star.active {
  opacity: 1;
  transform: scale(1.2);
}

.score-label {
  font-size: 30rpx;
  color: #FF6B8A;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.note-input {
  width: 90%;
  height: 80rpx;
  border: 2rpx solid #EEE;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  margin: 0 auto 30rpx;
  text-align: left;
}

.modal-actions {
  display: flex;
  justify-content: center;
  gap: 24rpx;
}

.modal-btn {
  padding: 20rpx 50rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.modal-btn.cancel {
  background: #F5F5F5;
  color: #999;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: white;
}

/* 成功提示 */
.success-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.75);
  color: white;
  padding: 40rpx 70rpx;
  border-radius: 24rpx;
  text-align: center;
  z-index: 200;
}

.success-icon {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}

.success-text {
  font-size: 30rpx;
}

/* 提醒设置 */
.reminder-card {
  background: white;
  border-radius: 24rpx;
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 154, 171, 0.1);
}

.reminder-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.reminder-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.reminder-row + .reminder-row {
  border-top: 1rpx solid #F5F5F5;
}

.reminder-label {
  font-size: 28rpx;
  color: #333;
  flex: 1;
}

.reminder-switch {
  margin-right: 20rpx;
}

.reminder-time {
  font-size: 28rpx;
  color: #FF6B8A;
  font-weight: bold;
  padding: 8rpx 16rpx;
  background: rgba(255, 107, 138, 0.08);
  border-radius: 12rpx;
}

.reminder-time.disabled {
  color: #CCC;
  background: #F5F5F5;
}

/* 底部安全区 */
.safe-bottom {
  height: 40rpx;
}

/* ===== 主线故事区域 ===== */
.story-section {
  margin: 12rpx 20rpx;
  background: linear-gradient(135deg, #FFF5F8 0%, #FFE4EC 100%);
  border-radius: 20rpx;
  padding: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 138, 0.15);
  animation: fadeIn 0.5s ease-out;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.story-header {
  margin-bottom: 12rpx;
}

.story-chapter-tag {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  padding: 10rpx 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 138, 0.1);
}

.story-chapter-emoji {
  font-size: 32rpx;
  margin-right: 10rpx;
}

.story-chapter-name {
  font-size: 28rpx;
  color: #E91E63;
  font-weight: bold;
}

/* 敌人信息 */
.story-enemy-info {
  background: rgba(255, 255, 255, 0.6);
  border-radius: 20rpx;
  padding: 20rpx;
}

.enemy-display {
  display: flex;
  align-items: center;
  margin-bottom: 15rpx;
}

.enemy-emoji {
  font-size: 60rpx;
  margin-right: 20rpx;
  animation: enemyBounce 2s ease-in-out infinite;
}

@keyframes enemyBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.enemy-details {
  flex: 1;
}

.enemy-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #E91E63;
  display: block;
  margin-bottom: 10rpx;
}

/* 小怪物进度 */
.minion-progress {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.minion-label {
  font-size: 22rpx;
  color: #666;
}

.minion-dots {
  display: flex;
  gap: 6rpx;
}

.minion-dot {
  font-size: 20rpx;
  color: #DDD;
}

.minion-dot.defeated {
  color: #4CAF50;
}

.minion-count {
  font-size: 20rpx;
  color: #999;
}

/* 大怪物HP条 */
.enemy-hp-bar {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-top: 8rpx;
}

.hp-bg {
  flex: 1;
  height: 16rpx;
  background: #FFD6E0;
  border-radius: 8rpx;
  overflow: hidden;
}

.hp-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease-out, background 0.3s ease;
}

.hp-text {
  font-size: 22rpx;
  color: #E91E63;
  font-weight: 500;
  min-width: 60rpx;
  text-align: right;
}

/* 任务提示 */
.story-mission {
  text-align: center;
  padding-top: 15rpx;
  border-top: 2rpx dashed #FFB6C1;
}

.mission-text {
  font-size: 26rpx;
  color: #E91E63;
  font-weight: 500;
}

.mission-complete {
  color: #4CAF50;
}
