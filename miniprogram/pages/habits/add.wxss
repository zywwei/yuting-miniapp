/* 添加习惯页样式 */
.container {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 30rpx;
}

.section {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.name-input {
  background: #F5F7FA;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.icon-item {
  width: 80rpx;
  height: 80rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.icon-item.selected {
  border-color: #FF6B8A;
  background: #FFF0F3;
}

.target-list {
  display: flex;
  gap: 20rpx;
}

.target-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #666;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.target-item.selected {
  border-color: #FF6B8A;
  background: #FFF0F3;
  color: #FF6B8A;
  font-weight: bold;
}

.save-btn {
  margin-top: 40rpx;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: white;
  text-align: center;
  padding: 28rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 138, 0.3);
}

.save-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}
