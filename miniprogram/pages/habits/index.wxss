/* 习惯养成首页样式 */
.container {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: 160rpx;
}

/* 头部统计 */
.header {
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  padding: 16rpx 24rpx 20rpx;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.header-stats {
  display: flex;
  gap: 16rpx;
}

.stat-card {
  background: rgba(255, 255, 255, 0.25);
  border-radius: 16rpx;
  padding: 14rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.stat-icon {
  font-size: 36rpx;
}

.stat-info {
  color: white;
}

.stat-number {
  font-size: 40rpx;
  font-weight: bold;
  line-height: 1;
}

.stat-total {
  font-size: 26rpx;
  opacity: 0.8;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.95;
  margin-top: 4rpx;
}

.add-btn {
  background: rgba(255, 255, 255, 0.3);
  color: white;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
}

/* 花园进度 */
.garden {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}

.garden-flowers {
  display: flex;
  justify-content: center;
  gap: 6rpx;
  flex-wrap: wrap;
  margin-bottom: 6rpx;
}

.flower {
  font-size: 28rpx;
  transition: all 0.3s;
}

.flower.bloomed {
  animation: bloom 0.5s ease-in-out;
}

.flower.bud {
  opacity: 0.6;
}

@keyframes bloom {
  0% { transform: scale(0.5); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

.garden-tip {
  text-align: center;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 习惯分组 */
.habit-group {
  margin: 12rpx 16rpx 0;
}

.group-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #666;
  margin-bottom: 8rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 4rpx 0;
}

.collapse-icon {
  font-size: 20rpx;
  color: #999;
}

/* 习惯网格 */
.habit-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.habit-grid-4 {
  grid-template-columns: repeat(4, 1fr);
}

.habit-item {
  background: white;
  border-radius: 14rpx;
  padding: 14rpx 8rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s;
}

.habit-item:active {
  transform: scale(0.95);
}

.habit-item.completed {
  background: #E8F5E9;
}

.habit-icon {
  font-size: 48rpx;
  margin-bottom: 6rpx;
}

.habit-name {
  font-size: 24rpx;
  color: #333;
  margin-bottom: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.habit-done {
  font-size: 20rpx;
  color: #999;
}

.habit-item.completed .habit-done {
  color: #4CAF50;
}
