/* 习惯详情页样式 */
.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 状态栏和工具栏 */
.status-bar {
  width: 100%;
  background: transparent;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: transparent;
}

.tool-left { display: flex; align-items: center; }
.tool-btn {
  padding: 12rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.25);
  color: white;
  font-size: 24rpx;
}
.tool-btn:active { background: rgba(255,255,255,0.4); }
.tool-center { flex: 1; text-align: center; }
.tool-title { color: white; font-size: 30rpx; font-weight: bold; }
.tool-right { display: flex; align-items: center; gap: 12rpx; }

/* 打卡动画 */
.checkin-animation {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(0);
  opacity: 0;
  z-index: 100;
  text-align: center;
  transition: all 0.5s ease;
}

.checkin-animation.show {
  transform: translate(-50%, -50%) scale(1);
  opacity: 1;
  animation: bounceIn 0.5s ease;
}

@keyframes bounceIn {
  0% { transform: translate(-50%, -50%) scale(0); }
  50% { transform: translate(-50%, -50%) scale(1.2); }
  100% { transform: translate(-50%, -50%) scale(1); }
}

.animation-icon {
  font-size: 120rpx;
}

.animation-text {
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 20rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

/* 头部 */
.header {
  padding: 60rpx 40rpx 40rpx;
  text-align: center;
  color: white;
}

.habit-icon-big {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.habit-name {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.habit-tip {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 统计 */
.stats {
  display: flex;
  background: rgba(255, 255, 255, 0.2);
  margin: 0 30rpx 20rpx;
  border-radius: 20rpx;
  padding: 24rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
  color: white;
}

.stat-number {
  font-size: 40rpx;
  font-weight: bold;
}

.stat-label {
  font-size: 22rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

/* 作息统计 */
.sleep-stats {
  background: rgba(255, 255, 255, 0.2);
  margin: 0 30rpx 20rpx;
  border-radius: 20rpx;
  padding: 24rpx;
}

.sleep-title {
  font-size: 28rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
}

.sleep-grid {
  display: flex;
  gap: 16rpx;
}

.sleep-item {
  flex: 1;
  text-align: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 16rpx 8rpx;
}

.sleep-value {
  font-size: 28rpx;
  font-weight: bold;
  color: white;
}

.sleep-label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

/* 今日进度 */
.today-progress {
  background: rgba(255, 255, 255, 0.2);
  margin: 0 30rpx 20rpx;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
}

.progress-text {
  color: white;
  font-size: 24rpx;
  margin-bottom: 12rpx;
}

.progress-bar-bg {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  background: white;
  border-radius: 8rpx;
  transition: width 0.3s;
}

/* 打卡按钮 */
.checkin-btn {
  margin: 0 30rpx 30rpx;
  background: rgba(255, 255, 255, 0.3);
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 30rpx;
  padding: 30rpx;
  text-align: center;
  color: white;
  transition: all 0.2s;
}

.checkin-btn:active {
  transform: scale(0.98);
}

.checkin-btn.completed {
  background: rgba(255, 255, 255, 0.5);
  border-color: white;
}

.btn-icon {
  font-size: 60rpx;
  margin-bottom: 12rpx;
}

.btn-text {
  font-size: 32rpx;
  font-weight: bold;
}

/* 区块 */
.section {
  margin: 0 30rpx 30rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 16rpx;
}

/* 记录列表 */
.record-list {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  overflow: hidden;
}

.record-item {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  color: white;
}

.record-item:last-child {
  border-bottom: none;
}

.record-date {
  font-size: 26rpx;
}

.record-time {
  font-size: 24rpx;
  opacity: 0.8;
}

.empty {
  text-align: center;
  padding: 40rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
}

/* 特色表单区域 */
.custom-fields {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 24rpx;
}

.field-item {
  margin-bottom: 24rpx;
}

.field-item:last-child {
  margin-bottom: 0;
}

.field-label {
  font-size: 26rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 12rpx;
}

.field-required {
  color: #FFD700;
  margin-left: 4rpx;
}

.field-input {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 16rpx;
}

.field-input input {
  font-size: 28rpx;
  color: white;
}

.time-picker {
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.7);
}

.time-picker.selected {
  color: white;
}

/* 计数器 */
.field-counter {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.counter-btn {
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: white;
  font-weight: bold;
}

.counter-btn.disabled {
  opacity: 0.5;
}

.counter-btn:active:not(.disabled) {
  background: rgba(255, 255, 255, 0.5);
}

.counter-value {
  min-width: 80rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  color: white;
}

/* 选项 */
.field-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.option-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.option-item.selected {
  background: rgba(255, 255, 255, 0.4);
  border-color: white;
}

.option-icon {
  font-size: 28rpx;
}

.option-label {
  font-size: 24rpx;
  color: white;
}

/* 心情选择 */
.field-mood {
  display: flex;
  gap: 16rpx;
}

.mood-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 8rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.mood-item.selected {
  background: rgba(255, 255, 255, 0.4);
  border-color: white;
}

.mood-icon {
  font-size: 36rpx;
}

.mood-label {
  font-size: 20rpx;
  color: white;
  text-align: center;
}

/* 照片区域 */
.photo-section {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 24rpx;
}

.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-edit {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0,0,0,0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
}

.photo-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 32rpx;
  height: 32rpx;
  background: rgba(255,0,0,0.7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
  color: white;
}

.photo-add {
  width: 150rpx;
  height: 150rpx;
  border: 3rpx dashed rgba(255, 255, 255, 0.5);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-icon {
  font-size: 36rpx;
}

.add-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 评分区域 */
.score-section {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 24rpx;
  text-align: center;
}

.score-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 16rpx;
}

.score-stars {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.score-star {
  font-size: 48rpx;
  opacity: 0.3;
  transition: transform 0.2s;
}

.score-star.active {
  opacity: 1;
  transform: scale(1.1);
}

.score-text {
  font-size: 28rpx;
  color: white;
  font-weight: bold;
  margin-top: 12rpx;
}

/* 留言区域 */
.note-section {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 24rpx;
}

.note-input {
  width: 100%;
  min-height: 100rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 28rpx;
  color: white;
  box-sizing: border-box;
}

.note-input::placeholder {
  color: rgba(255, 255, 255, 0.5);
}

/* 打卡按钮区域 */
.checkin-btn-area {
  padding: 0 30rpx 30rpx;
}

/* 记录详情 */
.record-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.record-right {
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.record-summary {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-note {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-score {
  display: flex;
  gap: 2rpx;
}

.record-score .star {
  font-size: 18rpx;
  opacity: 0.3;
}

.record-score .star.active {
  opacity: 1;
}

/* 成功提示 */
.success-toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0,0,0,0.8);
  color: white;
  padding: 30rpx 50rpx;
  border-radius: 20rpx;
  text-align: center;
  z-index: 1000;
  animation: fadeInOut 2s ease-in-out;
}

@keyframes fadeInOut {
  0% { opacity: 0; transform: translate(-50%, -50%) scale(0.8); }
  20% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  80% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(0.8); }
}

.success-icon {
  font-size: 60rpx;
  margin-bottom: 10rpx;
}

.success-text {
  font-size: 28rpx;
}

/* 底部安全区 */
.safe-bottom {
  height: 40rpx;
}
