<!-- 学习乐园首页 -->
<view class="container">
  <!-- 孩子切换器 -->
  <view class="switcher-wrapper" wx:if="{{children.length > 1}}">
    <child-switcher children="{{children}}" currentChildId="{{currentChildId}}" bind:childChanged="onChildChanged" />
  </view>

  <!-- 头部 -->
  <view class="header">
    <view class="header-left">
      <view class="header-title">📚 学习乐园</view>
      <view class="header-desc">寓教于乐，快乐学习</view>
    </view>
    <view class="header-actions">
      <view class="action-btn" bindtap="goStats">📊</view>
      <view class="action-btn" bindtap="goHistory">📝</view>
    </view>
  </view>

  <!-- 模块分组 -->
  <view class="module-groups">
    <view wx:for="{{moduleGroups}}" wx:key="id" class="module-group">
      <view class="group-header">
        <view class="group-icon">{{item.icon}}</view>
        <view class="group-title">{{item.title}}</view>
      </view>
      <view class="group-modules">
        <view
          wx:for="{{item.modules}}"
          wx:for-item="module"
          wx:key="type"
          class="module-card"
          style="width: 31.33%; margin-right: {{index % 3 === 2 ? '0' : '3%'}}"
          bindtap="goLearn"
          data-type="{{module.type}}"
        >
          <view class="module-icon">{{module.icon}}</view>
          <view class="module-name">{{module.name}}</view>
          <view class="module-desc">{{module.desc}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
