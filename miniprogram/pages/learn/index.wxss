/* 学习乐园首页样式 */
.container {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 孩子切换器 */
.switcher-wrapper {
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 头部 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #42A5F5, #2196F3);
  padding: 40rpx;
  color: white;
}

.header-left {
  flex: 1;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
}

.header-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

/* 模块分组 */
.module-groups {
  padding: 30rpx;
}

.module-group {
  margin-bottom: 30rpx;
}

.group-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.group-icon {
  font-size: 28rpx;
}

.group-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.group-modules {
  display: flex;
  flex-wrap: wrap;
}

.module-card {
  margin-bottom: 16rpx;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.module-card:active {
  transform: scale(0.98);
}

.module-icon {
  font-size: 36rpx;
  margin-bottom: 12rpx;
}

.module-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.module-desc {
  font-size: 20rpx;
  color: #999;
}
