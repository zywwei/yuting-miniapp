/* 学习乐园首页样式 */
.container {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 孩子切换器 */
.switcher-wrapper {
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #42A5F5, #2196F3);
  padding: 40rpx;
  color: white;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
}

.header-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

/* 学习类别列表 */
.category-list {
  padding: 30rpx;
}

.category-card {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.category-card:active {
  transform: scale(0.98);
}

.category-icon {
  width: 80rpx;
  height: 80rpx;
  background: #E3F2FD;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.category-info {
  flex: 1;
}

.category-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.category-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.category-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.progress-text {
  font-size: 22rpx;
  color: #666;
  min-width: 120rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #42A5F5, #2196F3);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.category-arrow {
  font-size: 40rpx;
  color: #CCC;
}
