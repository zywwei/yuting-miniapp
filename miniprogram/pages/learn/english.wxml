<!-- 英语学习 -->
<view class="container">
  <!-- 模式选择 -->
  <view wx:if="{{mode === 'select'}}" class="mode-select">
    <view class="mode-header">
      <view class="mode-title">🔤 英语学习</view>
      <view class="mode-desc">选择学习内容</view>
    </view>

    <view class="mode-cards">
      <view class="mode-card" bindtap="enterLetters">
        <view class="mode-icon">ABC</view>
        <view class="mode-name">字母学习</view>
        <view class="mode-info">学习26个英文字母</view>
        <view class="mode-progress">已学 {{learnedLetterCount}}/26</view>
      </view>

      <view class="mode-card" bindtap="enterWords">
        <view class="mode-icon">📖</view>
        <view class="mode-name">单词学习</view>
        <view class="mode-info">学习基础英语单词</view>
        <view class="mode-progress">已学 {{learnedWordCount}}/{{words.length}}</view>
      </view>
    </view>
  </view>

  <!-- 字母学习 -->
  <view wx:if="{{mode === 'letters'}}">
    <!-- 返回按钮 -->
    <view class="back-btn" bindtap="backToSelect">‹ 返回选择</view>

    <!-- 进度 -->
    <view class="progress-bar">
      <view class="progress-text">已学 {{learnedLetterCount}}/26</view>
      <view class="progress-track">
        <view class="progress-fill" style="width: {{learnedLetterCount / 26 * 100}}%;"></view>
      </view>
    </view>

    <!-- 字母卡片 -->
    <view class="letter-container" wx:if="{{letters.length > 0}}">
      <view class="letter-card">
        <view class="letter-big">{{letters[currentLetterIndex].letter}}</view>
        <view class="letter-phonetic" wx:if="{{showLetterPhonetic}}">{{letters[currentLetterIndex].phonetic}}</view>

        <!-- 示例单词 -->
        <view class="letter-word-section">
          <view class="letter-word">{{letters[currentLetterIndex].word}}</view>
          <view class="letter-word-meaning">{{letters[currentLetterIndex].wordMeaning}}</view>
          <view class="letter-word-phonetic" wx:if="{{showLetterPhonetic}}">{{letters[currentLetterIndex].wordPhonetic}}</view>
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="actions">
        <view class="action-btn" bindtap="prevLetter">上一个</view>
        <view class="action-btn speak" bindtap="speakLetter">🔊 跟读</view>
        <view class="action-btn primary" bindtap="markLetterLearned">
          {{letters[currentLetterIndex].learned ? '已学会 ✓' : '学会了'}}
        </view>
        <view class="action-btn" bindtap="nextLetter">下一个</view>
      </view>

      <!-- 音标开关 -->
      <view class="toggle-row">
        <view class="toggle-btn" bindtap="toggleLetterPhonetic">
          {{showLetterPhonetic ? '隐藏音标' : '显示音标'}}
        </view>
      </view>
    </view>
  </view>

  <!-- 单词学习 -->
  <view wx:if="{{mode === 'words'}}">
    <!-- 返回按钮 -->
    <view class="back-btn" bindtap="backToSelect">‹ 返回选择</view>

    <!-- 进度 -->
    <view class="progress-bar">
      <view class="progress-text">已学 {{learnedWordCount}}/{{words.length}}</view>
      <view class="progress-track">
        <view class="progress-fill" style="width: {{learnedWordCount / words.length * 100}}%;"></view>
      </view>
    </view>

    <!-- 单词卡片 -->
    <view class="word-container" wx:if="{{words.length > 0}}">
      <view class="word-card">
        <view class="word-english">{{words[currentWordIndex].word}}</view>
        <view class="word-phonetic" wx:if="{{showWordPhonetic}}">{{words[currentWordIndex].phonetic}}</view>
        <view class="word-chinese">{{words[currentWordIndex].meaning}}</view>
        <view class="word-category">{{words[currentWordIndex].category}}</view>
      </view>

      <!-- 操作按钮 -->
      <view class="actions">
        <view class="action-btn" bindtap="prevWord">上一个</view>
        <view class="action-btn speak" bindtap="speakWord">🔊 跟读</view>
        <view class="action-btn primary" bindtap="markWordLearned">
          {{words[currentWordIndex].learned ? '已学会 ✓' : '学会了'}}
        </view>
        <view class="action-btn" bindtap="nextWord">下一个</view>
      </view>

      <!-- 音标开关 -->
      <view class="toggle-row">
        <view class="toggle-btn" bindtap="toggleWordPhonetic">
          {{showWordPhonetic ? '隐藏音标' : '显示音标'}}
        </view>
      </view>
    </view>
  </view>
</view>
