<!-- 画画页面 -->
<view class="draw-container">
  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>
  <!-- 顶部工具栏 -->
  <view class="toolbar" style="padding-right: {{capsuleRight}}px;">
    <view class="tool-left">
      <view class="tool-btn" bindtap="goBack">
        <text>← 返回</text>
      </view>
    </view>

    <view class="tool-center">
      <text class="tool-title">{{canvasTitle}}</text>
    </view>

    <view class="tool-right">
      <view class="tool-btn" bindtap="toggleDrawingMusic" hover-class="tool-btn-hover">
        <text>{{drawingMusicEnabled ? '🎵' : '🔇'}}</text>
      </view>
      <view class="tool-btn" bindtap="choosePhoto" hover-class="tool-btn-hover">
        <text>📷</text>
      </view>
      <view class="tool-btn" bindtap="undoAction" hover-class="tool-btn-hover">
        <text>↩️</text>
      </view>
      <view class="tool-btn" bindtap="clearCanvas" hover-class="tool-btn-hover">
        <text>🗑️</text>
      </view>
      <view class="tool-btn" bindtap="saveDrawing" hover-class="tool-btn-hover">
        <text>💾</text>
      </view>
    </view>
  </view>

  <!-- 画布区域 -->
  <view class="canvas-area" id="canvasArea">
    <!-- 画布 -->
    <canvas
      class="drawing-canvas"
      type="2d"
      id="drawingCanvas"
      disable-scroll="true"
      bindtouchstart="onCanvasTouchStart"
      bindtouchmove="onCanvasTouchMove"
      bindtouchend="onCanvasTouchEnd"
    />

    <!-- 贴纸图层（仅贴纸模式下拦截触摸，其他模式穿透） -->
    <view
      wx:if="{{stickerOverlays.length > 0 && currentMode === 'sticker'}}"
      class="sticker-overlay"
      catchtouchstart="onStickerTouchStart"
      catchtouchmove="onStickerTouchMove"
      catchtouchend="onStickerTouchEnd"
    >
      <view
        wx:for="{{stickerOverlays}}"
        wx:key="id"
        class="sticker-layer-item {{activeStickerId === item.id ? 'sticker-active' : ''}}"
        style="left: {{item.x * 100}}%; top: {{item.y * 100}}%; font-size: {{item.size}}px; transform: translate(-50%, -50%) rotate({{item.rotation || 0}}deg);"
        data-id="{{item.id}}"
        catchtap="onStickerTap"
      >
        {{item.emoji}}
      </view>
    </view>

    <!-- 贴纸操作提示 -->
    <view wx:if="{{stickerOverlays.length > 0 && currentMode === 'sticker'}}" class="sticker-hint">
      <text>👆 拖拽移动 · 双指缩放/旋转 · 点击选中</text>
    </view>

    <!-- 确认贴纸按钮 -->
    <view wx:if="{{stickerOverlays.length > 0 && currentMode === 'sticker'}}" class="sticker-confirm-bar">
      <view class="sticker-confirm-btn" bindtap="cancelAllStickers">
        <text>✕ 取消</text>
      </view>
      <view class="sticker-confirm-btn" bindtap="deleteActiveSticker">
        <text>🗑️ 删除选中</text>
      </view>
      <view class="sticker-confirm-btn primary" bindtap="confirmStickers">
        <text>✓ 确认贴纸</text>
      </view>
    </view>
  </view>

  <!-- 底部工具栏 -->
  <view class="bottom-bar">
    <!-- 模式切换 -->
    <view class="mode-switch">
      <view
        class="mode-btn {{currentMode === 'draw' ? 'active' : ''}}"
        bindtap="switchMode"
        data-mode="draw"
      >
        <text>✏️ 画笔</text>
      </view>
      <view
        class="mode-btn {{currentMode === 'eraser' ? 'active' : ''}}"
        bindtap="switchMode"
        data-mode="eraser"
      >
        <text>🧹 橡皮</text>
      </view>
      <view
        class="mode-btn {{currentMode === 'sticker' ? 'active' : ''}}"
        bindtap="switchMode"
        data-mode="sticker"
      >
        <text>⭐ 贴纸</text>
      </view>
    </view>

    <!-- 贴纸面板（贴纸模式下显示） -->
    <view wx:if="{{currentMode === 'sticker'}}" class="sticker-panel">
      <scroll-view scroll-x class="sticker-scroll">
        <view class="sticker-list">
          <view
            wx:for="{{stickers}}"
            wx:key="index"
            class="sticker-item {{selectedSticker === item ? 'active' : ''}}"
            bindtap="selectSticker"
            data-sticker="{{item}}"
          >
            <text class="sticker-emoji">{{item}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 画笔粗细（画笔/橡皮模式下显示） -->
    <view wx:if="{{currentMode !== 'sticker'}}" class="brush-sizes">
      <view
        wx:for="{{brushSizes}}"
        wx:key="index"
        class="size-dot {{currentSize === item ? 'active' : ''}}"
        style="width: {{item * 2 + 10}}rpx; height: {{item * 2 + 10}}rpx;"
        bindtap="selectSize"
        data-size="{{item}}"
      />
    </view>

    <!-- 颜色选择（画笔模式下显示） -->
    <scroll-view wx:if="{{currentMode === 'draw'}}" scroll-x class="color-scroll">
      <view class="color-list">
        <view
          wx:for="{{colors}}"
          wx:key="index"
          class="color-item {{currentColor === item ? 'active' : ''}}"
          style="background-color: {{item}};"
          bindtap="selectColor"
          data-color="{{item}}"
        >
          <view wx:if="{{currentColor === item}}" class="color-check">✓</view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
