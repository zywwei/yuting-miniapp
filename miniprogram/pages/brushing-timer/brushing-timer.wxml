<!-- 刷牙计时页 - 梦幻可爱版 -->
<view class="timer-container" style="background: {{themeBg}};">
  <!-- 背景装饰 - 闪烁星星 -->
  <view class="bg-stars">
    <view class="star star-1">⭐</view>
    <view class="star star-2">✨</view>
    <view class="star star-3">💫</view>
    <view class="star star-4">⭐</view>
    <view class="star star-5">✨</view>
    <view class="star star-6">💫</view>
    <view class="star star-7">⭐</view>
    <view class="star star-8">✨</view>
  </view>
  <!-- 背景装饰 - 飘动云朵 -->
  <view class="bg-clouds">
    <view class="cloud cloud-1">☁️</view>
    <view class="cloud cloud-2">☁️</view>
    <view class="cloud cloud-3">☁️</view>
  </view>

  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 顶部工具栏 -->
  <view class="toolbar" style="padding-right: {{capsuleRight}}px;">
    <view class="tool-left">
      <view class="tool-btn" bindtap="goBack">
        <text>← 返回</text>
      </view>
    </view>
    <view class="tool-center">
      <text class="tool-title">{{timeOfDay === 'morning' ? '☀️ 早上好' : '🌙 晚上好'}}，钰婷！</text>
    </view>
    <view class="tool-right">
      <!-- 积分显示 -->
      <view class="points-badge" wx:if="{{brushPoints > 0}}">
        <text>⭐ {{brushPoints}}</text>
      </view>
      <view class="tool-btn" bindtap="toggleSound">
        <text>{{soundEnabled ? '🔊' : '🔇'}}</text>
      </view>
    </view>
  </view>

  <!-- ===== 主视觉区 ===== -->
  <view class="main-visual">
    <!-- 左右小动物加油 -->
    <view class="cheer-left {{isRunning ? 'cheer-active' : ''}}" bindtap="onTapCat">
      <text class="cheer-emoji">🐱</text>
      <text class="cheer-bubble">{{leftCheer}}</text>
    </view>
    <view class="cheer-right {{isRunning ? 'cheer-active' : ''}}" bindtap="onTapRabbit">
      <text class="cheer-emoji">🐰</text>
      <text class="cheer-bubble">{{rightCheer}}</text>
    </view>

    <!-- 中心区域：牙齿 + 进度环 -->
    <view class="center-area">
      <!-- 大大的可爱牙齿角色 -->
      <view class="tooth-character {{isRunning ? 'tooth-happy' : ''}} {{isCompleted ? 'tooth-excited' : ''}}"
            bindtap="onTapTooth">
        <view class="tooth-body">
          <text class="tooth-emoji">{{toothFace}}</text>
        </view>
        <!-- 牙齿头顶的皇冠 -->
        <view class="tooth-crown" wx:if="{{isCompleted}}">👑</view>
        <!-- 脸颊红晕 -->
        <view class="tooth-blush left" wx:if="{{isRunning}}"></view>
        <view class="tooth-blush right" wx:if="{{isRunning}}"></view>
      </view>

      <!-- 可爱的进度环 -->
      <view class="progress-ring-wrap" bindtap="onTapRing">
        <view class="ring-bg-circle"></view>
        <view class="ring-fill-circle" style="background: conic-gradient({{ringColor}} {{overallProgress * 3.6}}deg, transparent 0deg);"></view>
        <view class="ring-inner-circle">
          <view class="ring-center-content">
            <text class="ring-time">{{minutes}}:{{seconds}}</text>
            <text class="ring-hint" wx:if="{{!isCompleted}}">{{isRunning ? '加油刷！' : '点击开始'}}</text>
            <text class="ring-hint ring-done" wx:if="{{isCompleted}}">完成啦！</text>
          </view>
        </view>
        <!-- 进度环装饰 -->
        <view class="ring-deco ring-deco-1" wx:if="{{isRunning}}">✨</view>
        <view class="ring-deco ring-deco-2" wx:if="{{isRunning}}">⭐</view>
      </view>
    </view>

    <!-- 泡泡 -->
    <view wx:if="{{isRunning}}" class="bubble-area">
      <view wx:for="{{bubbles}}" wx:key="id"
            class="bubble-item"
            style="left:{{item.x}}%;animation-delay:{{item.delay}}s;font-size:{{item.size}}rpx;">
        {{item.emoji}}
      </view>
    </view>

    <!-- 公主角色（随机位置出现） -->
    <view wx:if="{{showPrincess}}" class="princess-character" bindtap="onTapPrincess"
          style="left: {{princessX}}%; top: {{princessY}}%;">
      <text class="princess-emoji">{{princessEmoji}}</text>
      <text class="princess-bubble" style="background: {{princessColor}};">{{princessBubble}}</text>
    </view>

    <!-- 脏东西（刷牙小游戏） -->
    <view wx:for="{{dirtySpots}}" wx:key="id" wx:for-item="dirty"
          class="dirty-spot" bindtap="onTapDirty"
          data-id="{{dirty.id}}"
          style="left: {{dirty.x}}%; top: {{dirty.y}}%;">
      <text class="dirty-emoji">{{dirty.emoji}}</text>
      <text class="dirty-points">+{{dirty.points}}</text>
    </view>

    <!-- 刷掉特效 -->
    <view wx:if="{{showCleanEffect}}" class="clean-effect"
          style="left: {{cleanEffectX}}%; top: {{cleanEffectY}}%;">
      <text class="clean-text">{{cleanEffectText}}</text>
    </view>

    <!-- 积分动画 -->
    <view wx:if="{{showPoints}}" class="points-popup">
      <text class="points-text">{{pointsText}}</text>
    </view>

    <!-- 刷牙小知识 -->
    <view wx:if="{{showTip}}" class="tip-popup">
      <text class="tip-text">{{currentTip}}</text>
    </view>
  </view>

  <!-- ===== 区域提示 ===== -->
  <view class="area-section" wx:if="{{isRunning || isPaused}}">
    <view class="area-card">
      <view class="area-tooth-row">
        <view wx:for="{{teethArea}}" wx:key="index" wx:for-item="area"
              class="mini-tooth {{currentAreaIndex === index ? 'current' : ''}} {{completedAreas.includes(area.name) ? 'done' : ''}}">
          <text class="mini-tooth-icon">🦷</text>
          <text class="mini-tooth-label">{{area.name}}</text>
          <view wx:if="{{currentAreaIndex === index}}" class="mini-tooth-glow"></view>
        </view>
      </view>
      <view class="area-timer">
        <view class="area-timer-ring">
          <view class="area-timer-fill" style="background: conic-gradient({{areaColor}} {{areaProgress * 3.6}}deg, #eee 0deg);"></view>
          <view class="area-timer-inner">
            <text class="area-timer-num">{{areaRemaining}}</text>
          </view>
        </view>
        <text class="area-timer-label">秒</text>
      </view>
    </view>
  </view>

  <!-- ===== 奖励星星 ===== -->
  <view class="reward-section" wx:if="{{isRunning || isPaused || isCompleted}}">
    <view class="star-row">
      <view wx:for="{{rewardStars}}" wx:key="index" class="star-item {{item ? 'earned' : ''}}">
        <text class="star-emoji">{{item ? '⭐' : '☆'}}</text>
      </view>
    </view>
    <text class="reward-text">{{currentRewardText}}</text>
  </view>

  <!-- ===== 按钮 ===== -->
  <view class="btn-area">
    <view wx:if="{{!isRunning && !isPaused && !isCompleted}}" class="btn-start" bindtap="startTimer">
      <view class="btn-sparkle"></view>
      <text class="btn-icon">🪥</text>
      <text class="btn-label">开始刷牙啦！</text>
    </view>
    <view wx:if="{{isRunning}}" class="btn-pause" bindtap="pauseTimer">
      <text class="btn-icon">⏸</text>
      <text class="btn-label">暂停一下</text>
    </view>
    <view wx:if="{{isPaused && !isCompleted}}" class="btn-start" bindtap="resumeTimer">
      <view class="btn-sparkle"></view>
      <text class="btn-icon">▶</text>
      <text class="btn-label">继续刷！</text>
    </view>
    <view wx:if="{{!isRunning && !isCompleted}}" class="btn-retry" bindtap="resetTimer">
      <text>↻ 重新开始</text>
    </view>
  </view>

  <!-- ===== 完成庆祝（超级炫酷满屏效果） ===== -->
  <view wx:if="{{isCompleted}}" class="celebrate-area">
    <!-- 全屏撒花层 -->
    <view class="confetti-fullscreen">
      <!-- 彩色纸片 -->
      <view wx:for="{{confetti}}" wx:key="id" wx:if="{{item.type === 'paper'}}"
            class="confetti-paper"
            style="left:{{item.x}}%;animation-delay:{{item.delay}}s;background:{{item.color}};width:{{item.w}}rpx;height:{{item.h}}rpx;--rotation:{{item.rotation}}deg;">
      </view>
      <!-- emoji表情 -->
      <view wx:for="{{confetti}}" wx:key="id" wx:if="{{item.type === 'emoji'}}"
            class="confetti-emoji-item"
            style="left:{{item.x}}%;animation-delay:{{item.delay}}s;font-size:{{item.size}}rpx;">
        {{item.emoji}}
      </view>
      <!-- 大号特效emoji -->
      <view wx:for="{{confetti}}" wx:key="id" wx:if="{{item.type === 'big'}}"
            class="confetti-big"
            style="left:{{item.x}}%;animation-delay:{{item.delay}}s;font-size:{{item.size}}rpx;">
        {{item.emoji}}
      </view>
    </view>

    <!-- 光芒效果 -->
    <view class="rays-container">
      <view class="ray ray-1"></view>
      <view class="ray ray-2"></view>
      <view class="ray ray-3"></view>
      <view class="ray ray-4"></view>
      <view class="ray ray-5"></view>
      <view class="ray ray-6"></view>
    </view>

    <!-- 完成弹窗 -->
    <view class="done-box">
      <view class="done-header">
        <text class="done-emoji-big">🎉</text>
        <text class="done-emoji-big">🦷</text>
        <text class="done-emoji-big">🎉</text>
      </view>
      <text class="done-title">钰婷太棒啦！</text>
      <view class="done-stars-row">
        <text wx:for="{{completedStarsArr}}" wx:key="index" class="done-star"
              style="animation-delay:{{index * 0.15}}s">⭐</text>
      </view>
      <text class="done-msg">{{completedText}}</text>
      <view class="done-points" wx:if="{{brushPoints > 0}}">
        <text>🏆 本次积分：{{brushPoints}}</text>
      </view>
      <view class="btn-checkin" bindtap="goCheckIn">📷 拍照打卡</view>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
