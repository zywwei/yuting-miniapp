/* 刷牙计时页 - 梦幻可爱版（粉色主色调） */
.timer-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFE4EC 0%, #FFF0F5 30%, #FFF5F8 60%, #FFEEF2 100%);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* ===== 背景装饰（粉色主题） ===== */
.bg-stars {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
}

.star {
  position: absolute;
  animation: twinkle 2s ease-in-out infinite;
  opacity: 0.5;
  color: #FFB6C1;
}

.star-1 { top: 10%; left: 5%; font-size: 24rpx; animation-delay: 0s; }
.star-2 { top: 15%; right: 10%; font-size: 20rpx; animation-delay: 0.5s; }
.star-3 { top: 25%; left: 15%; font-size: 16rpx; animation-delay: 1s; }
.star-4 { top: 35%; right: 20%; font-size: 28rpx; animation-delay: 1.5s; }
.star-5 { top: 50%; left: 8%; font-size: 18rpx; animation-delay: 0.3s; }
.star-6 { top: 60%; right: 5%; font-size: 22rpx; animation-delay: 0.8s; }
.star-7 { top: 75%; left: 20%; font-size: 14rpx; animation-delay: 1.2s; }
.star-8 { top: 85%; right: 15%; font-size: 26rpx; animation-delay: 0.6s; }

@keyframes twinkle {
  0%, 100% { opacity: 0.2; transform: scale(0.8); }
  50% { opacity: 0.8; transform: scale(1.2); }
}

.bg-clouds {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
}

.cloud {
  position: absolute;
  font-size: 80rpx;
  opacity: 0.15;
  animation: float 25s linear infinite;
  filter: blur(2px);
}

.cloud-1 { top: 8%; left: -15%; animation-duration: 30s; }
.cloud-2 { top: 22%; left: -20%; animation-duration: 35s; animation-delay: 8s; }
.cloud-3 { top: 38%; left: -15%; animation-duration: 28s; animation-delay: 15s; }

@keyframes float {
  0% { transform: translateX(0); }
  100% { transform: translateX(130vw); }
}

/* ===== 工具栏 ===== */
.status-bar { width: 100%; background: linear-gradient(135deg, #FF9AAB, #FF6B8A); }
.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  position: relative;
  z-index: 10;
}
.tool-left { display: flex; align-items: center; }
.tool-btn {
  padding: 12rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.25);
  color: white;
  font-size: 24rpx;
  backdrop-filter: blur(10px);
}
.tool-btn:active { background: rgba(255,255,255,0.4); }
.tool-center { flex: 1; text-align: center; }
.tool-title { color: white; font-size: 30rpx; font-weight: bold; text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.1); }
.tool-right { display: flex; align-items: center; gap: 12rpx; }

/* 积分徽章 */
.points-badge {
  background: linear-gradient(135deg, #FFD700, #FFA000);
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(255, 160, 0, 0.4);
  animation: badgePulse 2s ease-in-out infinite;
}

@keyframes badgePulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

/* ===== 主视觉区（四角+中心） ===== */
.main-visual {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0;
  flex: 1;
  z-index: 1;
}

/* 四角元素通用 */
.corner {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  z-index: 2;
  transition: all 0.3s;
}

.corner-tl { top: 16rpx; left: 24rpx; }
.corner-tr { top: 16rpx; right: 24rpx; }
.corner-bl { bottom: 16rpx; left: 24rpx; }
.corner-br { bottom: 16rpx; right: 24rpx; }

.corner.cheer-active {
  animation: cornerBounce 2s ease-in-out infinite;
}

.corner-tr.cheer-active { animation-delay: 0.3s; }

@keyframes cornerBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.corner-emoji {
  font-size: 80rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.12));
}

.corner-bubble {
  font-size: 20rpx;
  color: #FF6B8A;
  font-weight: bold;
  background: rgba(255, 255, 255, 0.9);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 154, 171, 0.15);
  white-space: nowrap;
}

/* 右下：陪伴小公主 */
.companion-mini {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  animation: miniAppear 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes miniAppear {
  0% { transform: scale(0) rotate(-20deg); opacity: 0; }
  70% { transform: scale(1.1) rotate(5deg); opacity: 1; }
  100% { transform: scale(1) rotate(0deg); opacity: 1; }
}

.companion-mini-emoji {
  font-size: 80rpx;
  animation: companionFloat 2s ease-in-out infinite;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.15));
}

@keyframes companionFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

.companion-mini-bubble {
  font-size: 18rpx;
  color: #FF6B8A;
  font-weight: bold;
  background: rgba(255, 255, 255, 0.95);
  padding: 6rpx 14rpx;
  border-radius: 18rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 154, 171, 0.2);
  white-space: nowrap;
}

/* 6区牙齿（2行3列，占满宽度） */
.tooth-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(2, 1fr);
  gap: 10rpx;
  padding: 16rpx;
  margin: 0 24rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 32rpx;
  backdrop-filter: blur(12px);
  box-shadow: 0 4rpx 16rpx rgba(255, 154, 171, 0.2);
}

.tooth-zone {
  position: relative;
  height: 120rpx;
  background: linear-gradient(180deg, #FFFDE7 0%, #FFF9C4 100%);
  border: 3rpx solid;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 当前正在刷的区域：脉冲发光 */
.tooth-zone.zone-current {
  background: linear-gradient(180deg, #FFF0F5 0%, #FFE4EC 100%);
  transform: scale(1.08);
  z-index: 2;
}

.zone-pulse {
  animation: zonePulse 1s ease-in-out infinite;
}

@keyframes zonePulse {
  0%, 100% { box-shadow: 0 0 16rpx rgba(255, 154, 171, 0.45); }
  50% { box-shadow: 0 0 36rpx rgba(255, 154, 171, 0.75); }
}

/* 已刷干净的区域：雪白闪亮 */
.tooth-zone.zone-clean {
  background: linear-gradient(180deg, #FFFFFF 0%, #E8F5E9 100%);
  border-color: #81C784 !important;
  transform: scale(1);
}

.zone-tooth-body {
  position: relative;
  z-index: 1;
}

.zone-tooth-emoji {
  font-size: 40rpx;
  display: block;
  transition: transform 0.4s;
}

.tooth-zone.zone-clean .zone-tooth-emoji {
  animation: cleanToothPop 0.6s ease-out;
}

@keyframes cleanToothPop {
  0% { transform: scale(0.5) rotate(-10deg); }
  60% { transform: scale(1.3) rotate(5deg); }
  100% { transform: scale(1) rotate(0deg); }
}

/* 细菌层 */
.zone-germs {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 2;
  pointer-events: none;
}

.zone-germ {
  position: absolute;
  font-size: 22rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0,0,0,0.15));
}

.germ-wiggle {
  animation: germWiggle 1.2s ease-in-out infinite;
}

@keyframes germWiggle {
  0%, 100% { transform: rotate(-12deg) scale(1); }
  50% { transform: rotate(12deg) scale(1.15); }
}

.germ-flee {
  animation: germFlee 0.7s ease-out forwards;
}

@keyframes germFlee {
  0% { transform: translate(0, 0) scale(1); opacity: 1; }
  40% { transform: translate(0, -30rpx) scale(1.1); opacity: 1; }
  100% { transform: translate(0, -120rpx) scale(0.3); opacity: 0; }
}

/* 闪亮特效 */
.zone-shine {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 40rpx;
  z-index: 3;
  animation: shinePop 0.8s ease-out forwards;
  pointer-events: none;
}

@keyframes shinePop {
  0% { transform: translate(-50%, -50%) scale(0) rotate(-45deg); opacity: 0; }
  50% { transform: translate(-50%, -50%) scale(1.6) rotate(0deg); opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(1) rotate(0deg); opacity: 0.85; }
}

/* 小皇冠 */
.zone-crown {
  position: absolute;
  top: -4rpx;
  right: -2rpx;
  font-size: 20rpx;
  z-index: 4;
  animation: miniCrownBounce 1s ease-in-out infinite;
}

@keyframes miniCrownBounce {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-4rpx) rotate(12deg); }
}

/* 区域名称标签 */
.zone-label {
  position: absolute;
  bottom: 4rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 18rpx;
  color: #999;
  font-weight: 500;
  z-index: 3;
  pointer-events: none;
}

.tooth-zone.zone-current .zone-label {
  color: #FF6B8A;
  font-weight: bold;
}

.tooth-zone.zone-clean .zone-label {
  color: #81C784;
  font-weight: bold;
}

/* 当前区域倒计时 */
.zone-timer {
  position: absolute;
  top: 2rpx;
  right: 4rpx;
  z-index: 5;
  pointer-events: none;
}

.zone-timer-num {
  font-size: 22rpx;
  font-weight: bold;
  color: #FF6B8A;
  background: rgba(255, 255, 255, 0.85);
  padding: 2rpx 8rpx;
  border-radius: 12rpx;
  line-height: 1;
  box-shadow: 0 2rpx 6rpx rgba(255, 154, 171, 0.2);
}

/* 已完成勾号 */
.zone-check {
  position: absolute;
  top: 2rpx;
  left: 4rpx;
  font-size: 20rpx;
  color: #81C784;
  font-weight: bold;
  z-index: 5;
  pointer-events: none;
  animation: checkPop 0.3s ease-out;
}

@keyframes checkPop {
  0% { transform: scale(0); }
  60% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

/* 进度环 */
.progress-ring-wrap {
  position: relative;
  width: 440rpx;
  height: 440rpx;
  z-index: 3;
}

.ring-bg-circle {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(255, 228, 236, 0.6);
  backdrop-filter: blur(10px);
}

.ring-fill-circle {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  transition: background 0.5s;
}

.ring-inner-circle {
  position: absolute;
  top: 16rpx; left: 16rpx; right: 16rpx; bottom: 16rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 8rpx 32rpx rgba(255, 154, 171, 0.25);
  backdrop-filter: blur(20px);
}

.ring-center-content {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ring-time {
  font-size: 88rpx;
  font-weight: bold;
  color: #FF6B8A;
  font-family: 'Courier New', monospace;
  text-shadow: 0 2rpx 4rpx rgba(255, 107, 138, 0.2);
}

.ring-hint {
  font-size: 28rpx;
  color: #FF9AAB;
  margin-top: 8rpx;
  font-weight: 500;
}

.ring-done {
  color: #81C784;
  font-weight: bold;
}

/* 进度环装饰 */
.ring-deco {
  position: absolute;
  font-size: 32rpx;
  animation: decoFloat 3s ease-in-out infinite;
}

.ring-deco-1 { top: -10rpx; right: 20rpx; animation-delay: 0s; }
.ring-deco-2 { bottom: -10rpx; left: 20rpx; animation-delay: 1.5s; }

@keyframes decoFloat {
  0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.7; }
  50% { transform: translateY(-10rpx) rotate(15deg); opacity: 1; }
}

/* 泡泡 */
.bubble-area {
  position: absolute;
  top: -40rpx;
  left: -60rpx;
  width: 300rpx;
  height: 300rpx;
  pointer-events: none;
  z-index: 0;
}

.bubble-item {
  position: absolute;
  animation: bubbleRise 3s ease-out infinite;
  opacity: 0;
}

@keyframes bubbleRise {
  0% { opacity: 0; transform: translateY(40rpx) scale(0.5); }
  20% { opacity: 0.9; }
  100% { opacity: 0; transform: translateY(-80rpx) scale(1.3); }
}

/* 公主角色 */
.princess-character {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: princessAppear 0.5s ease-out;
  z-index: 10;
}

.princess-character:active {
  transform: translate(-50%, -50%) scale(0.95);
}

@keyframes princessAppear {
  0% { transform: translate(-50%, -50%) scale(0) rotate(-180deg); opacity: 0; }
  50% { transform: translate(-50%, -50%) scale(1.2) rotate(10deg); }
  100% { transform: translate(-50%, -50%) scale(1) rotate(0deg); opacity: 1; }
}

.princess-emoji {
  font-size: 88rpx;
  animation: princessFloat 2s ease-in-out infinite;
  filter: drop-shadow(0 6rpx 12rpx rgba(0,0,0,0.2));
}

@keyframes princessFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.princess-bubble {
  font-size: 22rpx;
  color: white;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  margin-top: 6rpx;
  font-weight: bold;
  animation: bubblePop 0.3s ease-out;
  white-space: nowrap;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

/* 刷牙前小游戏：瞌睡细菌 */
.pre-game-area {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 8;
  pointer-events: none;
}

.pre-germ {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: auto;
}

.pre-germ-wiggle {
  animation: preGermWiggle 2s ease-in-out infinite;
}

@keyframes preGermWiggle {
  0%, 100% { transform: translate(-50%, -50%) rotate(-8deg) scale(1); }
  50% { transform: translate(-50%, -50%) rotate(8deg) scale(1.1); }
}

.pre-germ-flee {
  animation: preGermFlee 0.7s ease-out forwards;
}

@keyframes preGermFlee {
  0% { transform: translate(-50%, -50%) scale(1) rotate(0deg); opacity: 1; }
  100% { transform: translate(-50%, -150%) scale(0.3) rotate(360deg); opacity: 0; }
}

.pre-germ-emoji {
  font-size: 64rpx;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.2));
}

.pre-hint {
  position: absolute;
  bottom: 200rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(255, 255, 255, 0.95);
  color: #FF6B8A;
  font-size: 28rpx;
  font-weight: bold;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 154, 171, 0.3);
  animation: preHintPop 0.5s ease-out;
  pointer-events: none;
}

@keyframes preHintPop {
  0% { transform: translateX(-50%) scale(0); }
  60% { transform: translateX(-50%) scale(1.1); }
  100% { transform: translateX(-50%) scale(1); }
}

/* 刷牙后贴纸 */
.zone-stickers {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 4;
  pointer-events: none;
}

.zone-sticker {
  position: absolute;
  font-size: 24rpx;
  animation: stickerPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  filter: drop-shadow(0 2rpx 4rpx rgba(0,0,0,0.15));
}

@keyframes stickerPop {
  0% { transform: scale(0) rotate(-45deg); }
  70% { transform: scale(1.4) rotate(10deg); }
  100% { transform: scale(1) rotate(0deg); }
}

.sticker-section {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed rgba(255, 154, 171, 0.3);
}

.sticker-title {
  display: block;
  font-size: 26rpx;
  color: #FF6B8A;
  margin-bottom: 16rpx;
  font-weight: bold;
}

.sticker-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.sticker-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(255, 154, 171, 0.25);
  transition: transform 0.15s;
}

.sticker-btn:active { transform: scale(0.9); }

.sticker-emoji { font-size: 40rpx; }

.sticker-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.btn-save-decoration {
  display: inline-block;
  background: linear-gradient(135deg, #81C784, #66BB6A);
  color: white;
  padding: 22rpx 56rpx;
  border-radius: 60rpx;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 10rpx 30rpx rgba(129, 199, 132, 0.4);
  transition: transform 0.2s;
}

.btn-save-decoration:active { transform: scale(0.95); }

/* 脏东西 */
.dirty-spot {
  position: absolute;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 8;
  animation: dirtyAppear 0.4s ease-out;
  cursor: pointer;
}

.dirty-spot:active {
  transform: translate(-50%, -50%) scale(0.8);
}

@keyframes dirtyAppear {
  0% { transform: translate(-50%, -50%) scale(0) rotate(-180deg); opacity: 0; }
  60% { transform: translate(-50%, -50%) scale(1.2) rotate(10deg); }
  100% { transform: translate(-50%, -50%) scale(1) rotate(0deg); opacity: 1; }
}

.dirty-emoji {
  font-size: 60rpx;
  animation: dirtyWobble 1.5s ease-in-out infinite;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.2));
}

@keyframes dirtyWobble {
  0%, 100% { transform: rotate(-8deg); }
  50% { transform: rotate(8deg); }
}

.dirty-points {
  font-size: 20rpx;
  color: #FFD700;
  font-weight: bold;
  background: rgba(0, 0, 0, 0.7);
  padding: 4rpx 10rpx;
  border-radius: 12rpx;
  margin-top: -6rpx;
}

/* 刷掉特效 */
.clean-effect {
  position: absolute;
  transform: translate(-50%, -50%);
  z-index: 15;
  animation: cleanPop 1.5s ease-out forwards;
  pointer-events: none;
}

.clean-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #4CAF50;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
  white-space: nowrap;
}

@keyframes cleanPop {
  0% { transform: translate(-50%, -50%) scale(0); opacity: 0; }
  30% { transform: translate(-50%, -50%) scale(1.3); opacity: 1; }
  50% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  100% { transform: translate(-50%, -150%) scale(1); opacity: 0; }
}

/* 积分弹出动画 */
.points-popup {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 20;
  animation: pointsPop 2.5s ease-out forwards;
  pointer-events: none;
}

.points-text {
  font-size: 52rpx;
  font-weight: bold;
  color: #FFD700;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

@keyframes pointsPop {
  0% { transform: translate(-50%, -50%) scale(0); opacity: 0; }
  20% { transform: translate(-50%, -50%) scale(1.3); opacity: 1; }
  40% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  100% { transform: translate(-50%, -150%) scale(1); opacity: 0; }
}

/* 刷牙小知识 */
.tip-popup {
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
  animation: tipSlide 2.5s ease-out forwards;
  pointer-events: none;
}

.tip-text {
  background: rgba(0, 0, 0, 0.75);
  color: white;
  padding: 14rpx 28rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  white-space: nowrap;
  backdrop-filter: blur(10px);
}

@keyframes tipSlide {
  0% { transform: translateX(-50%) translateY(20rpx); opacity: 0; }
  20% { transform: translateX(-50%) translateY(0); opacity: 1; }
  80% { transform: translateX(-50%) translateY(0); opacity: 1; }
  100% { transform: translateX(-50%) translateY(-20rpx); opacity: 0; }
}

/* ===== 奖励 ===== */
.reward-section { padding: 8rpx 40rpx; text-align: center; }
.star-row { display: flex; justify-content: center; gap: 20rpx; margin-bottom: 6rpx; }
.star-item { transition: transform 0.3s; }
.star-emoji { font-size: 40rpx; opacity: 0.25; transition: opacity 0.3s; }
.star-item.earned .star-emoji { opacity: 1; animation: starPop 0.5s ease-out; }

@keyframes starPop {
  0% { transform: scale(0.3); }
  50% { transform: scale(1.5); }
  100% { transform: scale(1); }
}

.reward-text { font-size: 28rpx; color: #FF6B8A; font-weight: bold; }

/* ===== 按钮 ===== */
.btn-area {
  padding: 24rpx 50rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.btn-start {
  width: 100%;
  padding: 32rpx 0;
  text-align: center;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: white;
  border-radius: 64rpx;
  font-size: 36rpx;
  font-weight: bold;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(255, 107, 138, 0.4);
  transition: transform 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-start:active { transform: scale(0.96); }

.btn-icon { font-size: 40rpx; }
.btn-label { font-size: 36rpx; }

.btn-sparkle {
  position: absolute;
  top: -50%; left: -50%;
  width: 200%; height: 200%;
  background: linear-gradient(45deg, transparent 40%, rgba(255,255,255,0.2) 50%, transparent 60%);
  animation: sparkleMove 3s linear infinite;
}

@keyframes sparkleMove {
  0% { transform: translateX(-100%) rotate(25deg); }
  100% { transform: translateX(100%) rotate(25deg); }
}

.btn-pause {
  width: 100%;
  padding: 32rpx 0;
  text-align: center;
  background: linear-gradient(135deg, #FFB74D, #FF9800);
  color: white;
  border-radius: 64rpx;
  font-size: 36rpx;
  font-weight: bold;
  box-shadow: 0 12rpx 36rpx rgba(255, 152, 0, 0.35);
  transition: transform 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-pause:active { transform: scale(0.96); }

.btn-retry {
  padding: 12rpx 40rpx;
  color: #bbb;
  font-size: 26rpx;
}

/* ===== 完成庆祝（超级炫酷满屏效果） ===== */
.celebrate-area {
  display: flex;
  align-items: center;
  justify-content: center;
  animation: celebrateFadeIn 0.3s ease-out;
  background: rgba(255, 240, 245, 0.6);
  backdrop-filter: blur(6px);
}

@keyframes celebrateFadeIn {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

/* 全屏撒花层 */
.confetti-fullscreen {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  overflow: hidden;
  z-index: 1;
}

/* 彩色纸片 */
.confetti-paper {
  position: absolute;
  top: -30rpx;
  border-radius: 4rpx;
  animation: paperDrop 4s ease-in forwards;
  transform: rotate(var(--rotation, 0deg));
}

@keyframes paperDrop {
  0% {
    transform: translateY(0) rotate(0deg) scale(1);
    opacity: 1;
  }
  50% {
    opacity: 1;
  }
  100% {
    transform: translateY(110vh) rotate(1080deg) scale(0.5);
    opacity: 0;
  }
}

/* emoji表情 */
.confetti-emoji-item {
  position: absolute;
  top: -50rpx;
  animation: emojiDrop 3.5s ease-in forwards;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.2));
}

@keyframes emojiDrop {
  0% {
    transform: translateY(0) scale(0) rotate(-180deg);
    opacity: 0;
  }
  20% {
    transform: translateY(10vh) scale(1.2) rotate(0deg);
    opacity: 1;
  }
  40% {
    transform: translateY(30vh) scale(1) rotate(10deg);
    opacity: 1;
  }
  100% {
    transform: translateY(110vh) scale(0.8) rotate(360deg);
    opacity: 0;
  }
}

/* 大号特效emoji */
.confetti-big {
  position: absolute;
  top: 30%;
  animation: bigEmojiPop 3s ease-out forwards;
  filter: drop-shadow(0 8rpx 16rpx rgba(0,0,0,0.3));
  z-index: 2;
}

@keyframes bigEmojiPop {
  0% {
    transform: translate(-50%, -50%) scale(0) rotate(-180deg);
    opacity: 0;
  }
  30% {
    transform: translate(-50%, -50%) scale(1.5) rotate(10deg);
    opacity: 1;
  }
  50% {
    transform: translate(-50%, -50%) scale(1) rotate(-5deg);
    opacity: 1;
  }
  70% {
    transform: translate(-50%, -50%) scale(1.1) rotate(0deg);
    opacity: 1;
  }
  100% {
    transform: translate(-50%, -100%) scale(0.5) rotate(30deg);
    opacity: 0;
  }
}

/* 光芒效果 */
.rays-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  height: 600rpx;
  pointer-events: none;
  z-index: 0;
}

.ray {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 4rpx;
  height: 300rpx;
  background: linear-gradient(to top, rgba(255, 215, 0, 0), rgba(255, 215, 0, 0.8));
  transform-origin: bottom center;
  animation: rayPulse 2s ease-in-out infinite;
}

.ray-1 { transform: translate(-50%, -100%) rotate(0deg); animation-delay: 0s; }
.ray-2 { transform: translate(-50%, -100%) rotate(60deg); animation-delay: 0.3s; }
.ray-3 { transform: translate(-50%, -100%) rotate(120deg); animation-delay: 0.6s; }
.ray-4 { transform: translate(-50%, -100%) rotate(180deg); animation-delay: 0.9s; }
.ray-5 { transform: translate(-50%, -100%) rotate(240deg); animation-delay: 1.2s; }
.ray-6 { transform: translate(-50%, -100%) rotate(300deg); animation-delay: 1.5s; }

@keyframes rayPulse {
  0%, 100% { opacity: 0.3; height: 200rpx; }
  50% { opacity: 1; height: 350rpx; }
}

/* 完成弹窗 */
.done-box {
  position: relative;
  background: rgba(255, 245, 248, 0.98);
  border-radius: 48rpx;
  padding: 56rpx 48rpx;
  text-align: center;
  box-shadow:
    0 20rpx 60rpx rgba(255, 107, 138, 0.4),
    0 0 100rpx rgba(255, 154, 171, 0.2);
  animation: doneBoxPop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  backdrop-filter: blur(30px);
  border: 3rpx solid rgba(255, 182, 193, 0.5);
  z-index: 10;
  max-width: 80%;
}

@keyframes doneBoxPop {
  0% {
    transform: scale(0) rotate(-10deg);
    opacity: 0;
  }
  50% {
    transform: scale(1.1) rotate(2deg);
    opacity: 1;
  }
  100% {
    transform: scale(1) rotate(0deg);
    opacity: 1;
  }
}

.done-close {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #ccc;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
  transition: all 0.2s;
  z-index: 10;
}

.done-close:active {
  background: rgba(0, 0, 0, 0.1);
  color: #999;
  transform: scale(0.9);
}

.done-header {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.done-emoji-big {
  font-size: 72rpx;
  animation: emojiJump 0.8s ease-out infinite;
}

.done-emoji-big:nth-child(1) { animation-delay: 0s; }
.done-emoji-big:nth-child(2) { animation-delay: 0.2s; }
.done-emoji-big:nth-child(3) { animation-delay: 0.4s; }

@keyframes emojiJump {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-15rpx) scale(1.15); }
}

.done-title {
  display: block;
  font-size: 52rpx;
  font-weight: bold;
  color: #FF6B8A;
  margin: 16rpx 0;
  text-shadow: 0 3rpx 6rpx rgba(255, 107, 138, 0.3);
  animation: titlePulse 1.5s ease-in-out infinite;
}

@keyframes titlePulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.done-stars-row {
  margin: 20rpx 0;
  display: flex;
  justify-content: center;
  gap: 8rpx;
}

.done-star {
  font-size: 56rpx;
  display: inline-block;
  animation: starBounce 0.6s ease-out both;
}

@keyframes starBounce {
  0% { transform: scale(0) rotate(-180deg); opacity: 0; }
  50% { transform: scale(1.3) rotate(10deg); opacity: 1; }
  100% { transform: scale(1) rotate(0deg); opacity: 1; }
}

.done-msg {
  display: block;
  font-size: 30rpx;
  color: #666;
  margin: 20rpx 0;
  line-height: 1.6;
}

.done-points {
  background: linear-gradient(135deg, #FFD700, #FFA000);
  color: white;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: bold;
  display: inline-block;
  margin: 12rpx 0 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 160, 0, 0.3);
  animation: pointsPulse 1s ease-in-out infinite;
}

@keyframes pointsPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.08); }
}

.btn-checkin {
  display: inline-block;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: white;
  padding: 28rpx 72rpx;
  border-radius: 60rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 138, 0.4);
  transition: transform 0.2s;
}

.btn-checkin:active {
  transform: scale(0.95);
}

.safe-bottom { height: 40rpx; }
