/* 刷牙计时页 - 可爱互动版 */
.timer-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF0F6 0%, #FFE8F0 30%, #FFF8F0 70%, #FFF0E8 100%);
  overflow: hidden;
}

.status-bar { width: 100%; background: linear-gradient(135deg, #FF9AAB, #FF6B8A); }
.toolbar { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 20rpx; background: linear-gradient(135deg, #FF9AAB, #FF6B8A); }
.tool-left { display: flex; align-items: center; }
.tool-btn { padding: 12rpx 16rpx; border-radius: 16rpx; background: rgba(255,255,255,0.2); color: white; font-size: 24rpx; }
.tool-btn:active { background: rgba(255,255,255,0.4); }
.tool-center { flex: 1; text-align: center; }
.tool-title { color: white; font-size: 30rpx; font-weight: bold; }
.tool-right { display: flex; align-items: center; gap: 10rpx; }

/* ===== 主视觉区 ===== */
.main-visual {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0 10rpx;
  min-height: 500rpx;
}

/* 可爱牙齿角色 */
.tooth-character {
  position: relative;
  z-index: 5;
  margin-right: -60rpx;
}

.tooth-body {
  font-size: 140rpx;
  transition: transform 0.3s;
}

.tooth-happy {
  animation: toothBounce 1.2s ease-in-out infinite;
}

.tooth-excited {
  animation: toothJump 0.6s ease-in-out infinite;
}

@keyframes toothBounce {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  25% { transform: translateY(-12rpx) rotate(-5deg); }
  75% { transform: translateY(8rpx) rotate(5deg); }
}

@keyframes toothJump {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-20rpx) scale(1.1); }
}

.tooth-crown {
  position: absolute;
  top: -30rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 48rpx;
  animation: crownBounce 1s ease-in-out infinite;
}

@keyframes crownBounce {
  0%, 100% { transform: translateX(-50%) translateY(0) rotate(0deg); }
  50% { transform: translateX(-50%) translateY(-10rpx) rotate(10deg); }
}

/* 泡泡 */
.bubble-area {
  position: absolute;
  top: -40rpx;
  left: -60rpx;
  width: 300rpx;
  height: 300rpx;
  pointer-events: none;
}

.bubble-item {
  position: absolute;
  animation: bubbleRise 3s ease-out infinite;
  opacity: 0;
}

@keyframes bubbleRise {
  0% { opacity: 0; transform: translateY(40rpx) scale(0.5); }
  20% { opacity: 0.9; }
  100% { opacity: 0; transform: translateY(-80rpx) scale(1.3); }
}

/* 进度环 */
.progress-ring-wrap {
  position: relative;
  width: 320rpx;
  height: 320rpx;
  z-index: 3;
}

.ring-bg-circle {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
}

.ring-fill-circle {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  transition: background 0.5s;
}

.ring-inner-circle {
  position: absolute;
  top: 14rpx; left: 14rpx; right: 14rpx; bottom: 14rpx;
  border-radius: 50%;
  background: white;
  box-shadow: 0 4rpx 20rpx rgba(255, 154, 171, 0.2);
}

.ring-center-content {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ring-time {
  font-size: 60rpx;
  font-weight: bold;
  color: #FF6B8A;
  font-family: 'Courier New', monospace;
}

.ring-hint {
  font-size: 24rpx;
  color: #FF9AAB;
  margin-top: 4rpx;
}

.ring-done {
  color: #81C784;
  font-weight: bold;
}

/* 动物加油 */
.cheer-left, .cheer-right {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  opacity: 0.4;
  transition: opacity 0.3s;
  z-index: 2;
}

.cheer-left { left: 20rpx; top: 80rpx; }
.cheer-right { right: 20rpx; top: 100rpx; }

.cheer-active {
  opacity: 1;
  animation: cheerBounce 2s ease-in-out infinite;
}

.cheer-left.cheer-active { animation-delay: 0s; }
.cheer-right.cheer-active { animation-delay: 0.5s; }

@keyframes cheerBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.cheer-emoji { font-size: 56rpx; }
.cheer-bubble {
  font-size: 20rpx;
  color: #FF6B8A;
  font-weight: bold;
  background: white;
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  margin-top: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 154, 171, 0.2);
}

/* ===== 区域卡片 ===== */
.area-section { padding: 0 40rpx 10rpx; }

.area-card {
  background: white;
  border-radius: 28rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 154, 171, 0.12);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.area-tooth-row {
  flex: 1;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.mini-tooth {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 4rpx;
  border-radius: 12rpx;
  background: #F8F8F8;
  position: relative;
  transition: all 0.3s;
}

.mini-tooth.current {
  background: #FFF0F3;
  transform: scale(1.08);
}

.mini-tooth.done {
  background: #E8F5E9;
}

.mini-tooth-icon { font-size: 24rpx; }
.mini-tooth-label { font-size: 18rpx; color: #999; }
.mini-tooth.current .mini-tooth-label { color: #FF6B8A; font-weight: bold; }
.mini-tooth.done .mini-tooth-label { color: #81C784; }

.mini-tooth-glow {
  position: absolute;
  top: -2rpx; left: -2rpx; right: -2rpx; bottom: -2rpx;
  border-radius: 14rpx;
  border: 2rpx solid #FF9AAB;
  animation: miniGlow 1.5s ease-in-out infinite;
}

@keyframes miniGlow {
  0%, 100% { box-shadow: 0 0 8rpx rgba(255, 154, 171, 0.3); }
  50% { box-shadow: 0 0 16rpx rgba(255, 154, 171, 0.6); }
}

.area-timer { text-align: center; flex-shrink: 0; }
.area-timer-ring { position: relative; width: 72rpx; height: 72rpx; }
.area-timer-fill { width: 100%; height: 100%; border-radius: 50%; transition: background 0.3s; }
.area-timer-inner { position: absolute; top: 8rpx; left: 8rpx; right: 8rpx; bottom: 8rpx; border-radius: 50%; background: white; display: flex; align-items: center; justify-content: center; }
.area-timer-num { font-size: 24rpx; font-weight: bold; color: #FF6B8A; }
.area-timer-label { font-size: 18rpx; color: #999; margin-top: 4rpx; display: block; }

/* ===== 奖励 ===== */
.reward-section { padding: 6rpx 40rpx; text-align: center; }
.star-row { display: flex; justify-content: center; gap: 16rpx; margin-bottom: 4rpx; }
.star-item { transition: transform 0.3s; }
.star-emoji { font-size: 36rpx; opacity: 0.25; transition: opacity 0.3s; }
.star-item.earned .star-emoji { opacity: 1; animation: starPop 0.5s ease-out; }

@keyframes starPop {
  0% { transform: scale(0.3); }
  50% { transform: scale(1.4); }
  100% { transform: scale(1); }
}

.reward-text { font-size: 26rpx; color: #FF6B8A; font-weight: bold; }

/* ===== 按钮 ===== */
.btn-area { padding: 10rpx 50rpx; display: flex; flex-direction: column; align-items: center; gap: 12rpx; }

.btn-start {
  width: 100%;
  padding: 28rpx 0;
  text-align: center;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: white;
  border-radius: 60rpx;
  font-size: 34rpx;
  font-weight: bold;
  position: relative;
  overflow: hidden;
  box-shadow: 0 8rpx 28rpx rgba(255, 107, 138, 0.35);
  transition: transform 0.2s;
}

.btn-start:active { transform: scale(0.96); }

.btn-sparkle {
  position: absolute;
  top: -50%; left: -50%;
  width: 200%; height: 200%;
  background: linear-gradient(45deg, transparent 40%, rgba(255,255,255,0.18) 50%, transparent 60%);
  animation: sparkleMove 3s linear infinite;
}

@keyframes sparkleMove {
  0% { transform: translateX(-100%) rotate(25deg); }
  100% { transform: translateX(100%) rotate(25deg); }
}

.btn-pause {
  width: 100%;
  padding: 28rpx 0;
  text-align: center;
  background: linear-gradient(135deg, #FFB74D, #FF9800);
  color: white;
  border-radius: 60rpx;
  font-size: 34rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 28rpx rgba(255, 152, 0, 0.3);
  transition: transform 0.2s;
}

.btn-pause:active { transform: scale(0.96); }

.btn-retry { padding: 10rpx 40rpx; color: #ccc; font-size: 24rpx; }

/* ===== 完成庆祝 ===== */
.celebrate-area { position: relative; padding: 16rpx 40rpx; }

.confetti-layer {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 300rpx;
  pointer-events: none;
  overflow: hidden;
}

.confetti-piece {
  position: absolute;
  top: -20rpx;
  border-radius: 4rpx;
  animation: confettiDrop 3s ease-in forwards;
}

@keyframes confettiDrop {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  100% { transform: translateY(350rpx) rotate(800deg); opacity: 0; }
}

.done-box {
  background: white;
  border-radius: 32rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 30rpx rgba(255, 154, 171, 0.2);
  animation: doneSlide 0.5s ease-out;
}

@keyframes doneSlide {
  0% { transform: translateY(30rpx) scale(0.9); opacity: 0; }
  100% { transform: translateY(0) scale(1); opacity: 1; }
}

.done-header { margin-bottom: 8rpx; }
.done-emoji { font-size: 56rpx; }

.done-title { display: block; font-size: 40rpx; font-weight: bold; color: #FF6B8A; margin: 8rpx 0; }

.done-stars-row { margin: 12rpx 0; }
.done-star { font-size: 44rpx; margin: 0 4rpx; display: inline-block; animation: starPop 0.5s ease-out both; }

.done-msg { display: block; font-size: 26rpx; color: #666; margin: 12rpx 0 24rpx; }

.btn-checkin {
  display: inline-block;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: white;
  padding: 22rpx 56rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 138, 0.25);
}

.btn-checkin:active { transform: scale(0.96); }

.safe-bottom { height: 40rpx; }
