/* 模板选择页样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF0F3, #FFF8F0);
  padding-bottom: 40rpx;
}

.page-header {
  text-align: center;
  padding: 40rpx 0 20rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B8A;
  display: block;
}

.page-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

/* 分类标签 */
.category-tabs {
  display: flex;
  overflow-x: auto;
  padding: 20rpx 30rpx;
  gap: 16rpx;
  white-space: nowrap;
}

.tab-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  background: white;
  font-size: 26rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
  transition: all 0.2s;
}

.tab-item.active {
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: white;
  font-weight: bold;
}

/* 模板网格 */
.template-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20rpx;
  padding: 20rpx 30rpx;
}

.template-card {
  background: white;
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(255, 154, 171, 0.12);
  transition: all 0.2s;
}

.template-card:active {
  transform: scale(0.95);
}

.template-preview {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto;
  background: #FFF5F5;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.template-emoji {
  font-size: 64rpx;
}

.template-name {
  font-size: 26rpx;
  color: #333;
  margin-top: 12rpx;
  font-weight: bold;
}

.template-difficulty {
  font-size: 18rpx;
  margin-top: 6rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-top: 20rpx;
  display: block;
}
