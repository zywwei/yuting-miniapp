/* 画廊页面样式 - 成长记录时间线 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF0F3 0%, #FFF5F0 50%, #FFF8F5 100%);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 汇总卡片 */
.summary-cards {
  display: flex;
  justify-content: space-around;
  padding: 30rpx 20rpx;
  gap: 16rpx;
}

.summary-card {
  flex: 1;
  text-align: center;
  background: white;
  border-radius: 20rpx;
  padding: 20rpx 10rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 154, 171, 0.12);
}

.summary-number {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B8A;
}

.summary-label {
  display: block;
  font-size: 20rpx;
  color: #999;
  margin-top: 6rpx;
}

/* 日历卡片 */
.calendar-card {
  background: white;
  border-radius: 28rpx;
  margin: 0 30rpx 30rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 154, 171, 0.1);
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.calendar-nav {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.calendar-arrow {
  font-size: 24rpx;
  color: #FF6B8A;
  padding: 8rpx 12rpx;
  border-radius: 12rpx;
  background: rgba(255, 107, 138, 0.08);
}

.calendar-arrow:active {
  background: rgba(255, 107, 138, 0.2);
}

.calendar-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
  margin-bottom: 10rpx;
}

.weekday {
  font-size: 22rpx;
  color: #999;
}

.days-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.day-cell {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  position: relative;
  padding: 4rpx;
}

.day-cell.other-month {
  opacity: 0.3;
  background: transparent;
}

.day-cell.other-month .day-number {
  color: #ccc;
}

.day-cell.today {
  background: rgba(255, 107, 138, 0.05);
  border: 2rpx solid rgba(255, 107, 138, 0.3);
}

.day-cell.today .day-number {
  color: #FF6B8A;
  font-weight: bold;
}

.day-number {
  font-size: 22rpx;
  color: #333;
}

.day-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #FF6B8A;
  position: absolute;
  bottom: 4rpx;
}

/* 时间线 */
.timeline {
  padding: 0 30rpx;
}

.recent-section,
.history-section {
  margin-bottom: 30rpx;
}

.day-group {
  margin-bottom: 24rpx;
}

.day-header {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.date-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.date-dot.today-dot {
  background: #FF6B8A;
  box-shadow: 0 0 8rpx rgba(255, 107, 138, 0.5);
}

.day-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.count-badge {
  font-size: 22rpx;
  color: #FF9AAB;
  margin-left: 12rpx;
  background: #FFF0F3;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.drawings-list {
  padding-left: 24rpx;
  border-left: 3rpx solid #FFD6DE;
  margin-left: 7rpx;
}

.drawing-card {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 20rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  margin-left: 16rpx;
  box-shadow: 0 3rpx 12rpx rgba(255, 154, 171, 0.08);
  transition: all 0.2s;
}

.drawing-card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 6rpx rgba(255, 154, 171, 0.06);
}

.drawing-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  background: #F8F8F8;
}

.drawing-info {
  flex: 1;
  padding: 0 20rpx;
  min-width: 0;
}

.drawing-name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.drawing-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.edit-icon {
  font-size: 24rpx;
  padding: 4rpx;
  flex-shrink: 0;
}

.edit-icon:active {
  opacity: 0.7;
}

.drawing-time {
  display: block;
  font-size: 22rpx;
  color: #aaa;
  margin-top: 8rpx;
}

.drawing-actions {
  flex-shrink: 0;
}

.action-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  transition: all 0.2s;
}

.action-btn:active {
  transform: scale(0.9);
}

.delete-btn {
  background: #FFF0F0;
}

/* 历史月份 */
.month-group {
  margin-bottom: 20rpx;
}

.month-header {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 154, 171, 0.08);
}

.month-header:active {
  background: #FFF8F9;
}

.month-arrow {
  font-size: 24rpx;
  color: #FF6B8A;
  margin-right: 16rpx;
}

.month-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.month-days {
  padding-left: 16rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 60rpx;
}

.empty-icon-wrapper {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto;
  background: linear-gradient(135deg, #FFE0E6, #FFF0F3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #666;
  margin-top: 30rpx;
  font-weight: bold;
}

.empty-tip {
  display: block;
  font-size: 26rpx;
  color: #aaa;
  margin-top: 12rpx;
}

.empty-btn {
  display: inline-block;
  margin-top: 40rpx;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: white;
  padding: 22rpx 80rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 138, 0.25);
  transition: all 0.2s;
}

.empty-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 10rpx rgba(255, 107, 138, 0.2);
}

/* 底部快捷栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: white;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.bar-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  background: #F5F5F5;
  color: #666;
}

.bar-btn:active {
  background: #EEE;
}

.bar-btn.primary {
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 138, 0.25);
}

.bar-btn.primary:active {
  opacity: 0.9;
}

/* 底部安全区 */
.safe-bottom {
  height: 40rpx;
}
