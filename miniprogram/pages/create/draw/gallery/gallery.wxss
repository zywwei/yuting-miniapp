/* 画廊页面样式 - 成长记录时间线 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF0F3 0%, #FFF5F0 50%, #FFF8F5 100%);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 统计卡片 */
.stats-header {
  display: flex;
  justify-content: space-around;
  padding: 40rpx 30rpx 30rpx;
}

.stats-card {
  text-align: center;
  background: white;
  border-radius: 20rpx;
  padding: 20rpx 30rpx;
  min-width: 160rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 154, 171, 0.12);
}

.stats-number {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #FF6B8A;
}

.stats-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 时间线 */
.timeline {
  padding: 0 30rpx;
}

.timeline-group {
  margin-bottom: 24rpx;
}

/* 日期标签 */
.date-label {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  position: relative;
}

.date-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  margin-right: 16rpx;
  flex-shrink: 0;
}

.date-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.date-count {
  font-size: 22rpx;
  color: #FF9AAB;
  margin-left: 12rpx;
  background: #FFF0F3;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

/* 画作卡片 */
.date-drawings {
  padding-left: 24rpx;
  border-left: 3rpx solid #FFD6DE;
  margin-left: 7rpx;
}

.drawing-card {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 20rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
  margin-left: 16rpx;
  box-shadow: 0 3rpx 12rpx rgba(255, 154, 171, 0.08);
  transition: all 0.2s;
}

.drawing-card:active {
  transform: scale(0.98);
  box-shadow: 0 1rpx 6rpx rgba(255, 154, 171, 0.06);
}

.drawing-image {
  width: 140rpx;
  height: 140rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  background: #F8F8F8;
}

.drawing-info {
  flex: 1;
  padding: 0 20rpx;
  min-width: 0;
}

.drawing-name {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.drawing-time {
  display: block;
  font-size: 22rpx;
  color: #aaa;
  margin-top: 8rpx;
}

.drawing-actions {
  flex-shrink: 0;
}

.action-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  transition: all 0.2s;
}

.action-btn:active {
  transform: scale(0.9);
}

.delete-btn {
  background: #FFF0F0;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 60rpx;
}

.empty-icon-wrapper {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto;
  background: linear-gradient(135deg, #FFE0E6, #FFF0F3);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  display: block;
  font-size: 32rpx;
  color: #666;
  margin-top: 30rpx;
  font-weight: bold;
}

.empty-tip {
  display: block;
  font-size: 26rpx;
  color: #aaa;
  margin-top: 12rpx;
}

.empty-btn {
  display: inline-block;
  margin-top: 40rpx;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: white;
  padding: 22rpx 80rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 138, 0.25);
  transition: all 0.2s;
}

.empty-btn:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 10rpx rgba(255, 107, 138, 0.2);
}

/* 底部安全区 */
.safe-bottom {
  height: 40rpx;
}
