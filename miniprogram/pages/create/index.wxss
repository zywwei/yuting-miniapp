/* 创意天地首页样式 */
.container {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #FF9800, #F57C00);
  padding: 40rpx;
  color: white;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
}

.header-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.header-stat {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  display: inline-block;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
}

/* 创作入口列表 */
.work-list {
  padding: 30rpx;
}

.work-card {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.work-card:active {
  transform: scale(0.98);
}

.work-icon {
  width: 80rpx;
  height: 80rpx;
  background: #FFF3E0;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.work-info {
  flex: 1;
}

.work-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.work-desc {
  font-size: 24rpx;
  color: #999;
}

.work-arrow {
  font-size: 40rpx;
  color: #CCC;
}
