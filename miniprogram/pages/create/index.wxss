.container {
  background: #FFF5F5;
  padding-bottom: env(safe-area-inset-bottom);
}

.section {
  margin-bottom: 16rpx;
}

.section-header {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 8rpx;
}

.section-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  padding: 16rpx 32rpx 32rpx;
}

.category-grid .category-card:only-child {
  grid-column: 1 / -1;
}

.category-card {
  position: relative;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.1);
  transition: all 0.2s;
}

.category-card:active {
  transform: scale(0.98);
}

.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.card-content {
  position: relative;
  display: flex;
  align-items: center;
  padding: 32rpx 16rpx;
}

.card-icon {
  font-size: 44rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
}

.card-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 2rpx;
  white-space: nowrap;
}

.card-desc {
  font-size: 18rpx;
  color: rgba(255,255,255,0.8);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card-stat {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 8rpx;
  flex-shrink: 0;
  min-width: 60rpx;
}

.stat-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  line-height: 1;
}

.stat-label {
  font-size: 16rpx;
  color: rgba(255,255,255,0.8);
  line-height: 1;
}

.stat-icon {
  font-size: 40rpx;
}