.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  padding: 32rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.header.open {
  background: linear-gradient(135deg, #4CAF50 0%, #45a049 100%);
}

.header.closed {
  background: linear-gradient(135deg, #9E9E9E 0%, #757575 100%);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.stall-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stall-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.level-badge {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: rgba(255,255,255,0.2);
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}

.level-icon {
  font-size: 24rpx;
}

.level-name {
  font-size: 22rpx;
  color: #fff;
}

.streak {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.streak-icon {
  font-size: 28rpx;
}

.streak-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.streak-label {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
}

.open-btn {
  display: flex;
  justify-content: center;
  padding: 20rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 16rpx;
}

.open-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.stats-panel {
  margin: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.stats-row {
  display: flex;
  justify-content: space-around;
  margin-bottom: 16rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  background: #eee;
}

.goal-bar {
  position: relative;
  height: 32rpx;
  background: #f0f0f0;
  border-radius: 16rpx;
  overflow: hidden;
}

.goal-progress {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  background: linear-gradient(90deg, #4CAF50, #8BC34A);
  border-radius: 16rpx;
  transition: width 0.3s;
}

.goal-text {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  font-size: 20rpx;
  color: #333;
}

.quick-actions {
  display: flex;
  justify-content: space-around;
  margin: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  font-size: 48rpx;
}

.action-text {
  font-size: 24rpx;
  color: #666;
}

.tools-section {
  margin: 24rpx;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

.tools-grid {
  display: flex;
  gap: 16rpx;
}

.tool-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.tool-icon {
  font-size: 48rpx;
}

.tool-name {
  font-size: 24rpx;
  color: #666;
}

.stock-alert {
  margin: 24rpx;
  padding: 24rpx;
  background: #FFF3E0;
  border-radius: 16rpx;
  border: 1rpx solid #FFE0B2;
}

.alert-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #E65100;
  margin-bottom: 12rpx;
}

.alert-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.alert-item {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
}

.alert-name {
  font-size: 26rpx;
  color: #333;
}

.alert-count {
  font-size: 26rpx;
  color: #E65100;
  font-weight: bold;
}
