<view class="container {{posterPath ? 'modal-open' : ''}}">
  <view class="header">
    <view class="header-bg" style="background: {{themeGradient}};"></view>
    <view class="header-content">
      <view class="stats-cards">
        <view class="stat-card">
          <text class="stat-icon">💰</text>
          <text class="stat-value">¥{{stats.totalRevenue}}</text>
          <text class="stat-label">累计销售额</text>
        </view>
        <view class="stat-card">
          <text class="stat-icon">📈</text>
          <text class="stat-value">¥{{stats.totalProfit}}</text>
          <text class="stat-label">累计利润</text>
        </view>
        <view class="stat-card">
          <text class="stat-icon">📦</text>
          <text class="stat-value">{{stats.totalOrders}}</text>
          <text class="stat-label">总订单数</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 销售趋势图 -->
  <view class="section">
    <view class="section-header">
      <text class="section-title">📊 销售趋势</text>
      <view class="tab-bar">
        <view class="tab-item {{currentTab === 'week' ? 'active' : ''}}" bindtap="switchTab" data-tab="week">近7天</view>
        <view class="tab-item {{currentTab === 'month' ? 'active' : ''}}" bindtap="switchTab" data-tab="month">近30天</view>
      </view>
    </view>
    <view class="chart-container">
      <canvas type="2d" id="salesChart" class="sales-chart"></canvas>
    </view>
  </view>

  <!-- 热销商品 -->
  <view class="section">
    <view class="section-title">🏆 热销商品 Top5</view>
    <view class="top-list">
      <view class="top-item" wx:for="{{stats.topProducts}}" wx:key="id">
        <view class="top-rank">{{index + 1}}</view>
        <view class="top-info">
          <text class="top-name">{{item.name}}</text>
          <view class="top-bar">
            <view class="top-progress" style="width: {{item.percent}}%;"></view>
          </view>
        </view>
        <view class="top-stats">
          <text class="top-qty">x{{item.quantity}}</text>
          <text class="top-revenue">¥{{item.revenue}}</text>
        </view>
      </view>
      <view class="empty-hint" wx:if="{{stats.topProducts.length === 0}}">
        <text>暂无销售数据</text>
      </view>
    </view>
  </view>

  <!-- 分类统计 -->
  <view class="section" wx:if="{{categoryStats.length > 0}}">
    <view class="section-title">📦 分类统计</view>
    <view class="category-list">
      <view class="category-item" wx:for="{{categoryStats}}" wx:key="name">
        <view class="category-name">{{item.name}}</view>
        <view class="category-bar">
          <view class="category-progress" style="width: {{item.percent}}%;"></view>
        </view>
        <view class="category-stats">
          <text class="category-revenue">¥{{item.revenue}}</text>
          <text class="category-qty">x{{item.quantity}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 利润率 -->
  <view class="section">
    <view class="section-title">💹 利润分析</view>
    <view class="profit-section">
      <view class="profit-circle">
        <view class="profit-ring">
          <text class="profit-value">{{profitMargin}}%</text>
          <text class="profit-label">利润率</text>
        </view>
      </view>
      <view class="profit-details">
        <view class="profit-row">
          <text class="profit-key">累计销售额</text>
          <text class="profit-val">¥{{stats.totalRevenue}}</text>
        </view>
        <view class="profit-row">
          <text class="profit-key">累计利润</text>
          <text class="profit-val profit-green">¥{{stats.totalProfit}}</text>
        </view>
        <view class="profit-row">
          <text class="profit-key">平均客单价</text>
          <text class="profit-val">{{avgOrder}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 营业数据 -->
  <view class="section">
    <view class="section-title">🔥 营业数据</view>
    <view class="data-cards">
      <view class="data-card">
        <text class="data-icon">🔥</text>
        <text class="data-value">{{stats.streakDays}}</text>
        <text class="data-label">连续营业天数</text>
      </view>
      <view class="data-card">
        <text class="data-icon">⭐</text>
        <text class="data-value">Lv.{{stats.level}}</text>
        <text class="data-label">摊位等级</text>
      </view>
      <view class="data-card">
        <text class="data-icon">📊</text>
        <text class="data-value">{{avgOrder}}</text>
        <text class="data-label">平均客单价</text>
      </view>
    </view>
  </view>

  <!-- 折扣统计 -->
  <view class="section" wx:if="{{stats.discountOrderCount > 0}}">
    <view class="section-title">💰 折扣统计</view>
    <view class="discount-stats">
      <view class="discount-stat-item">
        <text class="discount-stat-value">¥{{stats.totalDiscountAmount}}</text>
        <text class="discount-stat-label">累计折扣</text>
      </view>
      <view class="discount-stat-item">
        <text class="discount-stat-value">{{stats.discountOrderCount}}</text>
        <text class="discount-stat-label">折扣订单</text>
      </view>
      <view class="discount-stat-item">
        <text class="discount-stat-value">¥{{stats.avgDiscountAmount}}</text>
        <text class="discount-stat-label">平均节省</text>
      </view>
    </view>
  </view>

  <!-- 营业时间统计 -->
  <view class="section">
    <view class="section-title">⏱️ 营业时间</view>
    <view class="hours-cards">
      <view class="hours-card">
        <text class="hours-value">{{businessHoursText}}</text>
        <text class="hours-label">今日营业时长</text>
      </view>
      <view class="hours-card">
        <text class="hours-value">{{businessHours.openCount}}</text>
        <text class="hours-unit">次</text>
        <text class="hours-label">今日开店次数</text>
      </view>
    </view>
    <view class="hours-trend" wx:if="{{weekBusinessHours.length > 0}}">
      <view class="trend-title">本周营业时长</view>
      <view class="trend-bars">
        <view class="trend-item" wx:for="{{weekBusinessHours}}" wx:key="date">
          <view class="trend-bar-bg">
            <view class="trend-bar" style="height: {{item.duration > 0 ? (item.duration / 120 * 100) : 0}}%;"></view>
          </view>
          <text class="trend-label">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 今日概况 -->
  <view class="section">
    <view class="section-title">📅 今日概况</view>
    <view class="today-stats">
      <view class="today-item">
        <text class="today-value">¥{{stats.todayRevenue}}</text>
        <text class="today-label">今日销售额</text>
      </view>
      <view class="today-item">
        <text class="today-value">{{stats.todayOrders}}</text>
        <text class="today-label">今日订单</text>
      </view>
    </view>
  </view>

  <view class="share-actions">
    <view class="share-btn" bindtap="generatePoster">
      <text class="share-icon">📊</text>
      <text class="share-text">生成海报</text>
    </view>
  </view>

  <!-- 隐藏的 Canvas 用于生成海报 -->
  <canvas type="2d" id="posterCanvas" class="poster-canvas"></canvas>

  <!-- 海报预览弹窗 -->
  <view class="poster-modal" wx:if="{{posterPath}}">
    <view class="poster-mask" bindtap="closePoster"></view>
    <view class="poster-content">
      <view class="poster-image-wrapper">
        <image src="{{posterPath}}" mode="aspectFit" class="poster-image" />
      </view>
      <view class="poster-actions">
        <view class="poster-btn" bindtap="savePoster">保存到相册</view>
        <button class="poster-btn primary" open-type="share">分享给好友</button>
      </view>
    </view>
  </view>
</view>
