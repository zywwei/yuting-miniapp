.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 32rpx;
}

.container.modal-open {
  overflow: hidden;
  height: 100vh;
}

.container.modal-open .chart-container {
  visibility: hidden;
}

.header {
  position: relative;
  margin-bottom: -16rpx;
  z-index: 1;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.header-content {
  position: relative;
  padding: 32rpx;
  z-index: 2;
}

.stats-cards {
  display: flex;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 16rpx;
  backdrop-filter: blur(10px);
}

.stat-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.8);
}

.section {
  position: relative;
  z-index: 3;
  margin: 16rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 24rpx 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  padding: 24rpx 24rpx 16rpx;
}

.section-header .section-title {
  padding: 0;
}

.tab-bar {
  display: flex;
  gap: 8rpx;
}

.tab-item {
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  color: #999;
  background: #f5f5f5;
  border-radius: 16rpx;
}

.tab-item.active {
  color: #FF6B8A;
  background: #FFF5F7;
}

.chart-container {
  padding: 0 24rpx 24rpx;
  position: relative;
  z-index: 1;
}

.sales-chart {
  width: 100%;
  height: 300rpx;
}

.top-list {
  padding: 0 24rpx 24rpx;
}

.top-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.top-item:last-child {
  border-bottom: none;
}

.top-rank {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FF6B8A;
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 50%;
  margin-right: 16rpx;
}

.top-item:nth-child(2) .top-rank {
  background: #FF9800;
}

.top-item:nth-child(3) .top-rank {
  background: #FFC107;
}

.top-info {
  flex: 1;
  margin-right: 16rpx;
}

.top-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.top-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.top-progress {
  height: 100%;
  background: linear-gradient(90deg, #FF6B8A, #FF9AAB);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.top-stats {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.top-qty {
  font-size: 24rpx;
  color: #999;
}

.top-revenue {
  font-size: 28rpx;
  font-weight: bold;
  color: #FF6B8A;
}

/* Category stats */
.category-list {
  padding: 0 24rpx 24rpx;
}

.category-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.category-name {
  width: 100rpx;
  font-size: 24rpx;
  color: #333;
}

.category-bar {
  flex: 1;
  height: 20rpx;
  background: #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.category-progress {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50, #8BC34A);
  border-radius: 10rpx;
}

.category-stats {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  width: 120rpx;
}

.category-revenue {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
}

.category-qty {
  font-size: 20rpx;
  color: #999;
}

/* Profit section */
.profit-section {
  display: flex;
  align-items: center;
  padding: 0 24rpx 24rpx;
  gap: 32rpx;
}

.profit-circle {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profit-ring {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 8rpx solid #FF6B8A;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.profit-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF6B8A;
}

.profit-label {
  font-size: 20rpx;
  color: #999;
}

.profit-details {
  flex: 1;
}

.profit-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.profit-row:last-child {
  border-bottom: none;
}

.profit-key {
  font-size: 26rpx;
  color: #666;
}

.profit-val {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.profit-green {
  color: #4CAF50;
}

.data-cards {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx 24rpx;
}

.data-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx;
  background: #FFF5F7;
  border-radius: 12rpx;
}

.data-icon {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.data-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.data-label {
  font-size: 20rpx;
  color: #999;
}

.today-stats {
  display: flex;
  justify-content: space-around;
  padding: 24rpx;
}

.today-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.today-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B8A;
}

.today-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.empty-hint {
  text-align: center;
  padding: 32rpx;
  color: #999;
  font-size: 26rpx;
}

.share-actions {
  padding: 32rpx 24rpx 48rpx;
}

.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #FF6B8A 0%, #FF9AAB 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(255,107,138,0.3);
}

.share-icon {
  font-size: 32rpx;
}

.share-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
}

.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 375px;
  height: 667px;
  z-index: -1;
  pointer-events: none;
}

.poster-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.poster-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.9);
}

.poster-content {
  position: relative;
  z-index: 10000;
  width: 90%;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poster-image-wrapper {
  width: 100%;
  padding-bottom: 177.87%; /* 667/375 = 1.7787 */
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.poster-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.poster-actions {
  display: flex;
  gap: 24rpx;
  width: 100%;
  flex-shrink: 0;
}

.poster-btn {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  background: #fff;
  border-radius: 12rpx;
}

.poster-btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #FF6B8A 0%, #FF9AAB 100%);
}
