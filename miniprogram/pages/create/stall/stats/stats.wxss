.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  position: relative;
  padding-bottom: 32rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 300rpx;
  background: linear-gradient(135deg, #FF6B8A 0%, #FF9AAB 100%);
  border-radius: 0 0 32rpx 32rpx;
}

.header-content {
  position: relative;
  padding: 32rpx;
}

.stats-cards {
  display: flex;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 16rpx;
  backdrop-filter: blur(10px);
}

.stat-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 4rpx;
}

.stat-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.8);
}

.section {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  padding: 24rpx 24rpx 16rpx;
}

.top-list {
  padding: 0 24rpx 24rpx;
}

.top-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.top-item:last-child {
  border-bottom: none;
}

.top-rank {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FF6B8A;
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 50%;
  margin-right: 16rpx;
}

.top-item:nth-child(2) .top-rank {
  background: #FF9800;
}

.top-item:nth-child(3) .top-rank {
  background: #FFC107;
}

.top-info {
  flex: 1;
  margin-right: 16rpx;
}

.top-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.top-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.top-progress {
  height: 100%;
  background: linear-gradient(90deg, #FF6B8A, #FF9AAB);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.top-stats {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.top-qty {
  font-size: 24rpx;
  color: #999;
}

.top-revenue {
  font-size: 28rpx;
  font-weight: bold;
  color: #FF6B8A;
}

.data-cards {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx 24rpx;
}

.data-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx;
  background: #FFF5F7;
  border-radius: 12rpx;
}

.data-icon {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.data-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.data-label {
  font-size: 20rpx;
  color: #999;
}

.today-stats {
  display: flex;
  justify-content: space-around;
  padding: 24rpx;
}

.today-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.today-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B8A;
}

.today-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.empty-hint {
  text-align: center;
  padding: 32rpx;
  color: #999;
  font-size: 26rpx;
}
