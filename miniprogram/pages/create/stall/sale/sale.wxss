.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 400rpx;
}

.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
  padding: 16rpx;
}

.product-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.product-item.selected {
  border-color: #FF6B8A;
  background: #FFF5F7;
}

.product-item:active {
  transform: scale(0.96);
}

.product-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.product-img {
  width: 100%;
  height: 100%;
}

.product-emoji {
  font-size: 40rpx;
}

.product-name {
  font-size: 24rpx;
  color: #333;
  text-align: center;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.product-price {
  font-size: 28rpx;
  font-weight: bold;
  color: #FF6B8A;
  margin-bottom: 4rpx;
}

.product-stock {
  font-size: 20rpx;
  color: #999;
}

.cart-panel {
  position: fixed;
  bottom: 200rpx;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.1);
  z-index: 100;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.cart-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.cart-count {
  font-size: 24rpx;
  color: #999;
}

.cart-list {
  max-height: 200rpx;
  overflow-y: auto;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
}

.cart-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.cart-qty {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 24rpx;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
  font-size: 32rpx;
  color: #333;
}

.qty-num {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  min-width: 40rpx;
  text-align: center;
}

.cart-subtotal {
  font-size: 28rpx;
  font-weight: bold;
  color: #FF6B8A;
}

.cart-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
}

.total-label {
  font-size: 30rpx;
  color: #333;
}

.total-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B8A;
}

.payment-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx 32rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.1);
  z-index: 101;
}

.payment-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.payment-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 16rpx;
}

.payment-input {
  flex: 1;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: right;
}

.change-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  background: #E8F5E9;
  border-radius: 8rpx;
}

.change-label {
  font-size: 28rpx;
  color: #2E7D32;
}

.change-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #2E7D32;
}

.confirm-btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4CAF50, #45a049);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.empty-btn {
  font-size: 28rpx;
  color: #fff;
  background: #FF6B8A;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
}
