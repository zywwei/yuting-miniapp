.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 400rpx;
}

.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
  padding: 16rpx;
}

.product-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.product-item.selected {
  border-color: #FF6B8A;
  background: #FFF5F7;
}

.product-item:active {
  transform: scale(0.96);
}

.product-image {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 8rpx;
}

.product-img {
  width: 100%;
  height: 100%;
}

.product-emoji {
  font-size: 40rpx;
}

.product-name {
  font-size: 24rpx;
  color: #333;
  text-align: center;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 100%;
}

.product-price {
  font-size: 28rpx;
  font-weight: bold;
  color: #FF6B8A;
  margin-bottom: 4rpx;
}

.product-stock {
  font-size: 20rpx;
  color: #999;
}

.cart-panel {
  position: fixed;
  bottom: 420rpx;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.1);
  z-index: 100;
}

.cart-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.cart-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.cart-count {
  font-size: 24rpx;
  color: #999;
}

.cart-list {
  max-height: 200rpx;
  overflow-y: auto;
}

.cart-item {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
}

.cart-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.cart-qty {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 0 24rpx;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
  font-size: 32rpx;
  color: #333;
}

.qty-num {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  min-width: 40rpx;
  text-align: center;
}

.cart-subtotal {
  font-size: 28rpx;
  font-weight: bold;
  color: #FF6B8A;
}

.cart-total {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid #f0f0f0;
}

.total-label {
  font-size: 30rpx;
  color: #333;
}

.total-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B8A;
}

.payment-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx 32rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.1);
  z-index: 101;
}

.payment-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.payment-label {
  font-size: 28rpx;
  color: #333;
  margin-right: 16rpx;
}

.payment-input {
  flex: 1;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  text-align: right;
}

.change-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  background: #E8F5E9;
  border-radius: 8rpx;
}

.change-label {
  font-size: 28rpx;
  color: #2E7D32;
}

.change-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #2E7D32;
}

.change-row.shortage {
  background: #FFEBEE;
}

.change-label.shortage {
  color: #C62828;
}

.change-value.shortage {
  color: #C62828;
}

/* 折扣区域 */
.discount-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.discount-label {
  font-size: 28rpx;
  color: #333;
  flex-shrink: 0;
}

.discount-btns {
  display: flex;
  gap: 8rpx;
}

.discount-btn {
  padding: 8rpx 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.discount-btn.active {
  background: #FF6B8A;
  color: #fff;
}

.discount-input {
  width: 80rpx;
  height: 56rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  text-align: center;
  font-size: 28rpx;
}

.discount-unit {
  font-size: 24rpx;
  color: #666;
}

.discount-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  background: #FFF3E0;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

.discount-arrow {
  font-size: 24rpx;
  color: #999;
}

.discounted-price {
  font-size: 28rpx;
  font-weight: bold;
  color: #FF6B8A;
}

.discount-save {
  font-size: 22rpx;
  color: #FF9800;
  margin-left: auto;
}

.confirm-btn {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #4CAF50, #45a049);
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.empty-btn {
  font-size: 28rpx;
  color: #fff;
  background: #FF6B8A;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
}

/* 搜索框 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

/* 分类筛选 */
.category-filter {
  display: flex;
  align-items: center;
  margin: 0 16rpx 16rpx;
  gap: 16rpx;
}

.category-scroll {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
}

.category-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: #fff;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #666;
  margin-right: 16rpx;
  border: 1rpx solid #eee;
}

.category-item.active {
  background: #FF6B8A;
  color: #fff;
  border-color: #FF6B8A;
}

.sort-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 20rpx;
  background: #fff;
  border-radius: 32rpx;
  border: 1rpx solid #eee;
  flex-shrink: 0;
  min-width: 80rpx;
  justify-content: center;
}

.sort-icon {
  font-size: 24rpx;
}

.sort-text {
  font-size: 24rpx;
  color: #666;
}

/* 排序菜单浮层 */
.sort-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  background: rgba(0,0,0,0.3);
}

.sort-menu-wrapper {
  position: fixed;
  left: 0;
  right: 0;
  top: 200rpx;
  z-index: 100;
  padding: 0 32rpx;
}

.sort-menu {
  padding: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.12);
}

.sort-option {
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  border-radius: 8rpx;
}

.sort-option.active {
  background: #FFF5F7;
  color: #FF6B8A;
  font-weight: bold;
}

/* 快速再来一单 */
.repeat-section {
  padding: 0 16rpx 16rpx;
}

.repeat-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx;
  background: #E3F2FD;
  border-radius: 12rpx;
  border: 1rpx solid #90CAF9;
}

.repeat-icon {
  font-size: 28rpx;
}

.repeat-text {
  font-size: 28rpx;
  color: #1976D2;
  font-weight: bold;
}

/* 热销和低库存标签 */
.product-item {
  position: relative;
}

.hot-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 2rpx 8rpx;
  background: #FF5722;
  color: #fff;
  font-size: 18rpx;
  border-radius: 8rpx;
}

.low-stock-badge {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  padding: 2rpx 8rpx;
  background: #FF9800;
  color: #fff;
  font-size: 18rpx;
  border-radius: 8rpx;
}

.sold-out {
  opacity: 0.5;
  pointer-events: none;
}

/* 庆祝动画 */
.celebration-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  pointer-events: auto;
}

.confetti {
  position: absolute;
  top: -10%;
  width: 16rpx;
  height: 40rpx;
  border-radius: 4rpx;
  animation: confettiFall 2.5s ease-in forwards;
}

@keyframes confettiFall {
  0% {
    top: -10%;
    opacity: 1;
    transform: rotate(0deg) translateX(0);
  }
  100% {
    top: 110%;
    opacity: 0;
    transform: rotate(var(--rotate, 720deg)) translateX(50rpx);
  }
}

.celebration-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: celebrationPop 0.5s cubic-bezier(0.18, 1.2, 0.5, 1) forwards;
}

@keyframes celebrationPop {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.3);
  }
  100% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

.celebration-emoji {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.celebration-text {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
  margin-bottom: 16rpx;
}

.celebration-amount {
  font-size: 64rpx;
  color: #FFD700;
  font-weight: bold;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}
