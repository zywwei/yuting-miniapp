.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.form {
  margin: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.form-item {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-row {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-row .half {
  flex: 1;
  border-bottom: none;
}

.form-row .half:first-child {
  border-right: 1rpx solid #f0f0f0;
}

.label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  display: block;
}

.input {
  font-size: 28rpx;
  color: #333;
  width: 100%;
}

.textarea {
  font-size: 28rpx;
  color: #333;
  width: 100%;
  height: 120rpx;
}

.image-upload {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.upload-icon {
  font-size: 48rpx;
}

.category-select {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.category-option {
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 24rpx;
}

.category-option.active {
  background: #FF6B8A;
  color: #fff;
}

.profit-info {
  padding: 12rpx 32rpx;
  background: #E8F5E9;
}

.profit-text {
  font-size: 24rpx;
  color: #2E7D32;
}

.submit-btn {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FF6B8A;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}
