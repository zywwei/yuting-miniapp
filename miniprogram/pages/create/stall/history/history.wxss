.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 16rpx;
}

/* 搜索框 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

/* 今日概况 */
.today-overview {
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  color: #fff;
}

.overview-title {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.overview-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.overview-row:last-child {
  margin-bottom: 0;
}

.overview-item {
  font-size: 24rpx;
  opacity: 0.9;
}

.overview-item.profit {
  color: #FFD700;
  font-weight: bold;
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.filter-item {
  padding: 12rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #666;
  border: 1rpx solid #eee;
}

.filter-item.active {
  background: #FF6B8A;
  color: #fff;
  border-color: #FF6B8A;
}

/* 自定义日期 */
.date-range-picker {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  padding: 12rpx 16rpx;
  background: #fff;
  border-radius: 12rpx;
}

.date-pick-btn {
  font-size: 24rpx;
  color: #999;
  padding: 8rpx 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.date-pick-btn.active {
  color: #FF6B8A;
  background: #FFF5F7;
}

.date-sep {
  font-size: 24rpx;
  color: #ccc;
}

.date-clear {
  font-size: 28rpx;
  color: #999;
  padding: 8rpx;
  margin-left: auto;
}

/* 汇总栏 */
.summary-bar {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.summary-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.summary-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.summary-value.profit {
  color: #4CAF50;
}

.summary-label {
  font-size: 22rpx;
  color: #999;
}

/* 历史列表 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.date-group {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

/* 日期头部 */
.date-header {
  padding: 16rpx 24rpx;
  background: #f8f8f8;
  border-bottom: 1rpx solid #f0f0f0;
}

.date-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.date-stats {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.date-orders {
  font-size: 22rpx;
  color: #666;
}

.date-total {
  font-size: 22rpx;
  color: #FF6B8A;
  font-weight: bold;
}

.date-profit {
  font-size: 22rpx;
  color: #4CAF50;
}

.date-hours {
  font-size: 22rpx;
  color: #999;
}

/* 营业时间详情 */
.business-hours-detail {
  padding: 12rpx 24rpx;
  background: #FAFAFA;
  border-bottom: 1rpx solid #f0f0f0;
}

.session-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6rpx 0;
}

.session-time {
  font-size: 22rpx;
  color: #666;
}

.session-duration {
  font-size: 22rpx;
  color: #4CAF50;
  font-weight: bold;
}

/* 订单项 */
.sale-item {
  border-bottom: 1rpx solid #f5f5f5;
}

.sale-item:last-child {
  border-bottom: none;
}

.sale-summary {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}

.sale-time {
  font-size: 24rpx;
  color: #999;
  width: 80rpx;
}

.sale-total {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.discount-badge {
  font-size: 20rpx;
  color: #fff;
  background: #FF9800;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.sale-count {
  font-size: 22rpx;
  color: #999;
}

.expand-icon {
  font-size: 20rpx;
  color: #ccc;
  margin-left: auto;
}

/* 订单详情 */
.sale-detail {
  padding: 0 24rpx 16rpx;
  background: #fafafa;
}

.sale-original {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.original-text {
  font-size: 22rpx;
  color: #999;
  text-decoration: line-through;
}

.save-text {
  font-size: 22rpx;
  color: #FF9800;
}

.sale-items {
  padding: 8rpx 0;
}

.sale-item-row {
  display: flex;
  align-items: center;
  padding: 6rpx 0;
}

.item-name {
  flex: 1;
  font-size: 24rpx;
  color: #333;
}

.item-qty {
  font-size: 22rpx;
  color: #999;
  margin: 0 16rpx;
}

.item-price {
  font-size: 24rpx;
  color: #FF6B8A;
  font-weight: bold;
}

.sale-payment {
  display: flex;
  gap: 24rpx;
  padding: 8rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.payment-text {
  font-size: 22rpx;
  color: #666;
}

.change-text {
  font-size: 22rpx;
  color: #4CAF50;
}

.sale-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  border-top: 1rpx solid #f0f0f0;
}

.sale-profit {
  font-size: 24rpx;
  color: #4CAF50;
  font-weight: bold;
}

.delete-btn {
  font-size: 22rpx;
  color: #F44336;
  padding: 8rpx 16rpx;
  background: #FFEBEE;
  border-radius: 8rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
