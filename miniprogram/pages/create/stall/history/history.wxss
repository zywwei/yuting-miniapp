.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.filter-bar {
  display: flex;
  justify-content: space-around;
  padding: 16rpx;
  background: #fff;
}

.filter-item {
  padding: 8rpx 24rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 24rpx;
}

.filter-item.active {
  background: #FF6B8A;
  color: #fff;
}

.summary-bar {
  display: flex;
  justify-content: space-around;
  padding: 24rpx;
  margin: 16rpx;
  background: #fff;
  border-radius: 12rpx;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.summary-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.history-list {
  padding: 0 16rpx;
}

.date-group {
  margin-bottom: 16rpx;
}

.date-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #f0f0f0;
  border-radius: 12rpx 12rpx 0 0;
}

.date-text {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.date-total {
  font-size: 28rpx;
  color: #FF6B8A;
  font-weight: bold;
}

.sale-item {
  background: #fff;
  padding: 16rpx 24rpx;
  margin-bottom: 2rpx;
}

.sale-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.sale-time {
  font-size: 26rpx;
  color: #666;
}

.sale-total {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.discount-badge {
  padding: 4rpx 12rpx;
  background: #FF9800;
  color: #fff;
  font-size: 22rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}

.sale-original {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
  margin-bottom: 8rpx;
}

.original-text {
  font-size: 22rpx;
  color: #999;
  text-decoration: line-through;
}

.save-text {
  font-size: 22rpx;
  color: #FF9800;
}

.sale-items {
  margin-bottom: 12rpx;
}

.sale-item-row {
  display: flex;
  align-items: center;
  padding: 4rpx 0;
}

.item-name {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.item-qty {
  font-size: 24rpx;
  color: #999;
  margin: 0 16rpx;
}

.item-price {
  font-size: 26rpx;
  color: #333;
}

.sale-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 12rpx;
  border-top: 1rpx solid #f0f0f0;
}

.sale-profit {
  font-size: 24rpx;
  color: #4CAF50;
}

.delete-btn {
  font-size: 24rpx;
  color: #F44336;
  padding: 4rpx 12rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
