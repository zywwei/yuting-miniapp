.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 32rpx;
}

.display {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.display-row {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.display-label {
  font-size: 36rpx;
  color: #333;
  width: 120rpx;
  flex-shrink: 0;
}

.display-input {
  flex: 1;
  font-size: 56rpx;
  font-weight: bold;
  color: #333;
  text-align: right;
  height: 80rpx;
  line-height: 80rpx;
  min-width: 0;
}

/* 折扣区域 */
.discount-section {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.discount-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.discount-btns {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.discount-btn {
  flex: 1;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #666;
}

.discount-btn.active {
  background: #FF6B8A;
  color: #fff;
}

.discount-custom {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.discount-input {
  width: 120rpx;
  height: 64rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
}

.discount-unit {
  font-size: 26rpx;
  color: #666;
}

.discount-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.discount-save {
  font-size: 26rpx;
  color: #FF9800;
}

.discount-result {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6B8A;
}

.change-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 0 16rpx;
}

.change-label {
  font-size: 40rpx;
  color: #4CAF50;
  font-weight: bold;
}

.change-row.negative .change-label {
  color: #F44336;
}

.change-value {
  font-size: 72rpx;
  font-weight: bold;
  color: #4CAF50;
}

.change-value.negative {
  color: #F44336;
}

.change-hint {
  padding: 16rpx 0;
  text-align: center;
}

.change-hint text {
  font-size: 28rpx;
  color: #F44336;
  background: #FFEBEE;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
}

.quick-amounts {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.amount-btn {
  flex: 1;
  min-width: calc(33.33% - 12rpx);
  padding: 28rpx;
  background: #fff;
  border-radius: 16rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6B8A;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.amount-btn:active {
  background: #FFF5F7;
}

.clear-btn {
  padding: 28rpx;
  background: #fff;
  border-radius: 16rpx;
  text-align: center;
  font-size: 32rpx;
  color: #F44336;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
