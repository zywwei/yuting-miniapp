.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #fff;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.add-btn {
  font-size: 28rpx;
  color: #FF6B8A;
  padding: 8rpx 16rpx;
  border: 1rpx solid #FF6B8A;
  border-radius: 8rpx;
}

.category-filter {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  background: #fff;
  overflow-x: auto;
  white-space: nowrap;
}

.filter-item {
  display: inline-block;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 24rpx;
}

.filter-item.active {
  background: #FF6B8A;
  color: #fff;
}

.product-list {
  padding: 16rpx;
}

.product-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.product-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.product-img {
  width: 100%;
  height: 100%;
}

.product-emoji {
  font-size: 48rpx;
}

.product-info {
  flex: 1;
}

.product-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.product-price {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.product-stock {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
}

.product-stock.low {
  background: #FFEBEE;
  color: #D32F2F;
}

.product-stock.medium {
  background: #FFF3E0;
  color: #E65100;
}

.product-stock.good {
  background: #E8F5E9;
  color: #2E7D32;
}

.product-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-left: 16rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  text-align: center;
}

.action-btn.edit {
  background: #E3F2FD;
  color: #1976D2;
}

.action-btn.delete {
  background: #FFEBEE;
  color: #D32F2F;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.empty-btn {
  font-size: 28rpx;
  color: #fff;
  background: #FF6B8A;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
}
