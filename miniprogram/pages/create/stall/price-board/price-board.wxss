.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F7 0%, #fff 100%);
  padding: 32rpx;
}

.header {
  text-align: center;
  margin-bottom: 48rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 32rpx;
  color: #FF6B8A;
}

.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.product-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.product-img {
  width: 100%;
  height: 100%;
}

.product-emoji {
  font-size: 60rpx;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 8rpx;
  text-align: center;
}

.product-price {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF6B8A;
}

.footer {
  text-align: center;
  margin-top: 48rpx;
}

.footer-text {
  font-size: 32rpx;
  color: #999;
}
