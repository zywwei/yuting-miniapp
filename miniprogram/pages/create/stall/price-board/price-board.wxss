.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF5F7 0%, #fff 100%);
  padding: 32rpx;
  padding-bottom: 200rpx;
}

/* 头部 */
.header {
  text-align: center;
  margin-bottom: 32rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 32rpx;
  color: #FF6B8A;
}

/* 搜索框 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

/* 工具栏 */
.toolbar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.category-scroll {
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
}

.category-item {
  display: inline-block;
  padding: 12rpx 24rpx;
  background: #fff;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #666;
  margin-right: 16rpx;
  border: 1rpx solid #eee;
}

.category-item.active {
  background: #FF6B8A;
  color: #fff;
  border-color: #FF6B8A;
}

.view-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  background: #fff;
  border-radius: 32rpx;
  border: 1rpx solid #eee;
  flex-shrink: 0;
}

.view-icon {
  font-size: 32rpx;
  color: #666;
}

.sort-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 20rpx;
  background: #fff;
  border-radius: 32rpx;
  border: 1rpx solid #eee;
  flex-shrink: 0;
  min-width: 80rpx;
  justify-content: center;
}

.sort-icon {
  font-size: 24rpx;
}

.sort-text {
  font-size: 24rpx;
  color: #666;
}

/* 排序菜单浮层 */
.sort-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 99;
  background: rgba(0,0,0,0.3);
}

.sort-menu-wrapper {
  position: absolute;
  left: 0;
  right: 0;
  top: 200rpx;
  z-index: 100;
  padding: 0 32rpx;
}

.sort-menu {
  padding: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.12);
}

.sort-option {
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  border-radius: 8rpx;
}

.sort-option.active {
  background: #FFF5F7;
  color: #FF6B8A;
  font-weight: bold;
}

/* 列表视图 */
.product-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.product-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.product-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.product-img {
  width: 100%;
  height: 100%;
}

.product-emoji {
  font-size: 60rpx;
}

.product-info {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.product-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.product-category {
  font-size: 22rpx;
  color: #FF6B8A;
  background: #FFF5F7;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.product-sales {
  font-size: 22rpx;
  color: #999;
}

.product-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.product-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF6B8A;
}

.product-stock {
  font-size: 24rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.product-stock.good {
  color: #4CAF50;
  background: #E8F5E9;
}

.product-stock.medium {
  color: #FF9800;
  background: #FFF3E0;
}

.product-stock.low {
  color: #F44336;
  background: #FFEBEE;
}

.product-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.action-btn {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  text-align: center;
}

.action-btn.edit {
  background: #E3F2FD;
  color: #1976D2;
}

.action-btn.delete {
  background: #FFEBEE;
  color: #F44336;
}

/* 网格视图 */
.product-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.product-card {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  overflow: hidden;
}

.card-image {
  width: 100%;
  height: 200rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.card-img {
  width: 100%;
  height: 100%;
}

.card-emoji {
  font-size: 80rpx;
}

.low-stock-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  padding: 4rpx 12rpx;
  background: #FF9800;
  color: #fff;
  font-size: 20rpx;
  border-radius: 8rpx;
}

.card-info {
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-price {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF6B8A;
}

.card-stock {
  font-size: 22rpx;
  color: #999;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 24rpx;
}

.empty-btn {
  font-size: 28rpx;
  color: #fff;
  background: #FF6B8A;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
}

/* 底部按钮 */
.footer {
  text-align: center;
  margin-top: 48rpx;
  padding-bottom: 32rpx;
}

.add-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #FF6B8A, #FF9AAB);
  color: #fff;
  border-radius: 44rpx;
  box-shadow: 0 4rpx 16rpx rgba(255,107,138,0.3);
}

.add-icon {
  font-size: 32rpx;
  font-weight: bold;
}

.add-text {
  font-size: 28rpx;
  font-weight: bold;
}
