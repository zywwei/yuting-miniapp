.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 32rpx;
  padding-bottom: 200rpx;
}

/* 清单列表 */
.list-section {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.item-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.item-card.checked {
  opacity: 0.6;
}

.item-check {
  margin-right: 16rpx;
}

.check-icon {
  font-size: 40rpx;
}

.item-info {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.item-name {
  font-size: 30rpx;
  color: #333;
  font-weight: bold;
}

.item-qty {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.qty-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 50%;
  font-size: 32rpx;
  color: #333;
}

.qty-num {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6B8A;
  min-width: 60rpx;
  text-align: center;
}

.item-remove {
  margin-left: 16rpx;
  padding: 8rpx;
}

.remove-icon {
  font-size: 28rpx;
  color: #999;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: #999;
}

/* 底部操作 */
.footer {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.footer-stats {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.stats-text {
  font-size: 24rpx;
  color: #666;
}

.stats-done {
  font-size: 24rpx;
  color: #4CAF50;
}

.clear-checked {
  padding: 16rpx;
  background: #FFEBEE;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #F44336;
}

/* 添加按钮 */
.add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #FF6B8A, #FF9AAB);
  border-radius: 44rpx;
  box-shadow: 0 4rpx 16rpx rgba(255,107,138,0.3);
}

.add-icon {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
}

.add-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
}

/* 添加面板 */
.add-panel {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.add-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
}

.add-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  max-height: 80vh;
}

.add-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.add-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.add-close {
  font-size: 32rpx;
  color: #999;
  padding: 8rpx;
}

/* 搜索 */
.add-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
}

/* 商品列表 */
.product-scroll {
  max-height: 400rpx;
  margin-bottom: 24rpx;
}

.product-item {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.product-item.selected {
  background: #FFF5F7;
}

.product-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.product-price {
  font-size: 24rpx;
  color: #FF6B8A;
  margin-right: 16rpx;
}

.product-stock {
  font-size: 22rpx;
  color: #999;
}

/* 数量输入 */
.add-quantity {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.qty-label {
  font-size: 28rpx;
  color: #333;
}

.qty-input {
  width: 160rpx;
  height: 64rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: bold;
}

/* 确认按钮 */
.add-confirm {
  padding: 24rpx;
  background: linear-gradient(135deg, #FF6B8A, #FF9AAB);
  border-radius: 44rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
}
