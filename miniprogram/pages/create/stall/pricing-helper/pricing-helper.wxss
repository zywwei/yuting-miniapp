.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 32rpx;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

/* 成本价输入 */
.input-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.cost-input-row {
  display: flex;
  align-items: center;
}

.currency {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-right: 12rpx;
}

.cost-input {
  flex: 1;
  font-size: 56rpx;
  font-weight: bold;
  color: #333;
  height: 80rpx;
  line-height: 80rpx;
}

/* 利润率选择 */
.rate-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.rate-btns {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.rate-btn {
  flex: 1;
  min-width: calc(33.33% - 12rpx);
  padding: 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
}

.rate-btn.active {
  background: #FF6B8A;
  color: #fff;
}

.custom-rate {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.custom-label {
  font-size: 28rpx;
  color: #666;
}

.custom-input {
  width: 160rpx;
  height: 64rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
}

.custom-unit {
  font-size: 28rpx;
  color: #666;
}

/* 计算结果 */
.result-section {
  margin-bottom: 24rpx;
}

.result-card {
  background: linear-gradient(135deg, #FF6B8A, #FF9AAB);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(255,107,138,0.3);
}

.result-main {
  text-align: center;
  margin-bottom: 24rpx;
}

.result-label {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  display: block;
  margin-bottom: 8rpx;
}

.result-price {
  font-size: 72rpx;
  font-weight: bold;
  color: #fff;
}

.result-detail {
  display: flex;
  justify-content: space-around;
}

.result-profit {
  font-size: 28rpx;
  color: #fff;
}

.result-rate {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
}

/* 参考售价表 */
.table-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.price-table {
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #f0f0f0;
}

.table-header {
  display: flex;
  background: #f5f5f5;
  padding: 16rpx 0;
}

.th {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #666;
  font-weight: bold;
}

.table-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.table-row:last-child {
  border-bottom: none;
}

.table-row.active {
  background: #FFF5F7;
}

.td {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #333;
}

.td.price {
  color: #FF6B8A;
  font-weight: bold;
}

.td.profit {
  color: #4CAF50;
}

/* 清除按钮 */
.clear-btn {
  padding: 28rpx;
  background: #fff;
  border-radius: 16rpx;
  text-align: center;
  font-size: 32rpx;
  color: #F44336;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
