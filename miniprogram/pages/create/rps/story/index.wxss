.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #E8EAF6 0%, #FFF5F5 100%);
  padding: 32rpx;
}

.phase-intro {
  text-align: center;
  padding-top: 40rpx;
}

.chapter-header {
  margin-bottom: 40rpx;
}

.chapter-num {
  font-size: 28rpx;
  color: #9C27B0;
  margin-bottom: 8rpx;
}

.chapter-name {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
}

.enemy-card {
  background: #fff;
  padding: 40rpx;
  border-radius: 20rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.enemy-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.enemy-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.story-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  margin-bottom: 32rpx;
  text-align: left;
  padding: 0 16rpx;
}

.battle-info {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 48rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.info-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #9C27B0;
}

.start-btn {
  padding: 24rpx;
  background: linear-gradient(135deg, #9C27B0 0%, #7B1FA2 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.back-btn {
  font-size: 28rpx;
  color: #999;
}

.phase-battle {
  text-align: center;
  padding-top: 40rpx;
}

.battle-header {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 48rpx;
  margin-bottom: 60rpx;
}

.player-info {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.player-name {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.player-score {
  font-size: 64rpx;
  font-weight: bold;
  color: #9C27B0;
}

.vs {
  font-size: 32rpx;
  font-weight: bold;
  color: #ccc;
}

.choice-buttons {
  display: flex;
  justify-content: center;
  gap: 32rpx;
}

.choice-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  padding: 32rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.choice-btn:active {
  transform: scale(0.95);
  background: #E8EAF6;
}

.choice-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.choice-text {
  font-size: 24rpx;
  color: #666;
}

.phase-victory,
.phase-defeat {
  text-align: center;
  padding-top: 120rpx;
}

.victory-icon,
.defeat-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.victory-title,
.defeat-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.reward-info {
  font-size: 28rpx;
  color: #FFD700;
  margin-bottom: 48rpx;
}

.next-btn {
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, #9C27B0 0%, #7B1FA2 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: inline-block;
}

.defeat-actions {
  display: flex;
  justify-content: center;
  gap: 24rpx;
}

.action-btn {
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, #9C27B0 0%, #7B1FA2 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.action-btn.secondary {
  background: #f5f5f5;
  color: #666;
}
