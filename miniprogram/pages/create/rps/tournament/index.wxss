.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFF5F5 100%);
  padding: 32rpx;
}

/* 对阵图阶段 */
.phase-bracket {
  text-align: center;
  padding-top: 40rpx;
}

.bracket-header {
  margin-bottom: 32rpx;
}

.bracket-icon {
  font-size: 80rpx;
  margin-bottom: 12rpx;
}

.bracket-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF9800;
  margin-bottom: 8rpx;
}

.bracket-subtitle {
  font-size: 26rpx;
  color: #666;
}

.bracket-stats {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 32rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF9800;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 对阵图树 */
.bracket-tree {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.bracket-round {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.round-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}

.match-card {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #FFF3E0;
  border: 2rpx solid #FFE0B2;
}

.match-card.current {
  border-color: #FF9800;
  box-shadow: 0 4rpx 12rpx rgba(255, 152, 0, 0.2);
}

.match-card.completed {
  opacity: 0.7;
}

.match-player {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.match-player.winner {
  background: rgba(76, 175, 80, 0.1);
}

.player-icon {
  font-size: 32rpx;
}

.player-name {
  font-size: 26rpx;
  color: #333;
}

.match-vs {
  font-size: 22rpx;
  color: #ccc;
  font-weight: bold;
}

.back-btn {
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
}

/* 对手介绍 */
.phase-matchIntro {
  text-align: center;
  padding-top: 80rpx;
}

.intro-round {
  font-size: 28rpx;
  color: #FF9800;
  margin-bottom: 24rpx;
}

.intro-card {
  background: #fff;
  padding: 48rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
  margin-bottom: 24rpx;
}

.intro-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.intro-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.intro-difficulty {
  font-size: 26rpx;
  color: #666;
}

.intro-rule {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 32rpx;
}

.start-btn {
  display: inline-block;
  padding: 24rpx 64rpx;
  background: linear-gradient(135deg, #FF9800 0%, #F57C00 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(255, 152, 0, 0.3);
}

/* 对战阶段 */
.phase-match {
  padding-top: 20rpx;
}

.match-header {
  text-align: center;
  margin-bottom: 32rpx;
}

.match-round {
  font-size: 26rpx;
  color: #FF9800;
  margin-bottom: 12rpx;
}

.match-score {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 24rpx;
  background: #fff;
  padding: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.score-side {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.score-name {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 4rpx;
}

.score-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF9800;
}

.score-vs {
  font-size: 32rpx;
  color: #ccc;
}

/* 出拳展示 */
.battle-area {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 32rpx;
  margin-bottom: 32rpx;
}

.player-side {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.player-choice {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.1);
  transition: all 0.3s ease;
  margin-bottom: 12rpx;
}

.player-choice.animating {
  animation: shake 0.5s ease-in-out;
}

.player-choice.winner {
  box-shadow: 0 0 0 4rpx rgba(76, 175, 80, 0.5);
  transform: scale(1.1);
}

.player-choice.loser {
  opacity: 0.6;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-10rpx); }
  75% { transform: translateX(10rpx); }
}

.choice-icon {
  font-size: 64rpx;
}

.choice-placeholder {
  font-size: 48rpx;
  color: #ccc;
}

.player-name {
  font-size: 24rpx;
  color: #666;
}

.vs-icon {
  font-size: 36rpx;
  color: #FF9800;
}

.vs-icon.vs-animate {
  animation: vsPulse 0.8s ease-in-out infinite;
}

@keyframes vsPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.3); }
}

/* 回合结果 */
.round-result {
  text-align: center;
  margin-bottom: 24rpx;
}

.result-badge {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.result-badge.win {
  background: rgba(76, 175, 80, 0.15);
  color: #4CAF50;
}

.result-badge.lose {
  background: rgba(244, 67, 54, 0.15);
  color: #F44336;
}

.result-badge.draw {
  background: rgba(255, 152, 0, 0.15);
  color: #FF9800;
}

.result-icon {
  font-size: 28rpx;
}

/* 出拳按钮 */
.choice-buttons {
  display: flex;
  justify-content: center;
  gap: 24rpx;
}

.choice-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08);
}

.choice-btn:active {
  transform: scale(0.95);
  background: #FFF3E0;
}

.choice-btn-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.choice-btn-text {
  font-size: 22rpx;
  color: #666;
}

/* 比赛结果 */
.phase-matchResult {
  text-align: center;
  padding-top: 80rpx;
}

.result-container {
  background: #fff;
  padding: 48rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
}

.result-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.result-score {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF9800;
  margin-bottom: 12rpx;
}

.result-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 32rpx;
}

.result-actions {
  display: flex;
  justify-content: center;
}

.action-btn {
  padding: 24rpx 48rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.action-btn.primary {
  background: linear-gradient(135deg, #FF9800 0%, #F57C00 100%);
  color: #fff;
}

.action-btn.secondary {
  background: #f5f5f5;
  color: #666;
}

/* 夺冠 */
.phase-champion {
  text-align: center;
  padding-top: 60rpx;
}

.champion-crown {
  font-size: 120rpx;
  margin-bottom: 16rpx;
  animation: crownBounce 1s ease-in-out infinite;
}

@keyframes crownBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-16rpx); }
}

.champion-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #FF9800;
  margin-bottom: 12rpx;
}

.champion-subtitle {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.champion-stats {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 40rpx;
}

.champion-actions {
  display: flex;
  justify-content: center;
  gap: 24rpx;
}

/* 撒花效果 */
.confetti-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 100;
}

.confetti {
  position: absolute;
  font-size: 48rpx;
  animation: confettiFall 2s ease-in forwards;
}

.confetti-1 { left: 10%; animation-delay: 0s; }
.confetti-2 { left: 30%; animation-delay: 0.2s; }
.confetti-3 { left: 50%; animation-delay: 0.4s; }
.confetti-4 { left: 70%; animation-delay: 0.1s; }
.confetti-5 { left: 85%; animation-delay: 0.3s; }
.confetti-6 { left: 45%; animation-delay: 0.5s; }

@keyframes confettiFall {
  0% { top: -10%; opacity: 1; transform: rotate(0deg); }
  100% { top: 110%; opacity: 0; transform: rotate(720deg); }
}
