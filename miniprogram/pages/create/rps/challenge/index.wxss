.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFF5F5 100%);
  padding: 32rpx;
}

/* 菜单阶段 */
.phase-menu {
  text-align: center;
  padding-top: 60rpx;
}

.header {
  margin-bottom: 48rpx;
}

.header-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF9800;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 28rpx;
  color: #666;
}

.progress-info {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 48rpx;
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.info-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.info-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF9800;
}

.start-btn {
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, #FF9800 0%, #F57C00 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: inline-block;
  box-shadow: 0 8rpx 24rpx rgba(255, 152, 0, 0.3);
}

.start-btn:active {
  transform: scale(0.98);
}

.reset-btn {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}

.back-btn {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}

/* 游戏阶段 */
.phase-playing {
  padding-top: 20rpx;
}

.level-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.level-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF9800;
}

.level-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.level-wins {
  font-size: 24rpx;
  color: #666;
  background: #FFF3E0;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
}

.level-lives {
  font-size: 28rpx;
}

/* 比分板 */
.scoreboard {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.score-side {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.score-side.score-win {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
}

.score-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.score-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF9800;
}

.score-divider {
  font-size: 28rpx;
  font-weight: bold;
  color: #ccc;
  padding: 0 24rpx;
}

/* 出拳区域 */
.battle-area {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}

.player-side {
  text-align: center;
}

.player-choice {
  width: 140rpx;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 50%;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 12rpx;
  transition: all 0.3s ease;
}

.player-choice.animating {
  animation: shake 0.3s ease-in-out infinite;
}

.player-choice.winner {
  box-shadow: 0 0 0 8rpx rgba(76, 175, 80, 0.3);
  transform: scale(1.1);
}

.player-choice.loser {
  opacity: 0.6;
  transform: scale(0.9);
}

@keyframes shake {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(15deg); }
  75% { transform: rotate(-15deg); }
}

.choice-icon {
  font-size: 72rpx;
}

.player-name {
  font-size: 24rpx;
  color: #666;
}

.vs-icon-container {
  margin: 0 32rpx;
}

.vs-icon {
  font-size: 40rpx;
  color: #FF9800;
  transition: all 0.3s ease;
}

.vs-icon.vs-animate {
  animation: vsPulse 0.5s ease-in-out;
}

@keyframes vsPulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.5); }
  100% { transform: scale(1); }
}

/* 回合结果 */
.round-result {
  text-align: center;
  margin-bottom: 32rpx;
  animation: fadeInUp 0.5s ease-out;
}

@keyframes fadeInUp {
  from { transform: translateY(20rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.result-badge {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.result-badge.win {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
}

.result-badge.lose {
  background: linear-gradient(135deg, #FFEBEE 0%, #FFCDD2 100%);
}

.result-badge.draw {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
}

.result-icon {
  font-size: 36rpx;
}

.result-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 选择按钮 */
.choice-buttons {
  display: flex;
  justify-content: center;
  gap: 24rpx;
}

.choice-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.choice-btn-inner {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.2s ease;
}

.choice-btn:active .choice-btn-inner {
  transform: scale(0.95);
  background: #FFF3E0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.choice-btn-icon {
  font-size: 56rpx;
}

.choice-btn-text {
  font-size: 22rpx;
  color: #666;
}

/* 关卡完成 */
.phase-levelComplete {
  text-align: center;
  padding-top: 80rpx;
}

.complete-container {
  background: #fff;
  padding: 48rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  animation: fadeInUp 0.5s ease-out;
}

.complete-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.complete-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF9800;
  margin-bottom: 16rpx;
}

.complete-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.complete-reward {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
}

.reward-icon {
  font-size: 32rpx;
}

.reward-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #FF9800;
}

.next-btn {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, #FF9800 0%, #F57C00 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(255, 152, 0, 0.3);
}

.next-btn:active {
  transform: scale(0.98);
}

.btn-text {
  font-size: 32rpx;
}

.btn-icon {
  font-size: 28rpx;
}

/* 游戏结束 */
.phase-gameOver {
  text-align: center;
  padding-top: 80rpx;
}

.gameover-container {
  background: #fff;
  padding: 48rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  animation: fadeInUp 0.5s ease-out;
}

.gameover-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.gameover-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #F44336;
  margin-bottom: 16rpx;
}

.gameover-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 32rpx;
}

.gameover-stats {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-bottom: 32rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF9800;
}

.gameover-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #FF9800 0%, #F57C00 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.action-btn.secondary {
  background: #f5f5f5;
  color: #666;
}

.action-btn:active {
  transform: scale(0.98);
}
