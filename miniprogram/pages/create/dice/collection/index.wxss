.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFE0B2 0%, #FFF5F5 100%);
  padding: 32rpx;
}

.header {
  text-align: center;
  padding: 40rpx 0;
}

.header-icon {
  font-size: 80rpx;
  margin-bottom: 12rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF5722;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 26rpx;
  color: #666;
}

.game-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 32rpx;
}

.game-card {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 32rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s ease;
}

.game-card:active {
  transform: scale(0.98);
}

.game-card.coming_soon {
  opacity: 0.7;
}

.game-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
}

.game-info {
  flex: 1;
}

.game-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.game-desc {
  font-size: 24rpx;
  color: #666;
}

.game-status {
  margin-left: 16rpx;
}

.status-tag {
  font-size: 22rpx;
  color: #FF9800;
  background: #FFF3E0;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.game-arrow {
  font-size: 36rpx;
  color: #ccc;
  margin-left: 16rpx;
}

.back-btn {
  text-align: center;
  font-size: 28rpx;
  color: #999;
  margin-top: 48rpx;
}
