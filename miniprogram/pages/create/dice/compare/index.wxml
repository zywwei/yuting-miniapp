<view class="container">
  <!-- 选择阶段 -->
  <view class="phase-select" wx:if="{{phase === 'select'}}">
    <view class="phase-title">选择对战模式</view>
    <view class="mode-buttons">
      <view class="mode-btn {{playMode === 'parent' ? 'active' : ''}}" bindtap="selectMode" data-mode="parent">
        <view class="mode-icon">👨‍👩‍👧</view>
        <view class="mode-text">亲子对战</view>
        <view class="mode-desc">轮流投骰比大小</view>
      </view>
      <view class="mode-btn {{playMode === 'ai' ? 'active' : ''}}" bindtap="selectMode" data-mode="ai">
        <view class="mode-icon">🤖</view>
        <view class="mode-text">人机对战</view>
        <view class="mode-desc">挑战AI对手</view>
      </view>
    </view>

    <view class="dice-count-section" wx:if="{{playMode}}">
      <view class="section-title">选择骰子数量</view>
      <view class="count-buttons">
        <view class="count-btn {{diceCount === 1 ? 'active' : ''}}" bindtap="selectDiceCount" data-count="1">1颗</view>
        <view class="count-btn {{diceCount === 2 ? 'active' : ''}}" bindtap="selectDiceCount" data-count="2">2颗</view>
        <view class="count-btn {{diceCount === 3 ? 'active' : ''}}" bindtap="selectDiceCount" data-count="3">3颗</view>
      </view>
      <view class="start-btn" bindtap="startGame">开始游戏</view>
    </view>

    <view class="back-btn" bindtap="goBack">返回</view>
  </view>

  <!-- 亲子模式：玩家1投掷 -->
  <view class="phase-playing" wx:if="{{phase === 'player1Roll'}}">
    <view class="turn-prompt">
      <view class="turn-icon">🎲</view>
      <view class="turn-text">玩家1 请投骰子</view>
    </view>

    <view class="battle-area">
      <view class="player-side">
        <view class="player-label">玩家1</view>
        <view class="dice-container">
          <block wx:for="{{player1Dice}}" wx:key="*this">
            <dice-face value="{{item}}" rolling="{{false}}" size="80"/>
          </block>
          <view class="dice-placeholder" wx:if="{{!player1Dice.length}}">
            <text class="placeholder-text">?</text>
          </view>
        </view>
      </view>
      <view class="vs-divider">VS</view>
      <view class="player-side">
        <view class="player-label">玩家2</view>
        <view class="dice-container">
          <view class="dice-placeholder">
            <text class="placeholder-text">?</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 中间大骰子 -->
    <view class="center-dice-area" wx:if="{{showCenterDice}}">
      <block wx:for="{{centerDiceValues}}" wx:key="*this">
        <dice-face value="{{item}}" rolling="{{centerDiceRolling}}" size="120"/>
      </block>
    </view>

    <view class="roll-btn {{isAnimating ? 'disabled' : ''}}" bindtap="rollDicePlayer1">
      <text class="roll-icon">🎲</text>
      <text class="roll-text">摇骰子</text>
    </view>
  </view>

  <!-- 亲子模式：玩家2投掷 -->
  <view class="phase-playing" wx:if="{{phase === 'player2Roll'}}">
    <view class="turn-prompt">
      <view class="turn-icon">🎲</view>
      <view class="turn-text">玩家2 请投骰子</view>
      <view class="turn-hint">玩家1已投完</view>
    </view>

    <view class="battle-area">
      <view class="player-side">
        <view class="player-label">玩家1</view>
        <view class="dice-container">
          <block wx:for="{{player1Dice}}" wx:key="*this">
            <dice-face value="{{item}}" rolling="{{false}}" size="80"/>
          </block>
        </view>
        <view class="player-sum" wx:if="{{player1Sum}}">合计: {{player1Sum}}</view>
      </view>
      <view class="vs-divider">VS</view>
      <view class="player-side">
        <view class="player-label">玩家2</view>
        <view class="dice-container">
          <block wx:for="{{player2Dice}}" wx:key="*this">
            <dice-face value="{{item}}" rolling="{{false}}" size="80"/>
          </block>
          <view class="dice-placeholder" wx:if="{{!player2Dice.length}}">
            <text class="placeholder-text">?</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 中间大骰子 -->
    <view class="center-dice-area" wx:if="{{showCenterDice}}">
      <block wx:for="{{centerDiceValues}}" wx:key="*this">
        <dice-face value="{{item}}" rolling="{{centerDiceRolling}}" size="120"/>
      </block>
    </view>

    <view class="roll-btn {{isAnimating ? 'disabled' : ''}}" bindtap="rollDicePlayer2">
      <text class="roll-icon">🎲</text>
      <text class="roll-text">摇骰子</text>
    </view>
  </view>

  <!-- 人机模式：投掷阶段 -->
  <view class="phase-playing" wx:if="{{phase === 'playing'}}">
    <!-- 比分板 -->
    <view class="scoreboard">
      <view class="score-side {{roundResult === 'win' ? 'score-win' : ''}}">
        <view class="score-label">我</view>
        <view class="score-value">{{player1Wins}}</view>
      </view>
      <view class="score-divider">VS</view>
      <view class="score-side {{roundResult === 'lose' ? 'score-win' : ''}}">
        <view class="score-label">AI</view>
        <view class="score-value">{{player2Wins}}</view>
      </view>
    </view>

    <view class="battle-area">
      <view class="player-side">
        <view class="player-label">我</view>
        <view class="dice-container">
          <block wx:for="{{player1Dice}}" wx:key="*this">
            <dice-face value="{{item}}" rolling="{{false}}" size="80"/>
          </block>
          <view class="dice-placeholder" wx:if="{{!player1Dice.length}}">
            <text class="placeholder-text">?</text>
          </view>
        </view>
        <view class="player-sum" wx:if="{{player1Sum}}">合计: {{player1Sum}}</view>
      </view>
      <view class="vs-divider">VS</view>
      <view class="player-side">
        <view class="player-label">AI</view>
        <view class="dice-container">
          <block wx:for="{{player2Dice}}" wx:key="*this">
            <dice-face value="{{item}}" rolling="{{false}}" size="80"/>
          </block>
          <view class="dice-placeholder" wx:if="{{!player2Dice.length}}">
            <text class="placeholder-text">?</text>
          </view>
        </view>
        <view class="player-sum" wx:if="{{player2Sum}}">合计: {{player2Sum}}</view>
      </view>
    </view>

    <!-- 中间大骰子 -->
    <view class="center-dice-area" wx:if="{{showCenterDice}}">
      <block wx:for="{{centerDiceValues}}" wx:key="*this">
        <dice-face value="{{item}}" rolling="{{centerDiceRolling}}" size="120"/>
      </block>
    </view>

    <view class="roll-btn {{isAnimating ? 'disabled' : ''}}" bindtap="rollDice">
      <text class="roll-icon">🎲</text>
      <text class="roll-text">摇骰子</text>
    </view>
  </view>

  <!-- 结果阶段 -->
  <view class="phase-result" wx:if="{{phase === 'result'}}">
    <!-- 比分板 -->
    <view class="scoreboard">
      <view class="score-side {{roundResult === 'win' ? 'score-win' : ''}}">
        <view class="score-label">{{playMode === 'parent' ? '玩家1' : '我'}}</view>
        <view class="score-value">{{player1Wins}}</view>
      </view>
      <view class="score-divider">VS</view>
      <view class="score-side {{roundResult === 'lose' ? 'score-win' : ''}}">
        <view class="score-label">{{playMode === 'parent' ? '玩家2' : 'AI'}}</view>
        <view class="score-value">{{player2Wins}}</view>
      </view>
    </view>

    <!-- 回合结果 - 简洁展示 -->
    <view class="round-result-simple">
      <view class="result-emoji">{{roundResultIcon}}</view>
      <view class="result-text-simple {{roundResult}}">{{roundResultText}}</view>
    </view>

    <!-- 骰子展示 -->
    <view class="battle-area">
      <view class="player-side {{roundResult === 'win' ? 'winner' : ''}}">
        <view class="player-label">{{playMode === 'parent' ? '玩家1' : '我'}}</view>
        <view class="dice-container">
          <block wx:for="{{player1Dice}}" wx:key="*this">
            <dice-face value="{{item}}" rolling="{{false}}" size="80"/>
          </block>
        </view>
        <view class="player-sum">合计: {{player1Sum}}</view>
        <view class="special-badge" wx:if="{{player1Special}}">
          <text>{{player1Special.icon}} {{player1Special.name}} (+{{player1Special.bonus}})</text>
        </view>
      </view>
      <view class="vs-divider">VS</view>
      <view class="player-side {{roundResult === 'lose' ? 'winner' : ''}}">
        <view class="player-label">{{playMode === 'parent' ? '玩家2' : 'AI'}}</view>
        <view class="dice-container">
          <block wx:for="{{player2Dice}}" wx:key="*this">
            <dice-face value="{{item}}" rolling="{{false}}" size="80"/>
          </block>
        </view>
        <view class="player-sum">合计: {{player2Sum}}</view>
        <view class="special-badge" wx:if="{{player2Special}}">
          <text>{{player2Special.icon}} {{player2Special.name}} (+{{player2Special.bonus}})</text>
        </view>
      </view>
    </view>

    <!-- 撒花效果 -->
    <view class="confetti-container" wx:if="{{showConfetti}}">
      <view class="confetti confetti-1">🎉</view>
      <view class="confetti confetti-2">🎊</view>
      <view class="confetti confetti-3">✨</view>
      <view class="confetti confetti-4">🎉</view>
      <view class="confetti confetti-5">🎊</view>
      <view class="confetti confetti-6">✨</view>
    </view>

    <!-- 游戏结果 -->
    <view class="game-result" wx:if="{{gameResult}}">
      <view class="game-result-badge {{gameResult}}">
        <view class="game-result-icon">{{gameResult === 'win' ? '🏆' : gameResult === 'lose' ? '🏆' : '🤝'}}</view>
        <view class="game-result-text">{{gameResultText}}</view>
        <view class="game-result-score">{{player1Wins}} : {{player2Wins}}</view>
      </view>
      <view class="game-result-actions">
        <view class="result-btn primary" bindtap="playAgain">
          <text class="btn-icon">🔄</text>
          <text class="btn-text">再来一局</text>
        </view>
        <view class="result-btn secondary" bindtap="goBack">
          <text class="btn-icon">🏠</text>
          <text class="btn-text">返回</text>
        </view>
      </view>
    </view>

    <!-- 下一局按钮 -->
    <view class="next-round" wx:if="{{!gameResult}}" bindtap="nextRound">
      <text class="next-round-icon">▶</text>
      <text class="next-round-text">下一局</text>
    </view>
  </view>
</view>
