<!-- 成长笔记首页 -->
<view class="container">
  <!-- 孩子切换器 -->
  <view class="switcher-wrapper" wx:if="{{children.length > 1}}">
    <child-switcher children="{{children}}" currentChildId="{{currentChildId}}" bind:childChanged="onChildChanged" />
  </view>

  <!-- 头部 -->
  <view class="header">
    <view class="header-left">
      <view class="header-title">📝 成长笔记</view>
      <view class="header-desc">共 {{totalCount}} 篇笔记</view>
    </view>
    <view class="header-actions">
      <view class="action-btn" bindtap="toggleSearch">
        <text>{{showSearch ? '✕' : '🔍'}}</text>
      </view>
      <view class="add-btn" bindtap="addNote">+ 写笔记</view>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar" wx:if="{{showSearch}}">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索笔记标题、内容或标签" value="{{searchKeyword}}" bindinput="onSearchInput" focus="{{showSearch}}" />
      <text class="search-clear" wx:if="{{searchKeyword}}" bindtap="clearSearch">✕</text>
    </view>
    <view class="search-options">
      <view class="search-option" bindtap="toggleAdvancedSearch">
        <text>{{showAdvancedSearch ? '收起筛选' : '高级筛选'}}</text>
        <text class="option-arrow">{{showAdvancedSearch ? '▲' : '▼'}}</text>
      </view>
      <view class="search-option" bindtap="toggleSortOrder">
        <text>{{sortOrder === 'desc' ? '最新优先' : '最早优先'}}</text>
        <text class="option-arrow">↕</text>
      </view>
    </view>
    
    <!-- 高级搜索面板 -->
    <view class="advanced-search" wx:if="{{showAdvancedSearch}}">
      <view class="search-row">
        <view class="search-label">时间范围</view>
        <view class="date-range">
          <picker mode="date" value="{{searchDateStart}}" bindchange="onStartDateChange">
            <view class="date-picker {{searchDateStart ? 'has-value' : ''}}">{{searchDateStart || '开始日期'}}</view>
          </picker>
          <view class="date-separator">至</view>
          <picker mode="date" value="{{searchDateEnd}}" bindchange="onEndDateChange">
            <view class="date-picker {{searchDateEnd ? 'has-value' : ''}}">{{searchDateEnd || '结束日期'}}</view>
          </picker>
        </view>
      </view>
      
      <view class="search-row" wx:if="{{allTags.length > 0}}">
        <view class="search-label">按标签</view>
        <picker range="{{allTags}}" value="{{searchTag}}" bindchange="onTagChange">
          <view class="tag-picker {{searchTag ? 'has-value' : ''}}">{{searchTag || '选择标签'}}</view>
        </picker>
      </view>
    </view>
    
    <view class="search-result" wx:if="{{searchKeyword || searchDateStart || searchDateEnd || searchTag}}">
      找到 {{noteCount}} 篇笔记
    </view>
  </view>

  <!-- 分类Tab -->
  <view class="category-tabs">
    <view 
      wx:for="{{categories}}" 
      wx:key="value"
      class="tab-item {{currentCategory === item.value ? 'active' : ''}}"
      bindtap="switchCategory"
      data-category="{{item.value}}"
    >
      <view class="tab-icon">{{item.icon}}</view>
      <view class="tab-label">{{item.label}}</view>
    </view>
  </view>

  <!-- 笔记列表 -->
  <view class="note-list" wx:if="{{notes.length > 0}}">
    <view
      wx:for="{{notes}}"
      wx:key="id"
      class="note-card {{item._swiped ? 'swiped' : ''}}"
      data-id="{{item.id}}"
      data-index="{{index}}"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
    >
      <view class="note-content-wrap" bindtap="goDetail" data-id="{{item.id}}">
        <view class="note-header">
          <view class="note-type-tag {{item.type}}">
            {{item.type === 'diary' ? '📖 日记' : item.type === 'funny' ? '😄 趣事' : '📚 学习'}}
          </view>
          <view class="note-header-right">
            <view class="visibility-tag {{item.visibility || 'family'}}">
              {{item.visibility === 'private' ? '🔒' : item.visibility === 'designated' ? '👥' : '👨‍👩‍👧‍👦'}}
            </view>
            <view class="note-mood">{{item.mood === 'happy' ? '😊' : item.mood === 'excited' ? '🤩' : item.mood === 'calm' ? '😌' : '😴'}}</view>
          </view>
        </view>
        <view class="note-body">
          <view class="note-text">
            <view class="note-title">{{item.title}}</view>
            <view class="note-content">{{item.content}}</view>
          </view>
          <view class="note-thumbnail" wx:if="{{item.images && item.images.length > 0}}">
            <image src="{{item.images[0]}}" mode="aspectFill" class="thumbnail-img" />
            <view class="image-count" wx:if="{{item.images.length > 1}}">+{{item.images.length - 1}}</view>
          </view>
        </view>
        <view class="note-footer">
          <view class="note-date">{{item._formattedTime}}</view>
          <view class="note-tags" wx:if="{{item.tags && item.tags.length > 0}}">
            <view wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</view>
          </view>
        </view>
      </view>
      <view class="note-delete" wx:if="{{item._canDelete}}" catchtap="deleteNote" data-id="{{item.id}}" data-title="{{item.title}}">
        <text class="delete-icon">删除</text>
      </view>
    </view>
  </view>

  <!-- 加载更多提示 -->
  <view class="load-more" wx:if="{{hasMore && notes.length > 0}}">
    <text class="load-more-text">上拉加载更多</text>
  </view>
  <view class="load-more" wx:if="{{!hasMore && notes.length > 0}}">
    <text class="load-more-text">已显示全部 {{noteCount}} 篇笔记</text>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{notes.length === 0 && !showEmpty}}" class="empty">
    <view class="empty-icon">📝</view>
    <view class="empty-text">还没有笔记，快来记录成长的瞬间吧</view>
    <view class="empty-btn" bindtap="addNote">写笔记</view>
  </view>

  <!-- 搜索无结果 -->
  <view wx:if="{{showEmpty}}" class="empty">
    <view class="empty-icon">🔍</view>
    <view class="empty-text">未找到匹配的笔记</view>
    <view class="empty-desc">试试调整搜索条件</view>
    <view class="empty-btn" bindtap="clearSearch">清除搜索</view>
  </view>
</view>
