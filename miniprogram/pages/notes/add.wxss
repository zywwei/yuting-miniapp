/* 注：WXSS 不支持 :root，变量已全部硬编码展开 */
/* ===== 设计Token（成长笔记主题） ===== */


/* 添加笔记页样式 */
.container {
  min-height: 100vh;
  background: #FFFBF5;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 覆盖 editor 默认样式 */
.title-editor .ql-container {
  min-height: 50rpx !important;
}

.title-editor .ql-editor {
  min-height: 50rpx !important;
  padding: 10rpx 0 !important;
}

.section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(74, 63, 53, 0.06);
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #4A3F35;
  margin-bottom: 20rpx;
}

.section-title.collapsible {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 0;
  cursor: pointer;
}

.collapse-arrow {
  font-size: 24rpx;
  color: #A89B8C;
  transition: transform 0.3s;
}

.collapse-arrow.collapsed {
  transform: rotate(-90deg);
}

.collapse-content {
  overflow: hidden;
  transition: max-height 0.3s ease-out;
  max-height: 2000rpx;
}

.collapse-content.hidden {
  max-height: 0;
  margin-top: 0;
}

.collapse-content:not(.hidden) {
  margin-top: 20rpx;
}

/* 笔记类型选择 */
.type-group-label {
  font-size: 22rpx;
  color: #A89B8C;
  margin: 16rpx 0 12rpx;
}

.type-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.type-item {
  min-width: 140rpx;
  text-align: center;
  padding: 20rpx 16rpx;
  background: #F7F0E6;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.type-item.selected {
  border-color: #FF8FA3;
  background: rgba(255, 143, 163, 0.1);
}

.type-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.type-label {
  font-size: 22rpx;
  color: #A89B8C;
}

.type-item.selected .type-label {
  color: #FF8FA3;
  font-weight: bold;
}

.title-editor {
  font-size: 36rpx;
  font-weight: bold;
  color: #4A3F35;
  height: 50rpx !important;
  min-height: 50rpx !important;
}

.title-section {
  padding: 16rpx 32rpx !important;
}

.content-editor {
  width: 100%;
  min-height: 300rpx;
  font-size: 28rpx;
  color: #4A3F35;
  line-height: 1.8;
}

/* 字数提示 */
.char-count {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  font-size: 22rpx;
  color: #A89B8C;
}

.char-count.warning {
  color: #F0B429;
}

.char-count.danger {
  color: #FF5A5A;
}

/* 心情选择 */
.mood-group-label {
  font-size: 22rpx;
  color: #A89B8C;
  margin: 16rpx 0 12rpx;
}

.mood-scroll {
  white-space: nowrap;
  width: 100%;
}

.mood-list {
  display: inline-flex;
  gap: 16rpx;
  padding-bottom: 8rpx;
}

.mood-item {
  flex-shrink: 0;
  min-width: 100rpx;
  text-align: center;
  padding: 16rpx 12rpx;
  background: #F7F0E6;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.mood-item.selected {
  border-color: #FF8FA3;
  background: rgba(255, 143, 163, 0.1);
}

.mood-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.mood-label {
  font-size: 22rpx;
  color: #A89B8C;
}

.tag-input-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.tag-input {
  flex: 1;
  background: #F7F0E6;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #4A3F35;
}

.tag-add-btn {
  background: #FF8FA3;
  color: white;
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  transition: transform 0.2s ease;
}

.tag-add-btn:active {
  transform: scale(0.95);
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 143, 163, 0.1);
  color: #FF8FA3;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
}

.tag-remove {
  font-size: 28rpx;
  color: #A89B8C;
  margin-left: 4rpx;
}

/* 照片区域 */
.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  transition: transform 0.2s ease;
}

.photo-item.sorting {
  transform: scale(1.05);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
  z-index: 10;
}

.sort-badge {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 32rpx;
  height: 32rpx;
  background: rgba(255, 143, 163, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
}

.sort-hint {
  text-align: center;
  padding: 16rpx;
  font-size: 22rpx;
  color: #A89B8C;
}

.sort-done-btn {
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 24rpx;
  background: #FF8FA3;
  color: white;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-edit {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.photo-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(255,0,0,0.7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: white;
}

.photo-add {
  width: 160rpx;
  height: 160rpx;
  border: 3rpx dashed #A89B8C;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #F7F0E6;
}

.add-icon {
  font-size: 40rpx;
}

.add-text {
  font-size: 22rpx;
  color: #A89B8C;
}

.photo-hint {
  font-size: 22rpx;
  color: #A89B8C;
  margin-top: 12rpx;
}

/* 保存按钮区域 */
.save-area {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.save-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 28rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: bold;
  transition: transform 0.2s ease;
}

.save-btn:active {
  transform: scale(0.98);
}

.save-btn-icon {
  font-size: 32rpx;
}

.save-btn-text {
  font-size: 28rpx;
}

/* 草稿按钮 - 浅色 */
.draft-btn {
  background: #F7F0E6;
  color: #4A3F35;
  border: 2rpx solid rgba(74, 63, 53, 0.1);
  box-shadow: 0 4rpx 20rpx rgba(74, 63, 53, 0.06);
}

/* 发布按钮 - 主色 */
.publish-btn {
  background: linear-gradient(135deg, #E8708A 0%, #D85878 100%);
  color: #fff;
  box-shadow: 0 4rpx 16rpx rgba(232, 112, 138, 0.4);
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 可见范围选择 */
.visibility-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.visibility-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #F7F0E6;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.visibility-item.selected {
  border-color: #FF8FA3;
  background: rgba(255, 143, 163, 0.1);
}

.visibility-icon {
  font-size: 40rpx;
}

.visibility-info {
  flex: 1;
}

.visibility-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #4A3F35;
  margin-bottom: 4rpx;
}

.visibility-item.selected .visibility-label {
  color: #FF8FA3;
}

.visibility-desc {
  font-size: 22rpx;
  color: #A89B8C;
}

/* 成员选择 */
.member-select {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(74, 63, 53, 0.1);
}

.member-title {
  font-size: 28rpx;
  color: #A89B8C;
  margin-bottom: 16rpx;
}

.member-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.member-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx;
  background: #F7F0E6;
  border-radius: 12rpx;
  border: 3rpx solid transparent;
  min-width: 120rpx;
  transition: all 0.2s;
}

.member-item.selected {
  border-color: #FF8FA3;
  background: rgba(255, 143, 163, 0.1);
  box-shadow: 0 4rpx 12rpx rgba(255, 143, 163, 0.2);
}

.member-item.selected .member-avatar-wrap {
  background: rgba(255, 143, 163, 0.2);
}

.member-item.selected .member-avatar-default {
  background: linear-gradient(135deg, rgba(255, 143, 163, 0.2), rgba(255, 143, 163, 0.3));
}

.member-avatar-wrap {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #F7F0E6;
}

.member-check {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 24rpx;
  height: 24rpx;
  background: #FF8FA3;
  color: white;
  font-size: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 2rpx solid white;
}

.member-avatar {
  width: 100%;
  height: 100%;
}

.member-avatar-default {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: linear-gradient(135deg, #F7F0E6, rgba(255, 143, 163, 0.1));
}

.member-name {
  font-size: 22rpx;
  color: #A89B8C;
}

.member-item.selected .member-name {
  color: #FF8FA3;
  font-weight: bold;
}

.member-empty {
  text-align: center;
  padding: 24rpx;
  color: #A89B8C;
  font-size: 22rpx;
}

/* 创建类型按钮 */
.create-type {
  border: 3rpx dashed #A89B8C;
  background: transparent;
}

/* 自定义类型弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  width: 80%;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.2);
}

.modal-title {
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
  color: #4A3F35;
}

.modal-input {
  background: #F7F0E6;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  color: #4A3F35;
}

.modal-icons {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
  margin-bottom: 30rpx;
}

.modal-icon-item {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: #F7F0E6;
  border-radius: 12rpx;
  border: 3rpx solid transparent;
}

.modal-icon-item.selected {
  border-color: #FF8FA3;
  background: rgba(255, 143, 163, 0.1);
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  transition: transform 0.2s ease;
}

.modal-btn.cancel {
  background: #F7F0E6;
  color: #4A3F35;
}

.modal-btn.confirm {
  background: linear-gradient(135deg, #E8708A 0%, #D85878 100%);
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.modal-btn:active {
  transform: scale(0.98);
}

/* 格式工具栏 */
.format-toolbar {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 16rpx;
  background: #F7F0E6;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.toolbar-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 8rpx;
  transition: all 0.2s ease;
}

.toolbar-btn:active {
  transform: scale(0.95);
}

.toolbar-btn.active {
  background: linear-gradient(135deg, #E8708A 0%, #D85878 100%);
  color: white;
  box-shadow: 0 2rpx 8rpx rgba(232, 112, 138, 0.4);
}

.toolbar-icon {
  font-size: 28rpx;
  font-weight: bold;
  color: #4A3F35;
}

.toolbar-btn.active .toolbar-icon {
  color: white;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.2);
}

.toolbar-divider {
  width: 2rpx;
  height: 32rpx;
  background: rgba(74, 63, 53, 0.1);
  margin: 0 4rpx;
}

/* 草稿恢复提示框 */
.draft-info {
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #A89B8C;
  line-height: 1.6;
}

/* 语音录制 */
.voice-record-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
}

.voice-btn {
  width: 160rpx;
  height: 160rpx;
  background: #F7F0E6;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border: 4rpx solid transparent;
  transition: all 0.2s ease;
}

.voice-btn.recording {
  background: rgba(255, 90, 90, 0.1);
  border-color: #FF5A5A;
  animation: recordPulse 1s ease-in-out infinite;
}

@keyframes recordPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.voice-icon {
  font-size: 48rpx;
}

.voice-text {
  font-size: 22rpx;
  color: #A89B8C;
}

.voice-duration {
  font-size: 22rpx;
  color: #A89B8C;
}

.voice-list {
  margin-top: 16rpx;
}

.voice-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  background: #F7F0E6;
  border-radius: 24rpx;
}

.voice-play-btn {
  width: 64rpx;
  height: 64rpx;
  background: #FF8FA3;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  transition: transform 0.2s ease;
}

.voice-play-btn:active {
  transform: scale(0.95);
}

.voice-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.voice-wave {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 40rpx;
}

.wave-bar {
  width: 6rpx;
  background: #FF8FA3;
  border-radius: 3rpx;
  transition: height 0.1s ease;
}

.voice-duration-text {
  font-size: 22rpx;
  color: #A89B8C;
}

.voice-delete {
  width: 48rpx;
  height: 48rpx;
  background: rgba(255, 90, 90, 0.1);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #FF5A5A;
}

.voice-hint {
  font-size: 22rpx;
  color: #A89B8C;
  margin-top: 12rpx;
}

/* 标签推荐 */
.tag-suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
  padding: 16rpx;
  background: #F7F0E6;
  border-radius: 12rpx;
}

.tag-suggestion-item {
  font-size: 22rpx;
  color: #FF8FA3;
  background: rgba(255, 143, 163, 0.1);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 143, 163, 0.2);
  transition: all 0.2s ease;
}

.tag-suggestion-item:active {
  background: rgba(255, 143, 163, 0.2);
  transform: scale(0.95);
}
