/* 添加笔记页样式 */
.container {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 30rpx;
}

.section {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 笔记类型选择 */
.type-list {
  display: flex;
  gap: 16rpx;
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 12rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.type-item.selected {
  border-color: #66BB6A;
  background: #E8F5E9;
}

.type-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.type-label {
  font-size: 22rpx;
  color: #666;
}

.type-item.selected .type-label {
  color: #43A047;
  font-weight: bold;
}

.title-input {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
}

.mood-list {
  display: flex;
  gap: 24rpx;
}

.mood-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.mood-item.selected {
  border-color: #FF6B8A;
  background: #FFF0F3;
}

.mood-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.mood-label {
  font-size: 22rpx;
  color: #666;
}

.tag-input-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.tag-input {
  flex: 1;
  background: #F5F7FA;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

.tag-add-btn {
  background: #FF6B8A;
  color: white;
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.tag-add-btn:active {
  opacity: 0.9;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #E8F5E9;
  color: #43A047;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.tag-remove {
  font-size: 28rpx;
  color: #999;
  margin-left: 4rpx;
}

/* 照片区域 */
.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-edit {
  position: absolute;
  bottom: 8rpx;
  left: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.photo-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(255,0,0,0.7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  color: white;
}

.photo-add {
  width: 160rpx;
  height: 160rpx;
  border: 3rpx dashed #DDD;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-icon {
  font-size: 40rpx;
}

.add-text {
  font-size: 22rpx;
  color: #999;
}

.photo-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}

.save-btn {
  margin-top: 40rpx;
  background: linear-gradient(135deg, #66BB6A, #43A047);
  color: white;
  text-align: center;
  padding: 28rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}

.save-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* 可见范围选择 */
.visibility-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.visibility-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.visibility-item.selected {
  border-color: #66BB6A;
  background: #E8F5E9;
}

.visibility-icon {
  font-size: 40rpx;
}

.visibility-info {
  flex: 1;
}

.visibility-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.visibility-item.selected .visibility-label {
  color: #43A047;
}

.visibility-desc {
  font-size: 22rpx;
  color: #999;
}

/* 成员选择 */
.member-select {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #EEE;
}

.member-title {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.member-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.member-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  border: 3rpx solid transparent;
  min-width: 120rpx;
  transition: all 0.2s;
}

.member-item.selected {
  border-color: #43A047;
  background: #E8F5E9;
  box-shadow: 0 4rpx 12rpx rgba(67, 160, 71, 0.2);
}

.member-item.selected .member-avatar-wrap {
  background: #C8E6C9;
}

.member-item.selected .member-avatar-default {
  background: linear-gradient(135deg, #C8E6C9, #A5D6A7);
}

.member-avatar-wrap {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #E8F5E9;
}

.member-check {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 24rpx;
  height: 24rpx;
  background: #43A047;
  color: white;
  font-size: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 2rpx solid white;
}

.member-avatar {
  width: 100%;
  height: 100%;
}

.member-avatar-default {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  background: linear-gradient(135deg, #E8F5E9, #C8E6C9);
}

.member-name {
  font-size: 22rpx;
  color: #666;
}

.member-item.selected .member-name {
  color: #43A047;
  font-weight: bold;
}

.member-empty {
  text-align: center;
  padding: 24rpx;
  color: #999;
  font-size: 24rpx;
}
