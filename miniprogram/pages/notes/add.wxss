/* 添加笔记页样式 */
.container {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 30rpx;
}

.section {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 笔记类型选择 */
.type-list {
  display: flex;
  gap: 16rpx;
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 12rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.type-item.selected {
  border-color: #66BB6A;
  background: #E8F5E9;
}

.type-icon {
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.type-label {
  font-size: 22rpx;
  color: #666;
}

.type-item.selected .type-label {
  color: #43A047;
  font-weight: bold;
}

.title-input {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
}

.mood-list {
  display: flex;
  gap: 24rpx;
}

.mood-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: #F5F7FA;
  border-radius: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s;
}

.mood-item.selected {
  border-color: #FF6B8A;
  background: #FFF0F3;
}

.mood-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.mood-label {
  font-size: 22rpx;
  color: #666;
}

.tag-input-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.tag-input {
  flex: 1;
  background: #F5F7FA;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
}

.tag-add-btn {
  background: #FF6B8A;
  color: white;
  padding: 16rpx 32rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.tag-add-btn:active {
  opacity: 0.9;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #E8F5E9;
  color: #43A047;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.tag-remove {
  font-size: 28rpx;
  color: #999;
  margin-left: 4rpx;
}

.save-btn {
  margin-top: 40rpx;
  background: linear-gradient(135deg, #66BB6A, #43A047);
  color: white;
  text-align: center;
  padding: 28rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}

.save-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}
