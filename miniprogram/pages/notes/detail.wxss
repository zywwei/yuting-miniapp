/* 注：WXSS 不支持 :root，变量已全部硬编码展开 */
/* ===== 设计Token（成长笔记主题） ===== */


/* 笔记详情页样式 */
.container {
  min-height: 100vh;
  background: #FFFBF5;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 30rpx;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.note-type-tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  background: rgba(255, 143, 163, 0.1);
  color: #FF8FA3;
}

.note-type-tag.diary {
  background: rgba(127, 176, 105, 0.1);
  color: #7FB069;
}

.note-type-tag.funny {
  background: rgba(240, 180, 41, 0.1);
  color: #F0B429;
}

.note-type-tag.learning {
  background: rgba(168, 155, 140, 0.1);
  color: #A89B8C;
}

.visibility-tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(74, 63, 53, 0.05);
  color: #A89B8C;
}

.visibility-tag.private {
  background: rgba(240, 180, 41, 0.1);
  color: #F0B429;
}

.visibility-tag.designated {
  background: rgba(127, 176, 105, 0.1);
  color: #7FB069;
}

.visibility-tag.family {
  background: rgba(255, 143, 163, 0.1);
  color: #FF8FA3;
}

.mood {
  font-size: 48rpx;
}

.date {
  font-size: 22rpx;
  color: #A89B8C;
  margin-top: 16rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #4A3F35;
  margin-bottom: 24rpx;
  background: #FFFFFF;
  padding: 24rpx 32rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(74, 63, 53, 0.06);
  text-align: center;
}

.content {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  font-size: 28rpx;
  color: #4A3F35;
  line-height: 1.8;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(74, 63, 53, 0.06);
}

/* 图片网格样式 */
.images-section {
  margin-bottom: 24rpx;
  padding: 0 30rpx;
}

.images-grid {
  display: grid;
  gap: 12rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.images-grid.single {
  grid-template-columns: 1fr;
}

.images-grid.double {
  grid-template-columns: 1fr 1fr;
}

.images-grid.quad {
  grid-template-columns: 1fr 1fr;
}

.images-grid.multi {
  grid-template-columns: 1fr 1fr 1fr;
}

.image-item {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  overflow: hidden;
}

.images-grid.single .image-item {
  padding-bottom: 75%;
}

.note-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
  padding: 0 30rpx;
}

.tag {
  background: rgba(255, 143, 163, 0.1);
  color: #FF8FA3;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(255, 143, 163, 0.2);
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 16rpx 30rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 -4rpx 20rpx rgba(74, 63, 53, 0.06);
  z-index: 100;
}

.bar-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  transition: transform 0.2s ease;
}

.bar-action:active {
  transform: scale(0.95);
}

.bar-icon {
  font-size: 40rpx;
}

.bar-text {
  font-size: 22rpx;
  color: #A89B8C;
}

.bar-action.liked .bar-icon {
  color: #FF5A5A;
}

.bar-action.edit,
.bar-action.delete {
  color: #A89B8C;
}

/* Hero图区域 */
.hero-section {
  position: relative;
  width: 100%;
  height: 420rpx;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(180deg, transparent, #FFFBF5);
}

/* 作者行 */
.author-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 30rpx;
  margin-bottom: 24rpx;
}

.author-avatar {
  width: 72rpx;
  height: 72rpx;
  background: #F7F0E6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #4A3F35;
  font-weight: bold;
}

.author-info {
  flex: 1;
}

.author-name {
  font-size: 28rpx;
  color: #4A3F35;
  font-weight: bold;
}

.author-date {
  font-size: 22rpx;
  color: #A89B8C;
  margin-top: 4rpx;
}

.mood-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #F7F0E6;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.mood-icon {
  font-size: 32rpx;
}

.mood-text {
  font-size: 22rpx;
  color: #A89B8C;
}

/* 评论区 */
.comment-section {
  padding: 0 30rpx;
  margin-bottom: 24rpx;
}

/* 分享卡片canvas */
.share-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 600rpx;
  height: 800rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #4A3F35;
  margin-bottom: 16rpx;
}

/* 语音播放器 */
.voice-player {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  margin-left: 30rpx;
  margin-right: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(74, 63, 53, 0.06);
}

.voice-play-btn {
  width: 72rpx;
  height: 72rpx;
  background: #FF8FA3;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  transition: transform 0.2s ease;
}

.voice-play-btn:active {
  transform: scale(0.95);
}

.voice-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.voice-wave {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 40rpx;
}

.wave-bar {
  width: 6rpx;
  height: 10rpx;
  background: #FF8FA3;
  border-radius: 3rpx;
  transition: height 0.2s ease;
}

.wave-bar.playing {
  animation: waveAnimation 0.5s ease-in-out infinite alternate;
}

.wave-bar:nth-child(1) { animation-delay: 0s; }
.wave-bar:nth-child(2) { animation-delay: 0.1s; }
.wave-bar:nth-child(3) { animation-delay: 0.2s; }
.wave-bar:nth-child(4) { animation-delay: 0.3s; }
.wave-bar:nth-child(5) { animation-delay: 0.4s; }
.wave-bar:nth-child(6) { animation-delay: 0.5s; }
.wave-bar:nth-child(7) { animation-delay: 0.6s; }
.wave-bar:nth-child(8) { animation-delay: 0.7s; }
.wave-bar:nth-child(9) { animation-delay: 0.8s; }
.wave-bar:nth-child(10) { animation-delay: 0.9s; }

@keyframes waveAnimation {
  0% { height: 10rpx; }
  100% { height: 40rpx; }
}

.voice-duration {
  font-size: 22rpx;
  color: #A89B8C;
}

/* 上下篇导航 */
.note-navigation {
  display: flex;
  justify-content: space-between;
  padding: 24rpx 30rpx;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.nav-btn {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(74, 63, 53, 0.06);
  transition: all 0.2s ease;
}

.nav-btn.disabled {
  opacity: 0.5;
}

.nav-btn:active:not(.disabled) {
  transform: scale(0.98);
  box-shadow: 0 8rpx 28rpx rgba(74, 63, 53, 0.10);
}

.nav-arrow {
  font-size: 24rpx;
  color: #FF8FA3;
}

.nav-info {
  flex: 1;
  overflow: hidden;
}

.nav-info.right {
  text-align: right;
}

.nav-label {
  font-size: 22rpx;
  color: #A89B8C;
  display: block;
}

.nav-title {
  font-size: 22rpx;
  color: #4A3F35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: block;
  margin-top: 4rpx;
}
