/* 笔记详情页样式 */
.container {
  min-height: 100vh;
  background: #F5F7FA;
  padding: 30rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.note-type-tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  background: #E8F5E9;
  color: #43A047;
}

.note-type-tag.diary {
  background: #E3F2FD;
  color: #1976D2;
}

.note-type-tag.funny {
  background: #FFF3E0;
  color: #F57C00;
}

.note-type-tag.learning {
  background: #E8F5E9;
  color: #43A047;
}

.mood {
  font-size: 48rpx;
}

.date {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.content {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 24rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 40rpx;
}

.tag {
  background: #E8F5E9;
  color: #43A047;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
}

.actions {
  text-align: center;
  margin-top: 60rpx;
}

.delete-btn {
  display: inline-block;
  color: #FF4444;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border: 2rpx solid #FF4444;
  border-radius: 40rpx;
}

.delete-btn:active {
  background: #FFF0F0;
}
