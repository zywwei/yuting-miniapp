/* 笔记详情页样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f5e9 0%, #f5f5f5 100%);
  padding: 30rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.note-type-tag {
  display: inline-block;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  background: #E8F5E9;
  color: #43A047;
}

.note-type-tag.diary {
  background: #E3F2FD;
  color: #1976D2;
}

.note-type-tag.funny {
  background: #FFF3E0;
  color: #F57C00;
}

.note-type-tag.learning {
  background: #E8F5E9;
  color: #43A047;
}

.visibility-tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.05);
  color: #666;
}

.visibility-tag.private {
  background: #FFF3E0;
  color: #F57C00;
}

.visibility-tag.designated {
  background: #E3F2FD;
  color: #1976D2;
}

.visibility-tag.family {
  background: #E8F5E9;
  color: #43A047;
}

.mood {
  font-size: 48rpx;
}

.date {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.9);
  padding: 24rpx 32rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  text-align: center;
}

.content {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 32rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 24rpx;
  backdrop-filter: blur(10px);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

/* 图片网格样式 */
.images-section {
  margin-bottom: 24rpx;
}

.images-grid {
  display: grid;
  gap: 12rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.images-grid.single {
  grid-template-columns: 1fr;
}

.images-grid.double {
  grid-template-columns: 1fr 1fr;
}

.images-grid.quad {
  grid-template-columns: 1fr 1fr;
}

.images-grid.multi {
  grid-template-columns: 1fr 1fr 1fr;
}

.image-item {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  overflow: hidden;
}

.images-grid.single .image-item {
  padding-bottom: 75%;
}

.note-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tag {
  background: rgba(255, 255, 255, 0.9);
  color: #43A047;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid #E8F5E9;
}

.actions {
  display: flex;
  justify-content: center;
  gap: 30rpx;
  margin-top: 60rpx;
  padding-bottom: 40rpx;
}

.edit-btn,
.delete-btn {
  display: inline-block;
  font-size: 28rpx;
  padding: 16rpx 40rpx;
  border-radius: 40rpx;
}

.edit-btn {
  color: #43A047;
  border: 2rpx solid #43A047;
  background: rgba(255, 255, 255, 0.9);
}

.edit-btn:active {
  background: #E8F5E9;
}

.delete-btn {
  color: #FF4444;
  border: 2rpx solid #FF4444;
  background: rgba(255, 255, 255, 0.9);
}

.delete-btn:active {
  background: #FFF0F0;
}
