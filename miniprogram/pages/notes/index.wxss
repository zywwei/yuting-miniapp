/* 成长笔记首页样式 */
.container {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 孩子切换器 */
.switcher-wrapper {
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #66BB6A, #43A047);
  padding: 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: white;
}

.header-left {
  flex: 1;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
}

.header-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 50%;
  font-size: 28rpx;
}

.action-btn:active {
  background: rgba(255, 255, 255, 0.5);
}

.add-btn {
  background: rgba(255, 255, 255, 0.3);
  color: white;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: bold;
}

.add-btn:active {
  background: rgba(255, 255, 255, 0.5);
}

/* 搜索栏 */
.search-bar {
  background: #fff;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #F5F7FA;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-clear {
  font-size: 28rpx;
  color: #999;
  padding: 8rpx;
}

.search-options {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 0 8rpx;
}

.search-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666;
  padding: 8rpx 0;
}

.option-arrow {
  font-size: 20rpx;
  color: #999;
}

/* 高级搜索面板 */
.advanced-search {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.search-row {
  margin-bottom: 16rpx;
}

.search-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.date-range {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.date-picker,
.tag-picker {
  flex: 1;
  background: #F5F7FA;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #999;
}

.date-picker.has-value,
.tag-picker.has-value {
  color: #333;
}

.date-separator {
  font-size: 24rpx;
  color: #999;
}

.search-result {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  padding-left: 8rpx;
}

/* 分类Tab */
.category-tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 30rpx;
  gap: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 12rpx;
  background: #F5F7FA;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.tab-item.active {
  background: #E8F5E9;
  border-color: #66BB6A;
}

.tab-icon {
  font-size: 32rpx;
}

.tab-label {
  font-size: 22rpx;
  color: #666;
}

.tab-item.active .tab-label {
  color: #43A047;
  font-weight: bold;
}

/* 笔记列表 */
.note-list {
  padding: 30rpx;
}

.note-card {
  position: relative;
  background: white;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.note-content-wrap {
  padding: 28rpx;
  transition: transform 0.3s ease;
}

.note-content-wrap:active {
  background: #fafafa;
}

.note-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.note-header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.note-type-tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #E8F5E9;
  color: #43A047;
}

.note-type-tag.diary {
  background: #E3F2FD;
  color: #1976D2;
}

.note-type-tag.funny {
  background: #FFF3E0;
  color: #F57C00;
}

.note-type-tag.learning {
  background: #E8F5E9;
  color: #43A047;
}

.visibility-tag {
  font-size: 20rpx;
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  background: rgba(0, 0, 0, 0.05);
}

.note-mood {
  font-size: 32rpx;
}

.note-body {
  display: flex;
  gap: 20rpx;
}

.note-text {
  flex: 1;
  min-width: 0;
}

.note-thumbnail {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.thumbnail-img {
  width: 100%;
  height: 100%;
}

.image-count {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
}

.note-date {
  font-size: 22rpx;
  color: #999;
}

.note-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.note-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.note-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.note-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag {
  background: #E8F5E9;
  color: #43A047;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

/* 删除按钮 */
.note-delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FF4444;
  color: white;
  font-size: 28rpx;
  transform: translateX(100%);
  transition: transform 0.3s ease;
}

.note-card.swiped .note-delete {
  transform: translateX(0);
}

.note-card.swiped .note-content-wrap {
  transform: translateX(-140rpx);
  transition: transform 0.3s ease;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
}

.load-more-text {
  font-size: 24rpx;
  color: #999;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #bbb;
  margin-bottom: 40rpx;
}

.empty-btn {
  display: inline-block;
  background: linear-gradient(135deg, #66BB6A, #43A047);
  color: white;
  padding: 20rpx 60rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.empty-btn:active {
  opacity: 0.9;
}
