/* ===== 设计Token（成长笔记主题） ===== */
:root {
  /* 主色板 */
  --note-primary:    #FF8FA3;   /* 主粉：强调、主按钮 */
  --note-primary-deep:#E8798F;  /* 按压/渐变末端 */
  --note-cream:      #FFFBF5;   /* 手账纸底色（页面背景） */
  --note-cream-dark: #F7F0E6;   /* 深色纸区（输入区、卡片底） */
  --note-ink:        #4A3F35;   /* 主文字：暖棕黑（替代冷灰#333） */
  --note-ink-light:  #A89B8C;   /* 次要文字 */
  --note-gold:       #F0B429;   /* 印章/里程碑/置顶 */
  --note-green:      #7FB069;   /* 成功/完成（原绿收敛为点缀色） */

  /* 卡片与层级 */
  --note-card-bg:    #FFFFFF;
  --note-radius:     24rpx;
  --note-shadow:     0 4rpx 20rpx rgba(74, 63, 53, 0.06);
  --note-shadow-lift:0 8rpx 28rpx rgba(74, 63, 53, 0.10);

  /* 字号 */
  --note-fs-title:   36rpx;  /* 卡片标题 */
  --note-fs-body:    28rpx;
  --note-fs-aux:     22rpx;
}

/* 成长笔记首页样式 */
.container {
  min-height: 100vh;
  background: var(--note-cream);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 孩子切换器 */
.switcher-wrapper {
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

/* 头部 */
.header {
  background: var(--note-cream);
  padding: 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--note-ink);
}

.header-left {
  flex: 1;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--note-ink);
}

.header-desc {
  font-size: var(--note-fs-aux);
  color: var(--note-ink-light);
  margin-top: 8rpx;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--note-card-bg);
  border-radius: 50%;
  font-size: 28rpx;
  box-shadow: var(--note-shadow);
  transition: transform 0.2s ease;
  position: relative;
}

.action-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(74, 63, 53, 0.1);
}

.draft-btn {
  position: relative;
}

.add-note-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #E8708A 0%, #D85878 100%);
  border-radius: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(232, 112, 138, 0.4);
  transition: transform 0.2s ease;
}

.add-note-btn:active {
  transform: scale(0.95);
}

.add-note-icon {
  font-size: 28rpx;
}

.add-note-text {
  font-size: var(--note-fs-aux);
  color: #fff;
  font-weight: bold;
}

.add-btn {
  background: var(--note-card-bg);
  color: var(--note-primary);
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: var(--note-fs-body);
  font-weight: bold;
  box-shadow: var(--note-shadow);
  transition: transform 0.2s ease;
}

.add-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 8rpx rgba(74, 63, 53, 0.1);
}

/* 统计条 */
.stats-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--note-card-bg);
  padding: 24rpx 30rpx;
  margin: 16rpx 30rpx;
  border-radius: var(--note-radius);
  box-shadow: var(--note-shadow);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: var(--note-fs-title);
  font-weight: bold;
  color: var(--note-primary);
}

.stat-label {
  font-size: var(--note-fs-aux);
  color: var(--note-ink-light);
  margin-top: 4rpx;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(74, 63, 53, 0.1);
}

/* 视图切换 */
.view-toggle {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  padding: 16rpx 30rpx;
  background: var(--note-card-bg);
  border-bottom: 1rpx solid rgba(74, 63, 53, 0.06);
}

.toggle-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: var(--note-cream-dark);
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.toggle-item.active {
  background: rgba(255, 143, 163, 0.1);
  border: 2rpx solid var(--note-primary);
}

.toggle-icon {
  font-size: 28rpx;
}

.toggle-text {
  font-size: var(--note-fs-aux);
  color: var(--note-ink-light);
}

.toggle-item.active .toggle-text {
  color: var(--note-primary);
  font-weight: bold;
}

/* 日历视图 */
.calendar-view {
  padding: 20rpx 30rpx;
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.month-nav {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--note-cream-dark);
  border-radius: 50%;
  transition: transform 0.2s ease;
}

.month-nav:active {
  transform: scale(0.95);
}

.nav-arrow {
  font-size: 24rpx;
  color: var(--note-primary);
}

.current-month {
  font-size: var(--note-fs-body);
  font-weight: bold;
  color: var(--note-ink);
}

.weekday-header {
  display: flex;
  margin-bottom: 16rpx;
}

.weekday-item {
  flex: 1;
  text-align: center;
  font-size: var(--note-fs-aux);
  color: var(--note-ink-light);
  padding: 8rpx 0;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  background: var(--note-card-bg);
  border-radius: var(--note-radius);
  overflow: hidden;
  box-shadow: var(--note-shadow);
}

.calendar-day {
  width: 14.28%;
  padding: 16rpx 8rpx;
  text-align: center;
  position: relative;
  transition: all 0.2s ease;
}

.calendar-day.other-month {
  opacity: 0.3;
}

.calendar-day.today {
  background: rgba(255, 143, 163, 0.1);
}

.calendar-day.has-note {
  background: rgba(255, 143, 163, 0.05);
}

.calendar-day.selected {
  background: linear-gradient(135deg, #E8708A 0%, #D85878 100%);
  border-radius: 50%;
}

.calendar-day.selected .day-number {
  color: #fff;
  font-weight: bold;
}

.calendar-day:active {
  background: rgba(255, 143, 163, 0.15);
}

.day-number {
  font-size: var(--note-fs-aux);
  color: var(--note-ink);
}

.calendar-day.today .day-number {
  color: var(--note-primary);
  font-weight: bold;
}

.note-dots {
  display: flex;
  justify-content: center;
  gap: 4rpx;
  margin-top: 4rpx;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}

/* 日历选中日期笔记 */
.calendar-notes {
  margin-top: 24rpx;
  background: var(--note-card-bg);
  border-radius: var(--note-radius);
  padding: 20rpx;
  box-shadow: var(--note-shadow);
}

.selected-date {
  font-size: var(--note-fs-body);
  font-weight: bold;
  color: var(--note-ink);
  margin-bottom: 16rpx;
}

.calendar-note-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.calendar-note-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx;
  background: var(--note-cream-dark);
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.calendar-note-item:active {
  background: rgba(255, 143, 163, 0.1);
}

.note-type-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.no-notes-tip {
  text-align: center;
  padding: 40rpx 0;
  color: var(--note-ink-light);
  font-size: var(--note-fs-aux);
}

.note-info {
  flex: 1;
  overflow: hidden;
}

.note-info .note-title {
  font-size: var(--note-fs-aux);
  color: var(--note-ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.note-time {
  font-size: 20rpx;
  color: var(--note-ink-light);
  margin-top: 4rpx;
}

.note-mood {
  font-size: 28rpx;
}

/* 搜索栏 */
.search-bar {
  background: var(--note-card-bg);
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid rgba(74, 63, 53, 0.06);
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: var(--note-cream-dark);
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  gap: 12rpx;
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: var(--note-fs-body);
  color: var(--note-ink);
}

.search-clear {
  font-size: 28rpx;
  color: var(--note-ink-light);
  padding: 8rpx;
}

.search-options {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 0 8rpx;
}

.search-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--note-fs-aux);
  color: var(--note-ink-light);
  padding: 8rpx 0;
}

.option-arrow {
  font-size: 20rpx;
  color: var(--note-ink-light);
}

/* 高级搜索面板 */
.advanced-search {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.search-row {
  margin-bottom: 16rpx;
}

.search-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.date-range {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.date-picker,
.tag-picker {
  flex: 1;
  background: #F5F7FA;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #999;
}

.date-picker.has-value,
.tag-picker.has-value {
  color: #333;
}

.date-separator {
  font-size: 24rpx;
  color: #999;
}

.search-result {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  padding-left: 8rpx;
}

/* 分类Tab */
.category-tabs-scroll {
  background: var(--note-card-bg);
  border-bottom: 1rpx solid rgba(74, 63, 53, 0.06);
  white-space: nowrap;
  width: 100%;
}

.category-tabs {
  display: inline-flex;
  padding: 20rpx 30rpx;
  gap: 16rpx;
}

.tab-item {
  flex-shrink: 0;
  min-width: 120rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  background: var(--note-cream-dark);
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.tab-item.active {
  background: rgba(255, 143, 163, 0.1);
  border-color: var(--note-primary);
}

.tab-icon {
  font-size: 32rpx;
}

.tab-label {
  font-size: var(--note-fs-aux);
  color: var(--note-ink-light);
}

.tab-item.active .tab-label {
  color: var(--note-primary);
  font-weight: bold;
}

/* 笔记列表 */
.note-list {
  padding: 30rpx;
}

.note-card {
  position: relative;
  background: var(--note-card-bg);
  border-radius: var(--note-radius);
  margin-bottom: 24rpx;
  box-shadow: var(--note-shadow);
  overflow: hidden;
  transition: box-shadow 0.2s ease;
}

.note-card:active {
  box-shadow: var(--note-shadow-lift);
}

/* 置顶卡片 */
.note-card.pinned {
  border-left: 8rpx solid var(--note-gold);
  background: linear-gradient(135deg, var(--note-card-bg) 0%, rgba(240, 180, 41, 0.05) 100%);
}

.note-content-wrap {
  padding: 28rpx;
  transition: transform 0.3s ease;
}

.note-content-wrap:active {
  background: var(--note-cream);
}

.note-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.note-header-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.note-type-tag {
  display: inline-block;
  font-size: var(--note-fs-aux);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(255, 143, 163, 0.1);
  color: var(--note-primary);
}

.note-type-tag.diary {
  background: rgba(127, 176, 105, 0.1);
  color: var(--note-green);
}

.note-type-tag.funny {
  background: rgba(240, 180, 41, 0.1);
  color: var(--note-gold);
}

.note-type-tag.learning {
  background: rgba(168, 155, 140, 0.1);
  color: var(--note-ink-light);
}

.visibility-tag {
  font-size: var(--note-fs-aux);
  padding: 4rpx 8rpx;
  border-radius: 6rpx;
  background: rgba(74, 63, 53, 0.05);
}

.note-mood {
  font-size: 32rpx;
}

.note-body {
  display: flex;
  gap: 20rpx;
}

.note-text {
  flex: 1;
  min-width: 0;
}

.note-thumbnail {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.thumbnail-img {
  width: 100%;
  height: 100%;
}

.image-count {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  font-size: var(--note-fs-aux);
  padding: 4rpx 10rpx;
  border-radius: 10rpx;
}

.note-date {
  font-size: var(--note-fs-aux);
  color: var(--note-ink-light);
}

.note-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.note-title {
  font-size: var(--note-fs-title);
  font-weight: bold;
  color: var(--note-ink);
  margin-bottom: 12rpx;
}

.note-content {
  font-size: var(--note-fs-body);
  color: var(--note-ink-light);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.note-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag {
  background: rgba(255, 143, 163, 0.1);
  color: var(--note-primary);
  font-size: var(--note-fs-aux);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

/* 删除按钮 */
.note-delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FF5A5A;
  color: white;
  font-size: var(--note-fs-body);
  transform: translateX(100%);
  transition: transform 0.3s ease;
}

.note-card.swiped .note-delete {
  transform: translateX(0);
}

.note-card.swiped .note-content-wrap {
  transform: translateX(-140rpx);
  transition: transform 0.3s ease;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 30rpx;
}

.load-more-text {
  font-size: var(--note-fs-aux);
  color: var(--note-ink-light);
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: var(--note-fs-body);
  color: var(--note-ink);
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: var(--note-fs-aux);
  color: var(--note-ink-light);
  margin-bottom: 40rpx;
}

.empty-btn {
  display: inline-block;
  background: linear-gradient(135deg, #E8708A 0%, #D85878 100%);
  color: #fff;
  padding: 20rpx 60rpx;
  border-radius: 50rpx;
  font-size: var(--note-fs-body);
  font-weight: bold;
  transition: transform 0.2s ease;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
  box-shadow: 0 4rpx 16rpx rgba(232, 112, 138, 0.4);
}

.empty-btn:active {
  transform: translateY(2rpx);
  opacity: 0.9;
}

/* FAB写笔记按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 40rpx;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #E8708A 0%, #D85878 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(232, 112, 138, 0.5);
  z-index: 100;
  transition: transform 0.2s ease;
}

.fab-btn:active {
  transform: scale(0.95);
}

.fab-icon {
  font-size: 60rpx;
  color: white;
  font-weight: bold;
  line-height: 1;
}

/* 按月分组标题 */
.month-header {
  margin-bottom: 24rpx;
  margin-top: 16rpx;
}

.month-stamp {
  display: inline-block;
  font-size: var(--note-fs-aux);
  color: var(--note-ink-light);
  background: var(--note-cream-dark);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(74, 63, 53, 0.1);
}

/* 笔记卡片杂志化 */
.note-hero-img {
  position: relative;
  width: 100%;
  height: 260rpx;
  border-radius: var(--note-radius) var(--note-radius) 0 0;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.note-hero-img .image-count {
  position: absolute;
  bottom: 12rpx;
  right: 12rpx;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  font-size: var(--note-fs-aux);
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
}

.pinned-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 32rpx;
  background: rgba(240, 180, 41, 0.9);
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.note-type-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  border-radius: 4rpx 0 0 4rpx;
}

/* 心情贴纸 */
.note-mood-sticker {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
}

.mood-sticker {
  font-size: 36rpx;
  background: rgba(255, 255, 255, 0.8);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transform: rotate(-8deg);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* 删除撤销条 */
.undo-bar {
  position: fixed;
  bottom: -120rpx;
  left: 30rpx;
  right: 30rpx;
  background: var(--note-ink);
  color: white;
  padding: 24rpx 30rpx;
  border-radius: var(--note-radius);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 24rpx rgba(74, 63, 53, 0.3);
  z-index: 200;
  transition: bottom 0.3s ease;
}

.undo-bar.show {
  bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.undo-text {
  font-size: var(--note-fs-body);
  flex: 1;
  margin-right: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.undo-btn {
  font-size: var(--note-fs-body);
  font-weight: bold;
  color: var(--note-primary);
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  transition: transform 0.2s ease;
}

.undo-btn:active {
  transform: scale(0.95);
}

/* 搜索历史 */
.search-history {
  background: var(--note-card-bg);
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid rgba(74, 63, 53, 0.06);
}

.history-title {
  font-size: var(--note-fs-aux);
  color: var(--note-ink-light);
  margin-bottom: 16rpx;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.history-item {
  font-size: var(--note-fs-aux);
  color: var(--note-ink-light);
  background: var(--note-cream-dark);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  transition: all 0.2s ease;
}

.history-item:active {
  background: rgba(255, 143, 163, 0.1);
  color: var(--note-primary);
}

/* 关键词高亮 */
.highlight {
  color: var(--note-primary);
  font-weight: bold;
}


