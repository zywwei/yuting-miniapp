/* ===== 成长手账主题 v2.1 =====
 * 注意：微信小程序 WXSS 不支持 :root 选择器，CSS 变量声明会被忽略。
 * 所有颜色一律硬编码，禁止用 var() 引用。 */

/* 成长笔记首页样式 */
.container {
  min-height: 100vh;
  background:
    radial-gradient(600rpx 300rpx at 90% -10%, rgba(255, 126, 157, 0.06), transparent 60%),
    #FFF7F1;
  padding-bottom: calc(300rpx + env(safe-area-inset-bottom));
}

/* ===== 沉浸式渐变头部 ===== */
.app-head {
  position: relative;
  padding: 36rpx 30rpx 110rpx;
  color: #ffffff;
}

.deco {
  position: absolute;
  pointer-events: none;
  opacity: 0.8;
  z-index: 0;
}
.deco.d1 { top: 30rpx; right: 36rpx; font-size: 56rpx; transform: rotate(8deg); }
.deco.d2 { top: 110rpx; right: 200rpx; font-size: 34rpx; transform: rotate(-12deg); opacity: 0.55; }
.deco.d3 { top: 200rpx; left: 50rpx; font-size: 38rpx; transform: rotate(-6deg); opacity: 0.5; }
.deco.d4 { top: 20rpx; left: 240rpx; font-size: 26rpx; opacity: 0.45; }

.head-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  position: relative;
  z-index: 2;
}

.head-left {
  flex: 1;
  min-width: 0;
}

.head-title {
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.12);
}

.head-sub {
  font-size: 22rpx;
  opacity: 0.92;
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

.head-actions {
  display: flex;
  gap: 16rpx;
}

.icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.24);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(190, 60, 100, 0.25);
  transition: transform 0.15s ease;
}
.icon-btn:active {
  transform: scale(0.92);
}

.badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  background: #F2B33D;
  border-radius: 16rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ffffff;
  box-sizing: border-box;
}

/* 孩子切换器（多孩子时） */
.switcher-wrapper {
  position: relative;
  z-index: 30;
  margin-top: 24rpx;
  display: inline-block;
}

/* ===== 成长档案卡 ===== */
.profile-card {
  position: relative;
  z-index: 5;
  margin: -70rpx 24rpx 0;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 16rpx 48rpx rgba(180, 70, 110, 0.18), 0 4rpx 12rpx rgba(180, 70, 110, 0.08);
  animation: rise 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}

.avatar-wrap {
  flex-shrink: 0;
  position: relative;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFE3EA, #FFC2D1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  border: 4rpx solid #ffffff;
  box-shadow: 0 0 0 5rpx #F2B33D, 0 10rpx 24rpx rgba(242, 179, 61, 0.35);
  box-sizing: border-box;
}

/* 上传的孩子头像 */
.avatar-img {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
  box-shadow: 0 0 0 5rpx #F2B33D, 0 10rpx 24rpx rgba(242, 179, 61, 0.35);
  box-sizing: border-box;
  background: linear-gradient(135deg, #FFE3EA, #FFC2D1);
  display: block;
}

.who {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 34rpx;
  font-weight: 800;
  color: #46363A;
}

.age {
  font-size: 22rpx;
  color: #A89292;
  margin-top: 4rpx;
}

.streak {
  font-size: 22rpx;
  color: #F05A80;
  margin-top: 6rpx;
  font-weight: 600;
}

.stats {
  display: flex;
  gap: 28rpx;
  flex-shrink: 0;
}

.stat {
  text-align: center;
}

.stat .v {
  font-size: 34rpx;
  font-weight: 800;
  color: #46363A;
  line-height: 1.1;
}
.stat .v .unit {
  font-size: 20rpx;
  color: #FF7E9D;
  margin-left: 2rpx;
}
.stat .v.mood-v {
  font-size: 36rpx;
}

.stat .l {
  font-size: 20rpx;
  color: #A89292;
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}

/* ===== 工具栏 ===== */
.toolbar {
  padding: 28rpx 24rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.seg {
  display: flex;
  background: #FBF1E8;
  border-radius: 20rpx;
  padding: 6rpx;
}

.seg .s {
  padding: 12rpx 34rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #A89292;
  transition: all 0.2s ease;
}
.seg .s.on {
  background: #FFFFFF;
  color: #F05A80;
  box-shadow: 0 4rpx 14rpx rgba(180, 70, 110, 0.16);
}

.sort-chip {
  font-size: 22rpx;
  color: #A89292;
  background: #FFFFFF;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  box-shadow: 0 2rpx 12rpx rgba(120, 80, 90, 0.1);
  display: flex;
  align-items: center;
}
.sort-chip:active {
  color: #F05A80;
}

/* ===== 搜索栏 ===== */
.search-bar {
  padding: 16rpx 24rpx 0;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #FBF1E8;
  border-radius: 999rpx;
  padding: 20rpx 26rpx;
  gap: 14rpx;
  box-shadow: 0 2rpx 8rpx rgba(120, 80, 90, 0.06) inset;
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #46363A;
}

.search-clear {
  font-size: 28rpx;
  color: #A89292;
  padding: 8rpx;
}

.search-options {
  display: flex;
  justify-content: flex-start;
  margin-top: 16rpx;
  padding: 0 10rpx;
}

.search-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #A89292;
  padding: 8rpx 0;
}
.search-option:active {
  color: #F05A80;
}

.option-arrow {
  font-size: 18rpx;
}

/* 高级搜索面板 */
.advanced-search {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(120, 80, 90, 0.09);
}

.search-row {
  margin-bottom: 16rpx;
}

.search-label {
  font-size: 22rpx;
  color: #A89292;
  margin-bottom: 12rpx;
}

.date-range {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.date-picker,
.tag-picker {
  flex: 1;
  background: #FBF1E8;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: #A89292;
}
.date-picker.has-value,
.tag-picker.has-value {
  color: #46363A;
}

.date-separator {
  font-size: 22rpx;
  color: #A89292;
}

.search-result {
  font-size: 22rpx;
  color: #A89292;
  margin-top: 14rpx;
  padding-left: 10rpx;
}

/* 搜索历史 */
.search-history {
  margin-top: 16rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(120, 80, 90, 0.09);
}

.history-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.history-title {
  font-size: 22rpx;
  color: #A89292;
}

.history-clear {
  font-size: 20rpx;
  color: #A89292;
  padding: 4rpx 12rpx;
  background: #FBF1E8;
  border-radius: 999rpx;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.history-item {
  font-size: 22rpx;
  color: #A89292;
  background: #FBF1E8;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
}
.history-item:active {
  background: #FFE3EA;
  color: #F05A80;
}

/* ===== 分类胶囊 ===== */
.cat-scroll {
  white-space: nowrap;
  width: 100%;
  margin-top: 20rpx;
  box-sizing: border-box;
}

.cat-inner {
  display: inline-flex;
  padding: 4rpx 24rpx 8rpx;
  gap: 14rpx;
}

.chip {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  border: 3rpx solid transparent;
  box-sizing: border-box;
  transition: all 0.18s ease;
}
.chip.on {
  border-color: currentColor;
  box-shadow: 0 4rpx 16rpx rgba(180, 70, 110, 0.14);
  font-weight: 800;
}

.chip-icon {
  font-size: 26rpx;
  line-height: 1;
}

.chip-label {
  line-height: 1;
}

/* ===== 日历视图 ===== */
.calendar-view {
  padding: 16rpx 24rpx;
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 6rpx;
  margin-bottom: 20rpx;
}

.cal-nav {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(120, 80, 90, 0.09);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #F05A80;
}
.cal-nav:active {
  transform: scale(0.92);
}

.cal-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #46363A;
}

.cal-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 20rpx 16rpx 16rpx;
  box-shadow: 0 6rpx 20rpx rgba(120, 80, 90, 0.09);
}

.cal-wd {
  display: flex;
  margin-bottom: 8rpx;
}

.wd-item {
  flex: 1;
  text-align: center;
  font-size: 20rpx;
  color: #A89292;
  padding: 8rpx 0;
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cd {
  width: 14.28%;
  height: 76rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.cd-n {
  font-size: 24rpx;
  color: #46363A;
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.15s ease;
}
.cd.om .cd-n {
  color: #D8CBCB;
}
.cd.today .cd-n {
  color: #F05A80;
  font-weight: 800;
  box-shadow: 0 0 0 3rpx #FF7E9D;
}
.cd.sel .cd-n {
  background: linear-gradient(135deg, #FF93AD, #F05A80);
  color: #ffffff;
  font-weight: 800;
  box-shadow: 0 6rpx 16rpx rgba(255, 126, 157, 0.35);
}

.dots {
  display: flex;
  gap: 5rpx;
  height: 8rpx;
  margin-top: 2rpx;
}
.dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}
.cd.sel .dot {
  background: #ffffff !important;
}

/* 选中日期笔记 */
.cal-notes {
  margin-top: 24rpx;
}

.cal-day-t {
  font-size: 26rpx;
  font-weight: 800;
  color: #46363A;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.day-cnt {
  font-size: 20rpx;
  background: #FFE3EA;
  color: #F05A80;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
}

.cal-note-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.cal-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(120, 80, 90, 0.09);
  transition: transform 0.15s ease;
}
.cal-item:active {
  transform: translateX(6rpx);
}

.cal-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.cal-info {
  flex: 1;
  min-width: 0;
}

.cal-title-t {
  font-size: 26rpx;
  font-weight: 700;
  color: #46363A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cal-time {
  font-size: 20rpx;
  color: #A89292;
  margin-top: 4rpx;
}

.cal-mood {
  font-size: 32rpx;
}

.no-notes-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #A89292;
  font-size: 22rpx;
}

/* ===== 笔记列表 ===== */
.note-list {
  padding: 16rpx 24rpx 24rpx;
}

/* 按月分组 */
.month-h {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 20rpx 4rpx 20rpx;
}
.m {
  font-size: 24rpx;
  font-weight: 800;
  color: #46363A;
  letter-spacing: 1rpx;
}
.line {
  flex: 1;
  height: 1rpx;
  background: linear-gradient(90deg, rgba(70, 54, 58, 0.14), transparent);
}

/* 笔记卡片 */
.note-card {
  position: relative;
  background: #FFFFFF;
  border-radius: 32rpx;
  margin-bottom: 26rpx;
  box-shadow: 0 6rpx 20rpx rgba(120, 80, 90, 0.09);
  overflow: hidden;
  transition: box-shadow 0.2s ease;
  animation: rise 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both;
}
.note-card:active {
  box-shadow: 0 12rpx 28rpx rgba(120, 80, 90, 0.16);
}

/* 置顶金徽章 */
.pin-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 10;
  font-size: 28rpx;
  background: rgba(242, 179, 61, 0.95);
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.18);
}

.note-content-wrap {
  transition: transform 0.3s ease;
}

/* 有图：大图封面 */
.cover {
  position: relative;
  height: 280rpx;
  overflow: hidden;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.cover-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.04), rgba(0, 0, 0, 0.22));
}

.cover-type {
  position: absolute;
  left: 20rpx;
  top: 20rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  padding: 8rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.14);
}

.cover-cnt {
  position: absolute;
  right: 20rpx;
  bottom: 18rpx;
  z-index: 2;
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.5);
  padding: 4rpx 14rpx;
  border-radius: 14rpx;
}

/* 卡片正文 */
.card-body {
  padding: 24rpx 26rpx 20rpx;
}

.body-row {
  display: flex;
  gap: 20rpx;
}

/* 类型图标徽章（无图卡片） */
.badge-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 26rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 6rpx 16rpx rgba(120, 80, 90, 0.1);
}

.txt-wrap {
  flex: 1;
  min-width: 0;
}

.note-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #46363A;
  line-height: 1.35;
}

.note-content {
  font-size: 25rpx;
  color: #A89292;
  line-height: 1.6;
  margin-top: 8rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.highlight {
  color: #F05A80;
  font-weight: 700;
}

/* 标签 */
.note-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.tag {
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

/* 底部 */
.note-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}

.foot-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.visi {
  font-size: 22rpx;
  opacity: 0.9;
}

.note-date {
  font-size: 21rpx;
  color: #A89292;
}

.note-mood-sticker {
  position: relative;
}

.mood-sticker {
  font-size: 32rpx;
  background: #FFF6EF;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transform: rotate(-8deg);
  box-shadow: 0 4rpx 12rpx rgba(120, 80, 90, 0.14);
  border: 2rpx solid rgba(242, 179, 61, 0.35);
  box-sizing: border-box;
}

/* 左滑删除 */
.note-delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #FF7A7A, #F05050);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  transform: translateX(100%);
  transition: transform 0.3s ease;
}

.note-card.swiped .note-delete {
  transform: translateX(0);
}

.note-card.swiped .note-content-wrap {
  transform: translateX(-140rpx);
  transition: transform 0.3s ease;
}

/* ===== 加载更多 ===== */
.load-more {
  text-align: center;
  padding: 30rpx;
}

.load-more-text {
  font-size: 22rpx;
  color: #A89292;
}

/* ===== 空状态 ===== */
.empty {
  text-align: center;
  padding: 140rpx 60rpx;
  animation: rise 0.5s ease both;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  display: inline-block;
}

.empty-text {
  font-size: 26rpx;
  color: #46363A;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 22rpx;
  color: #A89292;
  margin-bottom: 40rpx;
}

.empty-btn {
  display: inline-block;
  background: linear-gradient(135deg, #FF93AD, #F05A80);
  color: #ffffff;
  padding: 20rpx 64rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(240, 90, 128, 0.4);
  transition: transform 0.2s ease;
}
.empty-btn:active {
  transform: translateY(2rpx);
  opacity: 0.92;
}

/* ===== FAB =====
 * 注意：本页是 tabBar 页，自定义 tabBar 高 110rpx + 安全区(z-index 999)，
 * FAB 必须浮在 tabBar 上方，否则被遮挡。 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: calc(134rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  background: linear-gradient(135deg, #FF93AD, #F05A80);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 32rpx rgba(255, 126, 157, 0.45), 0 4rpx 10rpx rgba(190, 60, 100, 0.3);
  z-index: 100;
  transition: transform 0.2s ease;
}
.fab-btn:active {
  transform: scale(0.92);
}

/* FAB 虚线光环 */
.fab-ring {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  left: -8rpx;
  border-radius: 50%;
  border: 2rpx dashed rgba(255, 126, 157, 0.45);
  animation: spin 14s linear infinite;
  pointer-events: none;
}

/* 纯 CSS 白色铅笔：clip-path 一体成型（笔尖与笔身无缝、尖角锐利）
 * 降级：不支持 clip-path 时显示为白色圆角矩形，仍可用 */
.fab-pen-wrap {
  display: flex;
  align-items: center;
  transform: rotate(-45deg);
  pointer-events: none;
}
.fab-pen {
  width: 48rpx;
  height: 10rpx;
  background: #FFFFFF;
  border-radius: 2rpx;
  clip-path: polygon(0 50%, 29% 0, 100% 0, 100% 100%, 29% 100%);
}
.pen-cap {
  width: 8rpx;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 2rpx;
  margin-left: 1rpx;
}

/* ===== 删除撤销条 ===== */
.undo-bar {
  position: fixed;
  bottom: -140rpx;
  left: 30rpx;
  right: 30rpx;
  background: #46363A;
  color: #ffffff;
  padding: 24rpx 30rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 12rpx 32rpx rgba(70, 54, 58, 0.3);
  z-index: 200;
  transition: bottom 0.3s ease;
}

.undo-bar.show {
  bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.undo-text {
  font-size: 26rpx;
  flex: 1;
  margin-right: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.undo-btn {
  font-size: 26rpx;
  font-weight: 700;
  color: #FFB3C6;
  padding: 10rpx 28rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  transition: transform 0.2s ease;
}
.undo-btn:active {
  transform: scale(0.94);
}

/* ===== 动画 ===== */
@keyframes rise {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
