/* 成长笔记首页样式 */
.container {
  min-height: 100vh;
  background: #F5F7FA;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 头部 */
.header {
  background: linear-gradient(135deg, #66BB6A, #43A047);
  padding: 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: white;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
}

.header-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}

.add-btn {
  background: rgba(255, 255, 255, 0.3);
  color: white;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: bold;
}

.add-btn:active {
  background: rgba(255, 255, 255, 0.5);
}

/* 笔记列表 */
.note-list {
  padding: 30rpx;
}

.note-card {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.note-card:active {
  transform: scale(0.98);
}

.note-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.note-type-tag {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: #E8F5E9;
  color: #43A047;
}

.note-type-tag.diary {
  background: #E3F2FD;
  color: #1976D2;
}

.note-type-tag.funny {
  background: #FFF3E0;
  color: #F57C00;
}

.note-type-tag.learning {
  background: #E8F5E9;
  color: #43A047;
}

.note-mood {
  font-size: 32rpx;
}

.note-date {
  font-size: 22rpx;
  color: #999;
}

.note-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 16rpx;
}

.note-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.note-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.note-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.tag {
  background: #E8F5E9;
  color: #43A047;
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-btn {
  display: inline-block;
  background: linear-gradient(135deg, #66BB6A, #43A047);
  color: white;
  padding: 20rpx 60rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.empty-btn:active {
  opacity: 0.9;
}
