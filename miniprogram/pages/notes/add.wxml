<!-- 添加/编辑笔记 -->
<view class="container">
  <!-- 标题 -->
  <view class="section title-section">
    <editor
      id="titleEditor"
      class="title-editor"
      placeholder="给笔记起个标题..."
      bindready="onTitleEditorReady"
      bindinput="onTitleInput"
      maxlength="30"
    />
  </view>

  <!-- 内容 -->
  <view class="section">
    <editor
      id="contentEditor"
      class="content-editor"
      placeholder="记录今天的成长故事..."
      bindready="onContentEditorReady"
      bindinput="onContentInput"
      maxlength="500"
    />
  </view>

  <!-- 笔记类型（可折叠） -->
  <view class="section">
    <view class="section-title collapsible" bindtap="toggleTypeCollapsed">
      <text>笔记类型</text>
      <text class="collapse-arrow {{typeCollapsed ? 'collapsed' : ''}}">▼</text>
    </view>
    <view class="collapse-content {{typeCollapsed ? 'hidden' : ''}}">
      <view wx:for="{{typeGroups}}" wx:for-item="group" wx:key="key">
        <view class="type-group-label">{{group.label}}</view>
        <view class="type-list">
          <block wx:for="{{types}}" wx:for-item="t" wx:key="value">
            <view wx:if="{{t.group === group.key}}"
              class="type-item {{type === t.value ? 'selected' : ''}}"
              bindtap="selectType" data-type="{{t.value}}"
              bindlongpress="{{t.isCustom ? 'deleteCustomType' : ''}}"
              data-value="{{t.value}}">
              <view class="type-icon">{{t.icon}}</view>
              <view class="type-label">{{t.label}}</view>
            </view>
          </block>
        </view>
      </view>
      <view class="type-group-label">其他</view>
      <view class="type-list">
        <block wx:for="{{types}}" wx:for-item="t" wx:key="value">
          <view wx:if="{{t.group === 'other'}}"
            class="type-item {{type === t.value ? 'selected' : ''}}"
            bindtap="selectType" data-type="{{t.value}}"
            bindlongpress="{{t.isCustom ? 'deleteCustomType' : ''}}"
            data-value="{{t.value}}">
            <view class="type-icon">{{t.icon}}</view>
            <view class="type-label">{{t.label}}</view>
          </view>
        </block>
        <view class="type-item create-type" bindtap="showCustomTypeModal">
          <view class="type-icon">➕</view>
          <view class="type-label">新建类型</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 心情选择（可折叠） -->
  <view class="section">
    <view class="section-title collapsible" bindtap="toggleMoodCollapsed">
      <text>今天的心情</text>
      <text class="collapse-arrow {{moodCollapsed ? 'collapsed' : ''}}">▼</text>
    </view>
    <view class="collapse-content {{moodCollapsed ? 'hidden' : ''}}">
      <view wx:for="{{moodGroups}}" wx:for-item="group" wx:key="key">
        <view class="mood-group-label">{{group.label}}</view>
        <scroll-view scroll-x class="mood-scroll">
          <view class="mood-list">
            <block wx:for="{{moods}}" wx:for-item="m" wx:key="value">
              <view wx:if="{{m.group === group.key}}"
                class="mood-item {{mood === m.value ? 'selected' : ''}}"
                bindtap="selectMood" data-mood="{{m.value}}">
                <view class="mood-icon">{{m.icon}}</view>
                <view class="mood-label">{{m.label}}</view>
              </view>
            </block>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <!-- 标签 -->
  <view class="section">
    <view class="section-title">标签（可选）</view>
    <view class="tag-input-row">
      <input
        class="tag-input"
        placeholder="添加标签..."
        value="{{tagInput}}"
        bindinput="onTagInput"
        maxlength="10"
      />
      <view class="tag-add-btn" bindtap="addTag">添加</view>
    </view>
    <view class="tag-list" wx:if="{{tags.length > 0}}">
      <view wx:for="{{tags}}" wx:key="*this" class="tag-item">
        <text>{{item}}</text>
        <view class="tag-remove" bindtap="removeTag" data-index="{{index}}">×</view>
      </view>
    </view>
  </view>

  <!-- 照片 -->
  <view class="section">
    <view class="section-title">照片（可选）</view>
    <view class="photo-list">
      <view wx:for="{{images}}" wx:key="*this" class="photo-item">
        <image src="{{item}}" mode="aspectFill" class="photo-img" bindtap="previewImage" data-path="{{item}}" lazy-load />
        <view class="photo-edit" catchtap="editPhoto" data-path="{{item}}">✏️</view>
        <view class="photo-delete" catchtap="deletePhoto" data-index="{{index}}">✕</view>
      </view>
      <view wx:if="{{images.length < 9}}" class="photo-add" bindtap="takePhoto">
        <text class="add-icon">📷</text>
        <text class="add-text">拍照</text>
      </view>
    </view>
    <view class="photo-hint">支持拍照或从相册选择，最多9张，可画画编辑</view>
  </view>

  <!-- 可见范围 -->
  <view class="section">
    <view class="section-title">可见范围</view>
    <view class="visibility-list">
      <view 
        wx:for="{{visibilityOptions}}" 
        wx:key="value"
        class="visibility-item {{visibility === item.value ? 'selected' : ''}}"
        bindtap="selectVisibility"
        data-visibility="{{item.value}}"
      >
        <view class="visibility-icon">{{item.icon}}</view>
        <view class="visibility-info">
          <view class="visibility-label">{{item.label}}</view>
          <view class="visibility-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>
    
    <!-- 指定人选择 -->
    <view class="member-select" wx:if="{{visibility === 'designated'}}">
      <view class="member-title">选择可见成员</view>
      <view class="member-list" wx:if="{{familyMembers.length > 0}}">
        <view 
          wx:for="{{familyMembers}}" 
          wx:key="_id"
          class="member-item {{item._selected ? 'selected' : ''}}"
          bindtap="toggleMember"
          data-id="{{item._id}}"
        >
          <view class="member-avatar-wrap">
            <image wx:if="{{item.avatar && item.avatar !== '/images/default-avatar.png'}}" src="{{item.avatar}}" class="member-avatar" mode="aspectFill" binderror="onAvatarError" data-index="{{index}}" />
            <view wx:else class="member-avatar-default">{{item.roleIcon || '👤'}}</view>
            <view wx:if="{{item._selected}}" class="member-check">✓</view>
          </view>
          <view class="member-name">{{item.roleName || item.nickname || '成员'}}</view>
        </view>
      </view>
      <view class="member-empty" wx:else>
        <text>暂无其他家庭成员</text>
      </view>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-btn" bindtap="save">{{isEdit ? '更新笔记' : '保存笔记'}}</view>
</view>

<!-- 自定义类型创建弹窗 -->
<view class="modal-mask" wx:if="{{showCustomTypeModal}}" bindtap="hideCustomTypeModal">
  <view class="modal-content" catchtap="">
    <view class="modal-title">创建新类型</view>
    <input class="modal-input" placeholder="输入类型名称（如：手工记录）" value="{{customTypeName}}" bindinput="onCustomTypeNameInput" maxlength="6" />
    <view class="modal-icons">
      <view wx:for="{{customIconOptions}}" wx:key="*this"
        class="modal-icon-item {{customTypeIcon === item ? 'selected' : ''}}"
        bindtap="selectCustomIcon" data-icon="{{item}}">
        {{item}}
      </view>
    </view>
    <view class="modal-actions">
      <view class="modal-btn cancel" bindtap="hideCustomTypeModal">取消</view>
      <view class="modal-btn confirm" bindtap="createCustomType">创建</view>
    </view>
  </view>
</view>
