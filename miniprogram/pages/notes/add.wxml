<!-- 添加/编辑笔记 -->
<view class="container">
  <!-- 笔记类型 -->
  <view class="section">
    <view class="section-title">笔记类型</view>
    <view class="type-list">
      <view
        wx:for="{{types}}"
        wx:key="value"
        class="type-item {{type === item.value ? 'selected' : ''}}"
        bindtap="selectType"
        data-type="{{item.value}}"
      >
        <view class="type-icon">{{item.icon}}</view>
        <view class="type-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 标题 -->
  <view class="section">
    <input
      class="title-input"
      placeholder="给笔记起个标题..."
      value="{{title}}"
      bindinput="onTitleInput"
      maxlength="30"
    />
  </view>

  <!-- 内容 -->
  <view class="section">
    <textarea
      class="content-input"
      placeholder="记录今天的成长故事..."
      value="{{content}}"
      bindinput="onContentInput"
      maxlength="500"
      auto-height
    />
  </view>

  <!-- 心情选择 -->
  <view class="section">
    <view class="section-title">今天的心情</view>
    <view class="mood-list">
      <view
        wx:for="{{moods}}"
        wx:key="value"
        class="mood-item {{mood === item.value ? 'selected' : ''}}"
        bindtap="selectMood"
        data-mood="{{item.value}}"
      >
        <view class="mood-icon">{{item.icon}}</view>
        <view class="mood-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 标签 -->
  <view class="section">
    <view class="section-title">标签（可选）</view>
    <view class="tag-input-row">
      <input
        class="tag-input"
        placeholder="添加标签..."
        value="{{tagInput}}"
        bindinput="onTagInput"
        maxlength="10"
      />
      <view class="tag-add-btn" bindtap="addTag">添加</view>
    </view>
    <view class="tag-list" wx:if="{{tags.length > 0}}">
      <view wx:for="{{tags}}" wx:key="*this" class="tag-item">
        <text>{{item}}</text>
        <view class="tag-remove" bindtap="removeTag" data-index="{{index}}">×</view>
      </view>
    </view>
  </view>

  <!-- 照片 -->
  <view class="section">
    <view class="section-title">照片（可选）</view>
    <view class="photo-list">
      <view wx:for="{{images}}" wx:key="*this" class="photo-item">
        <image src="{{item}}" mode="aspectFill" class="photo-img" bindtap="previewImage" data-path="{{item}}" lazy-load />
        <view class="photo-edit" catchtap="editPhoto" data-path="{{item}}">✏️</view>
        <view class="photo-delete" catchtap="deletePhoto" data-index="{{index}}">✕</view>
      </view>
      <view wx:if="{{images.length < 9}}" class="photo-add" bindtap="takePhoto">
        <text class="add-icon">📷</text>
        <text class="add-text">拍照</text>
      </view>
    </view>
    <view class="photo-hint">支持拍照或从相册选择，最多9张，可画画编辑</view>
  </view>

  <!-- 可见范围 -->
  <view class="section">
    <view class="section-title">可见范围</view>
    <view class="visibility-list">
      <view 
        wx:for="{{visibilityOptions}}" 
        wx:key="value"
        class="visibility-item {{visibility === item.value ? 'selected' : ''}}"
        bindtap="selectVisibility"
        data-visibility="{{item.value}}"
      >
        <view class="visibility-icon">{{item.icon}}</view>
        <view class="visibility-info">
          <view class="visibility-label">{{item.label}}</view>
          <view class="visibility-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>
    
    <!-- 指定人选择 -->
    <view class="member-select" wx:if="{{visibility === 'designated'}}">
      <view class="member-title">选择可见成员</view>
      <view class="member-list" wx:if="{{familyMembers.length > 0}}">
        <view 
          wx:for="{{familyMembers}}" 
          wx:key="_id"
          class="member-item {{item._selected ? 'selected' : ''}}"
          bindtap="toggleMember"
          data-id="{{item._id}}"
        >
          <view class="member-avatar-wrap">
            <image wx:if="{{item.avatar && item.avatar !== '/images/default-avatar.png'}}" src="{{item.avatar}}" class="member-avatar" mode="aspectFill" binderror="onAvatarError" data-index="{{index}}" />
            <view wx:else class="member-avatar-default">{{item.roleIcon || '👤'}}</view>
            <view wx:if="{{item._selected}}" class="member-check">✓</view>
          </view>
          <view class="member-name">{{item.roleName || item.nickname || '成员'}}</view>
        </view>
      </view>
      <view class="member-empty" wx:else>
        <text>暂无其他家庭成员</text>
      </view>
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-btn" bindtap="save">{{isEdit ? '更新笔记' : '保存笔记'}}</view>
</view>
