<!-- 笔记详情 -->
<view class="container" wx:if="{{note}}">
  <!-- 头部 -->
  <view class="header">
    <view class="note-type-tag" style="background:{{typeInfo.color}};color:{{typeInfo.textColor}}">
      {{typeInfo.icon}} {{typeInfo.label}}
    </view>
    <view class="header-right">
      <view class="visibility-tag {{note.visibility || 'family'}}">
        {{note.visibility === 'private' ? '🔒 仅自己' : note.visibility === 'designated' ? '👥 指定人' : '👨‍👩‍👧‍👦 家庭'}}
      </view>
      <view class="mood">{{moodInfo.icon}}</view>
    </view>
  </view>

  <!-- 标题 -->
  <view class="title">
    <rich-text nodes="{{note.title}}"></rich-text>
  </view>

  <!-- 内容 -->
  <view class="content" wx:if="{{note.content}}">
    <rich-text nodes="{{note.content}}"></rich-text>
  </view>

  <!-- 图片展示 -->
  <view class="images-section" wx:if="{{note.images && note.images.length > 0}}">
    <view class="images-grid {{note.images.length === 1 ? 'single' : note.images.length === 2 ? 'double' : note.images.length <= 4 ? 'quad' : 'multi'}}">
      <view wx:for="{{note.images}}" wx:key="*this" class="image-item">
        <image 
          src="{{item}}" 
          mode="aspectFill" 
          class="note-image" 
          bindtap="previewImage" 
          data-index="{{index}}"
          lazy-load
        />
      </view>
    </view>
  </view>

  <!-- 标签 -->
  <view class="tags" wx:if="{{note.tags && note.tags.length > 0}}">
    <view wx:for="{{note.tags}}" wx:key="*this" class="tag">{{item}}</view>
  </view>

  <!-- 日期和作者 -->
  <view class="date">
    <text wx:if="{{note.createdByName}}">{{note.createdByName}} · </text>
    <text>创建于 {{formattedCreateTime}}</text>
    <text wx:if="{{formattedUpdateTime}}"> · 更新于 {{formattedUpdateTime}}</text>
  </view>

  <!-- 操作 -->
  <view class="actions" wx:if="{{canEdit}}">
    <view class="edit-btn" bindtap="editNote">编辑笔记</view>
    <view class="delete-btn" bindtap="deleteNote">删除笔记</view>
  </view>
</view>
