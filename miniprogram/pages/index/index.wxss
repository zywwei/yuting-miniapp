/* 首页样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF0F3 0%, #FFF5F0 50%, #FFF8F0 100%);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.status-bar {
  width: 100%;
  background: transparent;
}

/* 头部欢迎区 */
.header {
  padding: 40rpx 40rpx 20rpx;
}

.greeting {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
}

.growth-info {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 通用区块 */
.section {
  margin: 24rpx 30rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

/* 今日习惯 */
.habit-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.habit-item {
  background: white;
  border-radius: 20rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.habit-item:active {
  transform: scale(0.96);
}

.habit-item.completed {
  background: #F0FFF0;
  border: 2rpx solid #C8E6C9;
}

.habit-icon {
  font-size: 40rpx;
}

.habit-name {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.habit-status {
  font-size: 24rpx;
  color: #999;
}

.habit-item.completed .habit-status {
  color: #4CAF50;
}

/* 快捷入口 */
.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.quick-item {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx 0;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.quick-item:active {
  transform: scale(0.95);
}

.quick-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.quick-text {
  font-size: 24rpx;
  color: #666;
}

/* 今日推荐 */
.recommend-list {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.recommend-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #F5F5F5;
  transition: all 0.2s;
}

.recommend-item:last-child {
  border-bottom: none;
}

.recommend-item:active {
  background: #FFF5F5;
}

.recommend-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.recommend-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.recommend-arrow {
  font-size: 32rpx;
  color: #CCC;
}

/* 成就墙 */
.achievement-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.achievement-item {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.achievement-icon {
  font-size: 32rpx;
}

.achievement-text {
  font-size: 24rpx;
  color: #666;
}

/* 家长中心入口 */
.parent-entry {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(135deg, #F3E5F5, #E1BEE7);
  border: 2rpx solid #CE93D8;
}

.parent-icon {
  font-size: 40rpx;
}

.parent-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: bold;
  color: #7E57C2;
}

.parent-desc {
  font-size: 22rpx;
  color: #9C27B0;
}

.parent-arrow {
  font-size: 32rpx;
  color: #CE93D8;
}

/* 底部安全区 */
.safe-bottom {
  height: 40rpx;
}
