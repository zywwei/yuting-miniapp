<!-- 首页 - 钰婷成长小助手 -->
<view class="container">
  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px; background: {{themeColor}};"></view>

  <!-- 家庭切换组件 -->
  <family-switcher></family-switcher>

  <!-- 顶部欢迎区 -->
  <view class="header" style="background: {{themeGradient}};">
    <view class="header-main">
      <view class="header-left">
        <text class="header-date">{{weekdayStr}} {{dateStr}}</text>
        <text class="header-greeting">👋 {{greeting}}！</text>
      </view>

      <view class="header-center" wx:if="{{children.length > 0}}" bindtap="{{children.length > 1 ? 'toggleChildList' : ''}}">
        <view class="child-avatar">
          <image wx:if="{{currentChild.avatar}}" src="{{currentChild.avatar}}" mode="aspectFill" class="avatar-img" />
          <text wx:else class="avatar-emoji">{{currentChild.gender === 'boy' ? '👦' : currentChild.gender === 'girl' ? '👧' : '👶'}}</text>
        </view>
        <text class="child-current">{{currentChild.nickname || currentChild.name}}</text>
        <text class="select-arrow {{showChildList ? 'open' : ''}}" wx:if="{{children.length > 1}}">▾</text>
      </view>

      <view class="header-right">
        <view class="days-row">
          <text class="days-big">{{growthDays}}</text>
          <text class="days-unit">天</text>
        </view>
        <text class="days-detail">{{growthYears > 0 ? growthYears + '年' : ''}}{{growthMonths > 0 ? growthMonths + '个月' : ''}}{{growthDaysRemain > 0 ? growthDaysRemain + '天' : (growthYears === 0 && growthMonths === 0 ? '第1天' : '')}}</text>
      </view>
    </view>
  </view>

  <!-- 孩子下拉列表（放到header外面避免层级问题） -->
  <view class="child-dropdown {{showChildList ? 'show' : ''}}" wx:if="{{children.length > 1}}">
    <view
      class="child-option {{item.childId === currentChildId ? 'active' : ''}}"
      wx:for="{{children}}"
      wx:key="childId"
      data-id="{{item.childId}}"
      bindtap="onSwitchChild"
    >
      <text class="option-emoji">{{item.gender === 'boy' ? '👦' : item.gender === 'girl' ? '👧' : '👶'}}</text>
      <text class="option-name">{{item.nickname || item.name}}</text>
      <text class="option-check" wx:if="{{item.childId === currentChildId}}">✓</text>
    </view>
  </view>

  <!-- 今日习惯 -->
  <view class="section">
    <view class="section-title">📅 今日待办</view>
    <view class="habit-list">
      <view
        wx:for="{{todayHabits}}"
        wx:key="type"
        class="habit-item {{item.completed ? 'completed' : ''}}"
        bindtap="goHabit"
        data-type="{{item.type}}"
      >
        <view class="habit-icon">{{item.icon}}</view>
        <view class="habit-name">{{item.name}}</view>
        <view class="habit-status">
          <text wx:if="{{item.completed}}">✅</text>
          <text wx:else>{{item.done}}/{{item.target}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="section">
    <view class="section-title">🎯 快捷入口</view>
    <view class="quick-grid">
      <view class="quick-item" bindtap="goModule" data-module="rps">
        <view class="quick-icon">✊</view>
        <view class="quick-text">猜拳大战</view>
      </view>
      <view class="quick-item" bindtap="goModule" data-module="draw">
        <view class="quick-icon">🎨</view>
        <view class="quick-text">画画</view>
      </view>
      <view class="quick-item" bindtap="goModule" data-module="stall">
        <view class="quick-icon">🏪</view>
        <view class="quick-text">摆摊</view>
      </view>
      <view class="quick-item" bindtap="goModule" data-module="aiChat">
        <view class="quick-icon">🤖</view>
        <view class="quick-text">AI助手</view>
      </view>
    </view>
  </view>

  <!-- 今日推荐 -->
  <view class="section">
    <view class="section-title">⭐ 今日推荐</view>
    <view class="recommend-list">
      <view
        wx:for="{{recommendations}}"
        wx:key="text"
        class="recommend-item"
        bindtap="goRecommendation"
        data-target="{{item.target}}"
      >
        <view class="recommend-icon">{{item.icon}}</view>
        <view class="recommend-text">{{item.text}}</view>
        <view class="recommend-arrow">›</view>
      </view>
    </view>
  </view>

  <!-- 成就墙 -->
  <view class="section">
    <view class="section-title-bar">
      <view class="section-title">🏆 成就墙</view>
      <view class="section-more" bindtap="goAchievements">查看全部 ›</view>
    </view>
    <view class="achievement-list">
      <view wx:for="{{achievements}}" wx:key="text" class="achievement-item">
        <view class="achievement-icon">{{item.icon}}</view>
        <view class="achievement-text">{{item.text}}</view>
      </view>
    </view>
  </view>

  <!-- 成就解锁弹窗 -->
  <achievement-popup id="achievementPopup"></achievement-popup>

  <!-- 家长中心入口 -->
  <view class="section parent-entry" bindtap="goParent">
    <view class="parent-icon">👨‍👩‍👧</view>
    <view class="parent-text">家长中心</view>
    <view class="parent-desc">查看成长数据和报告</view>
    <view class="parent-arrow">›</view>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-bottom"></view>
</view>
