/* 全局样式 */
page {
  background-color: #FFF5F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  color: #333;
}

/* 通用按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 20rpx 60rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 138, 0.3);
}

.btn-primary:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* 卡片样式 */
.card {
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 20rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

/* 页面容器 */
.container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}
