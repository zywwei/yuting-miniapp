.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  padding: 20rpx;
  padding-bottom: 180rpx;
}

/* 进度条 */
.progress-bar {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 15rpx rgba(0, 0, 0, 0.05);
}

.progress-text {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.progress-track {
  height: 16rpx;
  background: #e0e0e0;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #d4fc79 0%, #96e6a1 100%);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

/* 名句卡片 */
.card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.card-source-badge {
  font-size: 28rpx;
  color: #fff;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  font-weight: bold;
}

.ai-btn {
  width: 60rpx;
  height: 60rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 15rpx rgba(102, 126, 234, 0.4);
}

.ai-icon {
  font-size: 32rpx;
}

/* 内容区块 */
.section {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 15rpx;
  padding-left: 15rpx;
  border-left: 6rpx solid #667eea;
}

.section-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  text-align: justify;
}

.section-content.quote {
  font-size: 36rpx;
  font-weight: bold;
  color: #222;
  text-align: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
  border-radius: 16rpx;
  line-height: 1.6;
}

.section-content.meaning {
  color: #555;
  font-size: 28rpx;
}

.section-content.lesson {
  color: #667eea;
  font-size: 28rpx;
  font-weight: bold;
  background: #f0f4ff;
  padding: 20rpx;
  border-radius: 16rpx;
}

/* 学习状态 */
.learned-status {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background: linear-gradient(135deg, #d4fc79 0%, #96e6a1 100%);
  border-radius: 16rpx;
  margin-top: 20rpx;
}

.learned-icon {
  font-size: 36rpx;
  color: #fff;
  margin-right: 10rpx;
}

.learned-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: bold;
}

/* 操作按钮 */
.actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.1);
  gap: 15rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  background: #f0f0f0;
  color: #666;
  transition: all 0.3s ease;
}

.action-btn.primary {
  background: linear-gradient(135deg, #d4fc79 0%, #96e6a1 100%);
  color: #fff;
  box-shadow: 0 4rpx 15rpx rgba(150, 230, 161, 0.4);
}

.action-btn.speak {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  box-shadow: 0 4rpx 15rpx rgba(102, 126, 234, 0.4);
}

.action-btn.learned {
  background: #e8e8e8;
  color: #999;
}

.action-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}
