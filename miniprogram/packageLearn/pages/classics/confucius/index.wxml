<!-- 论语孟子列表页 -->
<view class="container">
  <!-- 进度条 -->
  <view class="progress-bar">
    <view class="progress-text">已学 {{learnedCount}}/{{totalCount}}</view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{learnedCount / totalCount * 100}}%;"></view>
    </view>
  </view>

  <!-- 名句列表 -->
  <view class="list">
    <view class="list-item" wx:for="{{items}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="item-source-badge">{{item.source}}</view>
      <view class="item-info">
        <view class="item-quote">{{item.quote}}</view>
        <view class="item-lesson">{{item.lesson}}</view>
      </view>
      <view class="item-status {{item.learned ? 'learned' : ''}}">
        {{item.learned ? '✓' : ''}}
      </view>
    </view>
  </view>
</view>
