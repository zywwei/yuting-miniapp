<view class="container">
  <view class="header"><view class="header-title">论语孟子</view><view class="header-desc">学习儒家经典</view></view>
  <view class="quote-list">
    <view wx:for="{{quotes}}" wx:key="id" class="quote-item">
      <view class="quote-header">
        <view class="quote-source">《{{item.source}}》</view>
      </view>
      <view class="quote-text">{{item.quote}}</view>
      <view class="quote-meaning">{{item.meaning}}</view>
      <view class="quote-lesson">{{item.lesson}}</view>
    </view>
  </view>
</view>
