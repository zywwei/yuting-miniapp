.container { min-height: 100vh; background: #F5F7FA; }
.header { background: linear-gradient(135deg, #d4fc79, #96e6a1); padding: 40rpx; color: #333; }
.header-title { font-size: 44rpx; font-weight: bold; }
.header-desc { font-size: 26rpx; opacity: 0.8; margin-top: 8rpx; }
.quote-list { padding: 30rpx; }
.quote-item { background: white; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.quote-header { margin-bottom: 12rpx; }
.quote-source { font-size: 22rpx; color: #999; }
.quote-text { font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 12rpx; }
.quote-meaning { font-size: 24rpx; color: #666; margin-bottom: 8rpx; }
.quote-lesson { font-size: 22rpx; color: #4CAF50; }
