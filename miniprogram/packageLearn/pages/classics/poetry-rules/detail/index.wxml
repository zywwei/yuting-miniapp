<!-- 诗词格律详情页 -->
<view class="container">
  <!-- 进度条 -->
  <view class="progress-bar">
    <view class="progress-text">已学 {{learnedCount}}/{{totalCount}}</view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{learnedCount / totalCount * 100}}%;"></view>
    </view>
  </view>

  <!-- 格律卡片 -->
  <view class="card" wx:if="{{item}}">
    <view class="card-header">
      <view class="card-title">{{item.title}}</view>
      <!-- AI按钮 -->
      <view class="ai-btn" bindtap="openAIPanel">
        <text class="ai-icon">🤖</text>
      </view>
    </view>

    <!-- 结构 -->
    <view class="section">
      <view class="section-title">结构</view>
      <view class="section-content structure">{{item.structure}}</view>
    </view>

    <!-- 示例 -->
    <view class="section">
      <view class="section-title">示例</view>
      <view class="section-content example">{{item.example}}</view>
    </view>

    <!-- 规则 -->
    <view class="section">
      <view class="section-title">格律规则</view>
      <view class="rules-list">
        <view class="rule-item" wx:for="{{item.rules}}" wx:key="index">
          <view class="rule-index">{{index + 1}}</view>
          <view class="rule-text">{{item}}</view>
        </view>
      </view>
    </view>

    <!-- 学习状态 -->
    <view class="learned-status" wx:if="{{item.learned}}">
      <text class="learned-icon">✓</text>
      <text class="learned-text">已学会</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <view class="action-btn {{currentIndex <= 0 ? 'disabled' : ''}}" bindtap="prevItem">上一个</view>
    <view class="action-btn speak" bindtap="speakContent">🔊 朗读</view>
    <view class="action-btn {{item.learned ? 'learned' : 'primary'}}" bindtap="markAsLearned">
      {{item.learned ? '已学会 ✓' : '标记学会'}}
    </view>
    <view class="action-btn {{currentIndex >= totalCount - 1 ? 'disabled' : ''}}" bindtap="nextItem">下一个</view>
  </view>
</view>

<!-- AI面板组件 -->
<learn-ai-panel
  show="{{showAIPanel}}"
  module="classics-poetry-rules"
  contextData="{{item}}"
  quickQuestions="{{aiQuickQuestions}}"
  bind:close="closeAIPanel"
/>
