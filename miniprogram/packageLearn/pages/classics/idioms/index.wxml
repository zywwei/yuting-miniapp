<!-- 成语故事列表页 -->
<view class="container">
  <!-- 进度条 -->
  <view class="progress-bar">
    <view class="progress-text">已学 {{learnedCount}}/{{totalCount}}</view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{learnedCount / totalCount * 100}}%;"></view>
    </view>
  </view>

  <!-- 成语列表 -->
  <view class="list">
    <view class="list-item" wx:for="{{items}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <view class="item-index">{{index + 1}}</view>
      <view class="item-info">
        <view class="item-title">{{item.idiom}}</view>
        <view class="item-pinyin">{{item.pinyin}}</view>
      </view>
      <view class="item-status {{item.learned ? 'learned' : ''}}">
        {{item.learned ? '✓' : ''}}
      </view>
    </view>
  </view>
</view>
