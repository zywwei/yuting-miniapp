/* 数字启蒙样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8F5E9, #F5F7FA);
  padding: 30rpx;
}

/* 进度条 */
.progress-bar {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 30rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.progress-track {
  height: 12rpx;
  background: #E0E0E0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #66BB6A, #43A047);
  border-radius: 6rpx;
  transition: width 0.3s;
}

/* 数字卡片 */
.number-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.number-card {
  position: relative;
  background: white;
  border-radius: 30rpx;
  width: 100%;
  padding: 80rpx 50rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 40rpx;
  box-sizing: border-box;
}

/* AI按钮（嵌入卡片右上角） */
.ai-inline-btn {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.4);
}

.ai-inline-icon {
  font-size: 32rpx;
}

.ai-inline-btn:active {
  opacity: 0.9;
  transform: scale(0.9);
}

.number-big {
  font-size: 180rpx;
  font-weight: bold;
  color: #43A047;
  line-height: 1.2;
}

.number-chinese {
  font-size: 48rpx;
  color: #666;
  margin-top: 20rpx;
}

/* 操作按钮 */
.actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
  margin-bottom: 24rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 8rpx;
  background: white;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #666;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.action-btn.primary {
  background: linear-gradient(135deg, #66BB6A, #43A047);
  color: white;
  font-weight: bold;
}

.action-btn.speak {
  background: #FFF3E0;
  color: #FF9800;
}

.action-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.quiz-btn {
  width: 100%;
  text-align: center;
  padding: 28rpx;
  background: linear-gradient(135deg, #FFB74D, #FF9800);
  color: white;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 16rpx rgba(255, 152, 0, 0.3);
}

.quiz-btn:active {
  opacity: 0.9;
}

/* 测验模式 */
.quiz-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 30rpx;
}

.quiz-progress {
  font-size: 26rpx;
  color: #666;
}

.quiz-score {
  font-size: 26rpx;
  color: #FF9800;
  font-weight: bold;
}

.quiz-question {
  background: white;
  border-radius: 30rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-bottom: 40rpx;
}

.quiz-number {
  font-size: 80rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.quiz-hint {
  font-size: 28rpx;
  color: #999;
}

.quiz-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.quiz-option {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.quiz-option:active {
  transform: scale(0.98);
}

.quiz-option.correct {
  background: #E8F5E9;
  color: #43A047;
  border: 2rpx solid #43A047;
}

.quiz-option.wrong {
  background: #FFEBEE;
  color: #F44336;
  border: 2rpx solid #F44336;
}

.quiz-result {
  text-align: center;
  margin-bottom: 40rpx;
}

.result-text {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.next-btn {
  display: inline-block;
  background: linear-gradient(135deg, #66BB6A, #43A047);
  color: white;
  padding: 20rpx 60rpx;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.next-btn:active {
  opacity: 0.9;
}

.back-btn {
  text-align: center;
  color: #999;
  font-size: 26rpx;
  padding: 20rpx;
}

.back-btn:active {
  color: #666;
}
