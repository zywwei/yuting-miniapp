/* 学习历史页面样式 */
.container {
  min-height: 100vh;
  background: #F5F7FA;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx;
  color: white;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
}

.clear-btn {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  background: rgba(255, 255, 255, 0.3);
  border-radius: 20rpx;
}

.filter-bar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 30rpx;
  background: white;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-item {
  padding: 12rpx 24rpx;
  background: #F5F7FA;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
}

.filter-item.active {
  background: #667eea;
  color: white;
}

.log-list {
  padding: 30rpx;
}

.log-item {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.log-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.log-info {
  flex: 1;
}

.log-title {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.log-time {
  font-size: 22rpx;
  color: #999;
}

.empty {
  text-align: center;
  padding: 120rpx 60rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
