<view class="container">
  <view class="header"><view class="header-title">科学实验</view><view class="header-desc">动手做实验</view></view>
  <view class="experiment-list">
    <view wx:for="{{items}}" wx:key="id" class="experiment-item" bindtap="goDetail" data-id="{{item.id}}">
      <view class="experiment-header">
        <view class="experiment-title">{{item.no}}. {{item.title}}</view>
        <view class="experiment-category">{{item.tag}}{{item.learned ? ' · 已学' : ''}}</view>
      </view>
      <view class="experiment-principle">
        <view class="principle-title">原理：</view>
        <view class="principle-text">{{item.desc}}</view>
      </view>
    </view>
  </view>
</view>
