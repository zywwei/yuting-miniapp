.container { min-height: 100vh; background: #F5F7FA; }
.header { background: linear-gradient(135deg, #43e97b, #38f9d7); padding: 40rpx; color: white; }
.header-title { font-size: 44rpx; font-weight: bold; }
.header-desc { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }
.topic-list { padding: 30rpx; }
.topic-item { background: white; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.topic-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.topic-title { font-size: 28rpx; font-weight: bold; }
.topic-category { font-size: 22rpx; color: #43e97b; background: #E8F5E9; padding: 4rpx 12rpx; border-radius: 8rpx; }
.topic-content { font-size: 24rpx; color: #666; line-height: 1.6; margin-bottom: 12rpx; }
.topic-examples { background: #F5F7FA; border-radius: 8rpx; padding: 16rpx; }
.examples-title { font-size: 22rpx; color: #999; margin-bottom: 8rpx; }
.example-item { font-size: 24rpx; color: #333; margin-bottom: 4rpx; }
