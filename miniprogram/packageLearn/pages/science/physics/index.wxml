<view class="container">
  <view class="header"><view class="header-title">物理常识</view><view class="header-desc">探索物理世界</view></view>
  <view class="topic-list">
    <view wx:for="{{items}}" wx:key="id" class="topic-item" bindtap="goDetail" data-id="{{item.id}}">
      <view class="topic-header">
        <view class="topic-title">{{item.no}}. {{item.title}}</view>
        <view class="topic-category">{{item.tag}}{{item.learned ? ' · 已学' : ''}}</view>
      </view>
      <view class="topic-content">{{item.desc}}</view>
    </view>
  </view>
</view>
