<view class="container">
  <view class="header"><view class="header-title">化学常识</view><view class="header-desc">了解化学世界</view></view>
  <view class="topic-list">
    <view wx:for="{{topics}}" wx:key="id" class="topic-item">
      <view class="topic-header">
        <view class="topic-title">{{item.title}}</view>
        <view class="topic-category">{{item.category === 'substance' ? '物质' : item.category === 'reaction' ? '反应' : '元素'}}</view>
      </view>
      <view class="topic-content">{{item.content}}</view>
      <view class="topic-examples" wx:if="{{item.examples}}">
        <view class="examples-title">例子：</view>
        <view wx:for="{{item.examples}}" wx:for-item="ex" wx:key="*this" class="example-item">• {{ex}}</view>
      </view>
    </view>
  </view>
</view>
