.container { min-height: 100vh; background: #F5F7FA; }
.header { background: linear-gradient(135deg, #f093fb, #f5576c); padding: 40rpx; color: white; }
.header-title { font-size: 44rpx; font-weight: bold; }
.header-desc { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }
.classics-list { padding: 30rpx; }
.classic-item { background: white; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.classic-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.classic-title { font-size: 28rpx; font-weight: bold; }
.classic-source { font-size: 22rpx; color: #999; }
.classic-content { font-size: 26rpx; color: #333; line-height: 1.8; margin-bottom: 12rpx; }
.classic-meaning { background: #F5F7FA; border-radius: 8rpx; padding: 16rpx; }
.meaning-label { font-size: 22rpx; color: #999; margin-bottom: 4rpx; }
.meaning-text { font-size: 24rpx; color: #666; }
