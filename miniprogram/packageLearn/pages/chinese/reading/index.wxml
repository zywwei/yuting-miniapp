<view class="container">
  <view class="header">
    <view class="header-title">阅读理解</view>
    <view class="header-desc">提升阅读能力</view>
  </view>

  <view class="article-list">
    <view wx:for="{{items}}" wx:key="id" class="article-item" bindtap="goDetail" data-id="{{item.id}}">
      <view class="article-title">{{item.no}}. {{item.title}}</view>
      <view class="article-meta">
        <view class="article-type" wx:if="{{item.tag}}">{{item.tag}}{{item.learned ? ' · 已学' : ''}}</view>
      </view>
      <view class="article-content">{{item.desc}}</view>
    </view>
  </view>
</view>
