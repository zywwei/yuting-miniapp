<view class="container">
  <view class="header"><view class="header-title">写作指导</view><view class="header-desc">提升写作能力</view></view>
  <view class="section">
    <view class="section-title">作文题目</view>
    <view wx:for="{{items}}" wx:key="id" class="topic-item" bindtap="goDetail" data-id="{{item.id}}">
      <view class="topic-title">{{item.no}}. {{item.title}}</view>
      <view class="topic-desc">{{item.desc}}</view>
      <view class="topic-grade" wx:if="{{item.tag}}">{{item.tag}}{{item.learned ? ' · 已学' : ''}}</view>
    </view>
  </view>
</view>
