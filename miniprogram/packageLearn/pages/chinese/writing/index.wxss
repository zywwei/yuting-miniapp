.container { min-height: 100vh; background: #F5F7FA; }
.header { background: linear-gradient(135deg, #f093fb, #f5576c); padding: 40rpx; color: white; }
.header-title { font-size: 44rpx; font-weight: bold; }
.header-desc { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }
.section { padding: 30rpx; }
.section-title { font-size: 28rpx; font-weight: bold; margin-bottom: 16rpx; }
.tip-item { background: white; border-radius: 12rpx; padding: 20rpx; margin-bottom: 12rpx; }
.tip-title { font-size: 26rpx; font-weight: bold; margin-bottom: 8rpx; }
.tip-content { font-size: 24rpx; color: #666; }
.topic-item { background: white; border-radius: 12rpx; padding: 20rpx; margin-bottom: 12rpx; }
.topic-title { font-size: 26rpx; font-weight: bold; margin-bottom: 8rpx; }
.topic-desc { font-size: 24rpx; color: #666; margin-bottom: 8rpx; }
.topic-grade { font-size: 22rpx; color: #999; }
