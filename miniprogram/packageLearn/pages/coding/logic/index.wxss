.container { min-height: 100vh; background: #F5F7FA; }
.header { background: linear-gradient(135deg, #a18cd1, #fbc2eb); padding: 40rpx; color: white; }
.header-title { font-size: 44rpx; font-weight: bold; }
.header-desc { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }
.exercise-list { padding: 30rpx; }
.exercise-item { background: white; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.exercise-title { font-size: 28rpx; font-weight: bold; margin-bottom: 8rpx; }
.exercise-question { font-size: 24rpx; color: #666; }
.exercise-area { padding: 30rpx; }
.options { margin: 20rpx 0; }
.option-item { background: white; border-radius: 12rpx; padding: 20rpx; margin-bottom: 12rpx; border: 2rpx solid transparent; }
.option-item.selected { border-color: #a18cd1; background: #F3E5F5; }
.option-item.correct { border-color: #4CAF50; background: #E8F5E9; }
.explanation { background: white; border-radius: 12rpx; padding: 20rpx; margin-bottom: 20rpx; }
.explanation-title { font-size: 28rpx; font-weight: bold; margin-bottom: 8rpx; }
.explanation-text { font-size: 24rpx; color: #666; }
.action-btn { text-align: center; padding: 24rpx; background: #a18cd1; color: white; border-radius: 40rpx; }
