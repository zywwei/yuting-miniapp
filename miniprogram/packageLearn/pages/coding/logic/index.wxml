<view class="container">
  <view class="header"><view class="header-title">逻辑训练</view><view class="header-desc">提升逻辑思维</view></view>
  <view class="exercise-list">
    <view wx:for="{{items}}" wx:key="id" class="exercise-item" bindtap="goDetail" data-id="{{item.id}}">
      <view class="exercise-title">{{item.no}}. {{item.title}}{{item.learned ? ' · 已学' : ''}}</view>
      <view class="exercise-question">{{item.desc}}</view>
    </view>
  </view>
</view>
