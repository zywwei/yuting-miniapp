.container { min-height: 100vh; background: #F5F7FA; }
.header { background: linear-gradient(135deg, #a18cd1, #fbc2eb); padding: 40rpx; color: white; }
.header-title { font-size: 44rpx; font-weight: bold; }
.header-desc { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }
.algorithm-list { padding: 30rpx; }
.algorithm-item { background: white; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.algorithm-name { font-size: 28rpx; font-weight: bold; margin-bottom: 8rpx; }
.algorithm-desc { font-size: 24rpx; color: #666; margin-bottom: 12rpx; }
.algorithm-steps { background: #F5F7FA; border-radius: 8rpx; padding: 16rpx; margin-bottom: 12rpx; }
.step-item { font-size: 24rpx; color: #333; margin-bottom: 4rpx; }
.algorithm-complexity { font-size: 22rpx; color: #a18cd1; }
