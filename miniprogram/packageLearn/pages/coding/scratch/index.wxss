.container { min-height: 100vh; background: #F5F7FA; }
.header { background: linear-gradient(135deg, #a18cd1, #fbc2eb); padding: 40rpx; color: white; }
.header-title { font-size: 44rpx; font-weight: bold; }
.header-desc { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }
.project-list { padding: 30rpx; }
.project-item { background: white; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.project-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.project-title { font-size: 28rpx; font-weight: bold; }
.project-difficulty { font-size: 22rpx; color: #a18cd1; }
.project-desc { font-size: 24rpx; color: #666; margin-bottom: 12rpx; }
.project-blocks { background: #F3E5F5; border-radius: 8rpx; padding: 16rpx; }
.blocks-title { font-size: 22rpx; color: #999; margin-bottom: 8rpx; }
.block-item { font-size: 24rpx; color: #333; margin-bottom: 4rpx; }
