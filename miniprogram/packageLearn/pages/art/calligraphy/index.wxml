<view class="container">
  <view class="header"><view class="header-title">书法练习</view><view class="header-desc">学习书法基础</view></view>
  <view class="topic-list">
    <view wx:for="{{items}}" wx:key="id" class="topic-item" bindtap="goDetail" data-id="{{item.id}}">
      <view class="topic-title">{{item.no}}. {{item.title}}{{item.learned ? ' · 已学' : ''}}</view>
      <view class="topic-content">{{item.desc}}</view>
    </view>
  </view>
</view>
