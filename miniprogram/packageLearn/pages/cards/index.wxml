<!-- 识字卡片 -->
<view class="container">
  <!-- 进度 -->
  <view class="progress-bar">
    <view class="progress-text">已学 {{learnedCount}}/{{cards.length}}</view>
    <view class="progress-track">
      <view class="progress-fill" style="width: {{learnedCount / cards.length * 100}}%;"></view>
    </view>
  </view>

  <!-- 全部字入口 -->
  <view class="all-cards-entry" bindtap="goAllCards">
    <view class="entry-left">
      <view class="entry-icon">📑</view>
      <view class="entry-text">
        <view class="entry-title">全部字</view>
        <view class="entry-desc">{{learnedCount}}/{{cards.length}} 已学 · 点击查看所有汉字</view>
      </view>
    </view>
    <view class="entry-arrow">›</view>
  </view>

  <!-- 卡片 -->
  <view class="card-container" wx:if="{{cards.length > 0}}">
    <view class="card">
      <view class="card-word">{{cards[currentIndex].word}}</view>
      <view class="card-pinyin" wx:if="{{showPinyin}}">{{cards[currentIndex].pinyin}}</view>
      <view class="card-meaning">{{cards[currentIndex].meaning}}</view>
      <view class="card-category">{{cards[currentIndex].levelName}}</view>
      
      <!-- AI按钮（嵌入卡片右上角） -->
      <view class="ai-inline-btn" bindtap="openAIPanel">
        <text class="ai-inline-icon">🤖</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="actions">
      <view class="action-btn" bindtap="prevCard">上一个</view>
      <view class="action-btn speak" bindtap="speakWord">🔊 跟读</view>
      <view class="action-btn primary" bindtap="markLearned">
        {{cards[currentIndex].learned ? '已学会 ✓' : '学会了'}}
      </view>
      <view class="action-btn" bindtap="nextCard">下一个</view>
    </view>

    <!-- 拼音开关 -->
    <view class="toggle-row">
      <view class="toggle-btn" bindtap="togglePinyin">
        {{showPinyin ? '隐藏拼音' : '显示拼音'}}
      </view>
    </view>
  </view>
</view>

<!-- AI面板组件 -->
<learn-ai-panel
  show="{{showAIPanel}}"
  module="cards"
  contextData="{{cards[currentIndex]}}"
  quickQuestions="{{aiQuickQuestions}}"
  bind:close="closeAIPanel"
/>
