/* 全部古诗列表页样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF8E1, #F5F7FA);
  padding: 30rpx;
  box-sizing: border-box;
}

/* 顶部进度 */
.header {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-count {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
}

.filter-toggle {
  font-size: 24rpx;
  color: #FF8F00;
  padding: 8rpx 22rpx;
  border: 1rpx solid #FF8F00;
  border-radius: 30rpx;
  background: white;
}

.filter-toggle.active {
  background: #FF8F00;
  color: white;
}

.filter-toggle:active {
  opacity: 0.85;
}

.progress-track {
  height: 12rpx;
  background: #E0E0E0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FFB74D, #FF8F00);
  border-radius: 6rpx;
  transition: width 0.3s;
}

/* 搜索框 */
.search-box {
  background: white;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 14rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.search-clear {
  font-size: 28rpx;
  color: #ccc;
  padding: 0 8rpx;
}

/* 分类筛选 */
.category-bar {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin-right: 14rpx;
  background: white;
  color: #666;
  font-size: 24rpx;
  border-radius: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.chip.active {
  background: #FF8F00;
  color: white;
}

.chip:active {
  opacity: 0.85;
}

/* 结果计数 */
.result-summary {
  font-size: 22rpx;
  color: #999;
  padding: 4rpx 8rpx 16rpx;
}

/* 古诗列表 */
.poem-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.poem-item {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.poem-item:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.poem-item.memorized {
  border-left: 6rpx solid #FF8F00;
}

.poem-left {
  flex: 1;
}

.poem-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.poem-item.memorized .poem-title {
  color: #FF8F00;
}

.poem-author {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.poem-right {
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}

.poem-level {
  font-size: 20rpx;
  color: #999;
  background: #FFF8E1;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
}

.poem-status {
  font-size: 28rpx;
  color: #FF8F00;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 140rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 24rpx;
}
