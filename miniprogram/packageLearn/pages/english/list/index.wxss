/* 全部英语列表页样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF3E0, #F5F7FA);
  padding: 30rpx;
  box-sizing: border-box;
}

/* 模式选择 */
.mode-select {
  padding-top: 40rpx;
}

.mode-header {
  text-align: center;
  margin-bottom: 50rpx;
}

.mode-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
}

.mode-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
}

.mode-cards {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.mode-card {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
}

.mode-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.mode-icon {
  font-size: 60rpx;
  margin-right: 30rpx;
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF3E0;
  border-radius: 20rpx;
}

.mode-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.mode-info {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.mode-progress {
  font-size: 24rpx;
  color: #FF9800;
  margin-top: 8rpx;
}

/* 返回按钮 */
.back-btn {
  font-size: 28rpx;
  color: #FF9800;
  padding: 16rpx 0;
  margin-bottom: 10rpx;
}

/* 顶部进度 */
.header {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.progress-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-count {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
}

.filter-toggle {
  font-size: 24rpx;
  color: #FF9800;
  padding: 8rpx 22rpx;
  border: 1rpx solid #FF9800;
  border-radius: 30rpx;
  background: white;
}

.filter-toggle.active {
  background: #FF9800;
  color: white;
}

.filter-toggle:active {
  opacity: 0.85;
}

.progress-track {
  height: 12rpx;
  background: #E0E0E0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #FFB74D, #FF9800);
  border-radius: 6rpx;
  transition: width 0.3s;
}

/* 搜索框 */
.search-box {
  background: white;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 14rpx;
  opacity: 0.6;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
}

.search-clear {
  font-size: 28rpx;
  color: #ccc;
  padding: 0 8rpx;
}

/* 分类筛选 */
.category-bar {
  white-space: nowrap;
  margin-bottom: 16rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 26rpx;
  margin-right: 14rpx;
  background: white;
  color: #666;
  font-size: 24rpx;
  border-radius: 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.chip.active {
  background: #FF9800;
  color: white;
}

.chip:active {
  opacity: 0.85;
}

/* 结果计数 */
.result-summary {
  font-size: 22rpx;
  color: #999;
  padding: 4rpx 8rpx 16rpx;
}

/* 字母网格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cell {
  position: relative;
  width: calc((100% - 64rpx) / 5);
  height: 132rpx;
  background: white;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.cell:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.cell-letter {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.1;
}

.cell.learned .cell-letter {
  color: #FF9800;
}

.cell-word {
  font-size: 18rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 单词列表 */
.word-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.word-item {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.word-item:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.word-item.learned {
  border-left: 6rpx solid #FF9800;
}

.word-main {
  flex: 1;
}

.word-english {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.word-item.learned .word-english {
  color: #FF9800;
}

.word-phonetic {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.word-right {
  text-align: right;
}

.word-meaning {
  font-size: 28rpx;
  color: #333;
}

.word-category {
  font-size: 20rpx;
  color: #999;
  margin-top: 6rpx;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 140rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 26rpx;
  color: #999;
  margin-top: 24rpx;
}
