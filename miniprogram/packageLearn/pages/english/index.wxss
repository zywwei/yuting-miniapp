/* 英语学习样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #E8EAF6, #F5F7FA);
  padding: 30rpx;
}

/* 返回按钮 */
.back-btn {
  color: #5C6BC0;
  font-size: 28rpx;
  padding: 16rpx 0;
  margin-bottom: 16rpx;
}

.back-btn:active {
  opacity: 0.7;
}

/* ===== 模式选择 ===== */
.mode-select {
  padding-top: 40rpx;
}

.mode-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.mode-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.mode-desc {
  font-size: 26rpx;
  color: #999;
}

.mode-cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.mode-card {
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s;
}

.mode-card:active {
  transform: scale(0.98);
}

.mode-icon {
  font-size: 60rpx;
  font-weight: bold;
  color: #5C6BC0;
  margin-bottom: 16rpx;
}

.mode-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.mode-info {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 16rpx;
}

.mode-progress {
  display: inline-block;
  background: #E8EAF6;
  color: #5C6BC0;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
}

/* 全部英语入口 */
.all-english-entry,
.all-entry {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 30rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.all-english-entry:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.entry-left {
  display: flex;
  align-items: center;
}

.entry-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.entry-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.entry-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

.entry-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* ===== 进度条 ===== */
.progress-bar {
  background: white;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.progress-track {
  height: 12rpx;
  background: #E0E0E0;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #5C6BC0, #3F51B5);
  border-radius: 6rpx;
  transition: width 0.3s;
}

/* ===== 字母卡片 ===== */
.letter-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.letter-card {
  background: white;
  border-radius: 30rpx;
  width: 100%;
  padding: 48rpx 32rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 32rpx;
}

.letter-big {
  font-size: 160rpx;
  font-weight: bold;
  color: #3F51B5;
  line-height: 1.2;
}

.letter-phonetic {
  font-size: 36rpx;
  color: #999;
  margin-top: 12rpx;
}

.letter-word-section {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #F0F0F0;
}

.letter-word {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}

.letter-word-meaning {
  font-size: 28rpx;
  color: #666;
  margin-top: 8rpx;
}

.letter-word-phonetic {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}

/* ===== 单词卡片 ===== */
.word-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.word-card {
  background: white;
  border-radius: 30rpx;
  width: 100%;
  padding: 60rpx 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 32rpx;
}

.word-english {
  font-size: 64rpx;
  font-weight: bold;
  color: #3F51B5;
  line-height: 1.2;
}

.word-phonetic {
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
}

.word-chinese {
  font-size: 36rpx;
  color: #333;
  margin-top: 20rpx;
}

.word-category {
  display: inline-block;
  background: #E8EAF6;
  color: #5C6BC0;
  font-size: 22rpx;
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  margin-top: 20rpx;
}

/* ===== 操作按钮 ===== */
.actions {
  display: flex;
  gap: 16rpx;
  width: 100%;
  margin-bottom: 24rpx;
}

.action-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 8rpx;
  background: white;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #666;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.action-btn.primary {
  background: linear-gradient(135deg, #5C6BC0, #3F51B5);
  color: white;
  font-weight: bold;
}

.action-btn.speak {
  background: #FFF3E0;
  color: #FF9800;
}

.action-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}

/* ===== 音标开关 ===== */
.toggle-row {
  text-align: center;
}

.toggle-btn {
  display: inline-block;
  color: #5C6BC0;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
}

.toggle-btn:active {
  opacity: 0.7;
}

/* AI浮动按钮 */
.ai-float-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 16rpx 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.4);
}

.ai-icon {
  font-size: 28rpx;
}

.ai-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 500;
}

.ai-float-btn:active {
  opacity: 0.9;
  transform: scale(0.98);
}
