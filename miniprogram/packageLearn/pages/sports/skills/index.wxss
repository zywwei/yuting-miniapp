.container { min-height: 100vh; background: #F5F7FA; }
.header { background: linear-gradient(135deg, #f5af19, #f12711); padding: 40rpx; color: white; }
.header-title { font-size: 44rpx; font-weight: bold; }
.header-desc { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }
.skill-list { padding: 30rpx; }
.skill-item { background: white; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.skill-name { font-size: 28rpx; font-weight: bold; margin-bottom: 8rpx; }
.skill-desc { font-size: 24rpx; color: #666; margin-bottom: 12rpx; }
.skill-steps { background: #FFF3E0; border-radius: 8rpx; padding: 16rpx; }
.step-item { font-size: 24rpx; color: #333; margin-bottom: 4rpx; }
