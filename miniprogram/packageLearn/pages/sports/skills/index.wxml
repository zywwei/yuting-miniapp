<view class="container">
  <view class="header"><view class="header-title">运动技巧</view><view class="header-desc">学习运动方法</view></view>
  <view class="skill-list">
    <view wx:for="{{items}}" wx:key="id" class="skill-item" bindtap="goDetail" data-id="{{item.id}}">
      <view class="skill-name">{{item.no}}. {{item.title}}{{item.learned ? ' · 已学' : ''}}</view>
      <view class="skill-desc">{{item.desc}}</view>
    </view>
  </view>
</view>
