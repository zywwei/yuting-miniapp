.container { min-height: 100vh; background: #F5F7FA; }
.header { background: linear-gradient(135deg, #f5af19, #f12711); padding: 40rpx; color: white; }
.header-title { font-size: 44rpx; font-weight: bold; }
.header-desc { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }
.sport-list { padding: 30rpx; }
.sport-item { background: white; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.sport-name { font-size: 28rpx; font-weight: bold; margin-bottom: 8rpx; }
.sport-rules { font-size: 24rpx; color: #666; margin-bottom: 12rpx; }
.sport-skills { background: #FFF3E0; border-radius: 8rpx; padding: 16rpx; }
.skills-title { font-size: 22rpx; color: #999; margin-bottom: 8rpx; }
.skill-item { display: inline-block; margin-right: 16rpx; font-size: 24rpx; color: #333; }
