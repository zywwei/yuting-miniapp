.container { min-height: 100vh; background: #F5F7FA; }
.header { background: linear-gradient(135deg, #fa709a, #fee140); padding: 40rpx; color: white; }
.header-title { font-size: 44rpx; font-weight: bold; }
.header-desc { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }
.exercise-list { padding: 30rpx; }
.exercise-item { background: white; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.exercise-type { font-size: 22rpx; color: #fa709a; margin-bottom: 8rpx; }
.exercise-text { font-size: 28rpx; font-weight: bold; margin-bottom: 8rpx; }
.exercise-phonetic { font-size: 24rpx; color: #999; margin-bottom: 8rpx; }
.exercise-meaning { font-size: 24rpx; color: #666; margin-bottom: 12rpx; }
.exercise-example { background: #FFF0F3; border-radius: 8rpx; padding: 16rpx; margin-bottom: 12rpx; }
.example-title { font-size: 22rpx; color: #999; margin-bottom: 4rpx; }
.example-text { font-size: 24rpx; color: #333; }
.audio-btn { display: inline-block; padding: 12rpx 24rpx; background: #fa709a; color: white; border-radius: 20rpx; font-size: 24rpx; }
