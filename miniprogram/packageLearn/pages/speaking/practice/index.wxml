<view class="container">
  <view class="header"><view class="header-title">口语练习</view><view class="header-desc">提升口语能力</view></view>
  <view class="exercise-list">
    <view wx:for="{{items}}" wx:key="id" class="exercise-item" bindtap="goDetail" data-id="{{item.id}}">
      <view class="exercise-type">{{item.tag}}{{item.learned ? ' · 已学' : ''}}</view>
      <view class="exercise-text">{{item.no}}. {{item.title}}</view>
      <view class="exercise-meaning">{{item.desc}}</view>
      <view class="audio-btn" catchtap="playAudio">🔊 播放</view>
    </view>
  </view>
</view>
