<view class="container">
  <view class="header"><view class="header-title">情景对话</view><view class="header-desc">学习日常对话</view></view>
  <view class="scenario-list">
    <view wx:for="{{items}}" wx:key="id" class="scenario-item" bindtap="goDetail" data-id="{{item.id}}">
      <view class="scenario-title">{{item.no}}. {{item.title}}{{item.learned ? ' · 已学' : ''}}</view>
      <view class="dialogue-list">{{item.desc}}</view>
    </view>
  </view>
</view>
