<view class="container">
  <view class="header"><view class="header-title">英语演讲</view><view class="header-desc">提升演讲能力</view></view>
  <view class="speech-list">
    <view wx:for="{{items}}" wx:key="id" class="speech-item" bindtap="goDetail" data-id="{{item.id}}">
      <view class="speech-title">{{item.no}}. {{item.title}}{{item.learned ? ' · 已学' : ''}}</view>
      <view class="speech-content">{{item.desc}}</view>
    </view>
  </view>
</view>
