.container { min-height: 100vh; background: #F5F7FA; }
.header { background: linear-gradient(135deg, #667eea, #764ba2); padding: 40rpx; color: white; }
.header-title { font-size: 44rpx; font-weight: bold; }
.header-desc { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }
.problem-list { padding: 30rpx; }
.problem-item { background: white; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.problem-header { display: flex; justify-content: space-between; margin-bottom: 8rpx; }
.problem-title { font-size: 28rpx; font-weight: bold; }
.problem-grade { font-size: 22rpx; color: #667eea; }
.problem-question { font-size: 26rpx; color: #333; }
.problem-detail { padding: 30rpx; background: white; margin: 30rpx; border-radius: 16rpx; }
.problem-steps { background: #F5F7FA; border-radius: 8rpx; padding: 16rpx; margin: 16rpx 0; }
.steps-title { font-size: 22rpx; color: #999; margin-bottom: 8rpx; }
.step-item { font-size: 24rpx; color: #333; margin-bottom: 4rpx; }
.problem-answer { font-size: 28rpx; font-weight: bold; color: #667eea; margin: 16rpx 0; }
.actions { display: flex; gap: 12rpx; margin-top: 20rpx; }
.action-btn { flex: 1; text-align: center; padding: 20rpx; background: #667eea; color: white; border-radius: 40rpx; font-size: 24rpx; }
.action-btn.secondary { background: #F5F7FA; color: #666; }
