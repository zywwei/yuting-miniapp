<view class="container">
  <view class="header"><view class="header-title">应用题</view><view class="header-desc">解决实际问题</view></view>
  <view class="problem-list">
    <view wx:for="{{items}}" wx:key="id" class="problem-item" bindtap="goDetail" data-id="{{item.id}}">
      <view class="problem-header"><view class="problem-title">{{item.no}}. {{item.title}}</view><view class="problem-grade" wx:if="{{item.tag}}">{{item.tag}}</view></view>
      <view class="problem-question">{{item.desc}}</view>
    </view>
  </view>
</view>
