<view class="container">
  <view class="header"><view class="header-title">几何证明</view><view class="header-desc">学习几何知识</view></view>
  <view class="topic-list">
    <view wx:for="{{items}}" wx:key="id" class="topic-item" bindtap="goDetail" data-id="{{item.id}}">
      <view class="topic-title">{{item.no}}. {{item.title}}</view>
      <view class="topic-content">{{item.desc}}</view>
      <view class="learn-btn" catchtap="markAsLearned" data-id="{{item.id}}">已学会{{item.learned ? ' ✓' : ''}}</view>
    </view>
  </view>
</view>
