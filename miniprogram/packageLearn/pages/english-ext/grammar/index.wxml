<view class="container">
  <view class="header"><view class="header-title">语法学习</view><view class="header-desc">掌握英语语法</view></view>
  <view class="grammar-list">
    <view wx:for="{{items}}" wx:key="id" class="grammar-item" bindtap="goDetail" data-id="{{item.id}}">
      <view class="grammar-title">{{item.no}}. {{item.title}}</view>
      <view class="grammar-desc">{{item.desc}}</view>
    </view>
  </view>
</view>
