<view class="container">
  <view class="header"><view class="header-title">句型练习</view><view class="header-desc">掌握英语句型</view></view>
  <view class="sentence-list">
    <view wx:for="{{items}}" wx:key="id" class="sentence-item" bindtap="goDetail" data-id="{{item.id}}">
      <view class="sentence-type" wx:if="{{item.tag}}">{{item.tag}}{{item.learned ? ' · 已学' : ''}}</view>
      <view class="sentence-example">{{item.no}}. {{item.title}}</view>
      <view class="sentence-meaning">{{item.desc}}</view>
    </view>
  </view>
</view>
