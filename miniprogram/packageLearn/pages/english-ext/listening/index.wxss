.container { min-height: 100vh; background: #F5F7FA; }
.header { background: linear-gradient(135deg, #4facfe, #00f2fe); padding: 40rpx; color: white; }
.header-title { font-size: 44rpx; font-weight: bold; }
.header-desc { font-size: 26rpx; opacity: 0.9; margin-top: 8rpx; }
.exercise-list { padding: 30rpx; }
.exercise-item { background: white; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.exercise-type { font-size: 22rpx; color: #999; margin-bottom: 8rpx; }
.exercise-word { font-size: 28rpx; font-weight: bold; }
.exercise-area { padding: 30rpx; text-align: center; }
.exercise-title { font-size: 28rpx; margin-bottom: 20rpx; }
.audio-btn { display: inline-block; padding: 20rpx 40rpx; background: #4facfe; color: white; border-radius: 40rpx; margin-bottom: 20rpx; }
.answer-input { background: white; border-radius: 12rpx; padding: 20rpx; text-align: center; margin-bottom: 20rpx; }
.actions { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.action-btn { flex: 1; padding: 20rpx; background: #4facfe; color: white; border-radius: 40rpx; text-align: center; }
.action-btn.next { background: #F5F7FA; color: #666; }
.answer { background: white; border-radius: 16rpx; padding: 24rpx; }
.answer-word { font-size: 36rpx; font-weight: bold; margin-bottom: 8rpx; }
.answer-phonetic { font-size: 24rpx; color: #999; margin-bottom: 8rpx; }
.answer-meaning { font-size: 26rpx; color: #666; }
