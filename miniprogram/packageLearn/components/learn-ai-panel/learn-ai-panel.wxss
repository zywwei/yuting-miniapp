/* 学习AI助手面板样式 */

.ai-panel-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}

.ai-panel-mask.show {
  opacity: 1;
  visibility: visible;
}

.ai-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 70vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  z-index: 1001;
}

.ai-panel.show {
  transform: translateY(0);
}

/* 拖拽区域 */
.drag-area {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 16rpx 0;
  cursor: grab;
}

.drag-bar {
  width: 60rpx;
  height: 8rpx;
  background: #ddd;
  border-radius: 4rpx;
}

/* 头部 */
.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.panel-actions {
  display: flex;
  gap: 24rpx;
}

.clear-btn {
  font-size: 28rpx;
  color: #999;
  padding: 8rpx 16rpx;
}

.close-btn {
  font-size: 32rpx;
  color: #999;
  padding: 8rpx 16rpx;
}

/* 快捷问题 */
.quick-questions {
  white-space: nowrap;
  padding: 16rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.quick-btn {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #666;
}

.quick-btn:active {
  background: #e8e8e8;
}

/* 消息列表 */
.message-list {
  flex: 1;
  padding: 24rpx 16rpx;
  overflow-y: auto;
}

.message-item {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.message-item.user {
  align-items: flex-end;
  padding-right: 16rpx;
}

.message-item.assistant {
  align-items: flex-start;
  padding-left: 16rpx;
}

.message-bubble {
  max-width: 80%;
  padding: 20rpx 28rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

.user .message-bubble {
  background: #007AFF;
  color: #fff;
  border-bottom-right-radius: 8rpx;
  max-width: 70%;
  margin-right: 32rpx;
}

.assistant .message-bubble {
  background: #f5f5f5;
  color: #333;
  border-bottom-left-radius: 8rpx;
}

/* 语音朗读行 */
.speak-row {
  margin-top: 8rpx;
}

.speak-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  background: rgba(0, 0, 0, 0.05);
  border-radius: 50%;
  font-size: 28rpx;
  opacity: 0.6;
  transition: all 0.3s ease;
}

.speak-btn:active {
  opacity: 1;
  transform: scale(1.1);
}

.speak-btn.speaking {
  opacity: 1;
  background: rgba(102, 126, 234, 0.1);
}

/* 思考过程 */
.thinking-box {
  max-width: 85%;
  margin-bottom: 16rpx;
  padding: 16rpx;
  background: #fff8e1;
  border-radius: 12rpx;
  border: 1rpx solid #ffe082;
  box-sizing: border-box;
}

.thinking-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.thinking-label {
  font-size: 24rpx;
  color: #f57f17;
}

.thinking-arrow {
  font-size: 20rpx;
  color: #f57f17;
  transition: transform 0.3s ease;
}

.thinking-arrow.expanded {
  transform: rotate(180deg);
}

.thinking-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #ffe082;
}

/* 加载动画 */
.loading-dots {
  display: flex;
  gap: 8rpx;
  padding: 20rpx 28rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  border-bottom-left-radius: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: #999;
  border-radius: 50%;
  animation: dot-bounce 1.4s infinite ease-in-out both;
}

.dot:nth-child(1) {
  animation-delay: -0.32s;
}

.dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes dot-bounce {
  0%, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}

/* 输入区域 */
.input-area {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  background: #fff;
}

.msg-input {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.send-btn {
  margin-left: 16rpx;
  padding: 16rpx 32rpx;
  background: #ccc;
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.send-btn.active {
  background: #007AFF;
}

.send-btn:active {
  opacity: 0.8;
}

/* 用户图片 */
.user-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.user-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  object-fit: cover;
}

/* 消息操作菜单弹窗 */
.action-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.action-modal-content {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.action-list {
  display: flex;
  justify-content: space-around;
  margin-bottom: 32rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx;
}

.action-icon {
  font-size: 48rpx;
}

.action-text {
  font-size: 24rpx;
  color: #333;
}

.action-item.delete .action-text {
  color: #FF4444;
}

.action-cancel {
  text-align: center;
  padding: 24rpx;
  color: #666;
  font-size: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

