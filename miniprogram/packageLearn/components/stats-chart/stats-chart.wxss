.chart-container { background: white; border-radius: 16rpx; padding: 24rpx; }
.chart-title { font-size: 28rpx; font-weight: bold; margin-bottom: 16rpx; }
.chart-canvas { width: 100%; height: 400rpx; }
.chart-legend { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 16rpx; }
.legend-item { display: flex; align-items: center; gap: 8rpx; }
.legend-color { width: 24rpx; height: 24rpx; border-radius: 4rpx; }
.legend-label { font-size: 22rpx; color: #666; }
