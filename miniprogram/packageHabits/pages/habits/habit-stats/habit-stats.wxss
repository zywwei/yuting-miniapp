/* 习惯统计页样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFE4EC 0%, #FFF0F5 30%, #FFF5F8 60%, #FFEEF2 100%);
}

/* 状态栏和工具栏 */
.status-bar {
  width: 100%;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
}

.tool-left { display: flex; align-items: center; }
.tool-btn {
  padding: 12rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.25);
  color: white;
  font-size: 24rpx;
}
.tool-btn:active { background: rgba(255,255,255,0.4); }
.tool-center { flex: 1; text-align: center; }
.tool-title { color: white; font-size: 30rpx; font-weight: bold; }
.tool-right { width: 100rpx; }

/* 统计概览 */
.stats-overview {
  display: flex;
  margin: 20rpx;
  background: white;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.stat-card {
  flex: 1;
  text-align: center;
}

.stat-number {
  font-size: 40rpx;
  font-weight: bold;
  color: #E91E63;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 日历 */
.calendar-section {
  margin: 20rpx;
  background: white;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.calendar-nav {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #E91E63;
  font-size: 28rpx;
}

.calendar-nav:active {
  background: #FFE4EC;
  border-radius: 50%;
}

.calendar-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.calendar-weekdays {
  display: flex;
  margin-bottom: 10rpx;
}

.weekday {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #999;
}

.calendar-days {
  display: flex;
  flex-wrap: wrap;
}

.day-item {
  width: calc(100% / 7);
  height: 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.day-num {
  font-size: 28rpx;
}

.day-item.other .day-num {
  color: #DDD;
}

.day-item.current .day-num {
  color: #333;
}

.day-item.today {
  background: #FFE4EC;
  border-radius: 12rpx;
}

.day-item.today .day-num {
  color: #E91E63;
  font-weight: bold;
}

.day-item.selected {
  background: #E91E63;
  border-radius: 12rpx;
}

.day-item.selected .day-num {
  color: white;
}

.day-dot {
  width: 8rpx;
  height: 8rpx;
  background: #E91E63;
  border-radius: 50%;
  margin-top: 4rpx;
}

.day-item.selected .day-dot {
  background: white;
}

.day-count {
  position: absolute;
  top: 2rpx;
  right: 8rpx;
  font-size: 16rpx;
  color: #E91E63;
}

.day-item.selected .day-count {
  color: white;
}

/* 当日摘要 */
.day-summary {
  margin: 0 20rpx 20rpx;
  background: rgba(233, 30, 99, 0.1);
  border-radius: 16rpx;
  padding: 20rpx;
}

.summary-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #E91E63;
  margin-bottom: 8rpx;
}

.summary-info {
  font-size: 24rpx;
  color: #666;
}

/* 记录列表 */
.records-section {
  margin: 0 20rpx 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.record-list {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}

.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-item:active {
  background: #F8F8F8;
}

.record-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 160rpx;
}

.record-date {
  font-size: 26rpx;
  color: #333;
}

.record-time {
  font-size: 22rpx;
  color: #999;
}

.record-right {
  flex: 1;
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}

.record-summary {
  font-size: 24rpx;
  color: #E91E63;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-note {
  font-size: 24rpx;
  color: #666;
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-score {
  display: flex;
  gap: 2rpx;
}

.record-score .star {
  font-size: 18rpx;
  opacity: 0.3;
}

.record-score .star.active {
  opacity: 1;
}

.record-arrow {
  font-size: 28rpx;
  color: #CCC;
  margin-left: 10rpx;
}

.empty-text {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 24rpx;
  background: white;
  border-radius: 16rpx;
}

/* 详情弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 85%;
  max-height: 80vh;
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  position: relative;
  overflow-y: auto;
}

.modal-close {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #999;
}

.modal-close:active {
  color: #333;
}

.modal-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.modal-icon {
  font-size: 60rpx;
  margin-bottom: 8rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-body {
  margin-bottom: 24rpx;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-label {
  font-size: 26rpx;
  color: #666;
}

.detail-value {
  font-size: 26rpx;
  color: #333;
  text-align: right;
  max-width: 60%;
}

.detail-photos {
  margin-top: 20rpx;
}

.detail-photos .detail-label {
  display: block;
  margin-bottom: 12rpx;
}

.photo-scroll {
  white-space: nowrap;
}

.photo-list {
  display: inline-flex;
  gap: 12rpx;
}

.detail-photo {
  width: 150rpx;
  height: 150rpx;
  border-radius: 12rpx;
}

.modal-footer {
  text-align: center;
}

.btn-delete {
  display: inline-block;
  padding: 16rpx 32rpx;
  background: #FFEBEE;
  color: #F44336;
  border-radius: 20rpx;
  font-size: 26rpx;
}

.btn-delete:active {
  background: #FFCDD2;
}

/* 底部安全区 */
.safe-bottom {
  height: 40rpx;
}
