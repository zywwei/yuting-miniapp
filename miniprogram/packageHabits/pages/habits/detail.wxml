<!-- 习惯详情页 -->
<view class="container" style="background: {{style.bgGradient}};">
  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{statusBarHeight}}px;"></view>

  <!-- 顶部工具栏 -->
  <view class="toolbar" style="padding-right: {{capsuleRight}}px;">
    <view class="tool-left">
      <view class="tool-btn" bindtap="goBack">
        <text>← 返回</text>
      </view>
    </view>
    <view class="tool-center">
      <text class="tool-title">{{habit.icon}} {{habit.name}}</text>
    </view>
    <view class="tool-right">
      <view class="tool-btn" bindtap="goStats">
        <text>📊 统计</text>
      </view>
    </view>
  </view>

  <!-- 打卡动画 -->
  <view class="checkin-animation {{showCheckinAnimation ? 'show' : ''}}">
    <view class="animation-icon">{{style.icon}}</view>
    <view class="animation-text">{{style.successText}}</view>
  </view>

  <!-- 头部 -->
  <view class="header">
    <view class="habit-icon-big">{{habit.icon}}</view>
    <view class="habit-name">{{habit.name}}</view>
    <view class="habit-tip">{{style.tipText}}</view>
  </view>

  <!-- 统计 -->
  <view class="stats">
    <view class="stat-item">
      <view class="stat-number">{{stats.total}}</view>
      <view class="stat-label">累计打卡</view>
    </view>
    <view class="stat-item">
      <view class="stat-number">{{stats.streak}}</view>
      <view class="stat-label">连续天数</view>
    </view>
    <view class="stat-item">
      <view class="stat-number">{{stats.weekRate}}%</view>
      <view class="stat-label">本周完成率</view>
    </view>
  </view>

  <!-- 作息统计 -->
  <view wx:if="{{sleepStats}}" class="sleep-stats">
    <view class="sleep-title">
      {{habit.type === 'early_up' ? '🌅 早起统计' : habit.type === 'nap' ? '😴 午睡统计' : '🌙 早睡统计'}}
    </view>
    <view class="sleep-grid">
      <view class="sleep-item">
        <view class="sleep-value">{{sleepStats.avgTime}}</view>
        <view class="sleep-label">最近7天平均</view>
      </view>
      <view class="sleep-item">
        <view class="sleep-value">{{sleepStats.earliest}}</view>
        <view class="sleep-label">最早时间</view>
      </view>
      <view class="sleep-item">
        <view class="sleep-value">{{sleepStats.latest}}</view>
        <view class="sleep-label">最晚时间</view>
      </view>
    </view>
  </view>

  <!-- 今日进度 -->
  <view class="today-progress">
    <view class="progress-text">今日 {{todayDone}}/{{habit.target}}</view>
    <view class="progress-bar-bg">
      <view class="progress-bar-fill" style="width: {{todayDone / habit.target * 100}}%;"></view>
    </view>
  </view>

  <!-- 特色表单区域 -->
  <view wx:if="{{habitFields.length > 0 && !completed}}" class="section custom-fields">
    <view class="section-title">打卡详情</view>
    <view wx:for="{{habitFields}}" wx:key="key" class="field-item">
      <view class="field-label">
        <text>{{item.icon}} {{item.label}}</text>
        <text wx:if="{{item.required}}" class="field-required">*</text>
      </view>

      <!-- 文本输入 -->
      <view wx:if="{{item.type === 'text'}}" class="field-input">
        <input
          placeholder="{{item.placeholder || '请输入'}}"
          value="{{formData[item.key]}}"
          bindinput="onFieldInput"
          data-key="{{item.key}}"
        />
      </view>

      <!-- 时间选择 -->
      <view wx:if="{{item.type === 'time'}}" class="field-input">
        <picker mode="time" value="{{formData[item.key] || '00:00'}}" bindchange="onFieldTimeChange" data-key="{{item.key}}">
          <view class="time-picker {{formData[item.key] ? 'selected' : ''}}">
            {{formData[item.key] || item.placeholder || '选择时间'}}
          </view>
        </picker>
      </view>

      <!-- 计数器 -->
      <view wx:if="{{item.type === 'counter'}}" class="field-counter">
        <view class="counter-btn {{formData[item.key] <= (item.min || 0) ? 'disabled' : ''}}"
              bindtap="onFieldCounter" data-key="{{item.key}}" data-action="minus">
          <text>-</text>
        </view>
        <view class="counter-value">
          <text>{{formData[item.key] || 0}}</text>
        </view>
        <view class="counter-btn {{formData[item.key] >= (item.max || 99) ? 'disabled' : ''}}"
              bindtap="onFieldCounter" data-key="{{item.key}}" data-action="add">
          <text>+</text>
        </view>
      </view>

      <!-- 单选/多选 -->
      <view wx:if="{{item.type === 'select'}}" class="field-options">
        <view wx:for="{{item.options}}" wx:for-item="opt" wx:key="value"
              class="option-item {{opt.selected ? 'selected' : ''}}"
              bindtap="onFieldSelect" data-key="{{item.key}}" data-value="{{opt.value}}">
          <text class="option-icon">{{opt.icon}}</text>
          <text class="option-label">{{opt.label}}</text>
        </view>
      </view>

      <!-- 心情选择 -->
      <view wx:if="{{item.type === 'mood'}}" class="field-mood">
        <view wx:for="{{item.options}}" wx:for-item="opt" wx:key="value"
              class="mood-item {{formData[item.key] === opt.value ? 'selected' : ''}}"
              bindtap="onFieldMood" data-key="{{item.key}}" data-value="{{opt.value}}">
          <text class="mood-icon">{{opt.icon}}</text>
          <text class="mood-label">{{opt.label}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 照片区域 -->
  <view wx:if="{{!completed}}" class="section photo-section">
    <view class="section-title">📷 拍照记录（可选）</view>
    <view class="photo-list">
      <view wx:for="{{images}}" wx:key="*this" class="photo-item">
        <image src="{{item}}" mode="aspectFill" class="photo-img" bindtap="previewImage" data-path="{{item}}" lazy-load />
        <view class="photo-edit" catchtap="editPhoto" data-path="{{item}}">✏️</view>
        <view class="photo-delete" catchtap="deletePhoto" data-index="{{index}}">✕</view>
      </view>
      <view wx:if="{{images.length < 9}}" class="photo-add" bindtap="takePhoto">
        <text class="add-icon">📷</text>
        <text class="add-text">拍照</text>
      </view>
    </view>
  </view>

  <!-- 评分区域 -->
  <view wx:if="{{!completed}}" class="section score-section">
    <view class="score-label">给今天的{{habit.name}}打分</view>
    <view class="score-stars">
      <view wx:for="{{[1,2,3,4,5]}}" wx:key="*this"
            class="score-star {{score >= item ? 'active' : ''}}"
            bindtap="selectScore" data-score="{{item}}">
        ⭐
      </view>
    </view>
    <view class="score-text">{{scoreLabel}}</view>
  </view>

  <!-- 留言区域 -->
  <view wx:if="{{!completed}}" class="section note-section">
    <textarea class="note-input"
              placeholder="写点什么记录一下吧~（可选）"
              value="{{note}}"
              bindinput="onNoteInput"
              maxlength="200"
              auto-height />
  </view>

  <!-- 打卡按钮 -->
  <view class="checkin-btn-area">
    <view class="checkin-btn {{completed ? 'completed' : ''}}" bindtap="checkIn">
      <view class="btn-icon">{{completed ? '✅' : style.icon}}</view>
      <view class="btn-text">{{completed ? '今日已完成' : style.checkinText}}</view>
    </view>
  </view>

  <!-- 打卡记录 -->
  <view class="section">
    <view class="section-title">📋 打卡记录</view>
    <view class="record-list" wx:if="{{records.length > 0}}">
      <view wx:for="{{records}}" wx:key="id" class="record-item" bindtap="viewDetail" data-id="{{item.id}}">
        <!-- 照片缩略图 -->
        <view wx:if="{{item.images && item.images.length > 0}}" class="record-thumb">
          <image src="{{item.images[0]}}" mode="aspectFill" class="thumb-img" lazy-load />
          <view wx:if="{{item.images.length > 1}}" class="thumb-count">+{{item.images.length - 1}}</view>
        </view>
        <view class="record-left">
          <view class="record-date">{{item.date}}</view>
          <view class="record-time">{{item.time}}</view>
        </view>
        <view class="record-right">
          <view wx:if="{{item.summary}}" class="record-summary">{{item.summary}}</view>
          <view wx:elif="{{item.note}}" class="record-note">{{item.note}}</view>
          <view wx:if="{{item.score}}" class="record-score">
            <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" wx:for-item="star"
                  class="star {{star <= item.score ? 'active' : ''}}">⭐</text>
          </view>
        </view>
        <view class="record-arrow">›</view>
      </view>
    </view>
    <view wx:else class="empty">暂无打卡记录</view>
  </view>

  <!-- 详情弹窗 -->
  <view wx:if="{{showDetail}}" class="modal-mask" bindtap="closeDetail">
    <view class="modal-content" catchtap="noop">
      <view class="modal-close" bindtap="closeDetail">✕</view>

      <view class="modal-header">
        <view class="modal-icon">{{habit.icon}}</view>
        <view class="modal-title">{{habit.name}}打卡详情</view>
      </view>

      <view class="modal-body">
        <view class="detail-row">
          <text class="detail-label">📅 日期</text>
          <text class="detail-value">{{detailRecord.date}}</text>
        </view>
        <view wx:if="{{detailRecord.time}}" class="detail-row">
          <text class="detail-label">🕐 时间</text>
          <text class="detail-value">{{detailRecord.time}}</text>
        </view>
        <view wx:if="{{detailRecord.score}}" class="detail-row">
          <text class="detail-label">⭐ 评分</text>
          <text class="detail-value">
            <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" wx:for-item="star"
                  class="star {{star <= detailRecord.score ? 'active' : ''}}">⭐</text>
          </text>
        </view>
        <view wx:if="{{detailRecord.summary}}" class="detail-row">
          <text class="detail-label">📝 详情</text>
          <text class="detail-value">{{detailRecord.summary}}</text>
        </view>
        <view wx:if="{{detailRecord.note}}" class="detail-row">
          <text class="detail-label">💬 留言</text>
          <text class="detail-value">{{detailRecord.note}}</text>
        </view>

        <!-- 照片展示 -->
        <view wx:if="{{detailRecord.images && detailRecord.images.length > 0}}" class="detail-photos">
          <text class="detail-label">📷 照片</text>
          <scroll-view scroll-x class="photo-scroll">
            <view class="photo-list">
              <image wx:for="{{detailRecord.images}}" wx:key="*this"
                     src="{{item}}" mode="aspectFill" class="detail-photo"
                     bindtap="previewDetailImage" data-index="{{index}}" lazy-load />
            </view>
          </scroll-view>
        </view>
      </view>

      <view class="modal-footer">
        <view class="btn-delete" bindtap="deleteRecord" data-id="{{detailRecord.id}}">
          <text>🗑️ 删除记录</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 成功提示 -->
  <view wx:if="{{showSuccess}}" class="success-toast">
    <view class="success-icon">✨</view>
    <view class="success-text">{{successText}}</view>
  </view>

  <!-- 底部安全区 -->
  <view class="safe-bottom"></view>
</view>
