/* 刷牙计时页 - 战斗场景（一体化布局） */
.timer-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFE4EC 0%, #FFF0F5 30%, #FFF5F8 60%, #FFEEF2 100%);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* ===== 背景装饰 ===== */
.bg-stars {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
}

.star {
  position: absolute;
  animation: twinkle 2s ease-in-out infinite;
  opacity: 0.5;
  color: #FFB6C1;
}

.star-1 { top: 10%; left: 5%; font-size: 24rpx; animation-delay: 0s; }
.star-2 { top: 15%; right: 10%; font-size: 20rpx; animation-delay: 0.5s; }
.star-3 { top: 25%; left: 15%; font-size: 16rpx; animation-delay: 1s; }
.star-4 { top: 35%; right: 20%; font-size: 28rpx; animation-delay: 1.5s; }
.star-5 { top: 50%; left: 8%; font-size: 18rpx; animation-delay: 0.3s; }
.star-6 { top: 60%; right: 5%; font-size: 22rpx; animation-delay: 0.8s; }
.star-7 { top: 75%; left: 20%; font-size: 14rpx; animation-delay: 1.2s; }
.star-8 { top: 85%; right: 15%; font-size: 26rpx; animation-delay: 0.6s; }

@keyframes twinkle {
  0%, 100% { opacity: 0.2; transform: scale(0.8); }
  50% { opacity: 0.8; transform: scale(1.2); }
}

.bg-clouds {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 0;
}

.cloud {
  position: absolute;
  font-size: 80rpx;
  opacity: 0.15;
  animation: float 25s linear infinite;
  filter: blur(2px);
}

.cloud-1 { top: 8%; left: -15%; animation-duration: 30s; }
.cloud-2 { top: 22%; left: -20%; animation-duration: 35s; animation-delay: 8s; }
.cloud-3 { top: 38%; left: -15%; animation-duration: 28s; animation-delay: 15s; }

@keyframes float {
  0% { transform: translateX(0); }
  100% { transform: translateX(130vw); }
}

/* ===== 顶部极简工具栏 ===== */
.status-bar { width: 100%; background: transparent; }
.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 20rpx;
  position: relative;
  z-index: 10;
}
.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.6);
  border-radius: 50%;
  font-size: 28rpx;
  color: #E91E63;
}
.back-btn:active { background: rgba(255,255,255,0.8); }
.top-right { display: flex; align-items: center; gap: 15rpx; }
.sound-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.6);
  border-radius: 50%;
  font-size: 24rpx;
}
.points-badge {
  background: linear-gradient(135deg, #FFD700, #FFA000);
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
  box-shadow: 0 2rpx 8rpx rgba(255, 160, 0, 0.4);
  animation: badgePulse 2s ease-in-out infinite;
}

@keyframes badgePulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

/* ===== 战斗场景 ===== */
.battle-scene {
  flex: 1;
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
  overflow: hidden;
}

/* 顶部信息栏 */
.battle-top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 20rpx;
  background: rgba(255,255,255,0.6);
  backdrop-filter: blur(10px);
  flex-shrink: 0;
}

.chapter-tag {
  font-size: 24rpx;
  color: #E91E63;
  font-weight: bold;
}

.timer-bar {
  display: flex;
  align-items: center;
  gap: 15rpx;
}

.timer-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #E91E63;
  font-family: 'Courier New', monospace;
  min-width: 100rpx;
  text-align: center;
}

.timer-active .timer-num {
  animation: timerPulse 1s ease-in-out infinite;
}

@keyframes timerPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.timer-progress {
  width: 150rpx;
  height: 12rpx;
  background: #FFD6E0;
  border-radius: 6rpx;
  overflow: hidden;
}

.timer-fill {
  height: 100%;
  background: linear-gradient(90deg, #FF9AAB, #FF6B8A);
  border-radius: 6rpx;
  transition: width 0.5s;
}

/* 战斗竞技场 */
.battle-arena {
  flex: 1;
  position: relative;
  overflow: hidden;
  min-height: 0;
}

/* 战斗中 */
.battle-fight {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx;
}

/* 地面 */
.battle-ground {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 25%;
  background: linear-gradient(180deg, transparent, rgba(255,182,193,0.15));
}

/* 牙刷英雄 */
.toothbrush-hero {
  position: absolute;
  z-index: 10;
  transition: left 0.5s ease, top 0.5s ease;
}

.toothbrush-wrapper {
  transform-origin: center center;
  display: inline-block;
}

.toothbrush-emoji {
  font-size: 100rpx;
  display: block;
  filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.2));
  line-height: 1;
}

.attacking .toothbrush-emoji {
  animation: brushAttack 0.4s ease-in-out infinite;
}

@keyframes brushAttack {
  0% { transform: scale(1); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

/* 攻击线条 */
.attack-lines {
  position: absolute;
  top: 50%;
  right: -80rpx;
  transform: translateY(-50%);
}

.line {
  width: 80rpx;
  height: 5rpx;
  background: linear-gradient(90deg, #FF6B8A, transparent);
  margin: 12rpx 0;
  animation: lineDash 0.5s ease-out infinite;
}

.line-1 { animation-delay: 0s; }
.line-2 { animation-delay: 0.1s; width: 55rpx; }
.line-3 { animation-delay: 0.2s; width: 30rpx; }

@keyframes lineDash {
  0% { opacity: 0; transform: translateX(-30rpx); }
  50% { opacity: 1; }
  100% { opacity: 0; transform: translateX(30rpx); }
}

/* 敌人英雄 */
.enemy-hero {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 5;
  text-align: center;
  filter: drop-shadow(0 10rpx 20rpx rgba(0,0,0,0.15));
  transition: opacity 0.3s ease-out;
}

.enemy-hero.defeated {
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.8s ease-out 0.5s;
}

.enemy-emoji {
  font-size: 320rpx;
  display: block;
  --enemy-scale: 1.3;
  transition: transform 0.3s ease-out;
}

.enemy-idle {
  animation: enemyIdle 2s ease-in-out infinite;
}

@keyframes enemyIdle {
  0%, 100% { transform: scale(1.3); }
  50% { transform: scale(1.404); }
}

.shake {
  animation: shake 0.3s ease-in-out !important;
}

@keyframes shake {
  0%, 100% { transform: translate(-50%, -50%); }
  25% { transform: translate(calc(-50% - 30rpx), -50%); }
  75% { transform: translate(calc(-50% + 30rpx), -50%); }
}

.defeated {
  animation: defeated 1s cubic-bezier(0.25, 1.5, 0.5, 1) forwards !important;
}

@keyframes defeated {
  0% { transform: scale(var(--enemy-scale, 1.3)); opacity: 1; filter: brightness(1); }
  20% { transform: scale(1.6); opacity: 1; filter: brightness(2) blur(2rpx); }
  45% { transform: scale(0.9) rotate(-10deg); opacity: 0.9; filter: brightness(1.5) blur(0); }
  70% { transform: scale(0.4) rotate(10deg); opacity: 0.4; filter: brightness(0.8); }
  100% { transform: scale(0) rotate(0deg); opacity: 0; filter: brightness(0); }
}

/* 敌人被击败时的屏幕闪光 */
.defeat-flash-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.95);
  z-index: 9999;
  pointer-events: none;
  animation: defeatFlash 0.12s ease-out forwards;
}

@keyframes defeatFlash {
  0% { opacity: 0; }
  50% { opacity: 1; }
  100% { opacity: 0; }
}

/* 敌人被击败时的冲击波 */
.defeat-shockwave {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100rpx;
  height: 100rpx;
  margin-left: -50rpx;
  margin-top: -50rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(255, 215, 0, 0.9);
  background: rgba(255, 255, 255, 0.2);
  box-shadow: 0 0 60rpx rgba(255, 215, 0, 0.6), inset 0 0 40rpx rgba(255, 255, 255, 0.4);
  z-index: 100;
  pointer-events: none;
  animation: shockwaveExpand 0.9s ease-out forwards;
}

@keyframes shockwaveExpand {
  0% { transform: translate(-50%, -50%) scale(0); opacity: 1; border-width: 16rpx; }
  100% { transform: translate(-50%, -50%) scale(12); opacity: 0; border-width: 0; }
}

/* 敌人碎片飞溅 */
.enemy-debris-container {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 0;
  height: 0;
  z-index: 90;
  pointer-events: none;
}

.enemy-debris {
  position: absolute;
  font-size: var(--deb-size);
  left: 0;
  top: 0;
  opacity: 0;
  text-shadow: 0 0 10rpx currentColor;
  animation: debrisFly 1.2s ease-out forwards;
  animation-delay: var(--deb-delay);
}

@keyframes debrisFly {
  0% { transform: translate(-50%, -50%) rotate(0deg) scale(1); opacity: 1; }
  30% { transform: translate(calc(-50% + var(--deb-x) * 0.5), calc(-50% + var(--deb-y) * 0.5)) rotate(180deg) scale(1.2); opacity: 1; }
  100% { transform: translate(calc(-50% + var(--deb-x)), calc(-50% + var(--deb-y))) rotate(360deg) scale(0.3); opacity: 0; }
}

/* KO大字 */
.ko-text-container {
  position: absolute;
  top: 38%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 200;
  pointer-events: none;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  animation: koContainerPop 1.5s ease-out forwards;
}

.ko-text {
  font-size: 160rpx;
  font-weight: 900;
  color: #FF1744;
  text-shadow:
    0 0 20rpx rgba(255, 23, 68, 0.8),
    0 0 40rpx rgba(255, 215, 0, 0.6),
    6rpx 6rpx 0 #fff,
    -6rpx -6rpx 0 #FFD700;
  line-height: 1;
  animation: koTextPop 1.5s cubic-bezier(0.68, -0.55, 0.27, 1.55) forwards;
}

.ko-sub {
  font-size: 32rpx;
  color: #fff;
  background: linear-gradient(90deg, #FF6B8A, #FFD700);
  padding: 10rpx 28rpx;
  border-radius: 30rpx;
  margin-top: 16rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 138, 0.4);
  animation: koSubSlide 1.5s ease-out forwards;
}

@keyframes koContainerPop {
  0% { opacity: 0; }
  10% { opacity: 1; }
  80% { opacity: 1; }
  100% { opacity: 0; }
}

@keyframes koTextPop {
  0% { transform: scale(0) rotate(-20deg); opacity: 0; }
  25% { transform: scale(1.3) rotate(5deg); opacity: 1; }
  50% { transform: scale(1) rotate(0deg); opacity: 1; }
  80% { transform: scale(1.05); opacity: 1; }
  100% { transform: scale(1.2); opacity: 0; }
}

@keyframes koSubSlide {
  0% { transform: translateY(40rpx); opacity: 0; }
  30% { transform: translateY(40rpx); opacity: 0; }
  55% { transform: translateY(0); opacity: 1; }
  100% { transform: translateY(0); opacity: 0; }
}

/* 战斗场景屏幕震动（敌人被击败时） */
.battle-arena.enemy-defeated-shake {
  animation: arenaShake 0.5s ease-in-out;
}

@keyframes arenaShake {
  0%, 100% { transform: translate(0, 0); }
  10% { transform: translate(-8rpx, 6rpx); }
  20% { transform: translate(8rpx, -6rpx); }
  30% { transform: translate(-6rpx, -8rpx); }
  40% { transform: translate(6rpx, 8rpx); }
  50% { transform: translate(-4rpx, 4rpx); }
  60% { transform: translate(4rpx, -4rpx); }
  70% { transform: translate(-2rpx, 2rpx); }
  80% { transform: translate(2rpx, -2rpx); }
  90% { transform: translate(0, 0); }
}

/* 敌人HP */
.enemy-hp {
  margin-top: 24rpx;
  padding: 0 24rpx;
}

.hp-bar {
  width: 100%;
  max-width: 280rpx;
  height: 28rpx;
  background: #FFD6E0;
  border-radius: 14rpx;
  overflow: hidden;
  margin: 0 auto;
  border: none;
}

.hp-fill {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50, #8BC34A);
  border-radius: 14rpx;
  transition: width 0.5s, background 0.3s;
  border: none;
}

.hp-num {
  font-size: 28rpx;
  color: #E91E63;
  margin-top: 12rpx;
  display: block;
  font-weight: bold;
}

.enemy-name {
  font-size: 32rpx;
  color: #666;
  margin-top: 16rpx;
  display: block;
  font-weight: bold;
}

/* 敌人愤怒状态 */
.enemy-hero.angry .enemy-emoji {
  animation: enemyAngry 0.5s ease-in-out infinite;
  filter: hue-rotate(30deg) brightness(1.1);
}

@keyframes enemyAngry {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.angry-mark {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  font-size: 28rpx;
  animation: angryBounce 0.5s ease-in-out infinite;
}

@keyframes angryBounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

/* 敌人威胁话语气泡 */
.enemy-taunt-bubble {
  position: absolute;
  bottom: 110%;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, #FF1744, #D50000);
  color: white;
  padding: 14rpx 28rpx;
  border-radius: 24rpx;
  white-space: nowrap;
  animation: tauntAppear 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), tauntPulse 0.8s ease-in-out 0.4s infinite;
  box-shadow: 0 4rpx 16rpx rgba(255, 23, 68, 0.5), 0 0 20rpx rgba(255, 23, 68, 0.3), inset 0 2rpx 4rpx rgba(255, 255, 255, 0.2);
  z-index: 20;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.enemy-taunt-bubble::before {
  content: '💢';
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  font-size: 24rpx;
  animation: tauntAnger 0.6s ease-in-out infinite;
}

.enemy-taunt-bubble::after {
  content: '';
  position: absolute;
  bottom: -14rpx;
  left: 50%;
  transform: translateX(-50%);
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-top: 14rpx solid #D50000;
  filter: drop-shadow(0 2rpx 4rpx rgba(255, 23, 68, 0.3));
}

.enemy-taunt-text {
  font-size: 28rpx;
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 2rpx;
}

@keyframes tauntAppear {
  0% { opacity: 0; transform: translateX(-50%) translateY(20rpx) scale(0.3); }
  60% { opacity: 1; transform: translateX(-50%) translateY(-8rpx) scale(1.1); }
  100% { opacity: 1; transform: translateX(-50%) translateY(0) scale(1); }
}

@keyframes tauntPulse {
  0%, 100% { transform: translateX(-50%) scale(1); box-shadow: 0 4rpx 16rpx rgba(255, 23, 68, 0.5), 0 0 20rpx rgba(255, 23, 68, 0.3); }
  50% { transform: translateX(-50%) scale(1.05); box-shadow: 0 6rpx 24rpx rgba(255, 23, 68, 0.7), 0 0 30rpx rgba(255, 23, 68, 0.5); }
}

@keyframes tauntAnger {
  0%, 100% { transform: scale(1) rotate(0deg); }
  25% { transform: scale(1.2) rotate(-10deg); }
  75% { transform: scale(1.2) rotate(10deg); }
}

/* 命中效果 */
.hit-effect {
  position: absolute;
  transform: translate(-50%, -50%);
  z-index: 10;
  text-align: center;
  animation: hitBurst 0.6s ease-out forwards;
}

@keyframes hitBurst {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(0.5); }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.5); }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(1.8) translateY(-50rpx); }
}

.hit-text {
  font-size: 60rpx;
  font-weight: bold;
  color: #F44336;
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.3);
  display: block;
}

.hit-icon {
  font-size: 50rpx;
  display: block;
}

/* 暴击特效 */
.hit-effect.critical {
  animation: critBurst 0.8s ease-out forwards;
}

@keyframes critBurst {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(0.3); }
  30% { opacity: 1; transform: translate(-50%, -50%) scale(1.8); }
  60% { opacity: 1; transform: translate(-50%, -50%) scale(1.2); }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(1.5) translateY(-60rpx); }
}

.crit-text {
  font-size: 32rpx;
  color: #FFD700;
  font-weight: bold;
  display: block;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
  animation: critFlash 0.3s ease-out;
}

@keyframes critFlash {
  0% { opacity: 0; transform: scale(0.5); }
  50% { opacity: 1; transform: scale(1.3); }
  100% { opacity: 1; transform: scale(1); }
}

/* 连击计数器 */
.combo-counter {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
  animation: comboAppear 0.3s ease-out;
}

@keyframes comboAppear {
  0% { opacity: 0; transform: translateX(-50%) scale(0.5); }
  100% { opacity: 1; transform: translateX(-50%) scale(1); }
}

.combo-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF4081;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
  background: rgba(255,255,255,0.9);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  border: 3rpx solid #FF4081;
}

/* ===== 牙刷冲刺动画 ===== */
.dashing .toothbrush-wrapper {
  animation: dashForward 0.25s ease-out;
}

@keyframes dashForward {
  0% { transform: translate(-50%, -50%) rotate(var(--rotation, 0deg)); }
  40% { transform: translate(calc(-50% + 30rpx), calc(-50% - 30rpx)) rotate(var(--rotation, 0deg)) scale(1.2); }
  100% { transform: translate(-50%, -50%) rotate(var(--rotation, 0deg)) scale(1); }
}

/* 牙刷暴击闪光 */
.critical-flash {
  animation: critFlashEmoji 0.3s ease-out;
}

@keyframes critFlashEmoji {
  0% { filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.2)); }
  50% { filter: drop-shadow(0 0 20rpx #FFD700) brightness(2); }
  100% { filter: drop-shadow(0 4rpx 8rpx rgba(0,0,0,0.2)); }
}

/* 牙刷残影 */
.toothbrush-afterimage {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.5;
  animation: afterimage 0.5s ease-out forwards;
}

.toothbrush-afterimage::after {
  content: '🪥';
  font-size: 100rpx;
  filter: brightness(2) sepia(1) hue-rotate(10deg);
}

@keyframes afterimage {
  0% { opacity: 0.6; transform: scale(1); }
  100% { opacity: 0; transform: scale(1.5); }
}

/* ===== 攻击轨迹 ===== */
.attack-trail {
  position: absolute;
  top: 50%;
  right: -100rpx;
  transform: translateY(-50%) rotate(var(--trail-angle, 0deg));
  transform-origin: left center;
}

.trail-line {
  position: absolute;
  height: 4rpx;
  background: linear-gradient(90deg, rgba(255,107,138,0.8), transparent);
  animation: trailFade 0.3s ease-out forwards;
}

.trail-1 { width: 80rpx; top: -10rpx; animation-delay: 0s; }
.trail-2 { width: 60rpx; top: 0; animation-delay: 0.05s; }
.trail-3 { width: 40rpx; top: 10rpx; animation-delay: 0.1s; }

@keyframes trailFade {
  0% { opacity: 0; transform: translateX(-20rpx); }
  30% { opacity: 1; }
  100% { opacity: 0; transform: translateX(30rpx); }
}

/* ===== 命中爆炸粒子 ===== */
.explosion-particles {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.particle {
  position: absolute;
  width: 30rpx;
  height: 30rpx;
  font-size: 24rpx;
  text-align: center;
  line-height: 30rpx;
  animation: particleExplode 0.6s ease-out forwards;
  animation-delay: var(--delay, 0s);
}

/* 粒子不使用伪元素，直接显示文本节点 */
.particle.normal {
  font-size: 20rpx;
}

/* 暴击粒子（使用动态emoji） */
.particle.crit {
  width: 40rpx;
  height: 40rpx;
  font-size: 32rpx;
  line-height: 40rpx;
}

@keyframes particleExplode {
  0% {
    opacity: 1;
    transform: rotate(var(--angle, 0deg)) translateX(0) scale(1);
  }
  100% {
    opacity: 0;
    transform: rotate(var(--angle, 0deg)) translateX(100rpx) scale(0.5);
  }
}

/* 暴击粒子（更大范围，更持久） */
.hit-effect.critical .particle {
  animation: particleExplodeCritical 0.8s ease-out forwards;
}

@keyframes particleExplodeCritical {
  0% {
    opacity: 1;
    transform: rotate(var(--angle, 0deg)) translateX(0) scale(1);
  }
  100% {
    opacity: 0;
    transform: rotate(var(--angle, 0deg)) translateX(120rpx) scale(0.2);
  }
}

/* ===== 暴击专属特效（20种随机模式） ===== */
.critical-effect {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 30;
  pointer-events: none;
}

.critical-emoji {
  position: absolute;
  top: 35%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 120rpx;
  animation: critEmojiAppear 1s ease-out forwards;
}

@keyframes critEmojiAppear {
  0% { opacity: 0; transform: translate(-50%, -50%) scale(0) rotate(-180deg); }
  30% { opacity: 1; transform: translate(-50%, -50%) scale(1.5) rotate(10deg); }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1) rotate(0deg); }
  80% { opacity: 1; transform: translate(-50%, -50%) scale(1) translateY(0); }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(1.2) translateY(-150rpx); }
}

.critical-text {
  position: absolute;
  top: 60%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 72rpx;
  font-weight: bold;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.6);
  animation: critTextAppear 0.8s ease-out forwards;
}

@keyframes critTextAppear {
  0% { opacity: 0; transform: translate(-50%, -50%) scale(0.3); }
  20% { opacity: 1; transform: translate(-50%, -50%) scale(1.4); }
  40% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  80% { opacity: 1; transform: translate(-50%, -50%) scale(1) translateY(0); }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(1) translateY(-100rpx); }
}

.critical-flash-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.3;
  animation: critFlashOverlay 0.4s ease-out forwards;
}

@keyframes critFlashOverlay {
  0% { opacity: 0; }
  20% { opacity: 0.5; }
  100% { opacity: 0; }
}

/* ===== 暴击敌人受击反应（多种动画） ===== */

/* 普通受击 */
.enemy-emoji.hit-react {
  animation: enemyHitReact 0.3s ease-out;
}

@keyframes enemyHitReact {
  0% { transform: translateY(0) scale(1.3); filter: brightness(1); }
  20% { transform: translateY(20rpx) scaleY(0.91); filter: brightness(2); }
  40% { transform: translateY(0) scaleY(1.43); filter: brightness(1); }
  60% { transform: translateY(10rpx) scaleY(1.105); filter: brightness(1.2); }
  100% { transform: translateY(0) scale(1.3); filter: brightness(1); }
}

/* 暴击动画类型1：左上角飞旋击飞（大位移+旋转） */
.enemy-emoji.crit-knockback {
  animation: critKnockback 0.7s ease-out !important;
}

@keyframes critKnockback {
  0% { transform: translate(0, 0) rotate(0deg) scale(1.3); }
  12% { transform: translate(-20rpx, -15rpx) rotate(30deg) scale(1.56); filter: brightness(2); }
  30% { transform: translate(-100rpx, -80rpx) rotate(180deg) scale(0.91); }
  50% { transform: translate(-60rpx, -40rpx) rotate(270deg) scale(1.3); }
  70% { transform: translate(-20rpx, -10rpx) rotate(330deg) scale(1.3); }
  100% { transform: translate(0, 0) rotate(360deg) scale(1.3); filter: brightness(1); }
}

/* 暴击动画类型2：猛烈缩放脉冲（极端大小跳变） */
.enemy-emoji.crit-shrink-bounce {
  animation: critShrinkBounce 0.5s ease-in !important;
}

@keyframes critShrinkBounce {
  0% { transform: scale(1.3); }
  10% { transform: scale(0.3); filter: brightness(2.5); }
  25% { transform: scale(2.2); }
  40% { transform: scale(0.5); }
  55% { transform: scale(1.8); }
  70% { transform: scale(0.8); }
  85% { transform: scale(1.5); }
  100% { transform: scale(1.3); }
}

/* 暴击动画类型3：高速旋转（仅旋转，不位移） */
.enemy-emoji.crit-spin {
  animation: critSpin 0.6s linear !important;
}

@keyframes critSpin {
  0% { transform: rotate(0deg) scale(1.3); filter: brightness(1); }
  10% { transform: rotate(120deg) scale(1.5); filter: brightness(2); }
  30% { transform: rotate(360deg) scale(1.8); }
  50% { transform: rotate(600deg) scale(1.3); filter: brightness(1.5); }
  70% { transform: rotate(840deg) scale(1.6); }
  90% { transform: rotate(1050deg) scale(1.2); filter: brightness(2); }
  100% { transform: rotate(1080deg) scale(1.3); filter: brightness(1); }
}

/* 暴击动画类型4：重击砸地（向下压扁+地面弹跳感） */
.enemy-emoji.crit-squash {
  animation: critSquash 0.5s ease-in !important;
}

@keyframes critSquash {
  0% { transform: scaleX(1) scaleY(1.3); }
  10% { transform: scaleX(1) scaleY(1.5); filter: brightness(2); }
  20% { transform: scaleX(2.2) scaleY(0.45); }
  35% { transform: scaleX(0.7) scaleY(2.0); }
  50% { transform: scaleX(1.7) scaleY(0.7); }
  65% { transform: scaleX(0.85) scaleY(1.5); }
  80% { transform: scaleX(1.3) scaleY(0.9); }
  100% { transform: scaleX(1) scaleY(1.3); }
}

/* 暴击动画类型5：瞬移闪烁（消失→位移→闪烁出现） */
.enemy-emoji.crit-teleport {
  animation: critTeleport 0.8s ease-out !important;
}

@keyframes critTeleport {
  0% { opacity: 1; transform: scale(1.3); }
  12% { opacity: 0.3; transform: scale(2.0); filter: brightness(4); }
  20% { opacity: 0; transform: scale(1.0); }
  35% { opacity: 0; transform: translate(80rpx, 50rpx) scale(1.0); }
  45% { opacity: 1; transform: translate(80rpx, 50rpx) scale(1.8); filter: brightness(3); }
  55% { opacity: 0.2; transform: translate(80rpx, 50rpx) scale(1.2); }
  65% { opacity: 1; transform: translate(30rpx, 20rpx) scale(1.5); filter: brightness(1.5); }
  80% { opacity: 1; transform: translate(-10rpx, -5rpx) scale(1.2); }
  100% { opacity: 1; transform: translate(0, 0) scale(1.3); filter: brightness(1); }
}

/* 暴击动画类型6：剧烈摇晃（高频左右摇+放大闪烁） */
.enemy-emoji.crit-shake-big {
  animation: critShakeBig 0.5s ease-out !important;
}

@keyframes critShakeBig {
  0% { transform: translate(0, 0) scale(1.3); }
  8% { transform: translate(-25rpx, 0) scale(1.9); filter: brightness(2.5); }
  16% { transform: translate(25rpx, 0) scale(1.5); }
  24% { transform: translate(-20rpx, 0) scale(2.0); filter: brightness(1.5); }
  32% { transform: translate(20rpx, 0) scale(1.6); }
  40% { transform: translate(-15rpx, 0) scale(1.8); filter: brightness(2.5); }
  48% { transform: translate(15rpx, 0) scale(1.4); }
  56% { transform: translate(-8rpx, 0) scale(1.6); filter: brightness(1.5); }
  64% { transform: translate(8rpx, 0) scale(1.3); }
  80% { transform: translate(0, 0) scale(1.35); }
  100% { transform: translate(0, 0) scale(1.3); }
}

/* 暴击动画类型7：向右上方抛飞（大位移弧线） */
.enemy-emoji.crit-knockright {
  animation: critKnockRight 0.7s ease-out !important;
}

@keyframes critKnockRight {
  0% { transform: translate(0, 0) rotate(0deg) scale(1.3); }
  10% { transform: translate(40rpx, -20rpx) rotate(-15deg) scale(1.56); filter: brightness(2); }
  30% { transform: translate(120rpx, -70rpx) rotate(-45deg) scale(1.0); }
  50% { transform: translate(80rpx, -30rpx) rotate(-25deg) scale(1.3); }
  70% { transform: translate(30rpx, -10rpx) rotate(-10deg) scale(1.3); }
  100% { transform: translate(0, 0) rotate(0deg) scale(1.3); filter: brightness(1); }
}

/* 暴击动画类型8：弹射上升（快速冲高+重力回落） */
.enemy-emoji.crit-bounce {
  animation: critBounce 0.6s cubic-bezier(0.2, 0, 0.8, 1) !important;
}

@keyframes critBounce {
  0% { transform: translateY(0) scale(1.3); }
  8% { transform: translateY(10rpx) scaleY(0.7) scaleX(1.4); filter: brightness(2); }
  18% { transform: translateY(-120rpx) scaleY(1.4) scaleX(0.8); }
  35% { transform: translateY(0) scaleY(0.6) scaleX(1.5); }
  50% { transform: translateY(-50rpx) scaleY(1.2) scaleX(0.9); }
  65% { transform: translateY(0) scaleY(0.85) scaleX(1.15); }
  80% { transform: translateY(-10rpx) scale(1.3); }
  100% { transform: translateY(0) scale(1.3); filter: brightness(1); }
}

/* 暴击动画类型9：扭曲变形（极端比例拉扯+扭绞） */
.enemy-emoji.crit-distort {
  animation: critDistort 0.6s ease-out !important;
}

@keyframes critDistort {
  0% { transform: scale(1.3); }
  10% { transform: scaleX(0.25) scaleY(3.0) rotate(15deg); filter: brightness(2.5); }
  25% { transform: scaleX(3.0) scaleY(0.25) rotate(-15deg); }
  40% { transform: scaleX(0.4) scaleY(2.2) rotate(10deg); filter: brightness(1.5); }
  55% { transform: scaleX(2.2) scaleY(0.4) rotate(-10deg); }
  70% { transform: scaleX(0.7) scaleY(1.6) rotate(5deg); filter: brightness(2); }
  85% { transform: scaleX(1.5) scaleY(0.7) rotate(-3deg); }
  100% { transform: scale(1.3) rotate(0deg); filter: brightness(1); }
}

/* 暴击动画类型10：高频颤抖（快速微颤+颜色闪烁） */
.enemy-emoji.crit-tremble {
  animation: critTremble 0.4s steps(12) !important;
}

@keyframes critTremble {
  0% { transform: translate(0, 0) scale(1.3); filter: brightness(1); }
  8% { transform: translate(-12rpx, -8rpx) scale(1.15); filter: brightness(2.5); }
  16% { transform: translate(12rpx, 8rpx) scale(1.25); filter: brightness(1); }
  24% { transform: translate(-10rpx, 6rpx) scale(1.1); filter: brightness(2.5); }
  32% { transform: translate(10rpx, -6rpx) scale(1.3); filter: brightness(1); }
  40% { transform: translate(-8rpx, -10rpx) scale(1.05); filter: brightness(2.5); }
  48% { transform: translate(8rpx, 10rpx) scale(1.35); filter: brightness(1); }
  56% { transform: translate(-6rpx, 4rpx) scale(1.1); filter: brightness(2.5); }
  64% { transform: translate(6rpx, -4rpx) scale(1.25); filter: brightness(1); }
  72% { transform: translate(-4rpx, -6rpx) scale(1.15); filter: brightness(2.5); }
  80% { transform: translate(4rpx, 6rpx) scale(1.3); filter: brightness(1); }
  100% { transform: translate(0, 0) scale(1.3); filter: brightness(1); }
}

/* 暴击名字文字 */
.crit-name-text {
  display: block;
  position: absolute;
  top: -60rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 36rpx;
  font-weight: bold;
  color: #FFD700;
  text-shadow:
    0 0 10rpx rgba(255, 215, 0, 0.8),
    0 0 20rpx rgba(255, 165, 0, 0.6),
    0 0 40rpx rgba(255, 69, 0, 0.4);
  white-space: nowrap;
  z-index: 20;
  animation: critNameAppear 0.8s ease-out forwards;
  pointer-events: none;
}

@keyframes critNameAppear {
  0% {
    opacity: 0;
    transform: translateX(-50%) scale(0.3) rotate(-15deg);
    text-shadow: 0 0 40rpx rgba(255, 215, 0, 1), 0 0 80rpx rgba(255, 69, 0, 0.8);
  }
  15% {
    opacity: 1;
    transform: translateX(-50%) scale(1.6) rotate(5deg);
    text-shadow: 0 0 30rpx rgba(255, 215, 0, 0.9), 0 0 60rpx rgba(255, 165, 0, 0.7);
  }
  30% {
    opacity: 1;
    transform: translateX(-50%) scale(1.1) rotate(-3deg);
  }
  45% {
    opacity: 1;
    transform: translateX(-50%) scale(1.3) rotate(2deg);
  }
  65% {
    opacity: 0.9;
    transform: translateX(-50%) scale(1.15) translateY(-10rpx);
    text-shadow: 0 0 20rpx rgba(255, 215, 0, 0.7), 0 0 40rpx rgba(255, 165, 0, 0.5);
  }
  85% {
    opacity: 0.5;
    transform: translateX(-50%) scale(1.05) translateY(-25rpx);
  }
  100% {
    opacity: 0;
    transform: translateX(-50%) scale(0.9) translateY(-40rpx);
    text-shadow: 0 0 10rpx rgba(255, 215, 0, 0.3);
  }
}

/* ===== 小怪物系统 ===== */
.minions-area {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 8;
}

.minion {
  position: absolute;
  font-size: 50rpx;
  animation: minionFloat 2s ease-in-out infinite;
  transition: all 0.3s;
}

@keyframes minionFloat {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-10rpx) scale(1.1); }
}

.minion-defeating {
  animation: minionDefeat 0.5s ease-out forwards !important;
}

@keyframes minionDefeat {
  0% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.5); opacity: 0.8; }
  100% { transform: scale(0) rotate(360deg); opacity: 0; }
}

.minion-defeated {
  opacity: 0;
  transform: scale(0);
  pointer-events: none;
}

.minion-hit {
  position: absolute;
  top: -10rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 30rpx;
  animation: minionHitBurst 0.5s ease-out forwards;
}

@keyframes minionHitBurst {
  0% { opacity: 1; transform: translateX(-50%) scale(0.5); }
  50% { opacity: 1; transform: translateX(-50%) scale(1.5); }
  100% { opacity: 0; transform: translateX(-50%) scale(2) translateY(-30rpx); }
}

.minions-progress {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  background: rgba(0,0,0,0.6);
  color: white;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
}

.minions-count {
  font-weight: bold;
}

/* 小怪物消灭提示 */
.minion-defeat-text {
  position: absolute;
  bottom: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(76, 175, 80, 0.9);
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 10rpx;
  font-size: 22rpx;
  font-weight: bold;
  white-space: nowrap;
  animation: minionDefeatTextAppear 0.3s ease-out;
}

@keyframes minionDefeatTextAppear {
  from { opacity: 0; transform: translateX(-50%) translateY(10rpx); }
  to { opacity: 1; transform: translateX(-50%) translateY(0); }
}

/* 战斗提示 */
.fight-hint {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  font-size: 26rpx;
  color: #E91E63;
  background: rgba(255,255,255,0.8);
  padding: 10rpx 25rpx;
  border-radius: 20rpx;
  white-space: nowrap;
  z-index: 15;
}

/* 积分飘字 */
.points-float {
  position: absolute;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 15;
  animation: floatUp 1.5s ease-out forwards;
}

@keyframes floatUp {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(0.8); }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.2); }
  100% { opacity: 0; transform: translate(-50%, -150%) scale(1); }
}

.points-float text {
  font-size: 48rpx;
  font-weight: bold;
  color: #FFD700;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
  background: rgba(255,255,255,0.9);
  padding: 15rpx 25rpx;
  border-radius: 20rpx;
}

/* ===== 胜利状态 ===== */
.battle-victory {
  width: 100%;
  height: 100%;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 20rpx;
  overflow-y: auto;
}

/* 撒花 */
.confetti-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  overflow: hidden;
}

.confetti-paper {
  position: absolute;
  top: -20rpx;
  animation: confettiFall 3s ease-out forwards;
}

@keyframes confettiFall {
  0% { transform: translateY(0) rotate(0deg); opacity: 1; }
  100% { transform: translateY(600rpx) rotate(720deg); opacity: 0; }
}

.confetti-emoji {
  position: absolute;
  top: -40rpx;
  animation: emojiFall 3s ease-out forwards;
}

@keyframes emojiFall {
  0% { transform: translateY(0) scale(1); opacity: 1; }
  100% { transform: translateY(600rpx) scale(0.5); opacity: 0; }
}

/* 胜利主体 */
.victory-main {
  text-align: center;
  z-index: 10;
  animation: victoryPop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes victoryPop {
  0% { transform: scale(0); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

/* 被击败的敌人 */
.defeated-enemy {
  position: relative;
  display: inline-block;
  margin-bottom: 20rpx;
}

.defeated-emoji {
  font-size: 140rpx;
  display: block;
  filter: grayscale(0.5);
  opacity: 0.7;
}

.defeated-mark {
  position: absolute;
  top: -10rpx;
  right: -20rpx;
  background: #4CAF50;
  color: white;
  font-size: 20rpx;
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
  font-weight: bold;
}

/* 胜利信息 */
.victory-info {
  margin-bottom: 20rpx;
}

.victory-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #E91E63;
  display: block;
  margin-bottom: 10rpx;
}

.victory-desc {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 15rpx;
}

.victory-stars {
  display: flex;
  justify-content: center;
  gap: 10rpx;
  margin-bottom: 15rpx;
}

.victory-stars .star {
  font-size: 36rpx;
  animation: victoryStarPop 0.3s ease-out both;
}

@keyframes victoryStarPop {
  from { transform: scale(0); }
  to { transform: scale(1); }
}

.victory-points {
  background: linear-gradient(135deg, #FFD700, #FFA000);
  color: white;
  padding: 10rpx 20rpx;
  border-radius: 15rpx;
  font-size: 26rpx;
  font-weight: bold;
  display: inline-block;
}

/* 贴纸选择（内联到胜利画面） */
.sticker-picker-inline {
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  text-align: center;
  margin-top: 16rpx;
}

.sticker-hint {
  font-size: 24rpx;
  color: #E91E63;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
  text-align: center;
}

.sticker-list {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.sticker-item {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
  border-radius: 16rpx;
  border: 2rpx solid #FFB6C1;
  font-size: 32rpx;
  transition: all 0.2s ease;
  box-shadow: 0 2rpx 6rpx rgba(255, 107, 138, 0.15);
}

.sticker-item:active {
  transform: scale(0.9);
  background: #FFF0F3;
  border-color: #FF6B8A;
}

/* 已贴贴纸展示行 */
.placed-stickers-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  flex-wrap: wrap;
  padding: 16rpx 24rpx;
  margin-top: 12rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
}

.placed-sticker-item {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFF0F5, #FFE4EC);
  border-radius: 16rpx;
  border: 2rpx solid #FFB6C1;
  animation: stickerPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.placed-sticker-emoji {
  font-size: 36rpx;
}

@keyframes stickerPop {
  0% { transform: scale(0) rotate(-45deg); }
  70% { transform: scale(1.4) rotate(10deg); }
  100% { transform: scale(1) rotate(0deg); }
}

.placed-sticker-delete {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 28rpx;
  height: 28rpx;
  background: #FF4444;
  color: white;
  font-size: 18rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.placed-sticker-delete:active {
  background: #CC0000;
}

/* 完成按钮 */
.done-btn {
  margin-top: 20rpx;
  padding: 16rpx 60rpx;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: white;
  font-size: 28rpx;
  font-weight: bold;
  border-radius: 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 138, 0.3);
}

.done-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

/* 6区牙齿（2行3列，占满宽度） */
.tooth-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(2, 1fr);
  gap: 10rpx;
  padding: 16rpx;
  margin: 0 24rpx 16rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 32rpx;
  backdrop-filter: blur(12px);
  box-shadow: 0 4rpx 16rpx rgba(255, 154, 171, 0.2);
  flex-shrink: 0;
}

.tooth-zone {
  position: relative;
  height: 120rpx;
  background: linear-gradient(180deg, #FFFDE7 0%, #FFF9C4 100%);
  border: 3rpx solid;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 当前正在刷的区域：脉冲发光 */
.tooth-zone.zone-current {
  background: linear-gradient(180deg, #FFF0F5 0%, #FFE4EC 100%);
  transform: scale(1.08);
  z-index: 2;
}

.zone-pulse {
  animation: zonePulse 1s ease-in-out infinite;
}

@keyframes zonePulse {
  0%, 100% { box-shadow: 0 0 16rpx rgba(255, 154, 171, 0.45); }
  50% { box-shadow: 0 0 36rpx rgba(255, 154, 171, 0.75); }
}

/* 已刷干净的区域：雪白闪亮 */
.tooth-zone.zone-clean {
  background: linear-gradient(180deg, #FFFFFF 0%, #E8F5E9 100%);
  border-color: #81C784 !important;
  transform: scale(1);
}

.zone-tooth-body {
  position: relative;
  z-index: 1;
}

.zone-tooth-emoji {
  font-size: 40rpx;
  display: block;
  transition: transform 0.4s;
}

.tooth-zone.zone-clean .zone-tooth-emoji {
  animation: cleanToothPop 0.6s ease-out;
}

@keyframes cleanToothPop {
  0% { transform: scale(0.5) rotate(-10deg); }
  60% { transform: scale(1.3) rotate(5deg); }
  100% { transform: scale(1) rotate(0deg); }
}

/* 细菌层 */
.zone-germs {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 2;
  pointer-events: none;
}

.zone-germ {
  position: absolute;
  font-size: 22rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0,0,0,0.15));
}

.germ-wiggle {
  animation: germWiggle 1.2s ease-in-out infinite;
}

@keyframes germWiggle {
  0%, 100% { transform: rotate(-12deg) scale(1); }
  50% { transform: rotate(12deg) scale(1.15); }
}

.germ-flee {
  animation: germFlee 0.7s ease-out forwards;
}

@keyframes germFlee {
  0% { transform: translate(0, 0) scale(1); opacity: 1; }
  40% { transform: translate(0, -30rpx) scale(1.1); opacity: 1; }
  100% { transform: translate(0, -120rpx) scale(0.3); opacity: 0; }
}

/* 闪亮特效 */
.zone-shine {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 40rpx;
  z-index: 3;
  animation: shinePop 0.8s ease-out forwards;
  pointer-events: none;
}

@keyframes shinePop {
  0% { transform: translate(-50%, -50%) scale(0) rotate(-45deg); opacity: 0; }
  50% { transform: translate(-50%, -50%) scale(1.6) rotate(0deg); opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(1) rotate(0deg); opacity: 0.85; }
}

/* 小皇冠 */
.zone-crown {
  position: absolute;
  top: -4rpx;
  right: -2rpx;
  font-size: 20rpx;
  z-index: 4;
  animation: miniCrownBounce 1s ease-in-out infinite;
}

@keyframes miniCrownBounce {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-4rpx) rotate(12deg); }
}

/* 区域名称标签 */
.zone-label {
  position: absolute;
  bottom: 4rpx;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 18rpx;
  color: #999;
  font-weight: 500;
  z-index: 3;
  pointer-events: none;
}

.tooth-zone.zone-current .zone-label {
  color: #FF6B8A;
  font-weight: bold;
}

.tooth-zone.zone-clean .zone-label {
  color: #81C784;
  font-weight: bold;
}

/* 当前区域倒计时 */
.zone-timer {
  position: absolute;
  top: 2rpx;
  right: 4rpx;
  z-index: 5;
  pointer-events: none;
}

.zone-timer-num {
  font-size: 22rpx;
  font-weight: bold;
  color: #FF6B8A;
  background: rgba(255, 255, 255, 0.85);
  padding: 2rpx 8rpx;
  border-radius: 12rpx;
  line-height: 1;
  box-shadow: 0 2rpx 6rpx rgba(255, 154, 171, 0.2);
}

/* 已完成勾号 */
.zone-check {
  position: absolute;
  top: 2rpx;
  left: 4rpx;
  font-size: 20rpx;
  color: #81C784;
  font-weight: bold;
  z-index: 5;
  pointer-events: none;
  animation: checkPop 0.3s ease-out;
}

@keyframes checkPop {
  0% { transform: scale(0); }
  60% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

/* ===== 奖励 ===== */
.reward-section { padding: 8rpx 40rpx; text-align: center; flex-shrink: 0; }
.star-row { display: flex; justify-content: center; gap: 20rpx; margin-bottom: 6rpx; }
.star-item { transition: transform 0.3s; }
.star-emoji { font-size: 40rpx; opacity: 0.25; transition: opacity 0.3s; }
.star-item.earned .star-emoji { opacity: 1; animation: starPop 0.5s ease-out; }

@keyframes starPop {
  0% { transform: scale(0.3); }
  50% { transform: scale(1.5); }
  100% { transform: scale(1); }
}

.reward-text { font-size: 28rpx; color: #FF6B8A; font-weight: bold; }

/* ===== 时长选择 ===== */
.duration-picker {
  padding: 16rpx 50rpx 0;
  text-align: center;
}

.duration-title {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 16rpx;
}

.duration-options {
  display: flex;
  justify-content: center;
  gap: 24rpx;
}

.duration-opt {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  background: white;
  box-shadow: 0 4rpx 16rpx rgba(255, 154, 171, 0.15);
  transition: all 0.2s;
}

.duration-opt.active {
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: white;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 138, 0.35);
}

.duration-num {
  font-size: 36rpx;
  font-weight: bold;
}

.duration-unit {
  font-size: 22rpx;
}

.duration-opt.active .duration-num,
.duration-opt.active .duration-unit {
  color: white;
}

/* ===== 按钮 ===== */
.btn-area {
  padding: 24rpx 50rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.btn-start {
  width: 100%;
  padding: 32rpx 0;
  text-align: center;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: white;
  border-radius: 64rpx;
  font-size: 36rpx;
  font-weight: bold;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 36rpx rgba(255, 107, 138, 0.4);
  transition: transform 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-start:active { transform: scale(0.96); }

.btn-icon { font-size: 40rpx; }
.btn-label { font-size: 36rpx; }

.btn-sparkle {
  position: absolute;
  top: -50%; left: -50%;
  width: 200%; height: 200%;
  background: linear-gradient(45deg, transparent 40%, rgba(255,255,255,0.2) 50%, transparent 60%);
  animation: sparkleMove 3s linear infinite;
}

@keyframes sparkleMove {
  0% { transform: translateX(-100%) rotate(25deg); }
  100% { transform: translateX(100%) rotate(25deg); }
}

.btn-pause {
  width: 100%;
  padding: 32rpx 0;
  text-align: center;
  background: linear-gradient(135deg, #FFB74D, #FF9800);
  color: white;
  border-radius: 64rpx;
  font-size: 36rpx;
  font-weight: bold;
  box-shadow: 0 12rpx 36rpx rgba(255, 152, 0, 0.35);
  transition: transform 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-pause:active { transform: scale(0.96); }

.btn-retry {
  padding: 12rpx 40rpx;
  color: #bbb;
  font-size: 26rpx;
}

.btn-finish-early {
  padding: 16rpx 40rpx;
  color: #81C784;
  font-size: 28rpx;
  font-weight: bold;
  background: rgba(129, 199, 132, 0.1);
  border-radius: 40rpx;
  transition: transform 0.2s;
}

.btn-finish-early:active {
  transform: scale(0.96);
}

/* ===== 胜利后按钮 ===== */
.victory-actions {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 30rpx;
  justify-content: center;
}

.victory-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
  border-radius: 30rpx;
  font-size: 28rpx;
  font-weight: bold;
  white-space: nowrap;
  transition: all 0.2s;
}

.victory-btn:active {
  transform: scale(0.96);
}

.victory-btn.primary {
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 138, 0.3);
}

.victory-btn.secondary {
  background: linear-gradient(135deg, #81C784, #4CAF50);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
}

.victory-btn.outline {
  background: rgba(255, 255, 255, 0.9);
  color: #FF6B8A;
  border: 2rpx solid #FFD6DE;
}

.victory-btn-icon {
  font-size: 32rpx;
}

.victory-btn-text {
  font-size: 28rpx;
}

.safe-bottom { height: 40rpx; }

/* ===== 击败烟花 ===== */
.firework-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 15;
  pointer-events: none;
}

.firework-particle {
  position: absolute;
  font-size: var(--fw-size, 28rpx);
  width: var(--fw-size, 28rpx);
  height: var(--fw-size, 28rpx);
  line-height: var(--fw-size, 28rpx);
  text-align: center;
  opacity: 0;
  animation: fireworkScatter 1.4s ease-out forwards;
  animation-delay: var(--fw-delay, 0s);
  text-shadow: 0 0 12rpx currentColor;
}

@keyframes fireworkScatter {
  0% {
    opacity: 1;
    transform: rotate(var(--fw-angle, 0deg)) translateX(0) scale(1.8);
    filter: brightness(2.5);
  }
  20% {
    opacity: 1;
    transform: rotate(var(--fw-angle, 0deg)) translateX(var(--fw-distance, 100rpx)) scale(1.4);
    filter: brightness(2);
  }
  50% {
    opacity: 0.9;
    transform: rotate(var(--fw-angle, 0deg)) translateX(calc(var(--fw-distance, 100rpx) * 0.9)) translateY(20rpx) scale(1.1);
  }
  80% {
    opacity: 0.5;
    transform: rotate(var(--fw-angle, 0deg)) translateX(calc(var(--fw-distance, 100rpx) * 0.65)) translateY(90rpx) scale(0.7);
  }
  100% {
    opacity: 0;
    transform: rotate(var(--fw-angle, 0deg)) translateX(calc(var(--fw-distance, 100rpx) * 0.4)) translateY(160rpx) scale(0.2);
  }
}

/* ===== 拍照区域（完成界面） ===== */
.photo-section {
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  margin-top: 16rpx;
}

.photo-section-title {
  font-size: 26rpx;
  color: #E91E63;
  font-weight: bold;
  margin-bottom: 16rpx;
  text-align: center;
}

.photo-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.photo-item {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid #FFB6C1;
}

.photo-thumb {
  width: 100%;
  height: 100%;
}

.photo-edit {
  position: absolute;
  bottom: 4rpx;
  left: 4rpx;
  width: 36rpx;
  height: 36rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

.photo-delete {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  width: 32rpx;
  height: 32rpx;
  background: #FF4444;
  color: white;
  font-size: 18rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-add {
  width: 140rpx;
  height: 140rpx;
  border: 3rpx dashed #FFB6C1;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: rgba(255, 182, 193, 0.1);
}

.photo-add .add-icon {
  font-size: 36rpx;
}

.photo-add .add-text {
  font-size: 22rpx;
  color: #FF6B8A;
}

.photo-add:active {
  background: rgba(255, 182, 193, 0.3);
}

/* 拍照达上限：置灰 */
.photo-add-disabled {
  opacity: 0.5;
  border-style: solid;
  border-color: #DDD;
  background: rgba(0, 0, 0, 0.03);
}

.photo-add-disabled .add-text {
  color: #BBB;
}

/* ===== 操作按钮 ===== */
.action-btns {
  display: flex;
  justify-content: center;
  padding: 24rpx;
  margin-top: 16rpx;
}

.action-btn {
  padding: 20rpx 60rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
}

.action-btn.done-btn {
  background: linear-gradient(135deg, #4CAF50, #66BB6A);
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}

.action-btn.done-btn:active {
  transform: scale(0.95);
}

