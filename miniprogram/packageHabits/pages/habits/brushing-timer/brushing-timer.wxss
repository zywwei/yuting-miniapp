  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.btn-pause:active { transform: scale(0.96); }

.btn-retry {
  padding: 12rpx 40rpx;
  color: #bbb;
  font-size: 26rpx;
}

.btn-finish-early {
  padding: 16rpx 40rpx;
  color: #81C784;
  font-size: 28rpx;
  font-weight: bold;
  background: rgba(129, 199, 132, 0.1);
  border-radius: 40rpx;
  transition: transform 0.2s;
}

.btn-finish-early:active {
  transform: scale(0.96);
}

/* ===== 胜利后按钮 ===== */
.victory-actions {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 30rpx;
  justify-content: center;
}

.victory-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
