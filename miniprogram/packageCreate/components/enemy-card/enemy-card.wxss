/* 敌人卡片组件样式 */

.enemy-card {
  background: linear-gradient(135deg, #FFF5F8 0%, #FFE4EC 100%);
  border-radius: 30rpx;
  padding: 30rpx;
  margin: 20rpx;
  box-shadow: 0 10rpx 30rpx rgba(255, 107, 138, 0.2);
  position: relative;
  overflow: hidden;
  animation: slideIn 0.5s ease-out;
}

@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateX(-50rpx);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.enemy-card.victory {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  box-shadow: 0 10rpx 30rpx rgba(76, 175, 80, 0.3);
}

.enemy-card.shake {
  animation: shake 0.3s ease-in-out;
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-15rpx); }
  75% { transform: translateX(15rpx); }
}

/* 章节标签 */
.chapter-tag {
  display: inline-flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  padding: 8rpx 20rpx;
  margin-bottom: 20rpx;
}

.chapter-tag-emoji {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.chapter-tag-text {
  font-size: 24rpx;
  color: #E91E63;
  font-weight: 500;
}

/* 敌人主体 */
.enemy-body {
  text-align: center;
  position: relative;
  padding: 20rpx 0;
}

.enemy-emoji {
  font-size: 100rpx;
  display: inline-block;
  animation: enemyFloat 2s ease-in-out infinite;
}

@keyframes enemyFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15rpx); }
}

.enemy-emoji.defeated {
  animation: defeated 0.5s ease-out forwards;
  filter: grayscale(0.5);
  opacity: 0.7;
}

@keyframes defeated {
  0% { transform: scale(1); }
  50% { transform: scale(1.2); }
  100% { transform: scale(0.8) rotate(15deg); }
}

/* 胜利标记 */
.victory-badge {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(76, 175, 80, 0.9);
  color: #fff;
  padding: 10rpx 25rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: bold;
  animation: badgePop 0.5s ease-out;
}

@keyframes badgePop {
  0% { transform: translate(-50%, -50%) scale(0); }
  50% { transform: translate(-50%, -50%) scale(1.2); }
  100% { transform: translate(-50%, -50%) scale(1); }
}

/* 伤害显示 */
.damage-text {
  position: absolute;
  top: -20rpx;
  left: 50%;
  transform: translateX(-50%);
  color: #F44336;
  font-size: 48rpx;
  font-weight: bold;
  text-shadow: 2rpx 2rpx 4rpx rgba(0,0,0,0.3);
  animation: damageFloat 0.8s ease-out forwards;
}

@keyframes damageFloat {
  0% {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  100% {
    opacity: 0;
    transform: translateX(-50%) translateY(-80rpx);
  }
}

/* 敌人信息 */
.enemy-info {
  text-align: center;
  margin-top: 15rpx;
}

.enemy-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #E91E63;
  margin-bottom: 10rpx;
}

.victory .enemy-name {
  color: #4CAF50;
}

.enemy-desc {
  font-size: 24rpx;
  color: #888;
  margin-bottom: 15rpx;
}

/* HP条 */
.hp-bar-container {
  margin-top: 20rpx;
  padding: 0 20rpx;
}

.hp-bar-bg {
  width: 100%;
  height: 20rpx;
  background: #FFD6E0;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: inset 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.hp-bar-fill {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.5s ease-out, background 0.3s ease;
  position: relative;
}

.hp-bar-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 50%;
  background: linear-gradient(180deg, rgba(255,255,255,0.4) 0%, transparent 100%);
  border-radius: 10rpx 10rpx 0 0;
}

.hp-text {
  text-align: center;
  font-size: 22rpx;
  color: #E91E63;
  margin-top: 8rpx;
  font-weight: 500;
}

/* 胜利文字 */
.defeat-text {
  font-size: 28rpx;
  color: #4CAF50;
  font-weight: 500;
  margin-top: 15rpx;
  padding: 15rpx;
  background: rgba(76, 175, 80, 0.1);
  border-radius: 15rpx;
  animation: fadeInUp 0.5s ease-out;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
