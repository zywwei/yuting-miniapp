.container {
  min-height: 100vh;
  background: #FFF5F5;
}

.header {
  position: relative;
  padding-bottom: 32rpx;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: linear-gradient(135deg, #FF5722 0%, #E64A19 100%);
  border-radius: 0 0 40rpx 40rpx;
}

.header-content {
  position: relative;
  padding: 40rpx 32rpx 24rpx;
  text-align: center;
}

.sound-toggle {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  z-index: 10;
  padding: 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.sound-icon {
  font-size: 36rpx;
}

.header-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stats-bar {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  margin: 0 32rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF5722;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: #eee;
}

.mode-grid {
  padding: 32rpx;
}

.mode-card {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 32rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.mode-card:active {
  transform: scale(0.98);
}

.mode-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
}

.mode-info {
  flex: 1;
}

.mode-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.mode-desc {
  font-size: 24rpx;
  color: #999;
}

.mode-arrow {
  font-size: 40rpx;
  color: #ccc;
  font-weight: bold;
}

.recent-section {
  padding: 0 32rpx 32rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.record-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.record-item:last-child {
  border-bottom: none;
}

.record-mode {
  font-size: 24rpx;
  color: #666;
  width: 100rpx;
}

.record-result {
  flex: 1;
  font-size: 28rpx;
  font-weight: bold;
  text-align: center;
}

.record-result.win {
  color: #4CAF50;
}

.record-result.lose {
  color: #F44336;
}

.record-result.draw {
  color: #FF9800;
}

.record-score {
  font-size: 24rpx;
  color: #999;
  width: 100rpx;
  text-align: right;
}
