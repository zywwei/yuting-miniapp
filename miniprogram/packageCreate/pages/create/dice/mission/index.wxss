.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #E8F5E9 0%, #FFF5F5 100%);
  padding: 32rpx;
}

.header {
  text-align: center;
  margin-bottom: 48rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #4CAF50;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.progress-bar {
  background: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.progress-text {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.progress-track {
  height: 16rpx;
  background: #E8F5E9;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50 0%, #8BC34A 100%);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.phase-ready,
.phase-rolling,
.phase-task,
.phase-done {
  text-align: center;
  padding-top: 80rpx;
}

.dice-preview {
  margin-bottom: 60rpx;
}

.preview-icon {
  font-size: 120rpx;
  display: block;
  margin-bottom: 24rpx;
}

.preview-text {
  font-size: 32rpx;
  color: #666;
}

.rolling-dice {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 24rpx;
  margin: 0 auto 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
  animation: diceRoll 0.2s ease-in-out infinite;
}

@keyframes diceRoll {
  0% { transform: rotate(0deg) scale(1); }
  25% { transform: rotate(90deg) scale(1.1); }
  50% { transform: rotate(180deg) scale(1); }
  75% { transform: rotate(270deg) scale(1.1); }
  100% { transform: rotate(360deg) scale(1); }
}

.rolling-num {
  font-size: 80rpx;
  font-weight: bold;
  color: #FF5722;
}

.rolling-text {
  font-size: 32rpx;
  color: #666;
}

.task-dice {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  border-radius: 20rpx;
  margin: 0 auto 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.dice-value {
  font-size: 64rpx;
  font-weight: bold;
  color: #FF5722;
}

.task-card {
  background: #fff;
  padding: 48rpx;
  border-radius: 24rpx;
  margin-bottom: 48rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.task-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.task-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.task-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.task-type {
  display: inline-block;
  padding: 8rpx 24rpx;
  background: #E8F5E9;
  color: #4CAF50;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.task-actions {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  flex: 1;
  padding: 24rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: bold;
}

.action-btn.complete {
  background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
  color: #fff;
}

.action-btn.skip {
  background: #f5f5f5;
  color: #666;
}

.done-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
}

.done-text {
  font-size: 48rpx;
  font-weight: bold;
  color: #4CAF50;
  margin-bottom: 16rpx;
}

.done-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 48rpx;
}

.roll-btn {
  padding: 32rpx 64rpx;
  background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
  color: #fff;
  border-radius: 20rpx;
  font-size: 36rpx;
  font-weight: bold;
  display: inline-block;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.3);
}

.roll-btn:active {
  transform: scale(0.98);
}

.play-again-btn {
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, #4CAF50 0%, #388E3C 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: inline-block;
}

.back-btn {
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #999;
}
