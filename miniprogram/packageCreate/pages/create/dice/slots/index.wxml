<view class="container">
  <!-- 标题区 -->
  <view class="header">
    <view class="header-icon">🎰</view>
    <view class="header-title">趣味模拟</view>
    <view class="header-desc">学习概率，理性游戏</view>
  </view>

  <!-- 余额显示 -->
  <view class="balance-bar">
    <text class="balance-label">💰 金币</text>
    <text class="balance-value">{{balance}}</text>
  </view>

  <!-- 转盘区 -->
  <view class="slot-machine">
    <view class="reel-container">
      <view class="reel {{isSpinning ? 'spinning' : ''}}">
        <text class="reel-symbol">{{reels[0]}}</text>
      </view>
      <view class="reel {{isSpinning ? 'spinning' : ''}}">
        <text class="reel-symbol">{{reels[1]}}</text>
      </view>
      <view class="reel {{isSpinning ? 'spinning' : ''}}">
        <text class="reel-symbol">{{reels[2]}}</text>
      </view>
    </view>

    <!-- 中奖提示 -->
    <view class="win-alert" wx:if="{{showWin}}">
      <text class="win-text">🎉 {{lastResult.name}}！+{{lastWin}} 金币</text>
    </view>
  </view>

  <!-- 押注区 -->
  <view class="bet-section">
    <view class="bet-title">选择押注</view>
    <view class="bet-buttons">
      <view class="bet-btn {{betAmount === 10 ? 'active' : ''}}" bindtap="selectBet" data-amount="10">10</view>
      <view class="bet-btn {{betAmount === 20 ? 'active' : ''}}" bindtap="selectBet" data-amount="20">20</view>
      <view class="bet-btn {{betAmount === 50 ? 'active' : ''}}" bindtap="selectBet" data-amount="50">50</view>
    </view>
  </view>

  <!-- 投掷按钮 -->
  <view class="spin-btn {{isSpinning || balance < betAmount ? 'disabled' : ''}}" bindtap="spin">
    <text class="spin-text">{{isSpinning ? '转盘中...' : '开始抽奖'}}</text>
  </view>

  <!-- 继续按钮 -->
  <view class="continue-btn" wx:if="{{phase === 'result' && !isSpinning}}" bindtap="continuePlay">
    <text>再来一次</text>
  </view>

  <!-- 概率说明 -->
  <view class="prob-section">
    <view class="prob-title">📊 概率说明</view>
    <view class="prob-list">
      <view class="prob-item">
        <text class="prob-icon">7️⃣7️⃣7️⃣</text>
        <text class="prob-name">超级大奖</text>
        <text class="prob-rate">×50</text>
      </view>
      <view class="prob-item">
        <text class="prob-icon">⭐⭐⭐</text>
        <text class="prob-name">大奖</text>
        <text class="prob-rate">×20</text>
      </view>
      <view class="prob-item">
        <text class="prob-icon">🔔🔔🔔</text>
        <text class="prob-name">中奖</text>
        <text class="prob-rate">×10</text>
      </view>
      <view class="prob-item">
        <text class="prob-icon">🍒🍒🍒</text>
        <text class="prob-name">小奖</text>
        <text class="prob-rate">×5</text>
      </view>
      <view class="prob-item">
        <text class="prob-icon">XXY</text>
        <text class="prob-name">两个相同</text>
        <text class="prob-rate">×2</text>
      </view>
    </view>
  </view>

  <!-- 统计区 -->
  <view class="stats-section" wx:if="{{totalSpins > 0}}">
    <view class="stats-title">📈 实际统计</view>
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-value">{{totalSpins}}</text>
        <text class="stat-label">总次数</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{totalWin}}</text>
        <text class="stat-label">总赢取</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{threeSameCount}}</text>
        <text class="stat-label">三同</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">{{twoSameCount}}</text>
        <text class="stat-label">两同</text>
      </view>
    </view>
    <view class="stats-note">
      <text>三同概率: {{threeSameRate}}%（理论2.78%）</text>
    </view>
  </view>

  <view class="back-btn" bindtap="goBack">返回</view>
</view>
