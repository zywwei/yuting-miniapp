.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FCE4EC 0%, #FFF5F5 100%);
  padding: 32rpx;
}

/* 标题区 */
.header {
  text-align: center;
  padding: 24rpx 0;
}

.header-icon {
  font-size: 64rpx;
  margin-bottom: 8rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #E91E63;
  margin-bottom: 4rpx;
}

.header-desc {
  font-size: 24rpx;
  color: #666;
}

/* 余额 */
.balance-bar {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  padding: 16rpx 32rpx;
  border-radius: 24rpx;
  margin: 16rpx 0;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.balance-label {
  font-size: 28rpx;
  color: #666;
}

.balance-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF9800;
}

/* 转盘区 */
.slot-machine {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 24rpx 0;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.1);
}

.reel-container {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.reel {
  width: 140rpx;
  height: 140rpx;
  background: #FFF3E0;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FFE0B2;
}

.reel.spinning {
  animation: reelSpin 0.1s linear infinite;
}

@keyframes reelSpin {
  0% { transform: translateY(-5rpx); }
  50% { transform: translateY(5rpx); }
  100% { transform: translateY(-5rpx); }
}

.reel-symbol {
  font-size: 72rpx;
}

/* 中奖提示 */
.win-alert {
  text-align: center;
  padding: 16rpx;
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  border-radius: 12rpx;
  animation: winPulse 0.5s ease-in-out;
}

@keyframes winPulse {
  0% { transform: scale(0.8); opacity: 0; }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); opacity: 1; }
}

.win-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #4CAF50;
}

/* 押注区 */
.bet-section {
  margin: 24rpx 0;
}

.bet-title {
  font-size: 26rpx;
  color: #666;
  text-align: center;
  margin-bottom: 12rpx;
}

.bet-buttons {
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.bet-btn {
  padding: 12rpx 32rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #666;
  border: 2rpx solid #eee;
  transition: all 0.2s ease;
}

.bet-btn.active {
  background: #E91E63;
  color: #fff;
  border-color: #E91E63;
}

/* 投掷按钮 */
.spin-btn {
  text-align: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #E91E63 0%, #C2185B 100%);
  border-radius: 16rpx;
  margin: 24rpx 0;
  box-shadow: 0 8rpx 24rpx rgba(233, 30, 99, 0.3);
}

.spin-btn.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.spin-btn:active {
  transform: scale(0.98);
}

.spin-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

/* 继续按钮 */
.continue-btn {
  text-align: center;
  padding: 20rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #E91E63;
  border: 2rpx solid #E91E63;
  margin-bottom: 24rpx;
}

/* 概率说明 */
.prob-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.prob-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.prob-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.prob-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.prob-icon {
  font-size: 28rpx;
  width: 120rpx;
}

.prob-name {
  flex: 1;
  font-size: 24rpx;
  color: #666;
}

.prob-rate {
  font-size: 24rpx;
  font-weight: bold;
  color: #E91E63;
}

/* 统计区 */
.stats-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.stats-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  margin-bottom: 16rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #E91E63;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.stats-note {
  text-align: center;
  font-size: 22rpx;
  color: #999;
  padding-top: 12rpx;
  border-top: 2rpx solid #f5f5f5;
}

.back-btn {
  text-align: center;
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
}
