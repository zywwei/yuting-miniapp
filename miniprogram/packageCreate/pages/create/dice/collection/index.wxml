<view class="container">
  <view class="header">
    <view class="header-icon">🎯</view>
    <view class="header-title">游戏合集</view>
    <view class="header-desc">更多精彩游戏等你来玩</view>
  </view>

  <view class="game-list">
    <view class="game-card {{item.status}}" wx:for="{{games}}" wx:key="id" bindtap="goGame" data-game="{{item}}">
      <view class="game-icon">{{item.icon}}</view>
      <view class="game-info">
        <view class="game-name">{{item.name}}</view>
        <view class="game-desc">{{item.desc}}</view>
      </view>
      <view class="game-status" wx:if="{{item.status === 'coming_soon'}}">
        <text class="status-tag">即将推出</text>
      </view>
      <view class="game-arrow" wx:else>›</view>
    </view>
  </view>

  <view class="back-btn" bindtap="goBack">返回</view>
</view>
