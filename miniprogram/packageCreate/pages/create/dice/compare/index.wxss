.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #FFE0B2 0%, #FFF5F5 100%);
  padding: 32rpx;
}

/* 选择阶段 */
.phase-select {
  text-align: center;
  padding-top: 60rpx;
}

.phase-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #FF5722;
  margin-bottom: 48rpx;
}

.mode-buttons {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.mode-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fff;
  padding: 32rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 87, 34, 0.1);
  transition: all 0.2s ease;
  border: 4rpx solid transparent;
}

.mode-btn.active {
  border-color: #FF5722;
  background: #FFF3E0;
}

.mode-btn:active {
  transform: scale(0.98);
}

.mode-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.mode-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.mode-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

/* 骰子数量选择 */
.dice-count-section {
  margin-top: 40rpx;
}

.section-title {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
}

.count-buttons {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.count-btn {
  padding: 16rpx 32rpx;
  background: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #666;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid #eee;
  transition: all 0.2s ease;
}

.count-btn.active {
  background: #FF5722;
  color: #fff;
  border-color: #FF5722;
}

.start-btn {
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, #FF5722 0%, #E64A19 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  display: inline-block;
  box-shadow: 0 8rpx 24rpx rgba(255, 87, 34, 0.3);
}

.start-btn:active {
  transform: scale(0.98);
}

.back-btn {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #999;
}

/* 回合提示 */
.turn-prompt {
  text-align: center;
  margin-bottom: 32rpx;
}

.turn-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.turn-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF5722;
}

.turn-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

/* 游戏阶段 */
.phase-playing {
  padding-top: 20rpx;
}

.phase-result {
  padding-top: 20rpx;
}

/* 比分板 */
.scoreboard {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.score-side {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.score-side.score-win {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
}

.score-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.score-value {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF5722;
}

.score-divider {
  font-size: 28rpx;
  font-weight: bold;
  color: #ccc;
  padding: 0 24rpx;
}

/* 战斗区域 */
.battle-area {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  margin-bottom: 32rpx;
}

.player-side {
  flex: 1;
  text-align: center;
}

.player-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #666;
  margin-bottom: 16rpx;
}

.dice-container {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  min-height: 100rpx;
}

.dice-placeholder {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f5f5;
  border-radius: 16rpx;
}

.placeholder-text {
  font-size: 40rpx;
  color: #ccc;
}

.player-sum {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.special-badge {
  display: inline-block;
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #FF9800;
}

.vs-divider {
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  margin-top: 60rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #ccc;
}

/* 摇骰子按钮 */
.roll-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 64rpx;
  background: linear-gradient(135deg, #FF5722 0%, #E64A19 100%);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 87, 34, 0.3);
  margin: 0 auto;
}

.roll-btn.disabled {
  opacity: 0.6;
  pointer-events: none;
}

.roll-btn:active {
  transform: scale(0.98);
}

.roll-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.roll-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
}

/* 中间大骰子 */
.center-dice-area {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  margin: 20rpx 0;
  animation: fadeInScale 0.3s ease;
}

@keyframes fadeInScale {
  0% { 
    opacity: 0; 
    transform: scale(0.5); 
  }
  100% { 
    opacity: 1; 
    transform: scale(1); 
  }
}

/* 回合结果 */
.round-result {
  text-align: center;
  margin-bottom: 24rpx;
  animation: fadeInUp 0.5s ease-out;
}

@keyframes fadeInUp {
  from { transform: translateY(20rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

.result-badge {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.result-badge.win {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
}

.result-badge.lose {
  background: linear-gradient(135deg, #FFEBEE 0%, #FFCDD2 100%);
}

.result-badge.draw {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
}

.result-icon {
  font-size: 32rpx;
}

.result-text {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

/* 游戏结果 */
.game-result {
  text-align: center;
  margin-bottom: 24rpx;
  animation: fadeInUp 0.5s ease-out;
}

.game-result-badge {
  background: #fff;
  padding: 40rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  margin-bottom: 24rpx;
}

.game-result-badge.win {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
}

.game-result-badge.lose {
  background: linear-gradient(135deg, #FFEBEE 0%, #FFCDD2 100%);
}

.game-result-icon {
  font-size: 72rpx;
  margin-bottom: 12rpx;
}

.game-result-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.game-result-score {
  font-size: 48rpx;
  font-weight: bold;
  color: #FF5722;
}

.game-result-actions {
  display: flex;
  gap: 24rpx;
}

.result-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.result-btn.primary {
  background: linear-gradient(135deg, #FF5722 0%, #E64A19 100%);
  color: #fff;
}

.result-btn.secondary {
  background: #f5f5f5;
  color: #666;
}

.result-btn:active {
  transform: scale(0.98);
}

.btn-icon {
  font-size: 28rpx;
}

.btn-text {
  font-size: 28rpx;
}

/* 下一局按钮 */
.next-round {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #FF5722 0%, #E64A19 100%);
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.next-round:active {
  transform: scale(0.98);
}

.next-round-icon {
  font-size: 24rpx;
}

.next-round-text {
  font-size: 28rpx;
}

/* 撒花效果 */
.confetti-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 100;
}

.confetti {
  position: absolute;
  font-size: 48rpx;
  animation: confettiFall 2s ease-in forwards;
}

.confetti-1 { left: 10%; animation-delay: 0s; }
.confetti-2 { left: 30%; animation-delay: 0.2s; }
.confetti-3 { left: 50%; animation-delay: 0.4s; }
.confetti-4 { left: 70%; animation-delay: 0.1s; }
.confetti-5 { left: 85%; animation-delay: 0.3s; }
.confetti-6 { left: 45%; animation-delay: 0.5s; }

@keyframes confettiFall {
  0% { top: -10%; opacity: 1; transform: rotate(0deg); }
  100% { top: 110%; opacity: 0; transform: rotate(720deg); }
}
