.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 32rpx;
}

.container.modal-open {
  overflow: hidden;
  height: 100vh;
}

.container.modal-open .chart-container {
  visibility: hidden;
}

/* 时间维度选择器 */
.time-tabs {
  display: flex;
  background: #fff;
  padding: 16rpx 24rpx;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.time-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 24rpx;
}

.time-tab.active {
  color: #fff;
  background: linear-gradient(135deg, #FF6B8A, #FF9AAB);
}

/* 自定义日期选择器 */
.custom-date-picker {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.date-pick-btn {
  font-size: 24rpx;
  color: #999;
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.date-pick-btn.active {
  color: #FF6B8A;
  background: #FFF5F7;
}

.date-sep {
  font-size: 24rpx;
  color: #ccc;
}

.date-clear {
  font-size: 28rpx;
  color: #999;
  padding: 8rpx;
  margin-left: auto;
}

.section {
  margin: 16rpx 24rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 24rpx 16rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  padding: 24rpx 24rpx 16rpx;
}

/* 营业数据卡片 */
.data-cards {
  display: flex;
  gap: 12rpx;
  padding: 0 24rpx 24rpx;
}

.data-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  background: #FFF5F7;
  border-radius: 12rpx;
}

.data-value {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 4rpx;
}

.data-label {
  font-size: 20rpx;
  color: #999;
}

/* 核心指标卡片 */
.metrics-grid {
  display: flex;
  gap: 12rpx;
  padding: 0 24rpx 24rpx;
}

.metric-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 12rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.metric-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.metric-value {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.metric-value.profit {
  color: #4CAF50;
}

.metric-compare {
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-top: 4rpx;
}

.compare-text {
  font-size: 20rpx;
  font-weight: bold;
}

.compare-text.up {
  color: #4CAF50;
}

.compare-text.down {
  color: #F44336;
}

.compare-label {
  font-size: 18rpx;
  color: #999;
}

/* 销售趋势图 */
.chart-container {
  padding: 0 24rpx 24rpx;
  position: relative;
  z-index: 1;
}

.sales-chart {
  width: 100%;
  height: 300rpx;
}

/* 经营分析 */
.profit-section {
  display: flex;
  align-items: center;
  padding: 0 24rpx 24rpx;
  gap: 32rpx;
}

.profit-circle {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profit-ring {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 8rpx solid #FF6B8A;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.profit-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF6B8A;
}

.profit-label {
  font-size: 20rpx;
  color: #999;
}

.profit-details {
  flex: 1;
}

.profit-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.profit-row:last-child {
  border-bottom: none;
}

.profit-key {
  font-size: 26rpx;
  color: #666;
}

.profit-val {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

/* 目标完成率 */
.target-section {
  padding: 0 24rpx 24rpx;
}

.target-header {
  margin-bottom: 16rpx;
}

.target-title {
  font-size: 26rpx;
  color: #666;
}

.target-cards {
  display: flex;
  gap: 16rpx;
}

.target-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.target-label {
  font-size: 22rpx;
  color: #999;
}

.target-progress-bar {
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}

.target-progress {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50, #8BC34A);
  border-radius: 8rpx;
  transition: width 0.3s;
}

.target-value {
  font-size: 24rpx;
  font-weight: bold;
  color: #4CAF50;
  text-align: right;
}

/* 高利润商品 */
.high-profit-section {
  padding: 0 24rpx 24rpx;
}

.high-profit-header {
  margin-bottom: 16rpx;
}

.high-profit-title {
  font-size: 26rpx;
  color: #666;
}

.high-profit-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.high-profit-item {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
}

.high-profit-rank {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FF9800;
  color: #fff;
  font-size: 22rpx;
  font-weight: bold;
  border-radius: 50%;
  margin-right: 16rpx;
}

.high-profit-item:nth-child(1) .high-profit-rank {
  background: #FF6B8A;
}

.high-profit-item:nth-child(2) .high-profit-rank {
  background: #FF9800;
}

.high-profit-item:nth-child(3) .high-profit-rank {
  background: #FFC107;
}

.high-profit-info {
  flex: 1;
}

.high-profit-name {
  font-size: 26rpx;
  color: #333;
  display: block;
}

.high-profit-rate {
  font-size: 22rpx;
  color: #4CAF50;
}

.high-profit-stats {
  text-align: right;
}

.high-profit-amount {
  font-size: 28rpx;
  font-weight: bold;
  color: #4CAF50;
}

/* 客单价分布 */
.order-distribution-section {
  padding: 0 24rpx 24rpx;
}

.distribution-header {
  margin-bottom: 16rpx;
}

.distribution-title {
  font-size: 26rpx;
  color: #666;
}

.distribution-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.distribution-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.distribution-range {
  font-size: 24rpx;
  color: #666;
  width: 120rpx;
}

.distribution-bar {
  flex: 1;
  height: 20rpx;
  background: #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
}

.distribution-progress {
  height: 100%;
  background: linear-gradient(90deg, #2196F3, #64B5F6);
  border-radius: 10rpx;
}

.distribution-count {
  font-size: 24rpx;
  color: #999;
  width: 80rpx;
  text-align: right;
}

/* 热销商品 */
.top-list {
  padding: 0 24rpx 24rpx;
}

.top-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.top-item:last-child {
  border-bottom: none;
}

.top-rank {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FF6B8A;
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
  border-radius: 50%;
  margin-right: 16rpx;
}

.top-item:nth-child(2) .top-rank {
  background: #FF9800;
}

.top-item:nth-child(3) .top-rank {
  background: #FFC107;
}

.top-info {
  flex: 1;
  margin-right: 16rpx;
}

.top-name {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
  display: block;
}

.top-bar {
  height: 12rpx;
  background: #f0f0f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.top-progress {
  height: 100%;
  background: linear-gradient(90deg, #FF6B8A, #FF9AAB);
  border-radius: 6rpx;
  transition: width 0.3s;
}

.top-stats {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.top-qty {
  font-size: 24rpx;
  color: #999;
}

.top-revenue {
  font-size: 28rpx;
  font-weight: bold;
  color: #FF6B8A;
}

/* 分类统计 */
.category-list {
  padding: 0 24rpx 24rpx;
}

.category-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.category-name {
  width: 100rpx;
  font-size: 24rpx;
  color: #333;
}

.category-bar {
  flex: 1;
  height: 20rpx;
  background: #f0f0f0;
  border-radius: 10rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.category-progress {
  height: 100%;
  background: linear-gradient(90deg, #4CAF50, #8BC34A);
  border-radius: 10rpx;
}

.category-stats {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  width: 120rpx;
}

.category-revenue {
  font-size: 24rpx;
  font-weight: bold;
  color: #333;
}

.category-qty {
  font-size: 20rpx;
  color: #999;
}

.empty-hint {
  text-align: center;
  padding: 32rpx;
  color: #999;
  font-size: 26rpx;
}

/* 分享按钮 */
.share-actions {
  padding: 32rpx 24rpx 48rpx;
}

.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #FF6B8A 0%, #FF9AAB 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(255,107,138,0.3);
}

.share-icon {
  font-size: 32rpx;
}

.share-text {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
}

/* 海报相关 */
.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 375px;
  height: 667px;
  z-index: -1;
  pointer-events: none;
}

.poster-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.poster-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.9);
}

.poster-content {
  position: relative;
  z-index: 10000;
  width: 88%;
  max-height: 90vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.poster-image-wrapper {
  width: 100%;
  padding-bottom: 177.87%;
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.poster-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.poster-actions {
  display: flex;
  gap: 24rpx;
  width: 100%;
  flex-shrink: 0;
}

.poster-btn {
  flex: 1;
  padding: 24rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #333;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
  margin: 0;
  line-height: 1.5;
  border: none;
}

.poster-btn::after {
  border: none;
}

.poster-btn.primary {
  color: #fff;
  background: linear-gradient(135deg, #FF6B8A 0%, #FF9AAB 100%);
}
