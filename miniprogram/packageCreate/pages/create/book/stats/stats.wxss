.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.book-selector {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  color: #fff;
}

.book-icon {
  font-size: 32rpx;
}

.book-name {
  font-size: 28rpx;
  font-weight: bold;
}

.book-arrow {
  font-size: 20rpx;
  opacity: 0.8;
}

.filter-bar {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.filter-tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 6rpx;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx;
  font-size: 24rpx;
  color: #666;
  border-radius: 10rpx;
}

.filter-tab.active {
  background: #FF6B8A;
  color: #fff;
}

.overview-card {
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  color: #fff;
}

.overview-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.overview-item {
  text-align: center;
}

.overview-label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 10rpx;
}

.overview-value {
  font-size: 36rpx;
  font-weight: bold;
}

.income {
  color: #fff;
}

.expense {
  color: #ffe0e0;
}

.overview-footer {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  opacity: 0.8;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.chart-canvas {
  width: 100%;
  height: 400rpx;
  margin-bottom: 20rpx;
}

.category-list {
  margin-bottom: 20rpx;
}

.category-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.category-item:last-child {
  border-bottom: none;
}

.category-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.category-info {
  flex: 1;
}

.category-name {
  font-size: 28rpx;
  color: #333;
}

.category-count {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.category-amount {
  font-size: 30rpx;
  font-weight: bold;
  color: #ff4d4f;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.calendar-day {
  width: calc(14.28% - 6rpx);
  text-align: center;
  padding: 12rpx 4rpx;
  border-radius: 8rpx;
}

.calendar-day.has-data {
  background: #fff0f3;
}

.day-number {
  font-size: 22rpx;
  color: #666;
}

.day-dot {
  width: 8rpx;
  height: 8rpx;
  background: #FF6B8A;
  border-radius: 50%;
  margin: 4rpx auto 0;
}

.empty-tip {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 20rpx;
}

.member-stats {
  margin-bottom: 20rpx;
}

.member-stat-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.member-stat-item:last-child {
  border-bottom: none;
}

.member-stat-name {
  width: 120rpx;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
}

.member-stat-detail {
  flex: 1;
  display: flex;
  gap: 20rpx;
  font-size: 24rpx;
}

.member-stat-detail .income {
  color: #52c41a;
}

.member-stat-detail .expense {
  color: #ff4d4f;
}

.member-stat-detail .count {
  color: #999;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
