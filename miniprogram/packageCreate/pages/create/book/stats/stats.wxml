<view class="container">
  <!-- 账本切换 -->
  <view class="book-selector" bindtap="showBookPicker">
    <text class="book-icon">{{book ? book.icon : '📊'}}</text>
    <text class="book-name">{{book ? book.name : '全部账本'}}</text>
    <text class="book-arrow">▼</text>
  </view>

  <!-- 筛选条件 -->
  <view class="filter-bar">
    <view class="filter-tabs">
      <view class="filter-tab {{timeRange === item.value ? 'active' : ''}}" wx:for="{{timeRangeOptions}}" wx:key="value" bindtap="switchTimeRange" data-value="{{item.value}}">{{item.label}}</view>
    </view>
    <view class="filter-tabs">
      <view class="filter-tab {{typeFilter === item.value ? 'active' : ''}}" wx:for="{{typeOptions}}" wx:key="value" bindtap="switchTypeFilter" data-value="{{item.value}}">{{item.label}}</view>
    </view>
    <view class="filter-tabs" wx:if="{{memberList.length > 1}}">
      <view class="filter-tab member-filter {{selectedMembers.length > 0 ? 'active' : ''}}" bindtap="toggleMemberPicker">
        <text>记账人{{selectedMembers.length > 0 ? '(' + selectedMembers.length + ')' : ''}}</text>
        <text class="filter-arrow">{{showMemberPicker ? '▲' : '▼'}}</text>
      </view>
    </view>
  </view>

  <!-- 记账人选择器 -->
  <view class="member-picker" wx:if="{{showMemberPicker}}">
    <view class="member-picker-header">
      <view class="member-picker-action" bindtap="selectAllMembers">全选</view>
      <view class="member-picker-action" bindtap="clearMemberSelection">清除</view>
      <view class="member-picker-confirm" bindtap="confirmMemberSelection">确定</view>
    </view>
    <view class="member-picker-list">
      <view class="member-picker-item {{selectedMembers.indexOf(item.id) >= 0 ? 'selected' : ''}}" wx:for="{{memberList}}" wx:key="id" bindtap="toggleMember" data-id="{{item.id}}">
        <view class="member-checkbox">{{selectedMembers.indexOf(item.id) >= 0 ? '✓' : ''}}</view>
        <text class="member-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 收支概览 -->
  <view class="overview-card" wx:if="{{stats}}">
    <view class="overview-row">
      <view class="overview-item">
        <view class="overview-label">收入</view>
        <view class="overview-value income">+{{stats.income || 0}}</view>
      </view>
      <view class="overview-item">
        <view class="overview-label">支出</view>
        <view class="overview-value expense">-{{stats.expense || 0}}</view>
      </view>
      <view class="overview-item">
        <view class="overview-label">结余</view>
        <view class="overview-value {{stats.balance >= 0 ? 'income' : 'expense'}}">{{stats.balance >= 0 ? '+' : ''}}{{stats.balance || 0}}</view>
      </view>
    </view>
    <view class="overview-footer">
      <text>共 {{stats.entryCount || 0}} 笔记录</text>
      <text wx:if="{{comparison}}">{{comparisonText}}</text>
    </view>
  </view>

  <!-- 趋势图 -->
  <view class="section" wx:if="{{trendData}}">
    <view class="section-title">收支趋势</view>
    <canvas canvas-id="trendChart" class="chart-canvas"></canvas>
  </view>

  <!-- 分类占比 -->
  <view class="section" wx:if="{{categoryStats}}">
    <view class="section-title">{{typeFilter === 'income' ? '收入' : (typeFilter === 'expense' ? '支出' : '收支')}}分类占比</view>
    <canvas canvas-id="pieChart" class="chart-canvas"></canvas>
    <view class="category-list">
      <view class="category-item" wx:for="{{topCategories}}" wx:key="id">
        <view class="category-icon">{{item.icon}}</view>
        <view class="category-info">
          <view class="category-name">{{item.name}}</view>
          <view class="category-count">{{item.count}} 笔</view>
        </view>
        <view class="category-amount">{{item.amount}}</view>
      </view>
      <view class="empty-tip" wx:if="{{topCategories.length === 0}}">暂无数据</view>
    </view>
  </view>

  <!-- 日历热力图 -->
  <view class="section" wx:if="{{calendarData}}">
    <view class="section-title">本月记账日历</view>
    <heatmap data="{{calendarData}}" month="{{currentMonth}}" typeFilter="{{typeFilter}}" bind:daytap="onDayTap" />
  </view>

  <!-- 记账人统计 -->
  <view class="section" wx:if="{{memberStats && memberStats.length > 1}}">
    <view class="section-title">记账人统计</view>
    <view class="member-stats">
      <view class="member-stat-item" wx:for="{{memberStats}}" wx:key="name">
        <view class="member-stat-name">{{item.name}}</view>
        <view class="member-stat-detail">
          <text class="income">收入 {{item.income}}</text>
          <text class="expense">支出 {{item.expense}}</text>
          <text class="count">{{item.count}} 笔</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{!stats || stats.entryCount === 0}}">
    <view class="empty-icon">📊</view>
    <view class="empty-text">暂无统计数据</view>
  </view>
</view>
