.container {
  background: #f5f5f5;
  min-height: 100vh;
}

.status-bar {
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
}

.navbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  padding: 0 16rpx;
}

.navbar-left {
  width: 80rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
}

.back-arrow {
  font-size: 36rpx;
  color: #fff;
}

.navbar-center {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 30rpx;
}

.navbar-center .book-icon {
  font-size: 32rpx;
}

.navbar-center .book-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
}

.navbar-center .book-arrow {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.8);
}

.navbar-right {
  width: 80rpx;
}

.type-tabs {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  padding: 6rpx;
  margin: 12rpx 16rpx;
}

.type-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx;
  font-size: 26rpx;
  color: #666;
  border-radius: 10rpx;
}

.type-tab.active {
  background: #FF6B8A;
  color: #fff;
}

.amount-section {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 0 16rpx 12rpx;
}

.amount-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.amount-input-row {
  display: flex;
  align-items: center;
}

.amount-prefix {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-right: 12rpx;
}

.amount-input {
  flex: 1;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
}

.section {
  background: #fff;
  border-radius: 12rpx;
  padding: 16rpx;
  margin: 0 16rpx 12rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.section-header .section-title {
  margin-bottom: 0;
}

.section-action {
  font-size: 26rpx;
  color: #FF6B8A;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 10rpx;
}

.category-item {
  text-align: center;
  padding: 10rpx 2rpx;
  border: 2rpx solid #eee;
  border-radius: 10rpx;
}

.category-icon {
  font-size: 32rpx;
  margin-bottom: 2rpx;
  line-height: 1;
}

.category-name {
  font-size: 18rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.2;
}

.note-input {
  width: 100%;
  height: 80rpx;
  font-size: 26rpx;
  color: #333;
  padding: 12rpx;
  border: 1rpx solid #eee;
  border-radius: 10rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  position: relative;
  width: 160rpx;
  height: 160rpx;
}

.image-preview {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.image-remove {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  background: #ff4d4f;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.image-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 48rpx;
  color: #999;
}

.add-text {
  font-size: 20rpx;
  color: #999;
  margin-top: 8rpx;
}

.datetime-row {
  display: flex;
  justify-content: space-between;
}

.datetime-item {
  flex: 1;
}

.datetime-label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.datetime-value {
  font-size: 26rpx;
  color: #333;
  padding: 12rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  align-items: center;
}

.repeat-options {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.repeat-option {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.repeat-option.active {
  color: #FF6B8A;
  background: #fff0f3;
}

.tag-item {
  display: flex;
  align-items: center;
  padding: 6rpx 12rpx;
  background: #f0f0f0;
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #666;
}

.tag-remove {
  margin-left: 6rpx;
  font-size: 24rpx;
  color: #999;
}

.tag-input-row {
  display: flex;
  align-items: center;
}

.tag-input {
  width: 140rpx;
  font-size: 22rpx;
  padding: 6rpx;
}

.tag-add {
  font-size: 28rpx;
  color: #FF6B8A;
  margin-left: 6rpx;
}

.action-buttons {
  margin: 20rpx 16rpx 0;
  padding-bottom: env(safe-area-inset-bottom);
}

