.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.book-list {
  margin-bottom: 20rpx;
}

.book-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.book-item.active {
  border-color: #FF6B8A;
  background: #fff0f3;
}

.book-icon {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.book-name {
  font-size: 28rpx;
  color: #333;
}

.date-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.date-option {
  padding: 12rpx 24rpx;
  border: 2rpx solid #eee;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
}

.date-option.active {
  border-color: #FF6B8A;
  background: #fff0f3;
  color: #FF6B8A;
}

.custom-date {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.date-value {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
}

.date-separator {
  font-size: 26rpx;
  color: #666;
}

.field-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.field-item {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
}

.field-check {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ddd;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 12rpx;
  color: #fff;
}

.field-check.checked {
  background: #FF6B8A;
  border-color: #FF6B8A;
}

.field-label {
  font-size: 26rpx;
  color: #333;
}

.preview-info {
  margin-bottom: 20rpx;
}

.preview-item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.preview-item:last-child {
  border-bottom: none;
}

.preview-label {
  font-size: 26rpx;
  color: #666;
}

.preview-value {
  font-size: 26rpx;
  color: #333;
  font-weight: bold;
}

.export-btn {
  text-align: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  border-radius: 16rpx;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
  margin-top: 40rpx;
}
