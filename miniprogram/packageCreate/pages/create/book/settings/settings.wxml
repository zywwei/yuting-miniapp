<view class="container" wx:if="{{book}}">
  <!-- 基本信息 -->
  <view class="section">
    <view class="section-title">基本信息</view>
    <view class="form-group">
      <view class="form-label">账本图标</view>
      <view class="icon-display" bindtap="showIconPicker">
        <view class="icon-value">{{book.icon}}</view>
        <view class="icon-arrow">></view>
      </view>
    </view>
    <view class="form-group">
      <view class="form-label">账本名称</view>
      <input class="form-input" value="{{book.name}}" bindblur="onNameInput" />
    </view>
    <view class="form-group">
      <view class="form-label">账本描述</view>
      <input class="form-input" placeholder="添加描述..." value="{{book.description}}" bindblur="onDescriptionInput" />
    </view>
  </view>

  <!-- 预算设置 -->
  <view class="section">
    <view class="section-title">预算设置</view>
    <view class="form-group" bindtap="showBudgetDialog">
      <view class="form-label">月度预算</view>
      <view class="form-value">{{book.monthlyBudget ? book.monthlyBudget + ' 元' : '未设置'}}</view>
    </view>
  </view>

  <!-- 记账提醒 -->
  <view class="section">
    <view class="section-title">记账提醒</view>
    <view class="form-group">
      <view class="form-label">开启提醒</view>
      <switch checked="{{book.reminderEnabled}}" bindchange="toggleReminder" color="#FF6B8A" />
    </view>
    <view class="form-group" wx:if="{{book.reminderEnabled}}">
      <view class="form-label">提醒时间</view>
      <picker mode="time" value="{{book.reminderTime}}" bindchange="onReminderTimeChange">
        <view class="form-value">{{book.reminderTime}}</view>
      </picker>
    </view>
    <view class="reminder-days" wx:if="{{book.reminderEnabled}}">
      <view class="form-label">提醒日期</view>
      <view class="days-row">
        <view class="day-item {{reminderDaysMap[1] ? 'active' : ''}}" bindtap="toggleReminderDay" data-day="1">一</view>
        <view class="day-item {{reminderDaysMap[2] ? 'active' : ''}}" bindtap="toggleReminderDay" data-day="2">二</view>
        <view class="day-item {{reminderDaysMap[3] ? 'active' : ''}}" bindtap="toggleReminderDay" data-day="3">三</view>
        <view class="day-item {{reminderDaysMap[4] ? 'active' : ''}}" bindtap="toggleReminderDay" data-day="4">四</view>
        <view class="day-item {{reminderDaysMap[5] ? 'active' : ''}}" bindtap="toggleReminderDay" data-day="5">五</view>
        <view class="day-item {{reminderDaysMap[6] ? 'active' : ''}}" bindtap="toggleReminderDay" data-day="6">六</view>
        <view class="day-item {{reminderDaysMap[0] ? 'active' : ''}}" bindtap="toggleReminderDay" data-day="0">日</view>
      </view>
    </view>
  </view>

  <!-- 操作 -->
  <view class="section">
    <view class="section-title">操作</view>
    <view class="action-item" bindtap="setDefault">
      <view class="action-text">设为默认账本</view>
      <view class="action-badge" wx:if="{{book.isDefault}}">当前默认</view>
    </view>
    <view class="action-item" bindtap="goCategories">
      <view class="action-text">分类管理</view>
      <view class="action-arrow">></view>
    </view>
    <view class="action-item" bindtap="goExport">
      <view class="action-text">导出数据</view>
      <view class="action-arrow">></view>
    </view>
  </view>

  <!-- 数据管理 -->
  <view class="section">
    <view class="section-title">数据管理</view>
    <view class="action-item" bindtap="exportBackup">
      <view class="action-text">备份数据</view>
      <view class="action-arrow">></view>
    </view>
    <view class="action-item" bindtap="importBackup">
      <view class="action-text">恢复数据</view>
      <view class="action-arrow">></view>
    </view>
    <view class="action-item" bindtap="clearData">
      <view class="action-text">清空数据</view>
      <view class="action-arrow">></view>
    </view>
  </view>

  <!-- 危险操作 -->
  <view class="section danger">
    <view class="section-title">危险操作</view>
    <view class="action-item" bindtap="archiveBook" wx:if="{{!book.isArchived}}">
      <view class="action-text">归档账本</view>
      <view class="action-arrow">></view>
    </view>
    <view class="action-item" bindtap="restoreArchive" wx:if="{{book.isArchived}}">
      <view class="action-text">恢复账本</view>
      <view class="action-arrow">></view>
    </view>
    <view class="action-item" bindtap="deleteBook">
      <view class="action-text danger-text">删除账本</view>
      <view class="action-arrow">></view>
    </view>
  </view>

  <!-- 图标选择弹窗 -->
  <view class="modal-mask" wx:if="{{showIconPicker}}" bindtap="hideIconPicker">
    <view class="modal-content" catchtap="preventBubble">
      <view class="modal-title">选择图标</view>
      <view class="icon-grid">
        <view class="icon-item {{book.icon === item ? 'active' : ''}}" wx:for="{{iconOptions}}" wx:key="*this" bindtap="selectIcon" data-icon="{{item}}">{{item}}</view>
      </view>
    </view>
  </view>

  <!-- 预算输入弹窗 -->
  <view class="modal-mask" wx:if="{{showBudgetInput}}" bindtap="hideBudgetDialog">
    <view class="modal-content" catchtap="preventBubble">
      <view class="modal-title">设置月度预算</view>
      <input class="budget-input" type="digit" placeholder="输入预算金额" value="{{budgetInput}}" bindinput="onBudgetInput" />
      <view class="modal-footer">
        <view class="modal-btn cancel" bindtap="hideBudgetDialog">取消</view>
        <view class="modal-btn confirm" bindtap="confirmBudget">确定</view>
      </view>
    </view>
  </view>
</view>
