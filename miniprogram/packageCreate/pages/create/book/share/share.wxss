.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.section-header .section-title {
  margin-bottom: 0;
}

.section-action {
  font-size: 26rpx;
  color: #FF6B8A;
}

.mode-switch {
  display: flex;
  gap: 20rpx;
}

.mode-option {
  flex: 1;
  text-align: center;
  padding: 30rpx;
  border: 2rpx solid #eee;
  border-radius: 16rpx;
}

.mode-option.active {
  border-color: #FF6B8A;
  background: #fff0f3;
}

.mode-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.mode-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.mode-desc {
  font-size: 22rpx;
  color: #999;
}

.member-list {
  margin-bottom: 20rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.member-item:last-child {
  border-bottom: none;
}

.member-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 16rpx;
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.member-role {
  font-size: 24rpx;
  color: #FF6B8A;
  background: #fff0f3;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
}

.member-remove {
  font-size: 24rpx;
  color: #ff4d4f;
}

.permission-list {
  margin-bottom: 20rpx;
}

.permission-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.permission-item:last-child {
  border-bottom: none;
}

.permission-role {
  width: 120rpx;
  font-size: 26rpx;
  color: #FF6B8A;
  font-weight: bold;
}

.permission-desc {
  flex: 1;
  font-size: 24rpx;
  color: #666;
}

.empty-tip {
  text-align: center;
  font-size: 26rpx;
  color: #999;
  padding: 20rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  width: 80%;
  max-width: 600rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}

.select-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.select-list {
  margin-bottom: 24rpx;
}

.select-item {
  display: flex;
  align-items: center;
  padding: 16rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.select-item.active {
  border-color: #FF6B8A;
  background: #fff0f3;
}

.select-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #FF9AAB;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 12rpx;
}

.select-name {
  font-size: 28rpx;
  color: #333;
}

.role-options {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.role-option {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #666;
}

.role-option.active {
  border-color: #FF6B8A;
  background: #fff0f3;
  color: #FF6B8A;
}

.modal-footer {
  display: flex;
  justify-content: space-between;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
  margin-right: 16rpx;
}

.modal-btn.confirm {
  background: #FF6B8A;
  color: #fff;
}
