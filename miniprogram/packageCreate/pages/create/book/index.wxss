.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.overview-card {
  background: linear-gradient(135deg, #FF9AAB, #FF6B8A);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  color: #fff;
}

.overview-title {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 20rpx;
}

.overview-row {
  display: flex;
  justify-content: space-between;
}

.overview-item {
  text-align: center;
}

.overview-label {
  font-size: 24rpx;
  opacity: 0.8;
  margin-bottom: 10rpx;
}

.overview-value {
  font-size: 36rpx;
  font-weight: bold;
}

.income {
  color: #fff;
}

.expense {
  color: #ffe0e0;
}

.section {
  margin-bottom: 30rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.section-action {
  font-size: 28rpx;
  color: #FF6B8A;
}

.book-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.book-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.book-card:last-child {
  border-bottom: none;
}

.book-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.book-info {
  flex: 1;
}

.book-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.book-meta {
  font-size: 24rpx;
  color: #999;
}

.book-balance {
  text-align: right;
}

.book-restore {
  font-size: 24rpx;
  color: #1890ff;
  padding: 8rpx 16rpx;
  background: #e6f7ff;
  border-radius: 8rpx;
}

.archived-section {
  margin-top: 20rpx;
}

.archived-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
}

.archived-title {
  font-size: 26rpx;
  color: #999;
}

.archived-arrow {
  font-size: 24rpx;
  color: #999;
}

.archived-list {
  margin-top: 12rpx;
}

.book-card.archived {
  opacity: 0.7;
}

.balance-label {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.balance-amount {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF6B8A;
}

.empty-tip {
  padding: 60rpx;
  text-align: center;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.quick-actions {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.quick-btn {
  text-align: center;
}

.quick-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.quick-text {
  font-size: 24rpx;
  color: #666;
}

.entry-list {
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}

.entry-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.entry-item:last-child {
  border-bottom: none;
}

.entry-category {
  font-size: 36rpx;
  margin-right: 16rpx;
}

.entry-info {
  flex: 1;
}

.entry-note {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
}

.entry-date {
  font-size: 22rpx;
  color: #999;
}

.entry-amount {
  font-size: 30rpx;
  font-weight: bold;
}

.entry-amount.income {
  color: #52c41a;
}

.entry-amount.expense {
  color: #ff4d4f;
}

.entry-amount.transfer {
  color: #1890ff;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  width: 80%;
  max-width: 600rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
}

.form-group {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.form-input {
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

.icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.icon-item {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
}

.icon-item.active {
  border-color: #FF6B8A;
  background: #fff0f3;
}

.modal-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
  margin-right: 16rpx;
}

.modal-btn.confirm {
  background: #FF6B8A;
  color: #fff;
}
