<view class="container">
  <!-- 今日概览 -->
  <view class="overview-card">
    <view class="overview-title">今日收支</view>
    <view class="overview-row">
      <view class="overview-item">
        <view class="overview-label">收入</view>
        <view class="overview-value income">+{{overview.todayIncome || 0}}</view>
      </view>
      <view class="overview-item">
        <view class="overview-label">支出</view>
        <view class="overview-value expense">-{{overview.todayExpense || 0}}</view>
      </view>
      <view class="overview-item">
        <view class="overview-label">结余</view>
        <view class="overview-value {{overview.todayBalance >= 0 ? 'income' : 'expense'}}">{{overview.todayBalance >= 0 ? '+' : ''}}{{overview.todayBalance || 0}}</view>
      </view>
    </view>
    <view class="overview-divider"></view>
    <view class="overview-title">本月收支</view>
    <view class="overview-row">
      <view class="overview-item">
        <view class="overview-label">收入</view>
        <view class="overview-value income">+{{overview.monthIncome || 0}}</view>
      </view>
      <view class="overview-item">
        <view class="overview-label">支出</view>
        <view class="overview-value expense">-{{overview.monthExpense || 0}}</view>
      </view>
      <view class="overview-item">
        <view class="overview-label">结余</view>
        <view class="overview-value {{overview.monthBalance >= 0 ? 'income' : 'expense'}}">{{overview.monthBalance >= 0 ? '+' : ''}}{{overview.monthBalance || 0}}</view>
      </view>
    </view>
  </view>

  <!-- 账本列表 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title">我的账本</view>
      <view class="section-action" bindtap="showAddBookDialog">+ 新建</view>
    </view>
    <view class="book-list">
      <view class="book-card {{item.isDefault ? 'default' : ''}}" wx:for="{{books}}" wx:key="id" bindtap="goDetail" bindlongpress="setDefaultBook" data-id="{{item.id}}">
        <view class="book-icon">{{item.icon}}</view>
        <view class="book-info">
          <view class="book-name">{{item.name}} <text wx:if="{{item.isDefault}}" class="default-tag">默认</text></view>
          <view class="book-meta">{{item.entryCount || 0}} 笔记录</view>
        </view>
        <view class="book-balance">
          <view class="balance-label">本月支出</view>
          <view class="balance-amount">{{item.monthExpense || 0}}</view>
        </view>
      </view>
      <view class="empty-tip" wx:if="{{books.length === 0}}">
        <view class="empty-icon">📝</view>
        <view class="empty-text">还没有账本，点击"新建"开始记账吧</view>
      </view>
    </view>
    <!-- 归档账本 -->
    <view class="archived-section" wx:if="{{archivedBooks.length > 0}}">
      <view class="archived-header" bindtap="showArchivedBooks">
        <text class="archived-title">归档账本 ({{archivedBooks.length}})</text>
        <text class="archived-arrow">{{showArchived ? '▼' : '▶'}}</text>
      </view>
      <view class="archived-list" wx:if="{{showArchived}}">
        <view class="book-card archived" wx:for="{{archivedBooks}}" wx:key="id">
          <view class="book-icon">{{item.icon}}</view>
          <view class="book-info">
            <view class="book-name">{{item.name}}</view>
            <view class="book-meta">{{item.entryCount || 0}} 笔记录</view>
          </view>
          <view class="book-restore" bindtap="restoreBook" data-id="{{item.id}}">恢复</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-actions">
    <view class="quick-btn" bindtap="goAddEntry" bindlongpress="longPressAddEntry">
      <view class="quick-icon">✏️</view>
      <view class="quick-text">记一笔</view>
    </view>
    <view class="quick-btn" bindtap="goStats">
      <view class="quick-icon">📊</view>
      <view class="quick-text">统计</view>
    </view>
    <view class="quick-btn" bindtap="goExport">
      <view class="quick-icon">📤</view>
      <view class="quick-text">导出</view>
    </view>
  </view>

  <!-- 最近记录 -->
  <view class="section" wx:if="{{recentEntries.length > 0}}">
    <view class="section-header">
      <view class="section-title">最近记录</view>
    </view>
    <view class="entry-list">
      <view class="entry-item" wx:for="{{recentEntries}}" wx:key="id">
        <view class="entry-category">{{item.categoryIcon}}</view>
        <view class="entry-info">
          <view class="entry-note">{{item.categoryName}}</view>
          <view class="entry-date">{{item.date}} {{item.time}}</view>
        </view>
        <view class="entry-amount {{item.type}}">
          {{item.type === 'income' ? '+' : '-'}}{{item.amount}}
        </view>
      </view>
    </view>
  </view>

  <!-- 新建账本弹窗 -->
  <view class="modal-mask" wx:if="{{showAddBook}}" bindtap="hideAddBookDialog">
    <view class="modal-content" catchtap="preventBubble">
      <view class="modal-title">新建账本</view>
      <view class="form-group">
        <view class="form-label">账本名称</view>
        <input class="form-input" placeholder="请输入账本名称" value="{{newBookName}}" bindinput="onBookNameInput" />
      </view>
      <view class="form-group">
        <view class="form-label">选择图标</view>
        <view class="icon-grid">
          <view class="icon-item {{newBookIcon === item ? 'active' : ''}}" wx:for="{{iconOptions}}" wx:key="*this" bindtap="selectIcon" data-icon="{{item}}">{{item}}</view>
        </view>
      </view>
      <view class="modal-footer">
        <view class="modal-btn cancel" bindtap="hideAddBookDialog">取消</view>
        <view class="modal-btn confirm" bindtap="confirmAddBook">确定</view>
      </view>
    </view>
  </view>
</view>
