<view class="container" style="padding-bottom: {{keyboardHeight > 0 ? keyboardHeight + 'px' : '0'}};">
  <!-- 顶部栏 -->
  <view class="top-bar">
    <view class="model-badge" bindtap="showQuickSwitch">
      <text class="model-icon">{{modelInfo.icon}}</text>
      <view class="model-badge-info">
        <text class="model-name">{{modelInfo.name}}</text>
        <text class="model-sub-name">{{currentSubModelName || currentTemplateName}}</text>
      </view>
      <text class="model-badge-arrow">▾</text>
    </view>
    <view class="top-actions">
      <view class="action-btn stats-btn" bindtap="toggleContextStats">
        <text>📊</text>
        <text class="stats-cost-badge" wx:if="{{totalTokensUsed > 0}}">¥{{estimatedCost}}</text>
      </view>
      <view class="action-btn" bindtap="showSessions">
        <text>💬</text>
      </view>
      <view class="action-btn" bindtap="newSession">
        <text>➕</text>
      </view>
      <view class="action-btn" bindtap="goSettings">
        <text>⚙️</text>
      </view>
    </view>
  </view>
  
  <!-- 上下文统计详情（展开时显示） -->
  <view class="context-stats" wx:if="{{showContextStats}}">
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-label">上下文</text>
        <text class="stat-value">{{contextTokens}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">输出</text>
        <text class="stat-value">{{outputTokens}}</text>
      </view>
      <view class="stat-item">
        <text class="stat-label">总计</text>
        <text class="stat-value">{{totalTokensUsed}}</text>
      </view>
      <view class="stat-item cost">
        <text class="stat-label">预估费用</text>
        <text class="stat-value">¥{{estimatedCost}}</text>
      </view>
    </view>
  </view>
  
  <!-- 快速切换弹窗 -->
  <view class="quick-switch-modal" wx:if="{{showQuickSwitchModal}}" bindtap="hideQuickSwitch">
    <view class="quick-switch-content" catchtap="stopPropagation">
      <!-- Tab切换 -->
      <view class="quick-switch-tabs">
        <view class="quick-tab {{quickSwitchTab === 'template' ? 'active' : ''}}" bindtap="switchQuickTab" data-tab="template">
          助手
        </view>
        <view class="quick-tab {{quickSwitchTab === 'provider' ? 'active' : ''}}" bindtap="switchQuickTab" data-tab="provider">
          供应商/模型
        </view>
      </view>
      
      <!-- 助手类型列表 -->
      <view class="quick-panel" wx:if="{{quickSwitchTab === 'template'}}">
        <scroll-view scroll-y class="quick-scroll">
          <view class="template-select-list">
            <view 
              wx:for="{{templateList}}" 
              wx:key="key"
              class="template-select-item {{currentTemplateKey === item.key ? 'active' : ''}}"
              bindtap="quickSwitchTemplate"
              data-key="{{item.key}}"
              data-name="{{item.name}}"
            >
              <view class="template-select-icon">{{item.icon}}</view>
              <view class="template-select-info">
                <view class="template-select-name">{{item.name}}</view>
                <view class="template-select-desc">{{item.desc}}</view>
              </view>
              <view class="template-select-check" wx:if="{{currentTemplateKey === item.key}}">✓</view>
            </view>
          </view>
        </scroll-view>
      </view>
      
      <!-- 供应商和模型列表 -->
      <view class="quick-panel" wx:if="{{quickSwitchTab === 'provider'}}">
        <scroll-view scroll-y class="quick-scroll">
          <view class="provider-model-list">
            <view 
              wx:for="{{allProviders}}" 
              wx:key="key"
              class="provider-group {{currentProvider === item.key ? 'expanded' : ''}}"
            >
              <!-- 供应商主卡片 -->
              <view class="provider-main" bindtap="quickSwitchProvider" data-key="{{item.key}}">
                <view class="provider-icon" style="background: {{item.color}}">{{item.icon}}</view>
                <view class="provider-info">
                  <view class="provider-name">
                    {{item.name}}
                    <text class="provider-badge" wx:if="{{item.configured}}">✓ 已配置</text>
                  </view>
                  <view class="provider-desc">{{item.description}}</view>
                </view>
                <view class="provider-expand {{currentProvider === item.key ? 'open' : ''}}">
                  <text>›</text>
                </view>
              </view>
              
              <!-- 子模型列表（展开时显示） -->
              <view class="model-sub-list" wx:if="{{currentProvider === item.key && expandProvider}}">
                <view 
                  wx:for="{{item.subModels}}" 
                  wx:for-item="sub"
                  wx:key="key"
                  class="model-sub-item {{currentModelKey === sub.key ? 'active' : ''}}"
                  bindtap="quickSwitchModel"
                  data-key="{{sub.key}}"
                  data-name="{{sub.name}}"
                >
                  <view class="model-sub-name">{{sub.name}}</view>
                  <view class="model-sub-desc">{{sub.desc}}</view>
                  <view class="model-sub-check" wx:if="{{currentModelKey === sub.key}}">✓</view>
                </view>
              </view>
            </view>
          </view>
        </scroll-view>
      </view>
    </view>
  </view>

  <!-- 未配置提示 -->
  <view class="not-configured" wx:if="{{!isConfigured}}">
    <view class="not-configured-icon">🤖</view>
    <view class="not-configured-title">还未配置AI模型</view>
    <view class="not-configured-desc">请先配置API Key才能开始对话</view>
    <button class="config-btn" bindtap="goSettings">去配置</button>
  </view>

  <!-- 聊天区域 -->
  <view class="chat-area" wx:else style="padding-bottom: {{keyboardHeight > 0 ? keyboardHeight + 120 : 120}}rpx;">
    <!-- 消息列表 -->
    <scroll-view 
      class="message-list" 
      scroll-y 
      scroll-into-view="{{scrollToView}}"
      scroll-with-animation
    >
      <!-- 加载历史中 -->
      <view class="loading-history" wx:if="{{loadingHistory}}">
        <view class="loading-spinner"></view>
        <text>加载历史消息中...</text>
      </view>
      
      <!-- 欢迎消息 -->
      <view class="welcome-msg" wx:if="{{messages.length === 0 && !loadingHistory}}">
        <view class="welcome-icon">👋</view>
        <view class="welcome-title">{{welcomeTitle}}</view>
        <view class="welcome-desc">我可以根据你的成长数据和你聊天哦！</view>
        <view class="quick-questions">
          <view 
            wx:for="{{quickQuestions}}" 
            wx:key="q"
            class="quick-btn" 
            bindtap="quickQuestion" 
            data-q="{{item.q}}"
          >
            {{item.icon}} {{item.label}}
          </view>
        </view>
      </view>

      <!-- 消息列表 -->
      <view 
        wx:for="{{messages}}" 
        wx:key="id"
        class="message-item {{item.role === 'user' ? 'user-msg' : 'ai-msg'}} {{item.isError ? 'error-msg' : ''}}"
        id="msg-{{item.id}}"
        bindlongpress="showMessageActions"
        data-id="{{item.id}}"
        data-role="{{item.role}}"
        data-content="{{item.content}}"
      >
        <view class="msg-avatar" wx:if="{{item.role === 'assistant'}}">
          {{modelInfo.icon}}
        </view>
        <view class="msg-content">
          <!-- 思考过程（可折叠） -->
          <view class="thinking-section" wx:if="{{item.thinking}}">
            <view class="thinking-header" bindtap="toggleThinking" data-id="{{item.id}}">
              <text class="thinking-icon">🧠</text>
              <text class="thinking-title">思考过程</text>
              <text class="thinking-arrow {{item.showThinking ? 'open' : ''}}">›</text>
            </view>
            <view class="thinking-content" wx:if="{{item.showThinking}}">
              {{item.thinking}}
            </view>
          </view>
          <!-- 图片消息（支持多图） -->
          <view class="msg-image-list" wx:if="{{item.images && item.images.length > 0}}">
            <view 
              wx:for="{{item.images}}" 
              wx:key="*this"
              class="msg-image"
              bindtap="previewImage" 
              data-url="{{item}}"
            >
              <image src="{{item}}" mode="widthFix" class="image-preview" />
            </view>
          </view>
          <!-- 兼容旧格式单图 -->
          <view class="msg-image" wx:elif="{{item.image}}" bindtap="previewImage" data-url="{{item.image}}">
            <image src="{{item.image}}" mode="widthFix" class="image-preview" />
          </view>
          <!-- 文本消息 -->
          <view class="msg-text" wx:if="{{item.content && item.role === 'user'}}">{{item.content}}</view>
          <view class="msg-text msg-rich" wx:if="{{item.content && item.role === 'assistant'}}">
            <rich-text nodes="{{item.richText}}" />
          </view>
          <!-- AI朗读按钮 -->
          <view class="speak-btn {{item.isSpeaking ? 'speaking' : ''}}" wx:if="{{item.role === 'assistant' && item.content}}" bindtap="speakMessage" data-id="{{item.id}}" data-content="{{item.content}}">
            <text>{{item.isSpeaking ? '🔊' : '🔈'}}</text>
          </view>
          <!-- 用户消息重新发送按钮 -->
          <view class="msg-retry" wx:if="{{item.isError && item.role === 'user'}}" bindtap="retryMessage" data-id="{{item.id}}">
            <text class="retry-icon">🔄</text>
            <text class="retry-text">重新发送</text>
          </view>
          <view class="msg-time">{{item.timeStr}}</view>
        </view>
        <view class="msg-avatar" wx:if="{{item.role === 'user'}}">
          👦
        </view>
      </view>

      <!-- 加载中 -->
      <view class="message-item ai-msg" wx:if="{{loading}}">
        <view class="msg-avatar">{{modelInfo.icon}}</view>
        <view class="msg-content">
          <view class="thinking-indicator">
            <view class="thinking-dot"></view>
            <view class="thinking-dot"></view>
            <view class="thinking-dot"></view>
            <text class="thinking-text">{{loadingText}}</text>
          </view>
        </view>
      </view>

      <!-- 占位 -->
      <view id="msg-bottom" style="height: 20rpx;"></view>
    </scroll-view>

    <!-- 更多面板（加号展开） -->
    <view class="more-panel" wx:if="{{showMorePanel}}">
      <view class="more-panel-grid">
        <view class="more-panel-item" bindtap="chooseImage">
          <view class="more-panel-icon">🖼️</view>
          <text class="more-panel-label">图片</text>
        </view>
        <view class="more-panel-item" bindtap="showSkillList">
          <view class="more-panel-icon">⚡</view>
          <text class="more-panel-label">技能</text>
        </view>
        <view class="more-panel-item" bindtap="showVoiceSettings">
          <view class="more-panel-icon">🎵</view>
          <text class="more-panel-label">{{currentEngineName}}</text>
          <text class="more-panel-sub" wx:if="{{currentVoiceName}}">{{currentVoiceName}}</text>
        </view>
        <view class="more-panel-item {{streamThinkingEnabled ? 'active' : ''}}" bindtap="toggleStreamThinking">
          <view class="more-panel-icon">🧠</view>
          <text class="more-panel-label">实时思考</text>
        </view>
      </view>
    </view>

    <!-- 表情快捷栏 -->
    <view class="emoji-bar" wx:if="{{showEmojiBar}}">
      <!-- 分类Tab -->
      <scroll-view scroll-x class="emoji-tabs">
        <view 
          wx:for="{{emojiCategoryKeys}}" 
          wx:key="*this"
          class="emoji-tab {{currentEmojiCategory === item ? 'active' : ''}}"
          bindtap="switchEmojiCategory"
          data-category="{{item}}"
        >
          {{emojiCategories[item].name}}
        </view>
      </scroll-view>
      <!-- 表情列表 -->
      <scroll-view scroll-y class="emoji-scroll">
        <view class="emoji-list">
          <view 
            wx:for="{{emojiList}}" 
            wx:key="*this"
            class="emoji-item"
            bindtap="insertEmoji"
            data-emoji="{{item}}"
          >
            {{item}}
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 技能激活状态栏 -->
    <view class="skill-bar" wx:if="{{showSkillBar && activeSkill}}" bindtap="deactivateSkill">
      <view class="skill-bar-content">
        <text class="skill-bar-icon">{{activeSkill.icon}}</text>
        <text class="skill-bar-name">{{activeSkill.name}}</text>
        <text class="skill-bar-hint">点击取消</text>
      </view>
    </view>
    
    <!-- 数据上下文浮窗 -->
    <view class="context-banner" wx:if="{{showContextBanner}}" catchtap="noop">
      <view class="context-banner-header">
        <text class="context-banner-icon">📊</text>
        <text class="context-banner-title">检测到相关数据</text>
        <view class="context-banner-close" bindtap="dismissBanner">✕</view>
      </view>
      <view class="context-banner-items">
        <view wx:for="{{contextBannerItems}}" wx:key="type" class="context-banner-item">
          <text class="context-item-label">{{item.label}}</text>
          <text class="context-item-detail">{{item.detail}}</text>
        </view>
      </view>
      <view class="context-banner-actions">
        <view class="context-btn context-btn-skip" bindtap="skipContext">跳过</view>
        <view class="context-btn context-btn-send" bindtap="confirmSendContext">发送数据</view>
      </view>
    </view>
    
    <!-- 技能搜索结果浮窗 -->
    <view class="skill-search-panel" wx:if="{{showSkillSearch}}">
      <view class="skill-search-header">
        <text class="skill-search-title">搜索技能: {{skillSearchQuery}}</text>
        <view class="skill-search-close" bindtap="closeSkillSearch">✕</view>
      </view>
      <scroll-view scroll-y class="skill-search-list">
        <view wx:if="{{skillSearchResults.length === 0}}" class="skill-search-empty">
          搜索中...
        </view>
        <view 
          wx:for="{{skillSearchResults}}" 
          wx:key="id" 
          class="skill-search-item"
          bindtap="installSkill"
          data-skill="{{item}}"
        >
          <view class="skill-search-item-icon">{{item.icon}}</view>
          <view class="skill-search-item-info">
            <view class="skill-search-item-name">{{item.name}}</view>
            <view class="skill-search-item-desc">{{item.description}}</view>
          </view>
          <view class="skill-search-item-install">安装</view>
        </view>
      </scroll-view>
    </view>
    
    <!-- 输入区域 -->
    <view class="input-area" style="bottom: {{keyboardHeight > 0 ? keyboardHeight + 'px' : '0'}};">
      <!-- 加号按钮 -->
      <view class="action-btn {{showMorePanel ? 'active' : ''}}" bindtap="toggleMorePanel">
        <text>＋</text>
      </view>
      <!-- 表情按钮 -->
      <view class="action-btn {{showEmojiBar ? 'active' : ''}}" bindtap="toggleEmojiBar">
        <text>😊</text>
      </view>
      <!-- 输入框 -->
      <view class="input-wrapper">
        <textarea 
          class="msg-input"
          placeholder="输入消息..."
          value="{{inputValue}}"
          bindinput="onInput"
          bindlinechange="onInputLineChange"
          bindconfirm="sendMessage"
          confirm-type="send"
          disabled="{{loading}}"
          focus="{{inputFocus}}"
          auto-height
          maxlength="2000"
          adjust-position="{{false}}"
          show-confirm-bar="{{false}}"
        />
      </view>
      <!-- 语音/发送按钮 -->
      <view 
        wx:if="{{inputValue.length > 0 || selectedImages.length > 0}}"
        class="send-btn active" 
        bindtap="sendMessage"
      >
        发送
      </view>
      <view 
        wx:else
        class="voice-btn {{isRecording ? 'recording' : ''}}" 
        bindtouchstart="startRecording"
        bindtouchend="stopRecording"
        bindtouchcancel="cancelRecording"
      >
        <text>{{isRecording ? '🎤' : '🎙️'}}</text>
      </view>
    </view>
    
    <!-- 选中的图片预览 -->
    <view class="image-preview-bar" wx:if="{{selectedImages.length > 0}}">
      <scroll-view scroll-x class="image-preview-scroll">
        <view class="image-preview-list">
          <view 
            wx:for="{{selectedImages}}" 
            wx:key="*this"
            class="preview-image-wrapper"
          >
            <image src="{{item}}" mode="aspectFill" class="preview-image" />
            <view class="remove-image" bindtap="removeImage" data-index="{{index}}">✕</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 语音设置弹窗 -->
  <view class="voice-modal" wx:if="{{showVoiceModal}}" bindtap="hideVoiceModal">
    <view class="voice-modal-content" catchtap="stopPropagation">
      <view class="voice-modal-header">
        <text class="voice-modal-title">语音设置</text>
        <view class="voice-modal-close" bindtap="hideVoiceModal">✕</view>
      </view>
      <scroll-view scroll-y class="voice-modal-body">
        <!-- 引擎选择 -->
        <view class="voice-section">
          <view class="voice-section-title">语音引擎</view>
          <view class="voice-engine-list">
            <view 
              wx:for="{{voiceEngineList}}" 
              wx:key="id"
              class="voice-engine-item {{item.active ? 'active' : ''}}"
              bindtap="selectVoiceEngine"
              data-id="{{item.id}}"
            >
              <view class="voice-engine-name">{{item.name}}</view>
              <view class="voice-engine-desc">{{item.desc}}</view>
            </view>
          </view>
        </view>
        <!-- 音色选择 -->
        <view class="voice-section">
          <view class="voice-section-title">音色选择</view>
          <!-- 音色分组Tab（仅百度TTS显示） -->
          <view class="voice-tabs" wx:if="{{currentVoiceEngine === 'baidu'}}">
            <view 
              wx:for="{{voiceGroupTabs}}" 
              wx:key="key"
              class="voice-tab {{currentVoiceGroupTab === item.key ? 'active' : ''}}"
              bindtap="switchVoiceGroupTab"
              data-key="{{item.key}}"
            >
              {{item.name}}
            </view>
          </view>
          <view class="voice-list">
            <view 
              wx:for="{{voiceVoiceList}}" 
              wx:key="id"
              class="voice-item {{item.id === currentVoiceId ? 'active' : ''}}"
              bindtap="selectVoice"
              data-id="{{item.id}}"
            >
              <view class="voice-item-name">{{item.name}}</view>
              <view class="voice-item-desc">{{item.desc}}</view>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 消息操作弹窗 -->
  <view class="action-modal" wx:if="{{showActionModal}}" bindtap="hideMessageActions">
    <view class="action-modal-content" catchtap="stopPropagation">
      <view class="action-modal-header">消息操作</view>
      <view class="action-list">
        <view class="action-item" bindtap="copyMessage" data-content="{{actionMessage.content}}">
          <text class="action-icon">📋</text>
          <text class="action-text">复制</text>
        </view>
        <view class="action-item" bindtap="forwardMessage" data-content="{{actionMessage.content}}">
          <text class="action-icon">📤</text>
          <text class="action-text">转发</text>
        </view>
        <view class="action-item" bindtap="collectMessage" data-id="{{actionMessage.id}}" data-content="{{actionMessage.content}}">
          <text class="action-icon">⭐</text>
          <text class="action-text">收藏</text>
        </view>
        <view class="action-item" wx:if="{{actionMessage.role === 'assistant'}}" bindtap="speakMessage" data-content="{{actionMessage.content}}">
          <text class="action-icon">🔊</text>
          <text class="action-text">朗读</text>
        </view>
        <view class="action-item" wx:if="{{actionMessage.role === 'user'}}" bindtap="resendMessage" data-content="{{actionMessage.content}}" data-image="{{actionMessage.image}}">
          <text class="action-icon">🔄</text>
          <text class="action-text">重新发送</text>
        </view>
        <view class="action-item delete" bindtap="deleteMessage" data-id="{{actionMessage.id}}">
          <text class="action-icon">🗑️</text>
          <text class="action-text">删除</text>
        </view>
      </view>
      <view class="action-cancel" bindtap="hideMessageActions">取消</view>
    </view>
  </view>

  <!-- 会话列表弹窗 -->
  <view class="session-modal" wx:if="{{showSessionModal}}" bindtap="hideSessions">
    <view class="session-modal-content" catchtap="stopPropagation">
      <view class="session-modal-header">
        <text class="session-modal-title">历史会话</text>
        <view class="session-modal-close" bindtap="hideSessions">✕</view>
      </view>
      
      <!-- 搜索框 -->
      <view class="session-search">
        <view class="search-wrapper">
          <text class="search-icon">🔍</text>
          <input 
            class="search-input"
            placeholder="搜索会话..."
            value="{{searchKeyword}}"
            bindinput="onSearchInput"
          />
          <view class="search-clear" wx:if="{{searchKeyword}}" bindtap="clearSearch">✕</view>
        </view>
      </view>
      
      <!-- 统计信息 -->
      <view class="session-stats">
        <view class="stat-item">
          <text class="stat-value">{{totalSessions}}</text>
          <text class="stat-label">会话</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{totalMessages}}</text>
          <text class="stat-label">消息</text>
        </view>
        <view class="stat-item">
          <text class="stat-value">{{totalTokens}}</text>
          <text class="stat-label">Tokens</text>
        </view>
      </view>
      
      <!-- 会话列表 -->
      <scroll-view 
        class="session-list" 
        scroll-y
        bindscrolltolower="loadMoreSessions"
      >
        <view 
          wx:for="{{filteredSessions}}" 
          wx:key="sessionId"
          class="session-item {{currentSessionId === item.sessionId ? 'active' : ''}}"
          bindtap="switchSession"
          data-id="{{item.sessionId}}"
        >
          <view class="session-info">
            <view class="session-preview">{{item.lastMessage}}</view>
            <view class="session-detail">
              <view class="session-meta">
                <text class="session-model">{{item.modelName}}</text>
                <text class="session-count">{{item.messageCount}}条</text>
              </view>
              <view class="session-usage">
                <text class="session-tokens" wx:if="{{item.totalTokens}}">🔤 {{item.totalTokens}}</text>
                <text class="session-time">{{item.timeStr}}</text>
              </view>
            </view>
          </view>
          <view class="session-delete" catchtap="deleteSession" data-id="{{item.sessionId}}">🗑️</view>
        </view>
        
        <!-- 加载更多 -->
        <view class="load-more" wx:if="{{hasMoreSessions}}" bindtap="loadMoreSessions">
          {{loadingSessions ? '加载中...' : '加载更多'}}
        </view>
        
        <!-- 空状态 -->
        <view class="session-empty" wx:if="{{filteredSessions.length === 0}}">
          <text wx:if="{{searchKeyword}}">未找到匹配的会话</text>
          <text wx:else>暂无历史会话</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 技能列表弹窗 -->
  <view class="skill-modal" wx:if="{{showSkillModal}}" bindtap="hideSkillList">
    <view class="skill-modal-content" catchtap="stopPropagation">
      <view class="skill-modal-header">
        <text class="skill-modal-title">技能管理</text>
        <view class="skill-modal-close" bindtap="hideSkillList">✕</view>
      </view>

      <!-- 搜索框 -->
      <view class="skill-search-bar">
        <text class="skill-search-icon">🔍</text>
        <input class="skill-search-input" placeholder="搜索技能..." value="{{skillFilterKeyword}}" bindinput="onSkillFilterInput" />
        <view class="skill-search-clear" wx:if="{{skillFilterKeyword}}" bindtap="clearSkillFilter">✕</view>
      </view>
      
      <!-- 操作按钮 -->
      <view class="skill-modal-actions">
        <view class="skill-action-btn" bindtap="importSkill">
          <text>📁 导入技能</text>
        </view>
      </view>
      
      <!-- Tab切换 -->
      <view class="skill-tabs">
        <view 
          class="skill-tab {{skillActiveTab === 'all' ? 'active' : ''}}" 
          bindtap="switchSkillTab" 
          data-tab="all"
        >
          全部
        </view>
        <view 
          wx:for="{{skillCategories}}" 
          wx:key="id"
          class="skill-tab {{skillActiveTab === item.id ? 'active' : ''}}" 
          bindtap="switchSkillTab" 
          data-tab="{{item.id}}"
        >
          {{item.icon}} {{item.name}}
        </view>
      </view>
      
      <!-- 技能列表 -->
      <scroll-view scroll-y class="skill-list">
        <!-- 全部分类显示 -->
        <block wx:if="{{skillActiveTab === 'all'}}">
          <view wx:for="{{skillGrouped}}" wx:key="category" wx:for-item="group" class="skill-group">
            <view class="skill-group-header">
              <text class="skill-group-icon">{{group.category.icon}}</text>
              <text class="skill-group-name">{{group.category.name}}</text>
              <text class="skill-group-count">{{group.skills.length}}</text>
            </view>
            <view 
              wx:for="{{group.skills}}" 
              wx:for-item="item"
              wx:key="id"
              class="skill-item {{activeSkill.id === item.id ? 'active' : ''}}"
            >
              <view class="skill-item-main" bindtap="selectSkill" data-id="{{item.id}}">
                <view class="skill-item-icon">{{item.icon}}</view>
                <view class="skill-item-info">
                  <view class="skill-item-name">
                    {{item.name}}
                    <view class="skill-source-tag" style="background: {{item.source === 'builtin' ? '#4CAF50' : item.source === 'custom' ? '#2196F3' : item.source === 'network' ? '#FF9800' : '#9C27B0'}}">
                      {{item.source === 'builtin' ? '内置' : item.source === 'custom' ? '自定义' : item.source === 'network' ? '网络' : '导入'}}
                    </view>
                  </view>
                  <view class="skill-item-desc">{{item.description}}</view>
                </view>
              </view>
              <view class="skill-item-actions">
                <view 
                  wx:if="{{item.source !== 'builtin'}}"
                  class="skill-delete-btn" 
                  catchtap="deleteSkill" 
                  data-id="{{item.id}}"
                >🗑️</view>
              </view>
            </view>
          </view>
        </block>
        
        <!-- 单个分类显示 -->
        <block wx:else>
          <view 
            wx:for="{{filteredSkillList}}" 
            wx:key="id"
            class="skill-item {{activeSkill.id === item.id ? 'active' : ''}}"
          >
            <view class="skill-item-main" bindtap="selectSkill" data-id="{{item.id}}">
              <view class="skill-item-icon">{{item.icon}}</view>
              <view class="skill-item-info">
                <view class="skill-item-name">
                  {{item.name}}
                  <view class="skill-source-tag" style="background: {{item.source === 'builtin' ? '#4CAF50' : item.source === 'custom' ? '#2196F3' : item.source === 'network' ? '#FF9800' : '#9C27B0'}}">
                    {{item.source === 'builtin' ? '内置' : item.source === 'custom' ? '自定义' : item.source === 'network' ? '网络' : '导入'}}
                  </view>
                </view>
                <view class="skill-item-desc">{{item.description}}</view>
              </view>
            </view>
            <view class="skill-item-actions">
              <view 
                wx:if="{{item.source !== 'builtin'}}"
                class="skill-delete-btn" 
                catchtap="deleteSkill" 
                data-id="{{item.id}}"
              >🗑️</view>
            </view>
          </view>
        </block>
        
        <!-- 空状态 -->
        <view class="skill-empty" wx:if="{{skillActiveTab === 'all' ? skillGrouped.length === 0 : filteredSkillList.length === 0}}">
          <text wx:if="{{skillFilterKeyword}}">未找到匹配的技能</text>
          <text wx:else>暂无技能</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
