.container {
  min-height: 100vh;
  background: #FFF5F5;
}

.header {
  padding: 0 32rpx 32rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.header-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 40rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.stats-bar {
  display: flex;
  justify-content: center;
  padding: 24rpx;
  margin: 24rpx 32rpx 0;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.stats-text {
  font-size: 28rpx;
  color: #666;
}

.stats-num {
  font-size: 36rpx;
  font-weight: bold;
  color: #FF9800;
  margin: 0 8rpx;
}

.menu-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding: 32rpx;
}

.menu-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 16rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  transition: all 0.2s;
}

.menu-item:active {
  transform: scale(0.96);
}

.menu-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.menu-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.menu-desc {
  font-size: 22rpx;
  color: #999;
  text-align: center;
}
