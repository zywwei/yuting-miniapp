<view class="container">
  <!-- 漂移白云 -->
  <view class="clouds-container">
    <view class="cloud cloud-1">☁️</view>
    <view class="cloud cloud-2">☁️</view>
    <view class="cloud cloud-3">☁️</view>
  </view>
  
  <view class="header">
    <view class="header-bg"></view>
    <!-- 聚光灯效果 -->
    <view class="spotlight spotlight-left"></view>
    <view class="spotlight spotlight-right"></view>
    <!-- 漂浮星星 -->
    <view class="floating-stars">
      <text class="star star-1">✨</text>
      <text class="star star-2">✨</text>
      <text class="star star-3">✨</text>
    </view>
    <view class="header-content">
      <!-- 三拳小图标横排 -->
      <view class="rps-icons">
        <image class="rps-badge" src="/packageCreate/images/rps/rock.jpg" mode="aspectFit"/>
        <image class="rps-badge" src="/packageCreate/images/rps/scissors.jpg" mode="aspectFit"/>
        <image class="rps-badge" src="/packageCreate/images/rps/paper.jpg" mode="aspectFit"/>
      </view>
      <view class="header-title">猜拳大战</view>
      <view class="header-desc">剪刀石头布，智慧与运气的较量</view>
    </view>
    <view class="sound-toggle" bindtap="toggleSound">
      <text class="sound-icon">{{soundEnabled ? '🔊' : '🔇'}}</text>
    </view>
    <view class="stats-bar">
      <view class="stat-item">
        <text class="stat-value">{{totalGames}}</text>
        <text class="stat-label">总对战</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{winRate}}%</text>
        <text class="stat-label">胜率</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{bestStreak}}</text>
        <text class="stat-label">最佳连胜</text>
      </view>
    </view>
  </view>

  <view class="mode-grid">
    <view class="mode-card classic-card" bindtap="goClassic">
      <view class="mode-icon">🎮</view>
      <view class="mode-info">
        <view class="mode-title">经典对战</view>
        <view class="mode-desc">三局两胜，一决高下</view>
      </view>
      <view class="mode-arrow">›</view>
    </view>

    <view class="mode-card challenge-card" bindtap="goChallenge">
      <view class="mode-icon">🏆</view>
      <view class="mode-info">
        <view class="mode-title">闯关挑战</view>
        <view class="mode-desc">10关难度递增，挑战极限</view>
      </view>
      <view class="mode-arrow">›</view>
    </view>

    <view class="mode-card story-card" bindtap="goStory">
      <view class="mode-icon">⚔️</view>
      <view class="mode-info">
        <view class="mode-title">故事冒险</view>
        <view class="mode-desc">7章奇幻剧情，勇者之路</view>
      </view>
      <view class="mode-arrow">›</view>
    </view>

    <view class="mode-card tournament-card" bindtap="goTournament">
      <view class="mode-icon">🏅</view>
      <view class="mode-info">
        <view class="mode-title">锦标赛</view>
        <view class="mode-desc">家庭淘汰赛，谁是冠军</view>
      </view>
      <view class="mode-arrow">›</view>
    </view>
  </view>

  <view class="recent-section" wx:if="{{recentRecords.length > 0}}">
    <view class="section-title">最近战绩</view>
    <view class="record-list">
      <view class="record-item" wx:for="{{recentRecords}}" wx:key="id">
        <view class="record-mode">{{item.mode === 'classic' ? '经典' : item.mode === 'challenge' ? '闯关' : item.mode === 'story' ? '故事' : '锦标赛'}}</view>
        <view class="record-result {{item.result}}">{{item.result === 'win' ? '胜' : item.result === 'lose' ? '负' : '平'}}</view>
        <view class="record-score">{{item.score}}</view>
      </view>
    </view>
  </view>
</view>
