/* ===== 设计Token（猜拳竞技场主题） ===== */
/* 小程序页面根节点是 page，:root 无效；page+.container 双选择器确保变量生效 */
page,
.container {
  /* 主色板（与全局亲子粉衔接并提亮） */
  --rps-primary:      #FF6B8A;   /* 主粉：主按钮、标题强调 */
  --rps-primary-deep: #E8527A;   /* 深粉：渐变末端、按压态 */
  --rps-gold:         #FFB830;   /* 金色：胜利、奖杯、连胜 */
  --rps-ink:          #3A2E4D;   /* 主文字：深紫灰（替代纯黑#333，更柔和） */
  --rps-ink-light:    #8A7FA0;   /* 次要文字 */

  /* 三拳专属色（增强识别，全模块统一） */
  --rps-rock:     #FF9F43;  /* 石头：暖橙（与手势徽章同色） */
  --rps-scissors: #FF6B8A;  /* 剪刀：蜜桃粉（与手势徽章同色） */
  --rps-paper:    #4FC3F7;  /* 布：天空蓝（与手势徽章同色） */

  /* 结果色 */
  --rps-win:  #4CAF6D;   /* 胜：青绿 */
  --rps-lose: #FF5A5A;   /* 负：珊瑚红 */
  --rps-draw: #FFB830;   /* 平：金 */

  /* 背景（柔和蜜桃粉单色渐变，与全局亲子粉衔接） */
  --rps-bg: linear-gradient(180deg, #FFF4F7 0%, #FFE9F0 100%);

  /* 卡片与阴影（立体糖果感） */
  --rps-card-bg:    #FFFFFF;
  --rps-radius-lg:  32rpx;
  --rps-radius-md:  24rpx;
  --rps-shadow-1:   0 6rpx 20rpx rgba(58, 46, 77, 0.08);           /* 悬浮卡 */
  --rps-shadow-2:   0 12rpx 32rpx rgba(58, 46, 77, 0.12);          /* 强调卡 */
  --rps-border:     3rpx solid rgba(58, 46, 77, 0.06);             /* 柔边 */

  /* 立体按钮（街机感：顶面 + 底部厚度条） */
  --rps-btn-depth:  8rpx;   /* 按钮底部厚度，按压时压缩为 2rpx */

  /* 字号层级 */
  --rps-fs-hero:   64rpx;  /* 页面主标题 / 大比分 */
  --rps-fs-title:  40rpx;  /* 区块标题 */
  --rps-fs-body:   30rpx;  /* 正文 */
  --rps-fs-aux:    24rpx;  /* 辅助说明 */
}

.container {
  min-height: 100vh;
  background: var(--rps-bg);
  padding: 32rpx;
}

/* 菜单阶段 */
.phase-menu {
  text-align: center;
  padding-top: 60rpx;
}

.header {
  margin-bottom: 48rpx;
  animation: headerFadeIn 0.6s ease-out;
}

@keyframes headerFadeIn {
  0% { transform: translateY(-30rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.header-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
  animation: iconBounce 0.6s ease-out;
}

@keyframes iconBounce {
  0% { transform: scale(0.6); opacity: 0; }
  60% { transform: scale(1.1); }
  100% { transform: scale(1); opacity: 1; }
}

.header-title {
  font-size: var(--rps-fs-hero);
  font-weight: bold;
  color: var(--rps-primary-deep);
  margin-bottom: 8rpx;
  text-shadow: 0 3rpx 6rpx rgba(232, 82, 122, 0.25);
}

.header-desc {
  font-size: var(--rps-fs-aux);
  color: var(--rps-ink-light);
}

.progress-info {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 48rpx;
  animation: progressInfoFadeIn 0.6s ease-out 0.2s both;
}

@keyframes progressInfoFadeIn {
  0% { transform: translateY(20rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--rps-card-bg);
  padding: 24rpx 32rpx;
  border-radius: var(--rps-radius-md);
  box-shadow: var(--rps-shadow-1);
  border: var(--rps-border);
  flex: 1;
  max-width: 160rpx;
}

.info-label {
  font-size: var(--rps-fs-aux);
  color: var(--rps-ink-light);
  margin-bottom: 8rpx;
  font-weight: 500;
}

.info-value {
  font-size: var(--rps-fs-title);
  font-weight: bold;
  color: var(--rps-primary-deep);
}

/* 冒险地图路径 */
.adventure-map {
  margin: 32rpx 0;
  animation: mapFadeIn 0.6s ease-out 0.4s both;
}

@keyframes mapFadeIn {
  0% { transform: translateY(20rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.map-path {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx;
  background: var(--rps-card-bg);
  border-radius: var(--rps-radius-lg);
  box-shadow: var(--rps-shadow-1);
  border: var(--rps-border);
}

.map-node {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.node-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.3s ease;
}

/* 已通关 - 金色 */
.map-node.completed .node-circle {
  background: linear-gradient(135deg, var(--rps-gold) 0%, #F0951A 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 184, 48, 0.4);
}

/* 当前关卡 - 粉色脉冲 */
.map-node.current .node-circle {
  background: linear-gradient(135deg, var(--rps-primary) 0%, var(--rps-primary-deep) 100%);
  box-shadow: 0 0 0 4rpx rgba(255, 107, 138, 0.3), 0 4rpx 12rpx rgba(255, 107, 138, 0.4);
  animation: currentNodePulse 2s ease-in-out infinite;
}

@keyframes currentNodePulse {
  0%, 100% { box-shadow: 0 0 0 4rpx rgba(255, 107, 138, 0.3), 0 4rpx 12rpx rgba(255, 107, 138, 0.4); }
  50% { box-shadow: 0 0 0 8rpx rgba(255, 107, 138, 0.2), 0 4rpx 12rpx rgba(255, 107, 138, 0.4); }
}

/* 未解锁 - 灰色 */
.map-node.locked .node-circle {
  background: rgba(58, 46, 77, 0.1);
  border: 2rpx dashed rgba(58, 46, 77, 0.2);
}

.node-icon {
  font-size: 28rpx;
  margin-bottom: 2rpx;
}

.node-num {
  font-size: 20rpx;
  font-weight: bold;
  color: #fff;
}

.map-node.locked .node-num {
  color: var(--rps-ink-light);
}

/* 连接线 */
.node-line {
  width: 16rpx;
  height: 4rpx;
  background: rgba(255, 184, 48, 0.3);
  border-radius: 2rpx;
}

.map-node.completed .node-line {
  background: var(--rps-gold);
}

.start-btn {
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, var(--rps-gold) 0%, #F0951A 100%);
  color: #fff;
  border-radius: 28rpx;
  font-size: var(--rps-fs-body);
  font-weight: bold;
  display: inline-block;
  box-shadow: 0 8rpx 24rpx rgba(255, 184, 48, 0.4);
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  animation: startBtnFadeIn 0.6s ease-out 0.3s both;
}

@keyframes startBtnFadeIn {
  0% { transform: translateY(20rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

/* 立体按钮厚度 */
.start-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: var(--rps-btn-depth);
  background: rgba(0, 0, 0, 0.15);
  border-radius: 28rpx 28rpx 0 0;
}

.start-btn:active {
  transform: translateY(6rpx);
  box-shadow: 0 2rpx 8rpx rgba(255, 184, 48, 0.3);
}

.start-btn:active::before {
  height: 2rpx;
}

.reset-btn {
  margin-top: 24rpx;
  font-size: var(--rps-fs-aux);
  color: var(--rps-ink-light);
  transition: color 0.2s ease;
}

.reset-btn:active {
  color: var(--rps-primary);
}

.back-btn {
  margin-top: 24rpx;
  font-size: var(--rps-fs-aux);
  color: var(--rps-ink-light);
  transition: color 0.2s ease;
}

.back-btn:active {
  color: var(--rps-primary);
}

/* 游戏阶段 */
/* 对战阶段：全屏弹性布局，头部在顶、出拳区撑满中部、按钮贴底 */
.phase-playing {
  display: flex;
  flex-direction: column;
  min-height: calc(100vh - 64rpx); /* 减去 container 上下 padding，保证满屏不溢出 */
  box-sizing: border-box;
  padding-top: 20rpx;
}

.level-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  animation: levelHeaderFadeIn 0.5s ease-out;
}

@keyframes levelHeaderFadeIn {
  0% { transform: translateY(-20rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.level-num {
  font-size: var(--rps-fs-title);
  font-weight: bold;
  color: var(--rps-primary-deep);
  text-shadow: 0 2rpx 4rpx rgba(255, 107, 138, 0.3);
}

.level-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.level-wins {
  font-size: var(--rps-fs-aux);
  color: var(--rps-primary-deep);
  background: rgba(255, 107, 138, 0.12);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 107, 138, 0.3);
}

.level-lives {
  font-size: 28rpx;
}

/* 比分板 */
.scoreboard {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--rps-primary) 0%, var(--rps-primary-deep) 100%);
  padding: 24rpx;
  border-radius: var(--rps-radius-lg);
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(232, 82, 122, 0.35);
  position: relative;
  overflow: hidden;
}

@keyframes scoreboardSlideIn {
  0% { transform: translateY(-30rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

/* 记分牌光泽效果 */
.scoreboard::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
  animation: scoreboardShine 3s ease-in-out infinite;
}

@keyframes scoreboardShine {
  0% { left: -100%; }
  50% { left: 100%; }
  100% { left: 100%; }
}

.score-side {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: var(--rps-radius-md);
  background: rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
}

.score-side.score-win {
  background: rgba(255, 184, 48, 0.2);
}

.score-label {
  font-size: var(--rps-fs-aux);
  color: #fff;
  margin-bottom: 8rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.3);
}

.score-value {
  font-size: var(--rps-fs-hero);
  font-weight: bold;
  color: var(--rps-gold);
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.score-divider {
  font-size: var(--rps-fs-body);
  font-weight: bold;
  color: var(--rps-gold);
  padding: 0 24rpx;
  background: rgba(255, 184, 48, 0.2);
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 184, 48, 0.4);
}

/* 中部弹性区：出拳手势 + 回合结果横幅作为整体垂直居中，横幅紧跟手势下方 */
.battle-zone {
  flex: 1;               /* 占据中部剩余空间；内容多时自动收缩，避免撑出滚动 */
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 0;
}

/* 出拳区域 */
.battle-area {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;  /* 手势与回合结果横幅的间距 */
  position: relative;
}

.player-side {
  text-align: center;
  position: relative;
}

.player-choice {
  width: 220rpx;
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--rps-card-bg);
  border-radius: 50%;
  box-shadow: var(--rps-shadow-2);
  margin-bottom: 12rpx;
  transition: all 0.3s ease;
  position: relative;
  z-index: 2;
}

/* 我方玩家光环 */
.player-side:first-child .player-choice {
  box-shadow: 0 0 0 8rpx rgba(255, 107, 138, 0.3), var(--rps-shadow-2);
}

/* 对方玩家光环 */
.player-side:last-child .player-choice {
  box-shadow: 0 0 0 8rpx rgba(79, 195, 247, 0.3), var(--rps-shadow-2);
}

/* 对撞动画 - 我方从左侧冲向中央 */
.player-side:first-child .player-choice.animating {
  animation: player1Collide 0.6s ease-out;
}

@keyframes player1Collide {
  0% { transform: translateX(-40vw); }
  40% { transform: translateX(0); }
  60% { transform: translateX(-8rpx); }
  80% { transform: translateX(4rpx); }
  100% { transform: translateX(0); }
}

/* 对撞动画 - 对方从右侧冲向中央 */
.player-side:last-child .player-choice.animating {
  animation: player2Collide 0.6s ease-out;
}

@keyframes player2Collide {
  0% { transform: translateX(40vw); }
  40% { transform: translateX(0); }
  60% { transform: translateX(8rpx); }
  80% { transform: translateX(-4rpx); }
  100% { transform: translateX(0); }
}

/* 胜方金环脉冲 */
.player-choice.winner {
  border-color: var(--rps-win);
  box-shadow: 0 0 0 8rpx rgba(76, 175, 109, 0.4), 0 0 40rpx rgba(255, 184, 48, 0.6);
  animation: winnerGlow 0.5s ease-in-out;
}

@keyframes winnerGlow {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

/* 负方灰化下沉 */
.player-choice.loser {
  border-color: var(--rps-lose);
  opacity: 0.6;
  transform: scale(0.95);
  filter: grayscale(0.3);
}

.player-name {
  font-size: var(--rps-fs-aux);
  color: var(--rps-ink);
  font-weight: bold;
}

.vs-icon-container {
  margin: 0 32rpx;
  position: relative;
  z-index: 3;
}

.vs-icon {
  font-size: 48rpx;
  margin: 0 24rpx;
  color: var(--rps-primary);
  transition: all 0.3s ease;
}

.vs-icon.vs-animate {
  animation: vsPulse 0.6s ease-out;
}

@keyframes vsPulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

/* 冲击波效果 */
.battle-area::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  opacity: 0;
  z-index: 1;
  pointer-events: none;
}

.battle-area.shockwave::after {
  animation: shockwave 0.5s ease-out;
}

@keyframes shockwave {
  0% { transform: translate(-50%, -50%) scale(0); opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(2.5); opacity: 0; }
}

/* 回合结果 */
.round-result {
  text-align: center;
  margin-bottom: 0;      /* 位于 battle-zone 内，间距由 battle-area 的 margin 控制 */
  animation: bounceIn 0.4s ease-out;
}

@keyframes bounceIn {
  0% { transform: scale(0.6); opacity: 0; }
  60% { transform: scale(1.05); }
  100% { transform: scale(1); opacity: 1; }
}

.result-badge {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  background: var(--rps-card-bg);
  box-shadow: var(--rps-shadow-2);
  position: relative;
  overflow: hidden;
}

/* 胜利 - 金色横幅 */
.result-badge.win {
  background: linear-gradient(135deg, var(--rps-gold) 0%, #F0951A 100%);
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 失败 - 珊瑚红横幅 */
.result-badge.lose {
  background: linear-gradient(135deg, var(--rps-lose) 0%, #E04848 100%);
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 平局 - 紫灰横幅（中性色，取自墨色系） */
.result-badge.draw {
  background: linear-gradient(135deg, #9A8FB0 0%, #7A6F92 100%);
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 横幅光泽效果 */
.result-badge::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  animation: badgeShine 0.6s ease-out 0.2s;
}

@keyframes badgeShine {
  0% { left: -100%; }
  100% { left: 100%; }
}

.result-icon {
  font-size: 36rpx;
}

.result-text {
  font-size: var(--rps-fs-body);
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 选择按钮 */
.choice-buttons {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 32rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); /* 适配全面屏底部安全区 */
}

.choice-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.choice-btn-inner {
  width: 168rpx;
  height: 168rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

/* 石头按钮 - 岩蓝灰 */
.choice-btn:nth-child(1) .choice-btn-inner {
  background: linear-gradient(135deg, var(--rps-rock) 0%, #E8720C 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 159, 67, 0.45);
}

/* 剪刀按钮 - 青碧 */
.choice-btn:nth-child(2) .choice-btn-inner {
  background: linear-gradient(135deg, var(--rps-scissors) 0%, #E8436E 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 138, 0.45);
}

/* 布按钮 - 暖橙 */
.choice-btn:nth-child(3) .choice-btn-inner {
  background: linear-gradient(135deg, var(--rps-paper) 0%, #3D9BE0 100%);
  box-shadow: 0 8rpx 24rpx rgba(79, 195, 247, 0.45);
}

/* 顶部径向高光模拟立体感 */
.choice-btn-inner::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 30%;
  background: radial-gradient(ellipse at center top, rgba(255, 255, 255, 0.25) 0%, transparent 70%);
  pointer-events: none;
}

/* 底部厚度条 */
.choice-btn-inner::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: var(--rps-btn-depth);
  background: rgba(0, 0, 0, 0.2);
  border-radius: 0 0 32rpx 32rpx;
}

/* 呼吸浮动动画 */
.choice-btn:nth-child(1) .choice-btn-inner {
  animation: btnFloat1 3s ease-in-out infinite;
}

.choice-btn:nth-child(2) .choice-btn-inner {
  animation: btnFloat2 3s ease-in-out infinite;
  animation-delay: 0.4s;
}

.choice-btn:nth-child(3) .choice-btn-inner {
  animation: btnFloat3 3s ease-in-out infinite;
  animation-delay: 0.8s;
}

@keyframes btnFloat1 {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

@keyframes btnFloat2 {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

@keyframes btnFloat3 {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

/* 按压效果 */
.choice-btn:active .choice-btn-inner {
  transform: translateY(6rpx);
  animation: none;
}

.choice-btn:active .choice-btn-inner::after {
  height: 2rpx;
}

/* 手势标签：位于浅色页面上，需用深色文字保证可读性 */
.choice-btn-text {
  font-size: var(--rps-fs-aux);
  color: var(--rps-ink);
  font-weight: bold;
  background: rgba(58, 46, 77, 0.05);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(58, 46, 77, 0.12);
}

/* 三拳标签配色：深色调文字 + 同色系浅底，与上方按钮呼应 */
.choice-btn:nth-child(1) .choice-btn-text {
  color: #B85C06;
  background: rgba(255, 159, 67, 0.15);
  border-color: rgba(255, 159, 67, 0.5);
}

.choice-btn:nth-child(2) .choice-btn-text {
  color: #C93058;
  background: rgba(255, 107, 138, 0.13);
  border-color: rgba(255, 107, 138, 0.5);
}

.choice-btn:nth-child(3) .choice-btn-text {
  color: #1A72A4;
  background: rgba(79, 195, 247, 0.16);
  border-color: rgba(79, 195, 247, 0.6);
}

/* 关卡完成 */
.phase-levelComplete {
  text-align: center;
  padding-top: 80rpx;
}

.complete-container {
  background: var(--rps-card-bg);
  padding: 48rpx;
  border-radius: var(--rps-radius-lg);
  box-shadow: var(--rps-shadow-2);
  animation: fadeInUp 0.5s ease-out;
  position: relative;
  overflow: hidden;
}

@keyframes fadeInUp {
  from { transform: translateY(30rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

/* 领奖台效果 */
.complete-container::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(180deg, transparent, rgba(255, 184, 48, 0.1));
  pointer-events: none;
}

.complete-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  animation: trophyWobble 1.2s ease-in-out 2;
}

@keyframes trophyWobble {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-8deg); }
  75% { transform: rotate(8deg); }
}

.complete-title {
  font-size: var(--rps-fs-hero);
  font-weight: bold;
  color: var(--rps-primary-deep);
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 8rpx rgba(255, 107, 138, 0.3);
}

.complete-desc {
  font-size: var(--rps-fs-aux);
  color: var(--rps-ink-light);
  margin-bottom: 24rpx;
}

.complete-reward {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, var(--rps-gold) 0%, #F0951A 100%);
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  box-shadow: 0 4rpx 12rpx rgba(255, 184, 48, 0.3);
}

.reward-icon {
  font-size: 32rpx;
}

.reward-text {
  font-size: var(--rps-fs-aux);
  font-weight: bold;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.15);
}

.next-btn {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, var(--rps-gold) 0%, #F0951A 100%);
  color: #fff;
  border-radius: 28rpx;
  font-size: var(--rps-fs-body);
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(255, 184, 48, 0.4);
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

/* 立体按钮厚度 */
.next-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: var(--rps-btn-depth);
  background: rgba(0, 0, 0, 0.15);
  border-radius: 28rpx 28rpx 0 0;
}

.next-btn:active {
  transform: translateY(6rpx);
  box-shadow: 0 2rpx 8rpx rgba(255, 184, 48, 0.3);
}

.next-btn:active::before {
  height: 2rpx;
}

.btn-text {
  font-size: var(--rps-fs-body);
}

.btn-icon {
  font-size: 28rpx;
}

/* 游戏结束 */
.phase-gameOver {
  text-align: center;
  padding-top: 80rpx;
}

.gameover-container {
  background: var(--rps-card-bg);
  padding: 48rpx;
  border-radius: var(--rps-radius-lg);
  box-shadow: var(--rps-shadow-2);
  animation: fadeInUp 0.5s ease-out;
}

.gameover-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  animation: sadBounce 0.6s ease-out;
}

@keyframes sadBounce {
  0% { transform: scale(0.6); opacity: 0; }
  60% { transform: scale(1.1); }
  100% { transform: scale(1); opacity: 1; }
}

.gameover-title {
  font-size: var(--rps-fs-hero);
  font-weight: bold;
  color: var(--rps-lose);
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 8rpx rgba(255, 90, 90, 0.3);
}

.gameover-desc {
  font-size: var(--rps-fs-aux);
  color: var(--rps-ink-light);
  margin-bottom: 32rpx;
}

.gameover-stats {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 32rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--rps-card-bg);
  padding: 24rpx 32rpx;
  border-radius: var(--rps-radius-md);
  box-shadow: var(--rps-shadow-1);
  border: var(--rps-border);
  flex: 1;
  max-width: 160rpx;
}

.stat-label {
  font-size: var(--rps-fs-aux);
  color: var(--rps-ink-light);
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: var(--rps-fs-title);
  font-weight: bold;
  color: var(--rps-primary-deep);
}

.gameover-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, var(--rps-gold) 0%, #F0951A 100%);
  color: #fff;
  border-radius: 28rpx;
  font-size: var(--rps-fs-aux);
  font-weight: bold;
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  box-shadow: 0 8rpx 24rpx rgba(255, 184, 48, 0.4);
}

/* 立体按钮厚度 */
.action-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: var(--rps-btn-depth);
  background: rgba(0, 0, 0, 0.15);
  border-radius: 28rpx 28rpx 0 0;
}

.action-btn.secondary {
  background: var(--rps-card-bg);
  color: var(--rps-ink);
  box-shadow: var(--rps-shadow-1);
  border: var(--rps-border);
}

.action-btn:active {
  transform: translateY(6rpx);
  box-shadow: 0 2rpx 8rpx rgba(255, 184, 48, 0.3);
}

.action-btn:active::before {
  height: 2rpx;
}

/* 星级统计 */
.complete-stars {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 32rpx;
}

.stars-label {
  font-size: var(--rps-fs-aux);
  color: var(--rps-ink-light);
}

.stars-value {
  font-size: var(--rps-fs-body);
  font-weight: bold;
  color: var(--rps-primary-deep);
}

/* 撒花效果 - 双层彩带 */
.confetti-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 100;
  overflow: hidden;
}

/* 前排大彩带 - 快速下落 */
.confetti {
  position: absolute;
  font-size: 48rpx;
  animation: confettiFall 1.2s ease-out forwards;
}

.confetti-1 { left: 10%; animation-delay: 0s; }
.confetti-2 { left: 30%; animation-delay: 0.2s; }
.confetti-3 { left: 50%; animation-delay: 0.4s; }
.confetti-4 { left: 70%; animation-delay: 0.1s; }
.confetti-5 { left: 85%; animation-delay: 0.3s; }
.confetti-6 { left: 45%; animation-delay: 0.5s; }

@keyframes confettiFall {
  0% { top: -10%; opacity: 1; transform: rotate(0deg); }
  100% { top: 110%; opacity: 0; transform: rotate(720deg); }
}

/* 后排小彩带 - 慢速下落 */
.confetti-container::before {
  content: '✨✨✨✨✨✨';
  position: absolute;
  top: -20%;
  left: 0;
  right: 0;
  font-size: 24rpx;
  letter-spacing: 20rpx;
  text-align: center;
  animation: confettiSlow 2s ease-out 0.5s forwards;
  opacity: 0;
}

@keyframes confettiSlow {
  0% {
    top: -20%;
    opacity: 0;
    transform: rotate(0deg);
  }
  20% {
    opacity: 0.8;
  }
  100% {
    top: 100%;
    opacity: 0;
    transform: rotate(180deg);
  }
}

/* 顶部中央彩带喷射源点 */
.confetti-container::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 20rpx;
  background: radial-gradient(circle, rgba(255, 184, 48, 0.8) 0%, transparent 70%);
  animation: confettiSource 0.3s ease-out;
}

@keyframes confettiSource {
  0% { transform: translateX(-50%) scale(0); opacity: 0; }
  50% { transform: translateX(-50%) scale(3); opacity: 1; }
  100% { transform: translateX(-50%) scale(1); opacity: 0; }
}

/* ===== 手势图片（AI 卡通徽章图） ===== */
.choice-img {
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
}

.choice-btn-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  position: relative;
  z-index: 1;
}

/* 胜方手势弹跳 */
.player-choice.winner .choice-img {
  animation: gesturePop 0.45s ease-out;
}

@keyframes gesturePop {
  0% { transform: scale(0.7) rotate(-8deg); }
  55% { transform: scale(1.15) rotate(4deg); }
  100% { transform: scale(1) rotate(0); }
}

/* ===== 克制对决动画（石头砸剪刀 / 剪刀剪布 / 布包石头） ===== */

/* 攻击方手势：冲向对手并施展克制动作 */
.clash-smash.clash-w1 .clash-atk .choice-img { animation: atkSmashR 0.85s cubic-bezier(0.3, 0.1, 0.3, 1) both; }
.clash-smash.clash-w2 .clash-atk .choice-img { animation: atkSmashL 0.85s cubic-bezier(0.3, 0.1, 0.3, 1) both; }
.clash-cut.clash-w1 .clash-atk .choice-img { animation: atkCutR 0.85s ease-out both; }
.clash-cut.clash-w2 .clash-atk .choice-img { animation: atkCutL 0.85s ease-out both; }
.clash-wrap.clash-w1 .clash-atk .choice-img { animation: atkWrapR 0.9s ease-in-out both; }
.clash-wrap.clash-w2 .clash-atk .choice-img { animation: atkWrapL 0.9s ease-in-out both; }

/* 受击方手势：被砸碎 / 被剪断 / 被包裹 */
.clash-smash.clash-w1 .clash-vic .choice-img { animation: vicSmashR 0.8s ease-in both; }
.clash-smash.clash-w2 .clash-vic .choice-img { animation: vicSmashL 0.8s ease-in both; }
.clash-cut.clash-w1 .clash-vic .choice-img { animation: vicCutR 0.8s ease-in both; }
.clash-cut.clash-w2 .clash-vic .choice-img { animation: vicCutL 0.8s ease-in both; }
.clash-wrap .clash-vic .choice-img { animation: vicWrap 0.8s ease-in-out both; }

/* 石头：蓄力后仰 -> 冲刺重砸 */
@keyframes atkSmashR {
  0% { transform: translateX(0) rotate(0) scale(1); }
  30% { transform: translateX(-24rpx) rotate(-35deg) scale(1.12); }
  55% { transform: translateX(85rpx) rotate(22deg) scale(1.28); }
  65% { transform: translateX(110rpx) rotate(32deg) scale(1.34); }
  100% { transform: translateX(0) rotate(0) scale(1); }
}
@keyframes atkSmashL {
  0% { transform: translateX(0) rotate(0) scale(1); }
  30% { transform: translateX(24rpx) rotate(35deg) scale(1.12); }
  55% { transform: translateX(-85rpx) rotate(-22deg) scale(1.28); }
  65% { transform: translateX(-110rpx) rotate(-32deg) scale(1.34); }
  100% { transform: translateX(0) rotate(0) scale(1); }
}
/* 剪刀：冲刺 + 连续开合剪切 */
@keyframes atkCutR {
  0% { transform: translateX(0) rotate(0) scale(1); }
  25% { transform: translateX(-16rpx) rotate(-20deg) scale(1.06); }
  50% { transform: translateX(78rpx) rotate(14deg) scale(1.18); }
  62% { transform: translateX(102rpx) rotate(-10deg) scale(1.22); }
  74% { transform: translateX(108rpx) rotate(12deg) scale(1.24); }
  88% { transform: translateX(100rpx) rotate(-6deg) scale(1.16); }
  100% { transform: translateX(0) rotate(0) scale(1); }
}
@keyframes atkCutL {
  0% { transform: translateX(0) rotate(0) scale(1); }
  25% { transform: translateX(16rpx) rotate(20deg) scale(1.06); }
  50% { transform: translateX(-78rpx) rotate(-14deg) scale(1.18); }
  62% { transform: translateX(-102rpx) rotate(10deg) scale(1.22); }
  74% { transform: translateX(-108rpx) rotate(-12deg) scale(1.24); }
  88% { transform: translateX(-100rpx) rotate(6deg) scale(1.16); }
  100% { transform: translateX(0) rotate(0) scale(1); }
}
/* 布：后摆蓄力 -> 放大扑上覆盖 */
@keyframes atkWrapR {
  0% { transform: translateX(0) rotate(0) scale(1); }
  30% { transform: translateX(-18rpx) rotate(-14deg) scale(0.92); }
  60% { transform: translateX(90rpx) rotate(22deg) scale(1.52); }
  75% { transform: translateX(96rpx) rotate(-10deg) scale(1.46); }
  100% { transform: translateX(0) rotate(0) scale(1); }
}
@keyframes atkWrapL {
  0% { transform: translateX(0) rotate(0) scale(1); }
  30% { transform: translateX(18rpx) rotate(14deg) scale(0.92); }
  60% { transform: translateX(-90rpx) rotate(-22deg) scale(1.52); }
  75% { transform: translateX(-96rpx) rotate(10deg) scale(1.46); }
  100% { transform: translateX(0) rotate(0) scale(1); }
}
/* 剪刀被砸碎：受击膨胀闪白 -> 炸碎消散（碎片同步爆开） */
@keyframes vicSmashR {
  0%, 42% { transform: none; opacity: 1; }
  48% { transform: scale(1.24) rotate(8deg); opacity: 1; filter: brightness(2.2); }
  56% { transform: scale(0.42) rotate(26deg); opacity: 0; filter: brightness(2.2); }
  100% { transform: scale(0.42) rotate(26deg); opacity: 0; }
}
@keyframes vicSmashL {
  0%, 42% { transform: none; opacity: 1; }
  48% { transform: scale(1.24) rotate(-8deg); opacity: 1; filter: brightness(2.2); }
  56% { transform: scale(0.42) rotate(-26deg); opacity: 0; filter: brightness(2.2); }
  100% { transform: scale(0.42) rotate(-26deg); opacity: 0; }
}
/* 布被剪碎：受击膨胀闪白 -> 碎裂消散（蓝色布片同步爆开） */
@keyframes vicCutR {
  0%, 44% { transform: none; opacity: 1; }
  50% { transform: scale(1.2) rotate(-5deg) skewX(6deg); opacity: 1; filter: brightness(2.2); }
  58% { transform: scale(0.45) rotate(-16deg) skewX(10deg); opacity: 0; filter: brightness(2.2); }
  100% { transform: scale(0.45) rotate(-16deg) skewX(10deg); opacity: 0; }
}
@keyframes vicCutL {
  0%, 44% { transform: none; opacity: 1; }
  50% { transform: scale(1.2) rotate(5deg) skewX(-6deg); opacity: 1; filter: brightness(2.2); }
  58% { transform: scale(0.45) rotate(16deg) skewX(-10deg); opacity: 0; filter: brightness(2.2); }
  100% { transform: scale(0.45) rotate(16deg) skewX(-10deg); opacity: 0; }
}
/* 石头被包裹：缩小旋转被兜住 */
@keyframes vicWrap {
  0%, 40% { transform: none; opacity: 1; }
  60% { transform: scale(0.78) rotate(14deg); }
  80% { transform: scale(0.5) rotate(-16deg); opacity: 0.85; }
  100% { transform: scale(0.3) rotate(-28deg); opacity: 0.5; }
}

/* ===== 克制对决特效层 ===== */
.clash-fx {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 5;
}

/* 命中白闪 */
.fx-flash {
  position: absolute;
  left: 12%;
  right: 12%;
  top: 18%;
  bottom: 18%;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0) 70%);
  opacity: 0;
  animation: fxBurst 0.45s ease-out 0.32s;
}
@keyframes fxBurst {
  0% { opacity: 0; transform: scale(0.4); }
  30% { opacity: 1; transform: scale(1); }
  100% { opacity: 0; transform: scale(1.5); }
}

/* 碎片（剪刀被砸碎时四散） */
.fx-shard {
  position: absolute;
  top: 44%;
  width: 18rpx;
  height: 18rpx;
  border-radius: 6rpx;
  background: linear-gradient(135deg, #FF9FB6, #FF6B8A);
  opacity: 0;
}
.fx-hit-right .fx-shard { left: 66%; }
.fx-hit-left .fx-shard { left: 28%; }
.fx-shard.s1 { animation: shardFly1 0.7s cubic-bezier(0.2, 0.6, 0.35, 1) 0.34s both; }
.fx-shard.s2 { animation: shardFly2 0.7s cubic-bezier(0.2, 0.6, 0.35, 1) 0.38s both; }
.fx-shard.s3 { animation: shardFly3 0.7s cubic-bezier(0.2, 0.6, 0.35, 1) 0.34s both; }
.fx-shard.s4 { animation: shardFly4 0.7s cubic-bezier(0.2, 0.6, 0.35, 1) 0.4s both; }
.fx-shard.s5 { animation: shardFly5 0.7s cubic-bezier(0.2, 0.6, 0.35, 1) 0.36s both; }
.fx-shard.s6 { animation: shardFly6 0.7s cubic-bezier(0.2, 0.6, 0.35, 1) 0.42s both; }
.fx-shard.s7 { animation: shardFly7 0.7s cubic-bezier(0.2, 0.6, 0.35, 1) 0.38s both; }
.fx-shard.s8 { animation: shardFly8 0.7s cubic-bezier(0.2, 0.6, 0.35, 1) 0.44s both; }
@keyframes shardFly1 { 0% { opacity: 1; transform: translate(0, 0) rotate(0); } 100% { opacity: 0; transform: translate(-72rpx, -88rpx) rotate(-280deg) scale(0.4); } }
@keyframes shardFly2 { 0% { opacity: 1; transform: translate(0, 0) rotate(0); } 100% { opacity: 0; transform: translate(-18rpx, -110rpx) rotate(220deg) scale(0.35); } }
@keyframes shardFly3 { 0% { opacity: 1; transform: translate(0, 0) rotate(0); } 100% { opacity: 0; transform: translate(52rpx, -96rpx) rotate(300deg) scale(0.4); } }
@keyframes shardFly4 { 0% { opacity: 1; transform: translate(0, 0) rotate(0); } 100% { opacity: 0; transform: translate(-100rpx, -26rpx) rotate(-200deg) scale(0.4); } }
@keyframes shardFly5 { 0% { opacity: 1; transform: translate(0, 0) rotate(0); } 100% { opacity: 0; transform: translate(96rpx, -20rpx) rotate(240deg) scale(0.38); } }
@keyframes shardFly6 { 0% { opacity: 1; transform: translate(0, 0) rotate(0); } 100% { opacity: 0; transform: translate(-80rpx, 60rpx) rotate(-320deg) scale(0.35); } }
@keyframes shardFly7 { 0% { opacity: 1; transform: translate(0, 0) rotate(0); } 100% { opacity: 0; transform: translate(-10rpx, 92rpx) rotate(180deg) scale(0.32); } }
@keyframes shardFly8 { 0% { opacity: 1; transform: translate(0, 0) rotate(0); } 100% { opacity: 0; transform: translate(70rpx, 74rpx) rotate(260deg) scale(0.4); } }

/* 星光点缀 */
.fx-spark {
  position: absolute;
  top: 40%;
  width: 20rpx;
  height: 20rpx;
  background: #FFFFFF;
  border-radius: 4rpx;
  opacity: 0;
}
.fx-hit-right .fx-spark { left: 68%; }
.fx-hit-left .fx-spark { left: 26%; }
.fx-spark.k1 { animation: sparkTwinkle 0.5s ease-out 0.3s both; }
.fx-spark.k2 { animation: sparkTwinkle 0.5s ease-out 0.45s both; }
@keyframes sparkTwinkle {
  0% { opacity: 0; transform: rotate(45deg) scale(0.2); }
  40% { opacity: 1; transform: rotate(45deg) scale(1.3); }
  100% { opacity: 0; transform: rotate(85deg) scale(0.3); }
}

/* 剪切白光（剪刀剪布） */
.fx-slash {
  position: absolute;
  top: 20%;
  height: 60%;
  width: 10rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, transparent, #FFFFFF 30%, #EAF7FF 50%, #FFFFFF 70%, transparent);
  box-shadow: 0 0 24rpx rgba(255, 255, 255, 0.9);
  opacity: 0;
  animation: fxSlash 0.35s ease-out 0.42s;
}
.fx-hit-right .fx-slash { left: 64%; }
.fx-hit-left .fx-slash { left: 32%; }
@keyframes fxSlash {
  0% { opacity: 0; transform: scaleY(0.2) scaleX(0.3); }
  40% { opacity: 1; transform: scaleY(1) scaleX(1.6); }
  100% { opacity: 0; transform: scaleY(1.3) scaleX(0.5); }
}

/* 包裹光环（布包石头） */
.fx-wrap-ring {
  position: absolute;
  top: 26%;
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(79, 195, 247, 0.85);
  box-shadow: 0 0 32rpx rgba(79, 195, 247, 0.5);
  opacity: 0;
  animation: fxRing 0.55s ease-in 0.3s;
}
.fx-hit-right .fx-wrap-ring { left: 58%; }
.fx-hit-left .fx-wrap-ring { left: 20%; }
@keyframes fxRing {
  0% { opacity: 0.9; transform: scale(1.7); }
  100% { opacity: 0; transform: scale(0.45); }
}

/* 剪碎的布片（蓝色） */
.fx-shard.cut {
  background: linear-gradient(135deg, #9AD8F8, #3D9BE0);
  width: 24rpx;
  height: 14rpx;
  border-radius: 4rpx;
}

/* 受击爆裂痕迹（炸碎瞬间填补手势位置） */
.fx-burst {
  position: absolute;
  top: 26%;
  font-size: 88rpx;
  opacity: 0;
  z-index: 6;
  animation: fxBurstIcon 0.6s ease-out 0.34s both;
}
.fx-hit-right .fx-burst { left: 58%; }
.fx-hit-left .fx-burst { left: 22%; }
@keyframes fxBurstIcon {
  0% { opacity: 0; transform: scale(0.2) rotate(-15deg); }
  30% { opacity: 1; transform: scale(1.25) rotate(8deg); }
  100% { opacity: 0; transform: scale(1.7) rotate(15deg); }
}

/* 战败破损手势图（碎裂后弹入并保留） */
.broken-img {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  margin: auto;
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  z-index: 3;
  animation: brokenIn 0.55s cubic-bezier(0.2, 1.4, 0.4, 1) 0.46s both;
}
@keyframes brokenIn {
  0% { opacity: 0; transform: scale(0.3) rotate(-18deg); }
  60% { opacity: 1; transform: scale(1.12) rotate(5deg); }
  100% { opacity: 1; transform: scale(1) rotate(0); }
}
