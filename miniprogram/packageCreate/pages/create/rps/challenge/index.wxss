}

.stat-value {
  font-size: var(--rps-fs-title);
  font-weight: bold;
  color: var(--rps-gold);
}

.gameover-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, var(--rps-gold) 0%, #FFA726 100%);
  color: #fff;
  border-radius: 28rpx;
  font-size: var(--rps-fs-aux);
  font-weight: bold;
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  box-shadow: 0 8rpx 24rpx rgba(255, 184, 48, 0.4);
}

/* 立体按钮厚度 */
.action-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: var(--rps-btn-depth);
  background: rgba(0, 0, 0, 0.15);
