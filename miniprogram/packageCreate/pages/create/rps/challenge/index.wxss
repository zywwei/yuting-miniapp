/* ===== 设计Token（猜拳竞技场主题） ===== */
:root {
  /* 主色板（与全局亲子粉衔接并提亮） */
  --rps-primary:      #FF6B8A;   /* 主粉：主按钮、标题强调 */
  --rps-primary-deep: #E8527A;   /* 深粉：渐变末端、按压态 */
  --rps-gold:         #FFB830;   /* 金色：胜利、奖杯、连胜 */
  --rps-ink:          #3A2E4D;   /* 主文字：深紫灰（替代纯黑#333，更柔和） */
  --rps-ink-light:    #8A7FA0;   /* 次要文字 */

  /* 三拳专属色（增强识别，全模块统一） */
  --rps-rock:     #7C8DB0;  /* 石头：岩蓝灰 */
  --rps-scissors: #3EC6B8;  /* 剪刀：青碧 */
  --rps-paper:    #FF9F43;  /* 布：暖橙 */

  /* 结果色 */
  --rps-win:  #4CAF6D;   /* 胜：青绿 */
  --rps-lose: #FF5A5A;   /* 负：珊瑚红 */
  --rps-draw: #FFB830;   /* 平：金 */

  /* 背景（进一步加深以确保白色文字清晰） */
  --rps-bg: linear-gradient(180deg, #C9A0B8 0%, #B8A0C8 55%, #A8C0E0 100%);

  /* 卡片与阴影（立体糖果感） */
  --rps-card-bg:    #FFFFFF;
  --rps-radius-lg:  32rpx;
  --rps-radius-md:  24rpx;
  --rps-shadow-1:   0 6rpx 20rpx rgba(58, 46, 77, 0.08);           /* 悬浮卡 */
  --rps-shadow-2:   0 12rpx 32rpx rgba(58, 46, 77, 0.12);          /* 强调卡 */
  --rps-border:     3rpx solid rgba(58, 46, 77, 0.06);             /* 柔边 */

  /* 立体按钮（街机感：顶面 + 底部厚度条） */
  --rps-btn-depth:  8rpx;   /* 按钮底部厚度，按压时压缩为 2rpx */

  /* 字号层级 */
  --rps-fs-hero:   64rpx;  /* 页面主标题 / 大比分 */
  --rps-fs-title:  40rpx;  /* 区块标题 */
  --rps-fs-body:   30rpx;  /* 正文 */
  --rps-fs-aux:    24rpx;  /* 辅助说明 */
}

.container {
  min-height: 100vh;
  background: var(--rps-bg);
  padding: 32rpx;
}

/* 菜单阶段 */
.phase-menu {
  text-align: center;
  padding-top: 60rpx;
}

.header {
  margin-bottom: 48rpx;
  animation: headerFadeIn 0.6s ease-out;
}

@keyframes headerFadeIn {
  0% { transform: translateY(-30rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.header-icon {
  font-size: 100rpx;
  margin-bottom: 16rpx;
  animation: iconBounce 0.6s ease-out;
}

@keyframes iconBounce {
  0% { transform: scale(0.6); opacity: 0; }
  60% { transform: scale(1.1); }
  100% { transform: scale(1); opacity: 1; }
}

.header-title {
  font-size: var(--rps-fs-hero);
  font-weight: bold;
  color: var(--rps-gold);
  margin-bottom: 8rpx;
  text-shadow: 0 4rpx 8rpx rgba(255, 184, 48, 0.3);
}

.header-desc {
  font-size: var(--rps-fs-aux);
  color: var(--rps-ink-light);
}

.progress-info {
  display: flex;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 48rpx;
  animation: progressInfoFadeIn 0.6s ease-out 0.2s both;
}

@keyframes progressInfoFadeIn {
  0% { transform: translateY(20rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.info-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--rps-ink);
  padding: 24rpx 32rpx;
  border-radius: var(--rps-radius-md);
  box-shadow: var(--rps-shadow-2);
  flex: 1;
  max-width: 160rpx;
}

.info-label {
  font-size: var(--rps-fs-aux);
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 8rpx;
  font-weight: 500;
}

.info-value {
  font-size: var(--rps-fs-title);
  font-weight: bold;
  color: var(--rps-gold);
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

/* 冒险地图路径 */
.adventure-map {
  margin: 32rpx 0;
  animation: mapFadeIn 0.6s ease-out 0.4s both;
}

@keyframes mapFadeIn {
  0% { transform: translateY(20rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.map-path {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
  padding: 24rpx;
  background: var(--rps-card-bg);
  border-radius: var(--rps-radius-lg);
  box-shadow: var(--rps-shadow-1);
  border: var(--rps-border);
}

.map-node {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.node-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  transition: all 0.3s ease;
}

/* 已通关 - 金色 */
.map-node.completed .node-circle {
  background: linear-gradient(135deg, var(--rps-gold) 0%, #FFA726 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 184, 48, 0.4);
}

/* 当前关卡 - 粉色脉冲 */
.map-node.current .node-circle {
  background: linear-gradient(135deg, var(--rps-primary) 0%, var(--rps-primary-deep) 100%);
  box-shadow: 0 0 0 4rpx rgba(255, 107, 138, 0.3), 0 4rpx 12rpx rgba(255, 107, 138, 0.4);
  animation: currentNodePulse 2s ease-in-out infinite;
}

@keyframes currentNodePulse {
  0%, 100% { box-shadow: 0 0 0 4rpx rgba(255, 107, 138, 0.3), 0 4rpx 12rpx rgba(255, 107, 138, 0.4); }
  50% { box-shadow: 0 0 0 8rpx rgba(255, 107, 138, 0.2), 0 4rpx 12rpx rgba(255, 107, 138, 0.4); }
}

/* 未解锁 - 灰色 */
.map-node.locked .node-circle {
  background: rgba(58, 46, 77, 0.1);
  border: 2rpx dashed rgba(58, 46, 77, 0.2);
}

.node-icon {
  font-size: 28rpx;
  margin-bottom: 2rpx;
}

.node-num {
  font-size: 20rpx;
  font-weight: bold;
  color: #fff;
}

.map-node.locked .node-num {
  color: var(--rps-ink-light);
}

/* 连接线 */
.node-line {
  width: 16rpx;
  height: 4rpx;
  background: rgba(255, 184, 48, 0.3);
  border-radius: 2rpx;
}

.map-node.completed .node-line {
  background: var(--rps-gold);
}

.start-btn {
  padding: 24rpx 48rpx;
  background: linear-gradient(135deg, var(--rps-gold) 0%, #FFA726 100%);
  color: #fff;
  border-radius: 28rpx;
  font-size: var(--rps-fs-body);
  font-weight: bold;
  display: inline-block;
  box-shadow: 0 8rpx 24rpx rgba(255, 184, 48, 0.4);
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  animation: startBtnFadeIn 0.6s ease-out 0.3s both;
}

@keyframes startBtnFadeIn {
  0% { transform: translateY(20rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

/* 立体按钮厚度 */
.start-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: var(--rps-btn-depth);
  background: rgba(0, 0, 0, 0.15);
  border-radius: 28rpx 28rpx 0 0;
}

.start-btn:active {
  transform: translateY(6rpx);
  box-shadow: 0 2rpx 8rpx rgba(255, 184, 48, 0.3);
}

.start-btn:active::before {
  height: 2rpx;
}

.reset-btn {
  margin-top: 24rpx;
  font-size: var(--rps-fs-aux);
  color: var(--rps-ink-light);
  transition: color 0.2s ease;
}

.reset-btn:active {
  color: var(--rps-primary);
}

.back-btn {
  margin-top: 24rpx;
  font-size: var(--rps-fs-aux);
  color: var(--rps-ink-light);
  transition: color 0.2s ease;
}

.back-btn:active {
  color: var(--rps-primary);
}

/* 游戏阶段 */
.phase-playing {
  padding-top: 20rpx;
}

.level-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  animation: levelHeaderFadeIn 0.5s ease-out;
}

@keyframes levelHeaderFadeIn {
  0% { transform: translateY(-20rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

.level-num {
  font-size: var(--rps-fs-title);
  font-weight: bold;
  color: var(--rps-gold);
  text-shadow: 0 2rpx 4rpx rgba(255, 184, 48, 0.3);
}

.level-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.level-wins {
  font-size: var(--rps-fs-aux);
  color: var(--rps-ink);
  background: rgba(255, 184, 48, 0.15);
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 184, 48, 0.3);
}

.level-lives {
  font-size: 28rpx;
}

/* 比分板 */
.scoreboard {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #E8708A 0%, #D85878 100%);
  padding: 24rpx;
  border-radius: var(--rps-radius-lg);
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(232, 112, 138, 0.35);
  position: relative;
  overflow: hidden;
}

@keyframes scoreboardSlideIn {
  0% { transform: translateY(-30rpx); opacity: 0; }
  100% { transform: translateY(0); opacity: 1; }
}

/* 记分牌光泽效果 */
.scoreboard::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
  animation: scoreboardShine 3s ease-in-out infinite;
}

@keyframes scoreboardShine {
  0% { left: -100%; }
  50% { left: 100%; }
  100% { left: 100%; }
}

.score-side {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: var(--rps-radius-md);
  background: rgba(255, 255, 255, 0.1);
  transition: all 0.3s ease;
}

.score-side.score-win {
  background: rgba(255, 184, 48, 0.2);
}

.score-label {
  font-size: var(--rps-fs-aux);
  color: #fff;
  margin-bottom: 8rpx;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.3);
}

.score-value {
  font-size: var(--rps-fs-hero);
  font-weight: bold;
  color: var(--rps-gold);
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.score-divider {
  font-size: var(--rps-fs-body);
  font-weight: bold;
  color: var(--rps-gold);
  padding: 0 24rpx;
  background: rgba(255, 184, 48, 0.2);
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 184, 48, 0.4);
}

/* 出拳区域 */
.battle-area {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  position: relative;
}

.player-side {
  text-align: center;
  position: relative;
}

.player-choice {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--rps-card-bg);
  border-radius: 50%;
  box-shadow: var(--rps-shadow-2);
  margin-bottom: 12rpx;
  transition: all 0.3s ease;
  position: relative;
  z-index: 2;
}

/* 我方玩家光环 */
.player-side:first-child .player-choice {
  box-shadow: 0 0 0 8rpx rgba(255, 107, 138, 0.3), var(--rps-shadow-2);
}

/* 对方玩家光环 */
.player-side:last-child .player-choice {
  box-shadow: 0 0 0 8rpx rgba(62, 198, 184, 0.3), var(--rps-shadow-2);
}

/* 对撞动画 - 我方从左侧冲向中央 */
.player-side:first-child .player-choice.animating {
  animation: player1Collide 0.6s ease-out;
}

@keyframes player1Collide {
  0% { transform: translateX(-40vw); }
  40% { transform: translateX(0); }
  60% { transform: translateX(-8rpx); }
  80% { transform: translateX(4rpx); }
  100% { transform: translateX(0); }
}

/* 对撞动画 - 对方从右侧冲向中央 */
.player-side:last-child .player-choice.animating {
  animation: player2Collide 0.6s ease-out;
}

@keyframes player2Collide {
  0% { transform: translateX(40vw); }
  40% { transform: translateX(0); }
  60% { transform: translateX(8rpx); }
  80% { transform: translateX(-4rpx); }
  100% { transform: translateX(0); }
}

/* 胜方金环脉冲 */
.player-choice.winner {
  border-color: var(--rps-win);
  box-shadow: 0 0 0 8rpx rgba(76, 175, 109, 0.4), 0 0 40rpx rgba(255, 184, 48, 0.6);
  animation: winnerGlow 0.5s ease-in-out;
}

@keyframes winnerGlow {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}

/* 负方灰化下沉 */
.player-choice.loser {
  border-color: var(--rps-lose);
  opacity: 0.6;
  transform: scale(0.95);
  filter: grayscale(0.3);
}

.choice-icon {
  font-size: 80rpx;
}

.player-name {
  font-size: var(--rps-fs-aux);
  color: var(--rps-ink);
  font-weight: bold;
}

.vs-icon-container {
  margin: 0 32rpx;
  position: relative;
  z-index: 3;
}

.vs-icon {
  font-size: 48rpx;
  color: var(--rps-gold);
  transition: all 0.3s ease;
}

.vs-icon.vs-animate {
  animation: vsPulse 0.6s ease-out;
}

@keyframes vsPulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.3); }
  100% { transform: scale(1); }
}

/* 冲击波效果 */
.battle-area::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.8);
  opacity: 0;
  z-index: 1;
  pointer-events: none;
}

.battle-area.shockwave::after {
  animation: shockwave 0.5s ease-out;
}

@keyframes shockwave {
  0% { transform: translate(-50%, -50%) scale(0); opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(2.5); opacity: 0; }
}

/* 回合结果 */
.round-result {
  text-align: center;
  margin-bottom: 32rpx;
  animation: bounceIn 0.4s ease-out;
}

@keyframes bounceIn {
  0% { transform: scale(0.6); opacity: 0; }
  60% { transform: scale(1.05); }
  100% { transform: scale(1); opacity: 1; }
}

.result-badge {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx;
  border-radius: 16rpx;
  background: var(--rps-card-bg);
  box-shadow: var(--rps-shadow-2);
  position: relative;
  overflow: hidden;
}

/* 胜利 - 金色横幅 */
.result-badge.win {
  background: linear-gradient(135deg, #F0A020 0%, #E89010 100%);
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 失败 - 珊瑚红横幅 */
.result-badge.lose {
  background: linear-gradient(135deg, #E85050 0%, #D04040 100%);
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 平局 - 灰蓝横幅 */
.result-badge.draw {
  background: linear-gradient(135deg, #607D8B 0%, #546E7A 100%);
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 横幅光泽效果 */
.result-badge::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
  animation: badgeShine 0.6s ease-out 0.2s;
}

@keyframes badgeShine {
  0% { left: -100%; }
  100% { left: 100%; }
}

.result-icon {
  font-size: 36rpx;
}

.result-text {
  font-size: var(--rps-fs-body);
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 选择按钮 */
.choice-buttons {
  display: flex;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 32rpx;
}

.choice-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.choice-btn-inner {
  width: 168rpx;
  height: 168rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  position: relative;
  overflow: hidden;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

/* 石头按钮 - 岩蓝灰 */
.choice-btn:nth-child(1) .choice-btn-inner {
  background: linear-gradient(135deg, var(--rps-rock) 0%, #6B7DA0 100%);
  box-shadow: 0 8rpx 24rpx rgba(124, 141, 176, 0.4);
}

/* 剪刀按钮 - 青碧 */
.choice-btn:nth-child(2) .choice-btn-inner {
  background: linear-gradient(135deg, var(--rps-scissors) 0%, #2DB5A7 100%);
  box-shadow: 0 8rpx 24rpx rgba(62, 198, 184, 0.4);
}

/* 布按钮 - 暖橙 */
.choice-btn:nth-child(3) .choice-btn-inner {
  background: linear-gradient(135deg, var(--rps-paper) 0%, #E88B35 100%);
  box-shadow: 0 8rpx 24rpx rgba(255, 159, 67, 0.4);
}

/* 顶部径向高光模拟立体感 */
.choice-btn-inner::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 30%;
  background: radial-gradient(ellipse at center top, rgba(255, 255, 255, 0.25) 0%, transparent 70%);
  pointer-events: none;
}

/* 底部厚度条 */
.choice-btn-inner::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: var(--rps-btn-depth);
  background: rgba(0, 0, 0, 0.2);
  border-radius: 0 0 32rpx 32rpx;
}

/* 呼吸浮动动画 */
.choice-btn:nth-child(1) .choice-btn-inner {
  animation: btnFloat1 3s ease-in-out infinite;
}

.choice-btn:nth-child(2) .choice-btn-inner {
  animation: btnFloat2 3s ease-in-out infinite;
  animation-delay: 0.4s;
}

.choice-btn:nth-child(3) .choice-btn-inner {
  animation: btnFloat3 3s ease-in-out infinite;
  animation-delay: 0.8s;
}

@keyframes btnFloat1 {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

@keyframes btnFloat2 {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

@keyframes btnFloat3 {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6rpx); }
}

/* 按压效果 */
.choice-btn:active .choice-btn-inner {
  transform: translateY(6rpx);
  animation: none;
}

.choice-btn:active .choice-btn-inner::after {
  height: 2rpx;
}

.choice-btn-icon {
  font-size: 64rpx;
  position: relative;
  z-index: 1;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

.choice-btn-text {
  font-size: var(--rps-fs-aux);
  color: var(--rps-card-bg);
  font-weight: bold;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

/* 关卡完成 */
.phase-levelComplete {
  text-align: center;
  padding-top: 80rpx;
}

.complete-container {
  background: var(--rps-card-bg);
  padding: 48rpx;
  border-radius: var(--rps-radius-lg);
  box-shadow: var(--rps-shadow-2);
  animation: fadeInUp 0.5s ease-out;
  position: relative;
  overflow: hidden;
}

@keyframes fadeInUp {
  from { transform: translateY(30rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

/* 领奖台效果 */
.complete-container::before {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(180deg, transparent, rgba(255, 184, 48, 0.1));
  pointer-events: none;
}

.complete-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  animation: trophyWobble 1.2s ease-in-out 2;
}

@keyframes trophyWobble {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-8deg); }
  75% { transform: rotate(8deg); }
}

.complete-title {
