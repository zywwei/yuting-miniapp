}

.action-btn:active {
  transform: translateY(6rpx);
  box-shadow: 0 2rpx 8rpx rgba(255, 184, 48, 0.3);
}

.action-btn:active::before {
  height: 2rpx;
}

/* 星级统计 */
.complete-stars {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 32rpx;
}

.stars-label {
  font-size: var(--rps-fs-aux);
  color: var(--rps-ink-light);
}

.stars-value {
  font-size: var(--rps-fs-body);
  font-weight: bold;
  color: var(--rps-gold);
}

/* 撒花效果 - 双层彩带 */
.confetti-container {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 100;
  overflow: hidden;
}

/* 前排大彩带 - 快速下落 */
.confetti {
  position: absolute;
  font-size: 48rpx;
  animation: confettiFall 1.2s ease-out forwards;
}

.confetti-1 { left: 10%; animation-delay: 0s; }
.confetti-2 { left: 30%; animation-delay: 0.2s; }
.confetti-3 { left: 50%; animation-delay: 0.4s; }
.confetti-4 { left: 70%; animation-delay: 0.1s; }
.confetti-5 { left: 85%; animation-delay: 0.3s; }
.confetti-6 { left: 45%; animation-delay: 0.5s; }

@keyframes confettiFall {
  0% { top: -10%; opacity: 1; transform: rotate(0deg); }
  100% { top: 110%; opacity: 0; transform: rotate(720deg); }
}

/* 后排小彩带 - 慢速下落 */
.confetti-container::before {
  content: '✨✨✨✨✨✨';
  position: absolute;
  top: -20%;
  left: 0;
  right: 0;
  font-size: 24rpx;
  letter-spacing: 20rpx;
  text-align: center;
  animation: confettiSlow 2s ease-out 0.5s forwards;
  opacity: 0;
}

@keyframes confettiSlow {
  0% {
    top: -20%;
    opacity: 0;
    transform: rotate(0deg);
  }
  20% {
    opacity: 0.8;
  }
  100% {
    top: 100%;
    opacity: 0;
    transform: rotate(180deg);
  }
}

/* 顶部中央彩带喷射源点 */
.confetti-container::after {
  content: '';
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 20rpx;
  background: radial-gradient(circle, rgba(255, 184, 48, 0.8) 0%, transparent 70%);
  animation: confettiSource 0.3s ease-out;
}

@keyframes confettiSource {
  0% { transform: translateX(-50%) scale(0); opacity: 0; }
  50% { transform: translateX(-50%) scale(3); opacity: 1; }
  100% { transform: translateX(-50%) scale(1); opacity: 0; }
}
