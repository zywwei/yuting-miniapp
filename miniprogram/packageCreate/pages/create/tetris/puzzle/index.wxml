<view class="game-container">
  <!-- 关卡选择 -->
  <view wx:if="{{phase==='select'}}" class="sel-screen">
    <view class="sel-hd"><text class="sel-ico">🧩</text><text class="sel-t">拼图模式</text><text class="sel-d">用有限方块拼出目标图案</text><text class="sel-c">⭐ {{totalStars}} / {{levels.length*3}}</text></view>
    <view class="lv-grid">
      <view class="lv-item {{item.unlocked?'':'locked'}} {{starsMap[item.id]>0?'done':''}}" wx:for="{{levels}}" wx:key="id" bindtap="selectLevel" data-id="{{item.id}}">
        <text class="lv-n">{{item.id}}</text><text class="lv-na">{{item.name}}</text>
        <text wx:if="{{item.stars>=1}}">⭐</text><text wx:if="{{item.stars>=2}}">⭐</text><text wx:if="{{item.stars>=3}}">⭐</text>
        <text wx:if="{{item.stars===0&&item.unlocked}}" class="emp">☆☆☆</text>
        <text wx:if="{{!item.unlocked}}">🔒</text>
      </view>
    </view>
  </view>

  <!-- 游戏中 -->
  <view wx:if="{{phase==='playing'}}" class="play-screen">
    <view class="lv-info"><text class="li-t">第{{selectedLevel}}关：{{levelName}}</text><text class="li-d">{{levelDesc}}</text></view>
    <view class="stats"><text class="gs">🎯 {{targetFilled}}/{{targetTotal}}</text><text class="gs">⏱ {{elapsed}}秒</text><text class="gs">💡 {{hintsRemaining}}次</text></view>
    <view class="piece-info"><text class="pi-l">当前: </text><text class="pi-t">{{currentPiece.type}}</text><text class="pi-r"> ({{pieceIndex+1}}/{{pieces.length}})</text></view>
    <view class="board-wrap"><canvas type="2d" id="puzzleCanvas" class="board-canvas" style="width:{{boardWidth}}px;height:{{boardHeight}}px"></canvas></view>
    <view class="btn-bar">
      <view class="btn-row">
        <view class="btn" bindtap="moveLeft"><text class="btn-a">◀</text></view>
        <view class="btn btn-big" bindtap="rotatePiece"><text class="btn-a">↻</text></view>
        <view class="btn" bindtap="moveDown"><text class="btn-a">▼</text></view>
        <view class="btn" bindtap="moveRight"><text class="btn-a">▶</text></view>
        <view class="btn btn-purple" bindtap="placePiece"><text class="btn-t">放置</text></view>
        <view class="btn btn-gold" wx:if="{{hintsRemaining>0}}" bindtap="useHint"><text class="btn-t">💡</text></view>
      </view>
    </view>
    <text class="back-link" bindtap="goBack">‹ 返回关卡列表</text>
  </view>

  <!-- 结果 -->
  <view class="overlay" wx:if="{{phase==='result'}}">
    <view class="dialog">
      <text class="dt">{{targetFilled>=targetTotal?'🎉 通关成功！':'😅 未完成'}}</text>
      <view class="stars-r"><text wx:if="{{stars>=1}}">⭐</text><text wx:if="{{stars>=2}}">⭐</text><text wx:if="{{stars>=3}}">⭐</text></view>
      <text class="dd">用时 {{elapsed}}秒  目标 {{targetFilled}}/{{targetTotal}}</text>
      <text class="dr">🪙 +{{stars}} 金币</text>
      <view class="db-row"><view class="db" bindtap="nextLevel" wx:if="{{targetFilled>=targetTotal&&selectedLevel<20}}">下一关</view><view class="db" bindtap="retryLevel">重试</view><view class="db gray" bindtap="goBack">返回</view></view>
    </view>
  </view>
</view>
