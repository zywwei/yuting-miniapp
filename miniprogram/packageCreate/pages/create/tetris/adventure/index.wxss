/* 冒险模式 */
page { height: 100%; margin: 0; }
.game-container { height: 100%; display: flex; flex-direction: column; background: linear-gradient(180deg, #1A1A2E, #16213E); overflow: hidden; }

/* 关卡选择 */
.sel-screen { padding: 16rpx; overflow-y: auto; }
.sel-hd { text-align: center; padding: 16rpx 0; }
.sel-ico { font-size: 48rpx; }
.sel-t { display: block; font-size: 32rpx; font-weight: bold; color: #fff; }
.sel-d { display: block; font-size: 20rpx; color: rgba(255,255,255,0.7); }
.sel-c { display: block; font-size: 22rpx; color: #FFD700; margin-top: 8rpx; }
.shop-btn { background: rgba(255,255,255,0.1); border-radius: 12rpx; padding: 12rpx; text-align: center; font-size: 22rpx; color: #FFD700; margin: 8rpx 0; }
.ch-list { display: flex; flex-direction: column; gap: 8rpx; }
.ch-item { background: rgba(255,255,255,0.08); border-radius: 12rpx; padding: 10rpx 12rpx; display: flex; align-items: center; gap: 8rpx; }
.ch-item.done { opacity: 0.5; }
.ch-item.locked { opacity: 0.3; pointer-events: none; }
.ch-n { font-size: 20rpx; color: #FFD700; width: 24rpx; text-align: center; }
.ch-e { font-size: 28rpx; }
.ch-na { flex: 1; font-size: 22rpx; color: #fff; }
.ch-h { font-size: 18rpx; color: rgba(255,255,255,0.6); }

/* 游戏中 */
.play-screen { flex: 1; display: flex; flex-direction: column; min-height: 0; }

.mon-bar { display: flex; align-items: center; background: rgba(255,255,255,0.08); border-radius: 8rpx; padding: 4rpx 8rpx; margin: 4rpx 8rpx; flex-shrink: 0; }
.mon-e { font-size: 24rpx; margin-right: 6rpx; }
.mon-r { flex: 1; }
.mon-n { font-size: 18rpx; color: #fff; }
.hp-bar { height: 8rpx; background: rgba(255,255,255,0.2); border-radius: 4rpx; margin: 2rpx 0; overflow: hidden; }
.hp-fill { height: 100%; background: linear-gradient(90deg, #F44336, #FF5722); border-radius: 4rpx; }
.mon-hp { font-size: 16rpx; color: rgba(255,255,255,0.6); }

/* 信息栏 */
.info-bar { display: flex; justify-content: space-between; align-items: center; padding: 4rpx 8rpx; flex-shrink: 0; background: rgba(0,0,0,0.15); }
.info-left, .info-right { width: 80rpx; }
.info-lbl { font-size: 14rpx; color: rgba(255,255,255,0.6); text-align: center; display: block; margin-bottom: 2rpx; }
.hold-grid, .next-grid { display: flex; flex-direction: column; align-items: center; }
.next-grid { gap: 3rpx; }
.g-row { display: flex; }
.g-cell { width: 14rpx; height: 14rpx; margin: 1rpx; border-radius: 1rpx; }
.empty-m { font-size: 16rpx; color: rgba(255,255,255,0.3); }
.ni { background: rgba(255,255,255,0.08); border-radius: 4rpx; padding: 3rpx; }
.info-center { display: flex; gap: 16rpx; }
.sb { text-align: center; }
.sv { display: block; font-size: 28rpx; font-weight: bold; color: #FFD700; }
.sl { display: block; font-size: 14rpx; color: rgba(255,255,255,0.6); }

/* 棋盘 */
.board-wrap { flex: 1; display: flex; align-items: center; justify-content: center; min-height: 0; overflow: hidden; }
.board-canvas { display: block; border-radius: 4rpx; border: 2rpx solid rgba(255,255,255,0.12); box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.4); }

/* 道具栏 */
.items-bar { display: flex; gap: 8rpx; justify-content: center; padding: 3rpx 0; flex-shrink: 0; }
.itb { display: flex; align-items: center; gap: 3rpx; background: rgba(255,255,255,0.1); border-radius: 6rpx; padding: 4rpx 10rpx; font-size: 20rpx; }
.itb.off { opacity: 0.3; }
.it-c { font-size: 14rpx; color: rgba(255,255,255,0.7); }

/* 按钮栏 */
.btn-bar { flex-shrink: 0; padding: 6rpx 16rpx 20rpx; background: rgba(0,0,0,0.2); }
.btn-row { display: flex; justify-content: center; gap: 12rpx; }
.btn { width: 76rpx; height: 60rpx; background: rgba(255,255,255,0.2); border-radius: 12rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid rgba(255,255,255,0.2); }
.btn:active { background: rgba(255,255,255,0.35); }
.btn-a { font-size: 28rpx; color: #fff; }
.btn-t { font-size: 18rpx; color: #fff; font-weight: bold; }
.btn-big { width: 84rpx; height: 68rpx; background: rgba(255,255,255,0.25); }
.btn-big .btn-a { font-size: 36rpx; }
.btn-gold { background: rgba(255,215,0,0.3); }

/* 弹窗 */
.overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); display: flex; align-items: center; justify-content: center; z-index: 100; }
.dialog { background: linear-gradient(135deg, #2A2A4E, #1A1A3E); border-radius: 24rpx; padding: 28rpx 24rpx; min-width: 400rpx; text-align: center; border: 2rpx solid rgba(255,255,255,0.1); }
.dt { display: block; font-size: 36rpx; font-weight: bold; color: #fff; margin-bottom: 12rpx; }
.dd { display: block; font-size: 24rpx; color: rgba(255,255,255,0.8); margin-bottom: 12rpx; }
.ds { display: block; font-size: 56rpx; font-weight: bold; color: #7C4DFF; margin-bottom: 8rpx; }
.dr { display: block; font-size: 24rpx; color: #FFD700; margin-bottom: 16rpx; }
.dc { display: block; font-size: 22rpx; color: #FFD700; margin-bottom: 12rpx; }
.db { background: rgba(124,77,255,0.4); border-radius: 28rpx; padding: 14rpx 0; margin-top: 8rpx; color: #fff; font-size: 26rpx; font-weight: bold; }
.db:active { background: rgba(124,77,255,0.6); }
.db.gray { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.6); }
.shop-d { max-height: 60vh; overflow-y: auto; }
.sl { display: flex; flex-direction: column; gap: 6rpx; margin: 12rpx 0; }
.si { display: flex; align-items: center; padding: 8rpx; background: rgba(255,255,255,0.06); border-radius: 8rpx; gap: 8rpx; }
.si-e { font-size: 28rpx; }
.si-r { flex: 1; text-align: left; }
.si-n { display: block; font-size: 22rpx; color: #fff; }
.si-d { display: block; font-size: 16rpx; color: rgba(255,255,255,0.5); }
.si-p { font-size: 20rpx; color: #FFD700; }
