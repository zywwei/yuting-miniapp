/* 经典俄罗斯方块 - 单行顶部信息 | 棋盘撑满 | 底部按钮 */
page { height: 100%; margin: 0; }

.game-container {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #E8F4FD 0%, #D5F5E3 40%, #FDFEFE 100%);
  overflow: hidden;
}

/* === 顶部信息区：单行布局 === */
.top-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: rgba(255,255,255,0.6);
  backdrop-filter: blur(10px);
  gap: 16rpx;
}

/* 标签文字 */
.top-label {
  font-size: 20rpx;
  color: #6B9EAE;
  font-weight: 500;
  margin-bottom: 4rpx;
  text-align: center;
}

/* 左侧暂存 */
.top-hold {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 中间分数区 */
.top-scores {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.55);
  border-radius: 16rpx;
  padding: 10rpx 12rpx;
  gap: 0;
}

.top-score-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 76rpx;
}

.top-score-val {
  font-size: 34rpx;
  font-weight: bold;
  color: #3AAFA9;
  line-height: 1.1;
}

.top-score-val.coin-val {
  color: #E8A838;
}

.top-score-lbl {
  font-size: 18rpx;
  color: #88B4C0;
  margin-top: 4rpx;
  font-weight: 500;
}

.top-divider {
  width: 2rpx;
  height: 40rpx;
  background: linear-gradient(180deg, transparent, rgba(107,158,174,0.25), transparent);
  margin: 0 10rpx;
}

/* 右侧下一个 */
.top-next {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.next-row {
  display: flex;
  gap: 6rpx;
}

/* 预览框 */
.preview-box {
  background: rgba(255,255,255,0.65);
  border-radius: 10rpx;
  padding: 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  min-width: 60rpx;
  border: 2rpx solid rgba(255,255,255,0.8);
  box-shadow: 0 2rpx 8rpx rgba(107,158,174,0.1);
}

.mini-box {
  padding: 3rpx;
  min-height: 52rpx;
  min-width: 52rpx;
}

.preview-row {
  display: flex;
}

.preview-cell {
  width: 13rpx;
  height: 13rpx;
  border-radius: 0;
  box-shadow: none;
}

.preview-empty {
  font-size: 24rpx;
  color: rgba(107,158,174,0.3);
}

/* === 中间棋盘：撑满宽度 === */
.board-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 0;
}

.board-canvas {
  display: block;
  border-radius: 16rpx;
  border: 4rpx solid rgba(255,255,255,0.75);
  box-shadow:
    0 0 40rpx rgba(93,173,226,0.15),
    0 8rpx 32rpx rgba(107,158,174,0.15);
}

/* === 底部操作栏 === */
.control-bar {
  flex-shrink: 0;
  padding: 16rpx 48rpx 32rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.3), rgba(255,255,255,0.1));
}

.control-row-1 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 20rpx;
}

.control-row-2 {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 40rpx;
}

.ctrl-spacer {
  width: 20rpx;
}

.ctrl-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.65);
  border-radius: 20rpx;
  border: 2rpx solid rgba(255,255,255,0.8);
  transition: all 0.15s ease;
  box-shadow: 0 4rpx 12rpx rgba(107,158,174,0.12);
}

.ctrl-btn:active {
  background: rgba(255,255,255,0.85);
  transform: scale(0.95);
}

.ctrl-hold, .ctrl-drop {
  width: 130rpx;
  height: 80rpx;
  gap: 4rpx;
}

.ctrl-hold {
  background: rgba(93,173,226,0.2);
  border-color: rgba(93,173,226,0.3);
}

.ctrl-drop {
  background: rgba(247,220,111,0.25);
  border-color: rgba(247,220,111,0.35);
}

.ctrl-rotate {
  width: 100rpx;
  height: 100rpx;
  background: rgba(187,143,206,0.2);
  border-color: rgba(187,143,206,0.3);
}

.ctrl-icon {
  font-size: 28rpx;
  color: #5B8A9A;
  line-height: 1;
}

.ctrl-rotate .ctrl-icon {
  font-size: 48rpx;
  line-height: 1;
}

.rotate-icon {
  font-weight: bold;
  color: #7B6B8A;
}

.ctrl-text {
  font-size: 22rpx;
  color: #5B8A9A;
  font-weight: bold;
}

.ctrl-dir {
  width: 110rpx;
  height: 80rpx;
  background: rgba(255,255,255,0.55);
}

.ctrl-arrow {
  font-size: 36rpx;
  color: #5B8A9A;
}

/* === 弹窗（canvas 隐藏后普通 view 覆盖） === */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(107,158,174,0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  backdrop-filter: blur(6px);
}

.dialog {
  width: 520rpx;
  background: linear-gradient(135deg, #F0F9FF, #E8F6F3);
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  text-align: center;
  border: 2rpx solid rgba(255,255,255,0.9);
  box-shadow: 0 12rpx 40rpx rgba(107,158,174,0.2);
}

.dialog-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #3AAFA9;
  margin-bottom: 20rpx;
}

.dialog-score {
  display: block;
  font-size: 72rpx;
  font-weight: bold;
  color: #5DADE2;
  margin-bottom: 12rpx;
}

.dialog-info {
  display: block;
  font-size: 28rpx;
  color: #6B9EAE;
  margin-bottom: 8rpx;
}

.dialog-coin {
  display: block;
  font-size: 26rpx;
  color: #E8A838;
  margin-bottom: 24rpx;
}

.dialog-btn {
  background: rgba(93,173,226,0.25);
  border-radius: 36rpx;
  padding: 22rpx 0;
  margin-top: 16rpx;
  color: #3AAFA9;
  font-size: 30rpx;
  font-weight: bold;
  border: 2rpx solid rgba(255,255,255,0.6);
}

.dialog-btn:active {
  background: rgba(93,173,226,0.4);
}

.dialog-btn.gray {
  background: rgba(255,255,255,0.4);
  color: #88B4C0;
}
