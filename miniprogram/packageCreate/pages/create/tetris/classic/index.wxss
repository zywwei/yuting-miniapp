/* 经典俄罗斯方块 - 单行顶部信息 | 棋盘撑满 | 底部按钮 */
page { height: 100%; margin: 0; }

.game-container {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #6B46D4 0%, #4A2AB0 40%, #321F7A 100%);
  overflow: hidden;
}

/* === 顶部信息区：单行布局 === */
.top-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: rgba(0,0,0,0.25);
  backdrop-filter: blur(10px);
  gap: 16rpx;
}

/* 标签文字 */
.top-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.85);
  font-weight: 500;
  margin-bottom: 4rpx;
  text-align: center;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.3);
}

/* 左侧暂存 */
.top-hold {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 中间分数区 */
.top-scores {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,0.15);
  border-radius: 16rpx;
  padding: 10rpx 12rpx;
  gap: 0;
}

.top-score-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 76rpx;
}

.top-score-val {
  font-size: 34rpx;
  font-weight: bold;
  color: #FFD700;
  line-height: 1.1;
  text-shadow: 0 2rpx 8rpx rgba(255,215,0,0.4);
}

.top-score-val.coin-val {
  color: #FFB800;
}

.top-score-lbl {
  font-size: 18rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 4rpx;
  font-weight: 500;
}

.top-divider {
  width: 2rpx;
  height: 40rpx;
  background: linear-gradient(180deg, transparent, rgba(255,255,255,0.2), transparent);
  margin: 0 10rpx;
}

/* 右侧下一个 */
.top-next {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.next-row {
  display: flex;
  gap: 6rpx;
}

/* 预览框 */
.preview-box {
  background: rgba(0,0,0,0.4);
  border-radius: 10rpx;
  padding: 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 60rpx;
  min-width: 60rpx;
  border: 2rpx solid rgba(255,255,255,0.1);
  box-shadow: inset 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.mini-box {
  padding: 3rpx;
  min-height: 52rpx;
  min-width: 52rpx;
}

.preview-row {
  display: flex;
}

.preview-cell {
  width: 13rpx;
  height: 13rpx;
  border-radius: 0;
  box-shadow: none;
}

.preview-empty {
  font-size: 24rpx;
  color: rgba(255,255,255,0.15);
}

/* === 中间棋盘：撑满宽度 === */
.board-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 0;
}

.board-canvas {
  display: block;
  border-radius: 16rpx;
  border: 4rpx solid rgba(255,255,255,0.15);
  box-shadow: 
    0 0 60rpx rgba(107, 70, 212, 0.4),
    0 8rpx 32rpx rgba(0,0,0,0.5),
    inset 0 0 0 2rpx rgba(255,255,255,0.05);
}

/* === 底部操作栏 === */
.control-bar {
  flex-shrink: 0;
  padding: 16rpx 48rpx 32rpx;
  background: linear-gradient(180deg, rgba(0,0,0,0.2), rgba(0,0,0,0.4));
}

.control-row-1 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 20rpx;
}

.control-row-2 {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 40rpx;
}

.ctrl-spacer {
  width: 20rpx;
}

.ctrl-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, rgba(255,255,255,0.2), rgba(255,255,255,0.1));
  border-radius: 20rpx;
  border: 2rpx solid rgba(255,255,255,0.25);
  transition: all 0.15s ease;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2);
}

.ctrl-btn:active {
  background: linear-gradient(180deg, rgba(255,255,255,0.4), rgba(255,255,255,0.25));
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.3);
}

.ctrl-hold, .ctrl-drop {
  width: 130rpx;
  height: 80rpx;
  gap: 4rpx;
}

.ctrl-hold {
  background: linear-gradient(180deg, rgba(100,200,255,0.25), rgba(100,200,255,0.1));
  border-color: rgba(100,200,255,0.3);
}

.ctrl-drop {
  background: linear-gradient(180deg, rgba(255,215,0,0.3), rgba(255,215,0,0.15));
  border-color: rgba(255,215,0,0.4);
}

.ctrl-rotate {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.3), rgba(255,255,255,0.15));
  border-color: rgba(255,255,255,0.35);
}

.ctrl-icon {
  font-size: 28rpx;
  color: #fff;
  line-height: 1;
}

.ctrl-rotate .ctrl-icon {
  font-size: 48rpx;
  line-height: 1;
}

.rotate-icon {
  font-weight: bold;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}

.ctrl-text {
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
  font-weight: bold;
}

.ctrl-dir {
  width: 110rpx;
  height: 80rpx;
  background: linear-gradient(180deg, rgba(255,255,255,0.18), rgba(255,255,255,0.08));
}

.ctrl-arrow {
  font-size: 36rpx;
  color: #fff;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.3);
}

/* === 弹窗（canvas 隐藏后普通 view 覆盖） === */
.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.dialog {
  width: 520rpx;
  background: linear-gradient(135deg, #6C3CE0, #3B27A5);
  border-radius: 28rpx;
  padding: 40rpx 36rpx;
  text-align: center;
  border: 2rpx solid rgba(255,255,255,0.15);
}

.dialog-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.dialog-score {
  display: block;
  font-size: 72rpx;
  font-weight: bold;
  color: #FFD700;
  margin-bottom: 12rpx;
}

.dialog-info {
  display: block;
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  margin-bottom: 8rpx;
}

.dialog-coin {
  display: block;
  font-size: 26rpx;
  color: #FFD700;
  margin-bottom: 24rpx;
}

.dialog-btn {
  background: rgba(255,255,255,0.25);
  border-radius: 36rpx;
  padding: 22rpx 0;
  margin-top: 16rpx;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
}

.dialog-btn:active {
  background: rgba(255,255,255,0.4);
}

.dialog-btn.gray {
  background: rgba(255,255,255,0.1);
  color: rgba(255,255,255,0.7);
}
