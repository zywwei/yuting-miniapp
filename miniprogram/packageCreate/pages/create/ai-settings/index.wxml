<view class="container">
  <!-- Tab切换 -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'prompt' ? 'active' : ''}}" bindtap="switchTab" data-tab="prompt">
      <text class="tab-icon">📝</text>
      <text class="tab-text">提示词</text>
    </view>
    <view class="tab-item {{activeTab === 'model' ? 'active' : ''}}" bindtap="switchTab" data-tab="model">
      <text class="tab-icon">🤖</text>
      <text class="tab-text">模型配置</text>
    </view>
  </view>

  <!-- 模型配置Tab -->
  <view class="tab-content" wx:if="{{activeTab === 'model'}}">
    <!-- 调用方式选择 -->
    <view class="section">
      <view class="call-type-tabs">
        <view 
          class="call-type-tab {{callType === 'direct' ? 'active' : ''}}" 
          bindtap="switchCallType"
          data-type="direct"
        >
          <view class="tab-icon">🔗</view>
          <view class="tab-info">
            <view class="tab-name">直接调用</view>
            <view class="tab-desc">使用自己的API Key</view>
          </view>
        </view>
        <view 
          class="call-type-tab {{callType === 'plan' ? 'active' : ''}}" 
          bindtap="switchCallType"
          data-type="plan"
        >
          <view class="tab-icon">📦</view>
          <view class="tab-info">
            <view class="tab-name">套餐服务</view>
            <view class="tab-desc">使用平台套餐</view>
          </view>
        </view>
        <view 
          class="call-type-tab {{callType === 'voice' ? 'active' : ''}}" 
          bindtap="switchCallType"
          data-type="voice"
        >
          <view class="tab-icon">🔊</view>
          <view class="tab-info">
            <view class="tab-name">语音设置</view>
            <view class="tab-desc">测试语音合成</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 提示词Tab -->
  <view class="tab-content" wx:if="{{activeTab === 'prompt'}}">
    <!-- 提示词模板 -->
    <view class="section">
      <view class="section-title">选择提示词模板</view>
      <view class="template-grid">
        <view 
          wx:for="{{templates}}" 
          wx:key="key"
          class="template-card {{currentTemplate === item.key ? 'active' : ''}}"
          bindtap="selectTemplate"
          data-key="{{item.key}}"
        >
          <view class="template-icon">{{item.icon}}</view>
          <view class="template-name">{{item.name}}</view>
          <view class="template-desc">{{item.desc}}</view>
          <view class="template-check" wx:if="{{currentTemplate === item.key}}">✓</view>
        </view>
      </view>
    </view>
    
    <!-- 模板内容预览 -->
    <view class="section" wx:if="{{currentTemplateContent}}">
      <view class="section-title">模板内容</view>
      <view class="template-preview">
        <view class="preview-header">
          <view class="preview-copy" bindtap="copyTemplateContent">复制内容</view>
        </view>
        <view class="preview-content">{{currentTemplateContent}}</view>
      </view>
    </view>

    <!-- 自定义提示词 -->
    <view class="section">
      <view class="section-title">自定义提示词（可选）</view>
      <view class="textarea-wrapper">
        <textarea 
          class="textarea-field"
          placeholder="输入自定义提示词，将覆盖上方模板..."
          value="{{customPrompt}}"
          bindinput="onPromptInput"
          maxlength="1000"
        />
        <view class="textarea-count">{{customPrompt.length}}/1000</view>
      </view>
    </view>

    <!-- 保存提示词 -->
    <view class="section">
      <button class="save-prompt-btn" bindtap="savePrompt" disabled="{{saving}}">
        {{saving ? '保存中...' : '保存提示词配置'}}
      </button>
    </view>
  </view>

  <!-- 模型配置Tab内容（直接调用/套餐服务） -->
  <view class="tab-content" wx:if="{{activeTab === 'model' && callType !== 'voice'}}">
    <!-- 模型列表 -->
    <view class="section">
      <view class="model-list">
        <view 
          wx:for="{{callType === 'direct' ? domesticModels : platformModels}}" 
          wx:key="key"
          class="model-item {{currentModel === item.key ? 'active' : ''}}"
        >
          <!-- 厂家主卡片 -->
          <view class="model-main" bindtap="selectModel" data-key="{{item.key}}">
            <view class="model-icon" style="background: {{item.info.color}}">{{item.info.icon}}</view>
            <view class="model-info">
              <view class="model-name">
                {{item.info.name}}
                <text class="configured-badge" wx:if="{{configuredModels[item.key]}}">✓</text>
              </view>
              <view class="model-provider">
                {{item.info.provider}}
                <text class="current-sub" wx:if="{{currentModel === item.key && currentSubModelName}}">· {{currentSubModelName}}</text>
              </view>
            </view>
            <view class="model-expand {{currentModel === item.key && expandModel ? 'open' : ''}}" wx:if="{{item.info.subModels && item.info.subModels.length > 0}}">
              <text>›</text>
            </view>
          </view>
          
          <!-- 子模型选择 + API Key配置（展开时显示） -->
          <view class="model-expand-area" wx:if="{{currentModel === item.key && expandModel}}">
            <!-- 子模型选择 -->
            <view class="sub-model-section" wx:if="{{item.info.subModels && item.info.subModels.length > 0}}">
              <view class="sub-model-title">选择模型版本</view>
              <view class="sub-model-list">
                <view 
                  wx:for="{{item.info.subModels}}" 
                  wx:for-item="sub"
                  wx:key="key"
                  class="sub-item {{currentSubModel === sub.key ? 'active' : ''}}"
                  bindtap="selectSubModel"
                  data-key="{{sub.key}}"
                  data-name="{{sub.name}}"
                >
                  <view class="sub-name">{{sub.name}}</view>
                  <view class="sub-desc">{{sub.desc}}</view>
                  <view class="sub-check" wx:if="{{currentSubModel === sub.key}}">✓</view>
                </view>
              </view>
            </view>
            
            <!-- API Key配置 -->
            <view class="api-key-section">
              <view class="api-key-title">API Key配置</view>
              <view class="input-group">
                <input 
                  class="input-field"
                  type="text"
                  password="{{!showApiKey}}"
                  placeholder="请输入{{item.info.name}}的API Key"
                  value="{{apiKey}}"
                  bindinput="onApiKeyInput"
                />
                <view class="input-toggle" bindtap="toggleKeyVisibility">
                  {{showApiKey ? '🙈' : '👁️'}}
                </view>
              </view>
              
              <!-- Secret Key（文心一言专用） -->
              <view class="input-group" wx:if="{{currentModel === 'wenxin' || currentModel === 'wenxin-plan'}}">
                <input 
                  class="input-field"
                  type="text"
                  password="{{!showSecretKey}}"
                  placeholder="请输入Secret Key"
                  value="{{secretKey}}"
                  bindinput="onSecretKeyInput"
                />
                <view class="input-toggle" bindtap="toggleSecretVisibility">
                  {{showSecretKey ? '🙈' : '👁️'}}
                </view>
              </view>
              
              <view class="api-key-actions">
                <button class="test-btn" bindtap="testApiKey" disabled="{{testing}}">
                  {{testing ? '测试中...' : '测试连接'}}
                </button>
                <button class="save-btn-small" bindtap="saveConfig" disabled="{{saving}}">
                  {{saving ? '保存中...' : '保存配置'}}
                </button>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 语音设置Tab内容 -->
  <view class="tab-content" wx:if="{{activeTab === 'model' && callType === 'voice'}}">
    <!-- TTS引擎选择 -->
    <view class="section">
      <view class="section-title">语音合成引擎</view>
      <view class="voice-tabs">
        <view 
          wx:for="{{ttsEngines}}" 
          wx:key="key"
          class="voice-tab {{currentTtsEngine === item.key ? 'active' : ''}}"
          bindtap="switchTtsEngine"
          data-key="{{item.key}}"
        >
          {{item.name}}
        </view>
      </view>
    </view>

    <!-- 小米TTS配置 -->
    <view wx:if="{{currentTtsEngine === 'mimo'}}">
      <!-- 调用方式选择 -->
      <view class="section">
        <view class="call-type-tabs">
          <view 
            class="call-type-tab {{ttsCallType === 'direct' ? 'active' : ''}}" 
            bindtap="switchTtsCallType"
            data-type="direct"
          >
            <view class="tab-icon">🔗</view>
            <view class="tab-info">
              <view class="tab-name">直接调用</view>
              <view class="tab-desc">api.xiaomimimo.com</view>
            </view>
          </view>
          <view 
            class="call-type-tab {{ttsCallType === 'plan' ? 'active' : ''}}" 
            bindtap="switchTtsCallType"
            data-type="plan"
          >
            <view class="tab-icon">📦</view>
            <view class="tab-info">
              <view class="tab-name">套餐服务</view>
              <view class="tab-desc">token-plan-cn.xiaomimimo.com</view>
            </view>
          </view>
        </view>
      </view>

      <!-- 直接调用配置 -->
      <view class="section" wx:if="{{ttsCallType === 'direct'}}">
        <view class="config-card">
          <view class="config-header">
            <view class="config-icon">🤖</view>
            <view class="config-info">
              <view class="config-name">小米MiMo TTS</view>
              <view class="config-status {{mimoTtsApiKey ? 'configured' : ''}}">
                {{mimoTtsApiKey ? '已配置' : '未配置'}}
              </view>
            </view>
          </view>
          <view class="config-body">
            <view class="input-group">
              <view class="input-label">API密钥</view>
              <input 
                class="input-field"
                type="text"
                password="{{!showMimoTtsKey}}"
                placeholder="请输入API密钥"
                value="{{mimoTtsApiKey}}"
                bindinput="onMimoTtsKeyInput"
              />
              <view class="input-toggle" bindtap="toggleMimoTtsKeyVisibility">
                {{showMimoTtsKey ? '🙈' : '👁️'}}
              </view>
            </view>
            <view class="config-actions">
              <button class="test-btn" bindtap="testMimoTts" disabled="{{testingMimoTts}}">
                {{testingMimoTts ? '测试中...' : '测试'}}
              </button>
              <button class="save-btn" bindtap="saveMimoTtsKey" disabled="{{savingMimoTts}}">
                {{savingMimoTts ? '保存中...' : '保存'}}
              </button>
            </view>
          </view>
        </view>
      </view>

      <!-- 套餐服务配置 -->
      <view class="section" wx:if="{{ttsCallType === 'plan'}}">
        <view class="config-card">
          <view class="config-header">
            <view class="config-icon">📦</view>
            <view class="config-info">
              <view class="config-name">小米MiMo TTS</view>
              <view class="config-status {{mimoTtsPlanApiKey ? 'configured' : ''}}">
                {{mimoTtsPlanApiKey ? '已配置' : '未配置'}}
              </view>
            </view>
          </view>
          <view class="config-body">
            <view class="input-group">
              <view class="input-label">套餐API密钥</view>
              <input 
                class="input-field"
                type="text"
                password="{{!showMimoTtsPlanKey}}"
                placeholder="请输入套餐API密钥"
                value="{{mimoTtsPlanApiKey}}"
                bindinput="onMimoTtsPlanKeyInput"
              />
              <view class="input-toggle" bindtap="toggleMimoTtsPlanKeyVisibility">
                {{showMimoTtsPlanKey ? '🙈' : '👁️'}}
              </view>
            </view>
            <view class="config-actions">
              <button class="test-btn" bindtap="testMimoTts" disabled="{{testingMimoTts}}">
                {{testingMimoTts ? '测试中...' : '测试'}}
              </button>
              <button class="save-btn" bindtap="saveMimoTtsPlanKey" disabled="{{savingMimoTts}}">
                {{savingMimoTts ? '保存中...' : '保存'}}
              </button>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 百度TTS配置 -->
    <view wx:if="{{currentTtsEngine === 'baidu'}}">
      <view class="section">
        <view class="config-card">
          <view class="config-header">
            <view class="config-icon">🗣️</view>
            <view class="config-info">
              <view class="config-name">百度语音合成</view>
              <view class="config-status {{baiduApiKey ? 'configured' : ''}}">
                {{baiduApiKey ? '已配置' : '未配置'}}
              </view>
            </view>
          </view>
          <view class="config-body">
            <view class="input-group">
              <view class="input-label">App ID</view>
              <input 
                class="input-field"
                type="text"
                placeholder="请输入百度App ID"
                value="{{baiduAppId}}"
                bindinput="onBaiduAppIdInput"
              />
            </view>
            <view class="input-group">
              <view class="input-label">API Key</view>
              <input 
                class="input-field"
                type="text"
                password="{{!showBaiduApiKey}}"
                placeholder="请输入API Key"
                value="{{baiduApiKey}}"
                bindinput="onBaiduApiKeyInput"
              />
              <view class="input-toggle" bindtap="toggleBaiduApiKeyVisibility">
                {{showBaiduApiKey ? '🙈' : '👁️'}}
              </view>
            </view>
            <view class="input-group">
              <view class="input-label">Secret Key</view>
              <input 
                class="input-field"
                type="text"
                password="{{!showBaiduSecretKey}}"
                placeholder="请输入Secret Key"
                value="{{baiduSecretKey}}"
                bindinput="onBaiduSecretKeyInput"
              />
              <view class="input-toggle" bindtap="toggleBaiduSecretKeyVisibility">
                {{showBaiduSecretKey ? '🙈' : '👁️'}}
              </view>
            </view>
            <view class="config-actions">
              <button class="test-btn" bindtap="testBaiduTts" disabled="{{testingBaiduTts}}">
                {{testingBaiduTts ? '测试中...' : '测试'}}
              </button>
              <button class="save-btn" bindtap="saveBaiduTtsConfig" disabled="{{savingBaiduTts}}">
                {{savingBaiduTts ? '保存中...' : '保存'}}
              </button>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- Edge TTS配置 -->
    <view wx:if="{{currentTtsEngine === 'edge'}}">
      <view class="section">
        <view class="config-card">
          <view class="config-header">
            <view class="config-icon">🌐</view>
            <view class="config-info">
              <view class="config-name">Edge TTS</view>
              <view class="config-status configured">
                免费使用
              </view>
            </view>
          </view>
          <view class="config-body">
            <view class="help-card">
              <view class="help-item">
                <text class="help-icon">💡</text>
                <text class="help-text">Edge TTS免费，无需配置</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
