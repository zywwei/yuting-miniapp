.role-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: #FFF0F5;
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
}

.role-badge.small {
  padding: 2rpx 10rpx;
}

.badge-icon {
  font-size: 24rpx;
}

.role-badge.small .badge-icon {
  font-size: 20rpx;
}

.badge-name {
  font-size: 22rpx;
  color: #FF6B8A;
}

.role-badge.small .badge-name {
  font-size: 20rpx;
}
