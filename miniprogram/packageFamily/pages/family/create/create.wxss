.page {
  min-height: 100vh;
  background: #FFF5F7;
}

/* 头部 */
.header {
  position: relative;
  padding: 60rpx 40rpx 40rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, #FF9AAB 0%, #FFB6C1 50%, #FFD1DC 100%);
  border-radius: 0 0 60rpx 60rpx;
}

.header-content {
  position: relative;
  text-align: center;
}

.header-icon {
  font-size: 64rpx;
  display: block;
  margin-bottom: 12rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
}

/* 内容区 */
.content {
  padding: 20rpx 32rpx 40rpx;
}

/* 头像卡片 */
.avatar-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255,154,171,0.15);
  text-align: center;
}

.avatar-group {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.avatar-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  padding: 6rpx;
  background: linear-gradient(135deg, #FF9AAB, #FFB6C1);
  box-shadow: 0 8rpx 24rpx rgba(255,154,171,0.3);
}

.avatar-ring.child {
  background: linear-gradient(135deg, #FFD1DC, #FFE4E9);
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-default {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-emoji {
  font-size: 48rpx;
}

.avatar-label {
  font-size: 24rpx;
  color: #666;
  margin-top: 12rpx;
}

.avatar-connector {
  font-size: 32rpx;
  color: #FFB6C1;
  font-weight: bold;
}

.avatar-hint {
  font-size: 22rpx;
  color: #ccc;
}

/* 表单卡片 */
.form-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 0;
  margin-bottom: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(255,154,171,0.1);
}

.form-group {
  padding: 0 32rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
}

.form-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 48rpx;
  text-align: center;
}

.form-content {
  flex: 1;
}

.form-label {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.form-input {
  font-size: 30rpx;
  color: #333;
  width: 100%;
}

.form-input.picker {
  color: #333;
}

.form-input.placeholder {
  color: #ddd;
}

.form-divider {
  height: 1rpx;
  background: #f5f5f5;
  margin-left: 68rpx;
}

/* 性别选择 */
.gender-options {
  display: flex;
  gap: 20rpx;
}

.gender-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  background: #FFF5F7;
  border: 2rpx solid #FFE4E9;
  transition: all 0.2s;
}

.gender-btn.active-girl {
  background: linear-gradient(135deg, #FF9AAB, #FFB6C1);
  border-color: #FF9AAB;
  box-shadow: 0 4rpx 16rpx rgba(255,154,171,0.3);
}

.gender-btn.active-boy {
  background: linear-gradient(135deg, #4A90D9, #6BB3F0);
  border-color: #4A90D9;
  box-shadow: 0 4rpx 16rpx rgba(74,144,217,0.3);
}

.gender-emoji {
  font-size: 32rpx;
}

.gender-text {
  font-size: 26rpx;
  color: #666;
}

.gender-btn.active-girl .gender-text,
.gender-btn.active-boy .gender-text {
  color: #fff;
  font-weight: bold;
}

/* 创建按钮 */
.btn-create {
  background: linear-gradient(135deg, #FF9AAB 0%, #FFB6C1 100%);
  color: #fff;
  border: none;
  border-radius: 48rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 34rpx;
  font-weight: bold;
  box-shadow: 0 12rpx 32rpx rgba(255,154,171,0.4);
}

.btn-icon {
  font-size: 36rpx;
}

/* 成功页面 */
.success-panel {
  text-align: center;
  position: relative;
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, #FFD1DC 0%, #FFF5F7 50%);
}

.success-content {
  position: relative;
  padding: 40rpx;
  width: 100%;
}

.success-icon {
  font-size: 96rpx;
  margin-bottom: 20rpx;
}

.success-title {
  display: block;
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.success-subtitle {
  display: block;
  font-size: 28rpx;
  color: #888;
  margin-bottom: 32rpx;
}

.code-card {
  position: relative;
  margin-bottom: 24rpx;
}

.code-box {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(255,154,171,0.2);
  border: 3rpx dashed #FFB6C1;
}

.code {
  font-size: 56rpx;
  font-weight: bold;
  color: #FF6B8A;
  letter-spacing: 12rpx;
}

.code-decor {
  position: absolute;
  top: -16rpx;
  right: 24rpx;
  font-size: 40rpx;
}

.code-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-bottom: 48rpx;
}

.btn-group {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn-action {
  background: #fff;
  color: #FF6B8A;
  border: 2rpx solid #FFB6C1;
  border-radius: 48rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.btn-action.share {
  background: #07C160;
  color: #fff;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7,193,96,0.3);
}

.btn-action-icon {
  font-size: 32rpx;
}

.btn-home {
  background: transparent;
  color: #FF9AAB;
  border: none;
  font-size: 28rpx;
  margin-top: 16rpx;
}
