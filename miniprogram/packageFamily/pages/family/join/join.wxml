<view class="page">
  <view class="header">
    <text class="title">加入家庭</text>
    <text class="subtitle">输入家人分享的邀请码</text>
  </view>

  <view class="content">
    <view class="input-group">
      <text class="label">邀请码</text>
      <input
        class="input code-input"
        placeholder="请输入8位邀请码"
        value="{{inviteCode}}"
        bindinput="onCodeInput"
        maxlength="8"
        adjust-position="{{true}}"
      />
    </view>

    <view class="hint">
      <text>邀请码由家庭管理员分享给您，有效期为7天</text>
    </view>

    <button class="btn-primary" bindtap="joinFamily" loading="{{loading}}" disabled="{{inviteCode.length !== 8}}">加入家庭</button>
  </view>
</view>
